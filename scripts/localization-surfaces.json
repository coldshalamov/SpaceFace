{
  "schema": "spaceface.localizationSurfaces.v1",
  "sourceLocale": "en-US",
  "roots": [
    { "path": "index.html", "kind": "html" },
    { "path": "src/careers", "kind": "js" },
    { "path": "src/data", "kind": "js" },
    { "path": "src/story", "kind": "js" },
    { "path": "src/systems", "kind": "js" },
    { "path": "src/ui", "kind": "js" }
  ],
  "extensions": [".js", ".mjs", ".html"],
  "excludes": [
    "src/localization"
  ],
  "recognizedCopyFields": [
    "name",
    "displayName",
    "shortName",
    "label",
    "title",
    "text",
    "line",
    "desc",
    "description",
    "subtitle",
    "summary",
    "hint",
    "headline",
    "body",
    "message",
    "objective",
    "copy",
    "ariaLabel",
    "placeholder",
    "emptyText",
    "tooltip",
    "prompt",
    "question",
    "detail",
    "tagline",
    "flavor",
    "rumor",
    "brief",
    "acceptText",
    "declineText",
    "successText",
    "failureText",
    "warning",
    "hail",
    "ack",
    "entryLine",
    "identityLine",
    "blurb",
    "prose"
  ],
  "domTextProperties": ["textContent", "innerText"],
  "htmlAttributes": ["aria-label", "title", "placeholder", "alt"]
}
