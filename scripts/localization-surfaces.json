    "displayName",
    "shortName",
    "label",
    "title",
    "text",
    "line",
    "desc",
    "description",
    "subtitle",
    "summary",
    "hint",
    "headline",
    "body",
    "message",
    "objective",
    "copy",
    "ariaLabel",
    "placeholder",
    "emptyText",
    "tooltip",
    "prompt",
    "question",
    "detail",
    "tagline",
    "flavor",
    "rumor",
    "brief",
    "acceptText",
    "declineText",
    "successText",
    "failureText",
    "warning",
    "hail",
    "ack",
    "entryLine",
    "identityLine",
    "blurb",
    "prose"
