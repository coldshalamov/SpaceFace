    "src/features/counterweightCircuit/readModel.js": ["detailTemplate"]
  },
  "scopedReturnFunctions": {
    "src/features/breakwaterSpur/project.js": ["nextActionFor", "operatingAction"],
    "src/features/cinderglassJob/readModel.js": ["objective"]
  },
  "scopedTextCalls": {
    "src/features/breakwaterSpur/": ["pushReceipt", "logItinerary"]
  },
  "htmlAttributes": ["aria-label", "title", "placeholder", "alt"]
}
