+import assert from 'node:assert/strict';
+import {readFileSync} from 'node:fs';
+import test from 'node:test';
+import {render} from '../src/render/renderer.js';
+import {createAdaptiveResolution,dynResFloorForTier,softwareRendererEmergencyProfile} from '../src/render/adaptiveQuality.js';
+const source=readFileSync(new URL('../src/render/renderer.js',import.meta.url),'utf8');
+// Execute the actual production initialization block, with only GL sizing/toast sinks stubbed.
+const initSource=source.slice(source.indexOf('    const dynFloor = dynResFloorForTier(gpu.tier);'),source.indexOf('    // Opt-in integrated-GPU preset suggestion.'));
+const refreshStatement=source.match(/this\._adaptive\.setEnabled\(this\._dynResAllowed === true && vd\.dynamicResolution !== false\);/)[0];
+const refresh=new Function('vd',refreshStatement);
+const init=new Function('state','gpu','createAdaptiveResolution','dynResFloorForTier','softwareRendererEmergencyProfile','scheduleTimeout','bus',initSource);
+function owner(software=true,dynamicResolution=false) {
+ const calls=[]; const o=Object.create(render);
+ o.state={render:{gpu:{software,tier:software?'software':'integrated'},dynResScale:1},settings:{video:{bloom:true,bloomLevels:2,renderScale:1,dynamicResolution}}};
+ o.bloom={setOptions:p=>calls.push({...p})}; o._applySize=()=>{};
+ o._sectorPostTransition={graphOptions:{}};
+ return {o,calls};
+}
+for(const enabled of [false,true]) test(`software initial scale and refresh stay synchronized (enabled=${enabled})`,()=>{
+ const {o}=owner(true,enabled);const before=structuredClone(o.state.settings);
+ init.call(o,o.state,o.state.render.gpu,createAdaptiveResolution,dynResFloorForTier,softwareRendererEmergencyProfile,()=>{},{});
+ assert.equal(o._adaptive.getScale(),.34);
+ assert.equal(o.state.render.dynResScale,.34);
+ for(let i=0;i<100;i++)o._adaptive.update(.1);
+ assert.equal(o._adaptive.getScale(),.34,'slow frames must not increase the emergency scale');
+ for(const next of [false,true,false,false]) {refresh.call(o,{dynamicResolution:next});assert.equal(o._adaptive.getScale(),o.state.render.dynResScale);assert.equal(o.state.render.dynResScale,.34);}
+ assert.deepEqual(o.state.settings,before);
+});
+test('software bloom-off survives ordinary settings sync and sector transition without changing settings',()=>{
+ const {o,calls}=owner();const before=structuredClone(o.state.settings);
+ init.call(o,o.state,o.state.render.gpu,createAdaptiveResolution,dynResFloorForTier,softwareRendererEmergencyProfile,()=>{},{});
+ o._syncPostOptions();assert.equal(calls.at(-1).bloom,false);
+ o._sectorPost={bloomStrengthScale:1.2,exposure:1.02};o._invalidatePostOptionsCache();o._syncPostOptions();assert.equal(calls.at(-1).bloom,false);
+ o._applySectorPostTransitionOptions({bloom:true,bloomStrength:.52,exposure:1});assert.equal(calls.at(-1).bloom,false);
+ assert.deepEqual(o.state.settings,before);
+});
+test('hardware initialization, settings, disable-to-full-resolution and bloom remain unchanged',()=>{
+ const {o,calls}=owner(false,true);
+ init.call(o,o.state,o.state.render.gpu,createAdaptiveResolution,dynResFloorForTier,softwareRendererEmergencyProfile,()=>{},{});
+ assert.equal(o._adaptive.getScale(),1);assert.equal(o.state.render.dynResScale,1);
+ for(let i=0;i<100;i++)o._adaptive.update(.1);
+ assert.ok(o._adaptive.getScale()<1);o._adaptive.setEnabled(false);assert.equal(o.state.render.dynResScale,1);
+ o._syncPostOptions();assert.equal(calls.at(-1).bloom,true);
+ o.state.settings.video.bloom=false;o._syncPostOptions();assert.equal(calls.at(-1).bloom,false);
+});
+
+test('software probe-up and settings disable return through the same runtime sink',()=>{
+ const {o}=owner(true,true);
+ init.call(o,o.state,o.state.render.gpu,createAdaptiveResolution,dynResFloorForTier,softwareRendererEmergencyProfile,()=>{},{});
+ for(let i=0;i<1300;i++)o._adaptive.update(1/60);
+ assert.ok(o._adaptive.getScale()>.34);
+ assert.equal(o.state.render.dynResScale,o._adaptive.getScale());
+ refresh.call(o,{dynamicResolution:false});
+ assert.equal(o.state.render.dynResScale,.34);assert.equal(o._adaptive.getScale(),.34);
+ refresh.call(o,{dynamicResolution:true});assert.equal(o._adaptive.getScale(),.34);
+});
+test('software label without software flag cannot suppress hardware bloom',()=>{
+ const {o,calls}=owner(false,false);o.state.render.gpu.tier='software';
+ o._syncPostOptions();assert.equal(calls.at(-1).bloom,true);
+ o._applySectorPostTransitionOptions({bloom:true});assert.equal(calls.at(-1).bloom,true);
+});
