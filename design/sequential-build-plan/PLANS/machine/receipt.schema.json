{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SpaceFace Sequential Prompt Receipt",
  "type": "object",
  "required": [
    "packet",
    "prompt_file",
    "base_commit",
    "state_reached",
    "proof",
    "known_failures",
    "unproven_claims"
  ],
  "properties": {
    "packet": {
      "type": "string",
      "pattern": "^SF-[0-9]{2}$"
    },
    "prompt_file": {
      "type": "string"
    },
    "agent": {
      "type": "string"
    },
    "base_commit": {
      "type": "string"
    },
    "result_commit": {
      "type": "string"
    },
    "worktree": {
      "type": "string"
    },
    "state_reached": {
      "enum": [
        "ALREADY_SATISFIED",
        "IMPLEMENTED",
        "FOCUSED_GREEN",
        "ROUTE_ACCEPTED",
        "VISUALLY_ACCEPTED",
        "INTEGRATED",
        "BLOCKED",
        "BLOCKED_BY_DEPENDENCY"
      ]
    },
    "dependencies_seen": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "paths_changed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "shared_change_requests": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "proof": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "command",
          "result"
        ],
        "properties": {
          "command": {
            "type": "string"
          },
          "result": {
            "type": "string"
          }
        }
      }
    },
    "public_route": {
      "type": "object"
    },
    "visual_review": {
      "type": "object"
    },
    "performance": {
      "type": "object"
    },
    "known_failures": {
      "type": "array"
    },
    "unproven_claims": {
      "type": "array"
    },
    "follow_ons": {
      "type": "array"
    }
  },
  "additionalProperties": true
}