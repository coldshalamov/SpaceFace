{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "spaceface://production/observatory-finding.schema.json",
  "title": "SpaceFace Gameplay Observatory Finding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "findingId",
    "sessionId",
    "candidateHash",
    "detectorId",
    "detectorVersion",
    "severity",
    "classification",
    "signal",
    "thresholdSnapshotPath",
    "window",
    "evidencePaths",
    "reviewStatus"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "findingId": { "type": "string", "minLength": 1 },
    "sessionId": { "type": "string", "minLength": 1 },
    "candidateHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "detectorId": { "type": "string", "minLength": 1 },
    "detectorVersion": { "type": "string", "minLength": 1 },
    "severity": { "enum": ["critical", "major", "minor", "advisory"] },
    "classification": {
      "enum": ["plan", "execution", "presentation", "calibration", "content_coverage", "unknown"]
    },
    "signal": {
      "type": "object",
      "additionalProperties": true,
      "minProperties": 1
    },
    "thresholdSnapshotPath": { "type": "string", "minLength": 1 },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startSimTime", "endSimTime", "preRollSeconds", "postRollSeconds"],
      "properties": {
        "startSimTime": { "type": "number", "minimum": 0 },
        "endSimTime": { "type": "number", "minimum": 0 },
        "preRollSeconds": { "type": "number", "minimum": 8 },
        "postRollSeconds": { "type": "number", "minimum": 12 }
      }
    },
    "evidencePaths": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },
    "reviewStatus": { "enum": ["unreviewed", "confirmed", "false_positive", "superseded"] }
  }
}
