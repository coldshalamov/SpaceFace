Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Quiet open flight walked all 16 beam slots and refreshed shader uniforms
while activeCount===0. Early-out; group.visible already false after last
release. Picture unchanged.
---
 src/render/combat/persistentBeams.js | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/src/render/combat/persistentBeams.js b/src/render/combat/persistentBeams.js
index 2ff2f506f..8f7dcfe4b 100644
--- a/src/render/combat/persistentBeams.js
+++ b/src/render/combat/persistentBeams.js
@@ -313,6 +313,12 @@ export class PersistentCombatBeamPool {
    *   where the simulation put it, so nothing here can invent a hit.
    */
   update(timeS, toLocal, accessibility = null, cameraFloor = 0, resolveOrigin = null) {
+    // Quiet open flight: capacity walk (prod 16) + shader uniform refresh while
+    // activeCount===0 was pure CPU; group.visible already false after last release.
+    if (!(this.activeCount > 0)) {
+      this.group.visible = false;
+      return 0;
+    }
     const localize = typeof toLocal === 'function' ? toLocal : identityLocal;
     const socketOf = typeof resolveOrigin === 'function' ? resolveOrigin : null;
     const now = finite(timeS, 0);
