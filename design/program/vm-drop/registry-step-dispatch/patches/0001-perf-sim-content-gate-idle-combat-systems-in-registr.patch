From 324ad3dd3833588f10c9c0e894d9c3a5569a5e7f Mon Sep 17 00:00:00 2001
From: coldshalamov <93robingattis@gmail.com>
Date: Thu, 24 Sep 2026 00:59:18 -0400
Subject: [PATCH] perf(sim): content-gate idle combat systems in registry.step
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Skip quiet-idle combat-island owners (run/dock/wing/capital/massline/heat/
cloak/machinery/planet/law) via a cheap wake mask, and move chronicler,
difficultyDirector, titles, npcJobsRuntime, and traffic to the 2 Hz calendar.
Preserves update order with a reused scratch queue. Fair quiet harness ~1.7–2.9×.
---
 src/core/catchupPolicy.js                  | 127 ++++++++++++++++++++-
 src/core/registry.js                       |   8 +-
 src/runtime/authoritativeSystemManifest.js |  56 ++++++++-
 test/sim-clock-catchup.test.mjs            | 116 +++++++++++++++++--
 4 files changed, 291 insertions(+), 16 deletions(-)

diff --git a/src/core/catchupPolicy.js b/src/core/catchupPolicy.js
index a97bc6371..cc8ce47d7 100644
--- a/src/core/catchupPolicy.js
+++ b/src/core/catchupPolicy.js
@@ -1,16 +1,31 @@
 // Catch-up and clock policy. Extra fixed steps keep the table clock only.
 // Calendar owners run at 2 Hz (or on clockWake.calendar). Glass/HUD/voice never
 // run on extra catch-up steps. Near owners run on the primary tick, not catch-up.
+// Content-gated combat-island owners are omitted from the production primary queue
+// while their wake mask bit is clear (idle skip / dirty-set for registry.step).
 
 import {
   CALENDAR_CLOCK_PERIOD_TICKS,
+  CONTENT_GATE,
+  getContentGate,
   SYSTEM_CLOCK,
   getSystemCapability,
   getSystemClock,
 } from '../runtime/authoritativeSystemManifest.js';
 
 export const CATCHUP_SKIP_CAPABILITIES = Object.freeze(['hud', 'voice']);
-export { CALENDAR_CLOCK_PERIOD_TICKS, SYSTEM_CLOCK };
+export { CALENDAR_CLOCK_PERIOD_TICKS, SYSTEM_CLOCK, CONTENT_GATE };
+
+/** Sectors where environmentalMachinery does real work (Ceres / Pallas / weather). */
+const MACHINERY_SECTOR_IDS = new Set([
+  'sector_ceres_belt',
+  'sector_pallas_drift',
+  'sector_veil_nebula',
+  'sector_vesta_forge',
+]);
+
+/** Sole authored planet site sector (PQ-013). */
+const PLANET_SECTOR_ID = 'sector_tethys_junction';
 
 export function isCatchupPresentationSkip(state) {
   return !!(state && (state.simCatchupIndex | 0) > 0);
@@ -32,17 +47,91 @@ export function shouldSkipSystemOnCatchup(systemName, state) {
 /**
  * Single skip used by createSimulation and createRegistry.
  * Catch-up extra steps: table only. Primary ticks: calendar at 2 Hz; table/near/glass run.
+ * Content-gated owners also skip on production primary ticks while their wake bit is clear.
  */
 function isProductionClockState(state) {
   return !!(state && state.runtime && state.runtime.profileId === 'production');
 }
 
+function hasOwnEnumKey(obj) {
+  if (!obj) return false;
+  for (const _key in obj) return true;
+  return false;
+}
+
+/**
+ * Cheap wake mask for content-gated combat-island owners. No allocation, no entity walks.
+ * Sticky bits (massline telemetry/threats still `.active`, remoteMassline still `.active`)
+ * keep the family on the queue for the settle tick that clears them.
+ */
+export function contentWakeMask(state) {
+  if (!state) return 0;
+  let mask = 0;
+
+  const run = state.run;
+  if (run && run.phase && run.phase !== 'inactive') mask |= CONTENT_GATE.RUN;
+
+  const dockPlayer = state.stationServices && state.stationServices.player;
+  if (dockPlayer && dockPlayer.stationId) mask |= CONTENT_GATE.DOCK;
+
+  const fleet = state.automation && state.automation.fleet;
+  if (fleet && fleet.length > 0) mask |= CONTENT_GATE.WING;
+
+  const capital = state.capitalBossEncounters;
+  if (capital && (hasOwnEnumKey(capital.fights) || hasOwnEnumKey(capital.orders))) {
+    mask |= CONTENT_GATE.CAPITAL;
+  }
+
+  const player = state.player;
+  if (player) {
+    if (player.tether && player.tether.active) mask |= CONTENT_GATE.MASSLINE;
+    const tel = player.masslineTelemetry;
+    if (tel && tel.active) mask |= CONTENT_GATE.MASSLINE;
+    const threats = player.masslineThreats;
+    if (threats && threats.active) mask |= CONTENT_GATE.MASSLINE;
+    const remote = player.remoteMassline;
+    if (remote && remote.active) mask |= CONTENT_GATE.MASSLINE;
+    const throwRt = player.masslineThrow;
+    if (throwRt && throwRt.active) mask |= CONTENT_GATE.MASSLINE;
+    if (player.heat) {
+      mask |= CONTENT_GATE.HEAT;
+      mask |= CONTENT_GATE.LAW;
+    }
+  }
+  if (state.lawSecurity && state.lawSecurity.wanted) mask |= CONTENT_GATE.LAW;
+
+  const m2 = state.massline2;
+  const cloak = m2 && m2.cloak;
+  if (cloak && (cloak.active || (cloak.energy != null && cloak.energy < 1))) {
+    mask |= CONTENT_GATE.CLOAK;
+  }
+  const acts = state.input && state.input.actions;
+  if (acts && acts.cloakToggle) mask |= CONTENT_GATE.CLOAK;
+
+  const sectorId = state.world && state.world.currentSectorId;
+  if (sectorId && MACHINERY_SECTOR_IDS.has(sectorId)) mask |= CONTENT_GATE.MACHINERY;
+  if (sectorId === PLANET_SECTOR_ID) mask |= CONTENT_GATE.PLANET;
+  if (state.planet && state.planet.active) mask |= CONTENT_GATE.PLANET;
+
+  return mask;
+}
+
+export function isContentGatedIdle(systemName, wakeMask) {
+  const gate = getContentGate(systemName);
+  if (!gate) return false;
+  return (wakeMask & gate) === 0;
+}
+
 export function shouldSkipSystemThisStep(systemName, state) {
   const clock = getSystemClock(systemName);
   if (isCatchupPresentationSkip(state) && clock !== SYSTEM_CLOCK.TABLE) return true;
   if (clock === SYSTEM_CLOCK.CALENDAR && isProductionClockState(state) && !isCalendarTick(state)) {
     return true;
   }
+  if (isProductionClockState(state) && getContentGate(systemName)) {
+    const wake = contentWakeMask(state);
+    if (isContentGatedIdle(systemName, wake)) return true;
+  }
   return false;
 }
 
@@ -50,6 +139,8 @@ export function shouldSkipSystemThisStep(systemName, state) {
  * Partition an update list once at host init. Production primary ticks iterate `combat`
  * (table + near + glass) so calendar names are not even visited. Calendar ticks and
  * non-production profiles keep `all`. Catch-up extra steps keep `table`.
+ * Content-gated names stay inside `combat` (order preserved); `updateQueueForThisStep`
+ * filters them into a reused scratch queue while idle.
  */
 export function partitionUpdateSystems(systems) {
   const all = [];
@@ -66,14 +157,42 @@ export function partitionUpdateSystems(systems) {
     if (clock === SYSTEM_CLOCK.CALENDAR) calendar.push(system);
     else combat.push(system);
   }
-  return { all, table, combat, calendar };
+  return {
+    all,
+    table,
+    combat,
+    calendar,
+    _quiet: [],
+    _wake: -1,
+  };
+}
+
+function fillContentFilteredQueue(source, state, partitions) {
+  const wake = contentWakeMask(state);
+  if (wake === partitions._wake && partitions._quiet.length >= 0 && partitions._source === source) {
+    return partitions._quiet;
+  }
+  const q = partitions._quiet;
+  q.length = 0;
+  for (let i = 0; i < source.length; i++) {
+    const system = source[i];
+    if (isContentGatedIdle(system.name, wake)) continue;
+    q.push(system);
+  }
+  partitions._wake = wake;
+  partitions._source = source;
+  return q;
 }
 
 export function updateQueueForThisStep(partitions, state) {
   if (!partitions) return [];
   if (isCatchupPresentationSkip(state)) return partitions.table;
-  if (isProductionClockState(state) && !isCalendarTick(state)) return partitions.combat;
-  return partitions.all;
+  if (!isProductionClockState(state)) return partitions.all;
+  if (isCalendarTick(state)) {
+    // Calendar tick: full `all` order, still omit idle content-gated owners.
+    return fillContentFilteredQueue(partitions.all, state, partitions);
+  }
+  return fillContentFilteredQueue(partitions.combat, state, partitions);
 }
 
 export function shouldRunSystemThisStep(systemName, state) {
