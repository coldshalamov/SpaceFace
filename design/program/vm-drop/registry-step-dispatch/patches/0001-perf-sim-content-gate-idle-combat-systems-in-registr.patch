   // Observer receipts; primary ticks already throttle internally. Catch-up extra steps
   // must not rescan the island just to notice a flee flag.
   'combatOutcome',
@@ -199,6 +203,54 @@ const CLOCK_BY_ID = new Map();
 for (const id of CALENDAR_CLOCK_IDS) CLOCK_BY_ID.set(id, SYSTEM_CLOCK.CALENDAR);
 for (const id of NEAR_CLOCK_IDS) CLOCK_BY_ID.set(id, SYSTEM_CLOCK.NEAR);
 
+
+/**
+ * Content-gated combat-island owners. They stay TABLE/NEAR/GLASS for catch-up policy, but the
+ * production primary queue omits them while their wake predicate is false. Order is preserved by
+ * filtering the prebuilt combat list into a reused scratch array (see catchupPolicy).
+ *
+ * Wake predicates must be cheap state reads only — never allocate, never walk entities.
+ */
+export const CONTENT_GATE = Object.freeze({
+  RUN: 1 << 0,
+  DOCK: 1 << 1,
+  WING: 1 << 2,
+  CAPITAL: 1 << 3,
+  MASSLINE: 1 << 4,
+  HEAT: 1 << 5,
+  CLOAK: 1 << 6,
+  MACHINERY: 1 << 7,
+  PLANET: 1 << 8,
+  LAW: 1 << 9,
+});
+
+export const CONTENT_GATED_IDS = Object.freeze({
+  survivalArena: CONTENT_GATE.RUN,
+  swarmArena: CONTENT_GATE.RUN,
+  survivalWave: CONTENT_GATE.RUN,
+  survivalRun: CONTENT_GATE.RUN,
+  swarmChain: CONTENT_GATE.RUN,
+  stationServices: CONTENT_GATE.DOCK,
+  wingmen: CONTENT_GATE.WING,
+  capitalBossEncounters: CONTENT_GATE.CAPITAL,
+  masslineTelemetry: CONTENT_GATE.MASSLINE,
+  masslineThreats: CONTENT_GATE.MASSLINE,
+  masslineImpacts: CONTENT_GATE.MASSLINE,
+  masslineSnares: CONTENT_GATE.MASSLINE,
+  masslineThrow: CONTENT_GATE.MASSLINE,
+  heat: CONTENT_GATE.HEAT,
+  cloak: CONTENT_GATE.CLOAK,
+  environmentalMachinery: CONTENT_GATE.MACHINERY,
+  planetRuntime: CONTENT_GATE.PLANET,
+  pirateDisguise: CONTENT_GATE.LAW,
+  pirateParley: CONTENT_GATE.LAW,
+  pirateDisengage: CONTENT_GATE.LAW,
+});
+
+export function getContentGate(id) {
+  return CONTENT_GATED_IDS[id] || 0;
+}
+
 export function getSystemClock(id) {
   // Hosts partition instantiated systems by name, after resolving manifest slots. Both AI
   // backends must retain aiSlot's near clock or every extra catch-up step repeats full AI.
