          const frameBudgetMs = fixedDt * 1000;
          perf.beginFrame(
            frameDt,
            callbackStart,
            now,
            frameBudgetMs,
          );
    
          if (shouldSkipFullTickSystems(state) && !(Number(state.timeScale) > 0)
            && typeof registry.keepalive === 'function') {
            registry.keepalive(0, frameDt);
