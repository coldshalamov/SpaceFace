    function parseCsvLine(line) {
      const out = [];
      let current = '';
      let quoted = false;
      for (let i = 0; i < line.length; i++) {
        const ch = line[i];
        if (ch === '"') {
          if (quoted && line[i + 1] === '"') {
            current += '"';
            i++;
          } else {
            quoted = !quoted;
          }
        } else if (ch === ',' && !quoted) {
          out.push(current);
          current = '';
