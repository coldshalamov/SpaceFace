              return { status, program: first === undefined ? null : first };
            };
            let touched = 0;
            let notReady = 0;
            let noProgram = 0;
            let switched = 0;
            let touchMs = 0;
            let maxTouchMs = 0;
            const yieldTouch = typeof options.yieldToMain === 'function' ? options.yieldToMain : null;
