    function parseArgs(args) {
      const out = { _: [] };
      for (let i = 0; i < args.length; i++) {
        const arg = args[i];
        if (!arg.startsWith('--')) {
          out._.push(arg);
          continue;
        }
        const key = arg.slice(2);
        const eq = key.indexOf('=');
        if (eq !== -1) {
          out[key.slice(0, eq)] = key.slice(eq + 1);
          continue;
