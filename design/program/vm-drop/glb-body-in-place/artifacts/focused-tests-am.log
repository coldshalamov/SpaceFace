              let first;
              for (const material of materials) {
                if (!material) continue;
                let program = null;
                try { program = renderer.properties.get(material).currentProgram || null; } catch { program = null; }
                if (first === undefined) first = program;
                if (!program) {
                  status = 'none';
                  continue;
                }
