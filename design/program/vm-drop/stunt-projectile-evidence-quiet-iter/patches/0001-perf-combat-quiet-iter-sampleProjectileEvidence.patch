diff --git a/src/combat/stuntProjectileEvidence.js b/src/combat/stuntProjectileEvidence.js
index 586e8ecad..6207aa51f 100644
--- a/src/combat/stuntProjectileEvidence.js
+++ b/src/combat/stuntProjectileEvidence.js
@@ -39,14 +39,42 @@ const startTick=linear?root.tick:torque.tick,first=history?.frames?.find(f=>f.ti
 const width=Math.max(0,2*(entity.radius??0)),displacement=linear?distance(root.pos,entity.pos):0,turn=angular?Math.min(torque.ownedDegrees,Math.abs(Math.atan2(Math.sin((entity.rot||0)-torque.rot),Math.cos((entity.rot||0)-torque.rot)))*180/Math.PI):0;
 if(!(width>0&&(displacement>=width||turn>=20)))return null;
 return {solutionTick:startTick,surfaceDisplacement:displacement,surfaceTurn:turn,surfaceWidth:width,surfaceLife:life.id,surfaceId:entity.id,rootId:root?.id??null,priorPos:point(first.pos),priorRot:first.rot};}
+// Quiet sampleProjectileEvidence: collidables lane + for-in (no Object.entries
+// alloc) + surfaceHistory cadence when shots/contacts empty. Bench can disable.
+let _quietIterEnabled = true;
+export function setProjectileEvidenceQuietIterForBench(enabled) {
+  _quietIterEnabled = enabled !== false;
+}
+function bagEmpty(bag) {
+  if (!bag) return true;
+  for (const _ in bag) return false;
+  return true;
+}
+function contactPendingFor(contacts, lifeId, tick) {
+  for (const id in contacts) {
+    const c = contacts[id];
+    if (c && c.projectileLife === lifeId && !c.emitted && tick - c.tick <= 180) return true;
+  }
+  return false;
+}
 export function sampleProjectileEvidence(state,bus){const record=own(state);if(!record||state.mode!=='flight'||record.lastTick===state.tick)return;record.lastTick=state.tick;
 const player=state.entities.get(state.playerId);if(player?.alive&&valid(player.pos)&&valid(player.vel)){const life=bodyLife(player,state);record.playerHistory.push({tick:state.tick,lifeId:life.id,pos:point(player.pos),velocity:point(player.vel)});if(record.playerHistory.length>121)record.playerHistory.shift();
-let count=0;const px=player.pos.x,pz=player.pos.z;for(const entity of state.entities.values()){if(count>=8)break;if(!entity.alive||!entity.collides||!valid(entity.pos))continue;const dx=entity.pos.x-px,dz=entity.pos.z-pz;if(dx*dx+dz*dz>360000)continue;if(!materialSurface(entity))continue;const life=bodyLife(entity,state);const row=record.surfaceHistory[life.id]||={id:entity.id,lifeId:life.id,frames:[]};row.frames.push({tick:state.tick,pos:point(entity.pos),rot:entity.rot||0});if(row.frames.length>121)row.frames.shift();count++;}}
-for(const [id,row] of Object.entries(record.surfaceHistory))if(state.tick-(row.frames.at(-1)?.tick??-Infinity)>120)delete record.surfaceHistory[id];
-for(const [id,torque] of Object.entries(record.surfaceTorques||{})){const entity=state.entities.get(torque.id);if(!entity||bodyLife(entity,state)?.id!==id||state.tick-torque.tick>120){delete record.surfaceTorques[id];continue;}const turn=Math.atan2(Math.sin((entity.rot||0)-torque.lastRot),Math.cos((entity.rot||0)-torque.lastRot)),spin=entity.angVel||0;
-if(turn*torque.delta>0)torque.ownedDegrees+=Math.abs(turn)*180/Math.PI*Math.min(1,Math.abs(torque.delta)/Math.max(Math.abs(torque.after),Math.abs(spin),1e-6));torque.lastRot=entity.rot||0;}
-for(const [lifeId,shot] of Object.entries(record.shots)){const body=state.entities.get(shot.id),pending=Object.values(record.contacts).some(c=>c.projectileLife===lifeId&&!c.emitted&&state.tick-c.tick<=180);if(state.tick-shot.tick>480||(!body&&!pending)||(body&&bodyLife(body,state)?.id!==lifeId)){delete record.shots[lifeId];continue;}if(body?.alive&&state.tick>(shot.velocitySyncTick??-1)&&valid(body.vel)&&!same(body.vel,shot.expectedVelocity))shot.invalid=true;}
-for(const [id,contact] of Object.entries(record.contacts)){if(state.tick-contact.tick>180){delete record.contacts[id];continue;}if(contact.emitted||!contact.damage)continue;const target=state.entities.get(contact.targetId);if(!target||bodyLife(target,state)?.id!==contact.targetLife)continue;const tumble=readTumbleStatus(state,target);const active=tumble?.data&&tumble.applyTick>=contact.tick&&tumble.applyTick<=state.tick&&state.simTime<tumble.data.until;
+// Quiet cadence: with no live shots/contacts, surfaceHistory can wait one tick.
+// Emission snapshots history at fire time; the 120-tick solution window tolerates it.
+// Cadence only while surfaceHistory is still cold. Once a reflective plate is
+// tracked, keep warming its frames every tick (stunt solution windows need it).
+const quietNoAmmo=_quietIterEnabled&&bagEmpty(record.shots)&&bagEmpty(record.contacts)&&bagEmpty(record.surfaceHistory);
+const sampleSurfaces=!quietNoAmmo||((state.tick&1)===0);
+if(sampleSurfaces){let count=0;const px=player.pos.x,pz=player.pos.z;
+const index=state.entityIndex;
+const lane=_quietIterEnabled&&index&&index.__spacefaceEntityIndexV1&&Array.isArray(index.collidables)?index.collidables:null;
+if(lane){for(let i=0;i<lane.length;i++){if(count>=8)break;const entity=lane[i];if(!entity||!entity.alive||!entity.collides||!valid(entity.pos))continue;const dx=entity.pos.x-px,dz=entity.pos.z-pz;if(dx*dx+dz*dz>360000)continue;if(!materialSurface(entity))continue;const life=bodyLife(entity,state);const row=record.surfaceHistory[life.id]||={id:entity.id,lifeId:life.id,frames:[]};row.frames.push({tick:state.tick,pos:point(entity.pos),rot:entity.rot||0});if(row.frames.length>121)row.frames.shift();count++;}}
+else{for(const entity of state.entities.values()){if(count>=8)break;if(!entity.alive||!entity.collides||!valid(entity.pos))continue;const dx=entity.pos.x-px,dz=entity.pos.z-pz;if(dx*dx+dz*dz>360000)continue;if(!materialSurface(entity))continue;const life=bodyLife(entity,state);const row=record.surfaceHistory[life.id]||={id:entity.id,lifeId:life.id,frames:[]};row.frames.push({tick:state.tick,pos:point(entity.pos),rot:entity.rot||0});if(row.frames.length>121)row.frames.shift();count++;}}}}
+for(const id in record.surfaceHistory){const row=record.surfaceHistory[id];if(state.tick-(row.frames.at(-1)?.tick??-Infinity)>120)delete record.surfaceHistory[id];}
+const torques=record.surfaceTorques;if(torques){for(const id in torques){const torque=torques[id];const entity=state.entities.get(torque.id);if(!entity||bodyLife(entity,state)?.id!==id||state.tick-torque.tick>120){delete torques[id];continue;}const turn=Math.atan2(Math.sin((entity.rot||0)-torque.lastRot),Math.cos((entity.rot||0)-torque.lastRot)),spin=entity.angVel||0;
+if(turn*torque.delta>0)torque.ownedDegrees+=Math.abs(turn)*180/Math.PI*Math.min(1,Math.abs(torque.delta)/Math.max(Math.abs(torque.after),Math.abs(spin),1e-6));torque.lastRot=entity.rot||0;}}
+for(const lifeId in record.shots){const shot=record.shots[lifeId];const body=state.entities.get(shot.id),pending=contactPendingFor(record.contacts,lifeId,state.tick);if(state.tick-shot.tick>480||(!body&&!pending)||(body&&bodyLife(body,state)?.id!==lifeId)){delete record.shots[lifeId];continue;}if(body?.alive&&state.tick>(shot.velocitySyncTick??-1)&&valid(body.vel)&&!same(body.vel,shot.expectedVelocity))shot.invalid=true;}
+for(const id in record.contacts){const contact=record.contacts[id];if(state.tick-contact.tick>180){delete record.contacts[id];continue;}if(contact.emitted||!contact.damage)continue;const target=state.entities.get(contact.targetId);if(!target||bodyLife(target,state)?.id!==contact.targetLife)continue;const tumble=readTumbleStatus(state,target);const active=tumble?.data&&tumble.applyTick>=contact.tick&&tumble.applyTick<=state.tick&&state.simTime<tumble.data.until;
 if(active){contact.helmTicks=contact.lastHelmTick===state.tick-1?(contact.helmTicks||0)+1:1;contact.lastHelmTick=state.tick;}else if(!contact.death)contact.helmTicks=0;
 if(contact.helmTicks>=60)publishConsequence(state,contact,bus);}}
 /** Called only after a real weapon spawned this exact body. No root is allocated for ordinary fire. */
diff --git a/test/stunt-projectile-evidence-quiet-iter.test.mjs b/test/stunt-projectile-evidence-quiet-iter.test.mjs
new file mode 100644
index 000000000..0403f22ca
--- /dev/null
+++ b/test/stunt-projectile-evidence-quiet-iter.test.mjs
@@ -0,0 +1,106 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { bindStuntEvidence, bodyLife, journalFor } from '../src/combat/stuntEvidence.js';
+import {
+  sampleProjectileEvidence,
+  setProjectileEvidenceQuietIterForBench,
+} from '../src/combat/stuntProjectileEvidence.js';
+
+function harness({ withIndex = true } = {}) {
+  const entities = new Map();
+  const entityList = [];
+  const collidables = [];
+  const add = (e) => {
+    entities.set(e.id, e);
+    entityList.push(e);
+    if (e.collides) collidables.push(e);
+    return e;
+  };
+  const player = add({
+    id: 1, type: 'ship', alive: true, collides: true, rot: 0,
+    pos: { x: 0, z: 0 }, vel: { x: 10, z: 0 },
+    surfaceMaterial: 'ship', data: {}, name: 'player',
+    mass: 10, radius: 8, hull: 100, hullMax: 100,
+  });
+  add({
+    id: 2, type: 'structure', alive: true, collides: true, rot: 0.1,
+    pos: { x: 100, z: 0 }, vel: { x: 0, z: 0 },
+    surfaceMaterial: 'plate', data: { surfaceMaterial: 'plate' },
+    name: 'near-plate', mass: 50, radius: 20, hull: 200, hullMax: 200,
+  });
+  // Non-colliding reflective decoy — must NOT be tracked (same collides gate as before).
+  add({
+    id: 3, type: 'prop', alive: true, collides: false, rot: 0,
+    pos: { x: 50, z: 0 }, vel: { x: 0, z: 0 },
+    surfaceMaterial: 'mirror', data: { surfaceMaterial: 'mirror' },
+    name: 'ghost-mirror', mass: 1, radius: 5, hull: 1, hullMax: 1,
+  });
+  for (let i = 10; i < 120; i++) {
+    add({
+      id: i, type: 'asteroid', alive: true, collides: true, rot: 0,
+      pos: { x: 800 + (i % 40) * 20, z: 800 + (i % 30) * 20 },
+      vel: { x: 0, z: 0 }, surfaceMaterial: 'rock', data: {},
+      name: `rock-${i}`, mass: 5, radius: 8, hull: 40, hullMax: 40,
+    });
+  }
+  const state = {
+    tick: 500, mode: 'flight', playerId: 1, entities, entityList,
+  };
+  if (withIndex) {
+    state.entityIndex = {
+      __spacefaceEntityIndexV1: true,
+      ready: true,
+      collidables,
+      projectiles: [],
+    };
+  }
+  bindStuntEvidence(state);
+  bodyLife(player, state);
+  return state;
+}
+
+test('quiet-iter collidables lane still records near reflective surfaces', () => {
+  setProjectileEvidenceQuietIterForBench(true);
+  const state = harness({ withIndex: true });
+  sampleProjectileEvidence(state, null);
+  const hist = journalFor(state).projectiles.surfaceHistory;
+  const ids = Object.values(hist).map((row) => row.id).sort((a, b) => a - b);
+  assert.deepEqual(ids, [2]);
+});
+
+test('quiet-iter falls back to entities.values without index', () => {
+  setProjectileEvidenceQuietIterForBench(true);
+  const state = harness({ withIndex: false });
+  sampleProjectileEvidence(state, null);
+  const hist = journalFor(state).projectiles.surfaceHistory;
+  const ids = Object.values(hist).map((row) => row.id).sort((a, b) => a - b);
+  assert.deepEqual(ids, [2]);
+});
+
+test('quiet-iter keeps warming frames once surfaceHistory is hot', () => {
+  setProjectileEvidenceQuietIterForBench(true);
+  const state = harness({ withIndex: true });
+  sampleProjectileEvidence(state, null);
+  state.tick = 501;
+  sampleProjectileEvidence(state, null);
+  state.tick = 502;
+  sampleProjectileEvidence(state, null);
+  const plateLife = bodyLife(state.entities.get(2), state);
+  assert.equal(
+    journalFor(state).projectiles.surfaceHistory[plateLife.id].frames.length,
+    3,
+  );
+});
+
+test('bench toggle off still records near plate', () => {
+  setProjectileEvidenceQuietIterForBench(false);
+  try {
+    const state = harness({ withIndex: true });
+    sampleProjectileEvidence(state, null);
+    const ids = Object.values(journalFor(state).projectiles.surfaceHistory)
+      .map((row) => row.id);
+    assert.deepEqual(ids, [2]);
+  } finally {
+    setProjectileEvidenceQuietIterForBench(true);
+  }
+});
