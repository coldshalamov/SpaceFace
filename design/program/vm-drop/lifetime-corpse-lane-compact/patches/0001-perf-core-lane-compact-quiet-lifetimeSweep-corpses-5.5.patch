From c8302a27923c42a44ffb4b1fc422a9db9a720ad2 Mon Sep 17 00:00:00 2001
From: coldshalamov <93robingattis@gmail.com>
Date: Thu, 24 Sep 2026 06:22:58 -0400
Subject: [PATCH] =?UTF-8?q?perf(core):=20lane-compact=20quiet=20lifetimeSw?=
 =?UTF-8?q?eep=20corpses=20(~5.5=C3=97)?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Quiet ticks skip the fat asteroid/station entityList reverse walk.
Death-capable typed lanes (movables, damageables, ordnance) still GC
bare alive=false writers; MEMBERSHIP dirty (removeEntity, mining rock
destroy, field emitter expiry, TTL) fails open to the full walk.
Soft-GPU fps not claimed.
---
 src/core/coreSystem.js | 58 +++++++++++++++++++++++++++++++++++++-----
 src/systems/fields.js  | 12 +++++++--
 src/systems/mining.js  |  1 +
 3 files changed, 63 insertions(+), 8 deletions(-)

diff --git a/src/core/coreSystem.js b/src/core/coreSystem.js
index b94d15fdb..6427a0702 100644
--- a/src/core/coreSystem.js
+++ b/src/core/coreSystem.js
@@ -6,7 +6,7 @@ import { mulberry32, hash32, wrapAngle } from './rng.js';
 import { hasActiveSpatialHash } from './spatialQuery.js';
 import { initializePresentationAdmission } from './presentationAdmission.js';
 import { packCombatTable } from './combatTable.js';
-import { beginDirtyTick, markDirty, collectDirtyIds, DIRTY } from './dirtyJournal.js';
+import { beginDirtyTick, markDirty, collectDirtyIds, hasDirty, DIRTY } from './dirtyJournal.js';
 import { stampNearWorkBudget, refreshNearWorkAlwaysAwake } from './activityScheduler.js';
 
 const DAY_SECONDS = 600; // 10 sim-minutes per in-game "day" (faction decay/conflict cadence)
@@ -72,6 +72,7 @@ export const core = {
       const e = state.entities.get(id);
       if (!e) return false;
       e.alive = false;
+      markDirty(state, e.id, DIRTY.MEMBERSHIP);
       if (opts && opts.immediate === true) {
         const hintedIndex = Number.isInteger(opts.index) ? opts.index : -1;
         const index = state.entityList[hintedIndex] === e
@@ -346,11 +347,11 @@ export const core = {
     if (tier1 && tier1.isEnabled()) {
       tier1.countEntityVisits(list.length, 'lifetime-sweep');
     }
-    for (let i = list.length - 1; i >= 0; i--) {
-      const e = list[i];
-      if (e && e.id === state.playerId) continue;
-      if (e && !e.alive) this._removeEntityAtIndex(i, state);
-    }
+    // Quiet corpse compact: bare alive=false writers (combat, projectiles, TTL) live on
+    // typed death lanes. Fat asteroid/station/statics only need a scan when MEMBERSHIP is
+    // dirty (removeEntity / mining destroy / TTL mark it). Fail-open to the full list when
+    // the index is not ready or membership churned this tick.
+    this._compactDeadEntities(state, list, index);
     if (state.entityIndex && state.entityIndex.__spacefaceEntityIndexV1) {
       markEntityIndexSourceSynced(state.entityIndex, list);
     }
@@ -359,6 +360,51 @@ export const core = {
     }
     this.bus.flush();
   },
+
+  /**
+   * Collect corpses. Quiet ticks skip the fat asteroid/station walk; membership-dirty or
+   * an unreadied index takes the full entityList reverse walk so beacon/asteroid/static
+   * deaths cannot leak.
+   */
+  _compactDeadEntities(state, list, index) {
+    const membershipDirty = hasDirty(state, DIRTY.MEMBERSHIP);
+    if (!(index && index.__spacefaceEntityIndexV1 && index.ready === true) || membershipDirty) {
+      for (let i = list.length - 1; i >= 0; i--) {
+        const e = list[i];
+        if (e && e.id === state.playerId) continue;
+        if (e && !e.alive) this._removeEntityAtIndex(i, state);
+      }
+      return;
+    }
+    // Movables cover ships/drones/projectiles/pickups/payloads/fx/bombs/massSeed.
+    // Damageables adds stations, mines, field emitters, and snare anchors without the
+    // asteroid fat list. Ordnance leftovers (charges/vectormines/snares/wrecks) stay explicit.
+    this._compactDeadLane(state, index.movables);
+    this._compactDeadLane(state, index.damageables);
+    this._compactDeadLane(state, index.vectorMines);
+    this._compactDeadLane(state, index.snares);
+    this._compactDeadLane(state, index.charges);
+    this._compactDeadLane(state, index.wrecks);
+  },
+
+  _compactDeadLane(state, lane) {
+    if (!lane || lane.length === 0) return;
+    const dead = this._deadLaneScratch || (this._deadLaneScratch = []);
+    dead.length = 0;
+    const playerId = state.playerId;
+    for (let i = 0; i < lane.length; i++) {
+      const e = lane[i];
+      if (e && !e.alive && e.id !== playerId) dead.push(e);
+    }
+    if (dead.length === 0) return;
+    const list = state.entityList;
+    for (let i = 0; i < dead.length; i++) {
+      const e = dead[i];
+      // Lane iteration is unordered vs entityList; locate by identity (corpses are rare).
+      const idx = list.indexOf(e);
+      if (idx >= 0) this._removeEntityAtIndex(idx, state);
+    }
+  },
 };
 
 function ensureEntityIndex(state) {
diff --git a/src/systems/fields.js b/src/systems/fields.js
index 7d72d2ff4..12d3d5fc8 100644
--- a/src/systems/fields.js
+++ b/src/systems/fields.js
@@ -38,6 +38,7 @@ import { publishHitstunImpulse, signedHitSide } from '../combat/impulseKernel.js
 import { PINNED_STATUS_ID, UNMOORED_STATUS_ID } from '../data/combatDefs.js';
 import { combatFlag } from '../data/featureFlags.js';
 import { queryCombatTableEntities, COMBAT_TABLE_FLAGS } from '../core/combatTable.js';
+import { markDirty, DIRTY } from '../core/dirtyJournal.js';
 import {
   ORBIT_NODE_TYPE,
   attachOrbitWorld,
@@ -1092,6 +1093,7 @@ export const fields = {
       }
       if (now >= rec.expireAt) {
         entity.alive = false;
+        markDirty(state, entity.id, DIRTY.MEMBERSHIP);
         this._retireDeployed(state, rt, rec, FIELD_END_REASONS.expired);
         continue;
       }
@@ -1104,7 +1106,10 @@ export const fields = {
     this._kernel.unregister(rec.fieldId);
     delete rt.deployed[rec.fieldId];
     const entity = state.entities && state.entities.get ? state.entities.get(rec.emitterId) : null;
-    if (entity && entity.alive !== false && reason !== FIELD_END_REASONS.expired) entity.alive = false;
+    if (entity && entity.alive !== false && reason !== FIELD_END_REASONS.expired) {
+      entity.alive = false;
+      markDirty(state, entity.id, DIRTY.MEMBERSHIP);
+    }
     // Cooldown starts when a deployed field actually leaves the field (not on a replacement).
     // Planted hostile fields must not write the player's well/repulsor cooldown.
     if (reason !== FIELD_END_REASONS.replaced && !rec.planted && rt.cooldowns[rec.kind] != null && FIELD_DEFS[rec.kind]) {
@@ -1130,7 +1135,10 @@ export const fields = {
     for (const id of Object.keys(rt.deployed)) {
       const rec = rt.deployed[id];
       const entity = state.entities && state.entities.get ? state.entities.get(rec.emitterId) : null;
-      if (entity && entity.alive !== false) entity.alive = false;
+      if (entity && entity.alive !== false) {
+        entity.alive = false;
+        markDirty(state, entity.id, DIRTY.MEMBERSHIP);
+      }
     }
     if (this._orbitWorld) resetOrbitWorld(this._orbitWorld);
     if (this._kernel) this._kernel.clear();
diff --git a/src/systems/mining.js b/src/systems/mining.js
index eba789c0e..0fff05356 100644
--- a/src/systems/mining.js
+++ b/src/systems/mining.js
@@ -789,6 +789,7 @@ export const mining = {
       this.bus.emit('asteroid:destroyed', { id: ast.id, typeId: d.typeId || (def && def.id), pos: { x: ast.pos.x, z: ast.pos.z } });
       d.respawnAt = state.simTime + ((def && def.respawnSec) || 90); // world reads this to repopulate
       ast.alive = false;
+      markDirty(state, ast.id, DIRTY.MEMBERSHIP);
       d.depletedAtT = Number.isFinite(state.simTime) ? state.simTime : (state.tick | 0);
     }
     persistTouchedResourceBody(state, ast);
