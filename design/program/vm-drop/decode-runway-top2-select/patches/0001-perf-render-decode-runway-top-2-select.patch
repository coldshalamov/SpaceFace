+/**
+ * Bench-only strategy toggle for decode-runway start selection.
+ * Production stays on `top2`. `sort` restores the legacy full-list
+ * slice+sort that recomputed entityTimeToGlassSeconds on every compare.
+ */
+let _decodeRunwaySelectStrategy = 'top2';
+
+export function setDecodeRunwaySelectStrategyForBench(strategy) {
+  _decodeRunwaySelectStrategy = strategy === 'sort' ? 'sort' : 'top2';
+  return _decodeRunwaySelectStrategy;
+}
+
+export function getDecodeRunwaySelectStrategyForBench() {
+  return _decodeRunwaySelectStrategy;
+}
+
+/**
+ * Pick up to `limit` ship/station decode-runway starts from a presentation list.
+ * Priority matches the historical kickDecode order: wave-planned hulls first,
+ * then earliest time-to-glass. `top2` (default) does one O(n) pass over eligible
+ * candidates; `sort` rebuilds the legacy full-list comparator (bench / oracle).
+ *
+ * Eligibility (same as kickDecodeRunwayAssets):
+ * - alive ship/station that still needs authored decode and is not already pending
+ * - wave-planned OR authored-upgrade-relevant OR time-to-glass within the decode runway
+ */
+export function selectDecodeRunwayPrefetchStarts(
+  list,
+  state,
+  env,
+  decodePad,
+  {
+    limit = 2,
+    needsDecode = null,
+    isPending = null,
+    strategy = null,
+    glassCalls = null,
+  } = {},
+) {
+  const mode = strategy || _decodeRunwaySelectStrategy;
+  const horizon = TABLE_DECODE_RUNWAY_SECONDS;
+  const pad = Number(decodePad) || 0;
+  const maxStarts = Math.max(0, limit | 0);
+  if (!Array.isArray(list) || maxStarts === 0 || !state || !env) return [];
+
+  const decodeSeconds = (entity) => {
+    if (glassCalls) glassCalls.count += 1;
+    return entityTimeToGlassSeconds(entity, env, state, horizon, pad);
+  };
+
+  const eligible = (entity) => {
+    if (!entity || entity.alive === false) return false;
+    if (entity.type !== 'ship' && entity.type !== 'station') return false;
+    if (typeof needsDecode === 'function' && !needsDecode(entity)) return false;
+    if (typeof isPending === 'function' && isPending(entity.id)) return false;
+    if (entityMatchesWaveHullRunway(entity, state)) return true;
+    if (isEntityAuthoredUpgradeRelevant(entity, state)) return true;
+    return decodeSeconds(entity) <= horizon;
+  };
+
+  if (mode === 'sort') {
+    // Legacy: sort the entire presentation list by (wave, time-to-glass), then
+    // walk until `limit` eligible starts are collected. Pays glass timing on
+    // every comparator call — including rocks/dressing that can never start.
+    const ordered = list.length > 1
+      ? list.slice().sort((a, b) => {
+        const aw = entityMatchesWaveHullRunway(a, state) ? 0 : 1;
+        const bw = entityMatchesWaveHullRunway(b, state) ? 0 : 1;
+        if (aw !== bw) return aw - bw;
+        return decodeSeconds(a) - decodeSeconds(b);
+      })
+      : list.slice();
+    const out = [];
+    for (let i = 0; i < ordered.length && out.length < maxStarts; i++) {
+      const entity = ordered[i];
+      if (!eligible(entity)) continue;
+      out.push(entity);
+    }
+    return out;
+  }
+
+  // Production: single pass, track the best `limit` eligible candidates.
+  // Wave rank 0 outranks rank 1; within a rank, lower time-to-glass wins.
+  // Glass timing runs at most once per eligible ship/station (plus the
+  // eligibility probe for non-wave / non-authored-relevant rows).
+  const best = []; // { entity, wave, t }
+  for (let i = 0; i < list.length; i++) {
+    const entity = list[i];
+    if (!entity || entity.alive === false) continue;
+    if (entity.type !== 'ship' && entity.type !== 'station') continue;
+    if (typeof needsDecode === 'function' && !needsDecode(entity)) continue;
+    if (typeof isPending === 'function' && isPending(entity.id)) continue;
+    const wave = entityMatchesWaveHullRunway(entity, state) ? 0 : 1;
+    // Wave-planned starts are always eligible; others need authored relevance or a
+    // decode-runway deadline. Compute time-to-glass once for ranking + eligibility.
+    const t = decodeSeconds(entity);
+    if (wave !== 0
+        && !isEntityAuthoredUpgradeRelevant(entity, state)
+        && !(t <= horizon)) continue;
+    // Insert into sorted best[] (ascending wave, then t). Length stays <= limit.
+    let placed = false;
+    for (let b = 0; b < best.length; b++) {
+      const cur = best[b];
+      if (wave < cur.wave || (wave === cur.wave && t < cur.t)) {
+        best.splice(b, 0, { entity, wave, t });
+        placed = true;
+        break;
+      }
+    }
+    if (!placed) best.push({ entity, wave, t });
+    if (best.length > maxStarts) best.length = maxStarts;
+  }
+  const out = [];
+  for (let i = 0; i < best.length; i++) out.push(best[i].entity);
+  return out;
+}
