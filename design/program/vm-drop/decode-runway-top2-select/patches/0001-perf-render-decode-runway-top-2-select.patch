+/**
+ * Portable microbench for decode-runway start selection.
+ * Builds a quiet presentation-shaped list (many rocks + a few inbound ships)
+ * and compares legacy full-list sort vs top-2 select.
+ */
+export function runDecodeRunwaySelectMicrobench(options = {}) {
+  const entityCount = Math.max(8, options.entityCount | 0 || 400);
+  const shipCount = Math.max(2, options.shipCount | 0 || 24);
+  const iterations = Math.max(1, options.iterations | 0 || 200);
+  const strategy = options.strategy === 'sort' ? 'sort' : 'top2';
+  const state = {
+    mode: 'flight',
+    simTime: 30,
+    tick: 1800,
+    playerId: 1,
+    camera: { zoom: 144, liveZoom: 144, fov: 50, tilt: 60, aspect: 16 / 9, focus: { x: 0, z: 0 } },
+    settings: { video: { fov: 50 } },
+    world: { frameOrigin: { x: 0, z: 0 }, currentSectorId: 'sector_ceres_belt' },
+    render: {},
+  };
+  const player = {
+    id: 1, type: 'ship', alive: true, isPlayer: true,
+    pos: { x: 0, z: 0 }, vel: { x: 40, z: 0 }, radius: 8, maxSpeed: 220,
+  };
+  const entities = new Map([[player.id, player]]);
+  state.entities = entities;
+  // Presentation-shaped crowd: mostly static rocks, plus inbound/outbound ships.
+  const list = [];
+  for (let i = 0; i < entityCount; i++) {
+    const isShip = i < shipCount;
+    const ang = (i * 2.399963) % (Math.PI * 2);
+    const dist = isShip ? (180 + (i % 7) * 90) : (400 + (i % 97) * 35);
+    const inbound = isShip && (i % 3) !== 0;
+    const entity = {
+      id: 1000 + i,
+      type: isShip ? 'ship' : 'asteroid',
+      alive: true,
+      pos: { x: Math.cos(ang) * dist, z: Math.sin(ang) * dist },
+      vel: isShip
+        ? { x: inbound ? -Math.cos(ang) * 160 : Math.cos(ang) * 40, z: inbound ? -Math.sin(ang) * 160 : Math.sin(ang) * 40 }
+        : { x: 0, z: 0 },
+      radius: isShip ? 10 : 18,
+      data: isShip ? { trafficRole: 'hauler' } : { rock: true },
+    };
+    list.push(entity);
+    entities.set(entity.id, entity);
+  }
+
+  const env = renderAdmissionEnv(state);
+  const decodePad = approachDistanceWu(TABLE_SUBMIT_APPROACH_SECONDS, tableTravelSpeed(state));
+  const glassCalls = { count: 0 };
+  const needsDecode = () => true;
+  const isPending = () => false;
+
+  // Warm
+  selectDecodeRunwayPrefetchStarts(list, state, env, decodePad, {
+    limit: 2, needsDecode, isPending, strategy, glassCalls: { count: 0 },
+  });
+
+  glassCalls.count = 0;
+  const t0 = performance.now();
+  let selected = 0;
+  for (let n = 0; n < iterations; n++) {
+    const picks = selectDecodeRunwayPrefetchStarts(list, state, env, decodePad, {
+      limit: 2, needsDecode, isPending, strategy, glassCalls,
+    });
+    selected += picks.length;
+  }
+  const ms = performance.now() - t0;
+  return {
+    strategy,
+    entityCount,
+    shipCount,
+    iterations,
+    ms,
+    glassCalls: glassCalls.count,
+    selected,
+    avgGlassCallsPerIter: glassCalls.count / iterations,
+  };
+}
