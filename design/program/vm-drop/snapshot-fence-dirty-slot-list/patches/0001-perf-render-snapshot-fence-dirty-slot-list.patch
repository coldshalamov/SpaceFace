--- a/src/render/snapshotFence.js
+++ b/src/render/snapshotFence.js
@@ -6,6 +6,17 @@ import { PRESENTATION_DIRTY } from './presentationWorld.js';
 
 export const SNAPSHOT_FENCE_BUFFERS = 3;
 
+// Dirty>0 pack: walk world.dirtySlots (dense) instead of every activeSlots mask.
+// Bench-only toggle restores the O(active) mask scan for A/B microbench.
+let SNAPSHOT_FENCE_DIRTY_SLOT_LIST = true;
+export function setSnapshotFenceDirtySlotListForBench(enabled) {
+  SNAPSHOT_FENCE_DIRTY_SLOT_LIST = enabled !== false;
+  return SNAPSHOT_FENCE_DIRTY_SLOT_LIST;
+}
+export function getSnapshotFenceDirtySlotListForBench() {
+  return SNAPSHOT_FENCE_DIRTY_SLOT_LIST !== false;
+}
+
 function readonlyColumns(columns) {
   // Ownership is the immutability boundary: only the writer slot can call
   // write(), and commit rotates to another slot before the next pack. Do not
@@ -364,26 +375,61 @@ export function packPresentationWorldToFence(world, fence, simTime = 0, poseEpoc
 
     const snapshot = fence.beginIncrementalPack(active, simTime, poseEpoch, layoutVersion);
     if (snapshot && (snapshot.count | 0) === active) {
-      // activeSlots is dense (removeActive swaps compact). Row index == activeSlots index.
-      for (let index = 0; index < active; index++) {
-        const slot = world.activeSlots[index];
-        if (world.alive[slot] !== 1) {
-          // Invariant break — reset write slot via full pack below.
-          return packPresentationWorldToFenceFull(world, fence, active, simTime, poseEpoch, layoutVersion);
+      const dirtyN = world.dirtyCount | 0;
+      const useDirtyList = SNAPSHOT_FENCE_DIRTY_SLOT_LIST
+        && dirtyN > 0
+        && world.dirtySlots
+        && (world.dirtySlots.length | 0) >= dirtyN
+        && world.activePositions;
+      if (useDirtyList) {
+        // Dense dirtySlots (length == dirtyCount). Row index via activePositions.
+        const dirtySlots = world.dirtySlots;
+        const activePositions = world.activePositions;
+        for (let d = 0; d < dirtyN; d++) {
+          const slot = dirtySlots[d];
+          if (world.alive[slot] !== 1) {
+            return packPresentationWorldToFenceFull(world, fence, active, simTime, poseEpoch, layoutVersion);
+          }
+          const index = activePositions[slot];
+          if (index < 0 || index >= active) {
+            return packPresentationWorldToFenceFull(world, fence, active, simTime, poseEpoch, layoutVersion);
+          }
+          if ((dirtyMasks[slot] & PRESENTATION_DIRTY.ALL) === 0) continue;
+          const { qy, qw } = yawQuatForSlot(world, slot);
