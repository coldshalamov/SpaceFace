+            world.y[slot],
+            world.z[slot],
+            qy,
+            qw,
+            world.flags[slot] >>> 0,
+            world.bank ? Number(world.bank[slot]) || 0 : 0,
+            world.pitch ? Number(world.pitch[slot]) || 0 : 0,
