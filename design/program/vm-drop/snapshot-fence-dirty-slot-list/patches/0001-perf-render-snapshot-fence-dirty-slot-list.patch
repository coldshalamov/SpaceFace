diff --git a/test/snapshot-fence-dirty-slot-list.test.mjs b/test/snapshot-fence-dirty-slot-list.test.mjs
new file mode 100644
index 000000000..ec60f1724
--- /dev/null
+++ b/test/snapshot-fence-dirty-slot-list.test.mjs
@@ -0,0 +1,132 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createPresentationWorld } from '../src/render/presentationWorld.js';
+import {
+  createSnapshotFence,
+  packPresentationWorldToFence,
+  snapshotIndexOf,
+  setSnapshotFenceDirtySlotListForBench,
+  getSnapshotFenceDirtySlotListForBench,
+} from '../src/render/snapshotFence.js';
+
+function seed(n) {
+  const world = createPresentationWorld({ capacity: n });
+  const entities = [];
+  for (let i = 0; i < n; i++) {
+    const entity = {
+      id: i + 1,
+      alive: true,
+      type: 'ship',
+      pos: { x: i * 10, y: 0, z: i },
+      rot: i * 0.01,
+      bank: 0,
+      pitch: 0,
+      radius: 4,
+    };
+    entities.push(entity);
+    world.allocateEntity(entity, 0);
+  }
+  return { world, entities };
+}
+
+function move(world, entity, dx) {
+  entity.pos.x += dx;
+  world.applyTransform({
+    entityId: entity.id,
+    generation: 0,
+    revision: (entity._rev = (entity._rev || 0) + 1),
+    x: entity.pos.x,
+    y: 0,
+    z: entity.pos.z,
+    rot: entity.rot,
+    bank: 0,
+    pitch: 0,
+  }, entity);
+}
+
+function clearDirty(world) {
+  const active = world.getDiagnostics().active;
+  for (let i = 0; i < active; i++) world.clearDirty(world.activeSlots[i]);
+}
+
+test('dirtySlots list tracks mark/clear cardinality', () => {
+  const { world, entities } = seed(16);
+  assert.equal(world.dirtyCount, 16); // allocate dirties all
+  clearDirty(world);
+  assert.equal(world.dirtyCount, 0);
+  move(world, entities[2], 1);
+  move(world, entities[5], 2);
+  assert.equal(world.dirtyCount, 2);
+  const seen = new Set();
+  for (let i = 0; i < world.dirtyCount; i++) seen.add(world.dirtySlots[i]);
+  assert.equal(seen.size, 2);
+  const slot2 = world.getSlotForEntityId(entities[2].id);
+  const slot5 = world.getSlotForEntityId(entities[5].id);
+  assert.ok(seen.has(slot2));
+  assert.ok(seen.has(slot5));
+  world.clearDirty(slot2);
+  assert.equal(world.dirtyCount, 1);
+  assert.equal(world.dirtySlots[0], slot5);
+});
+
+test('dirty-slot list pack matches forceFull and walk-all', () => {
+  const restore = getSnapshotFenceDirtySlotListForBench();
+  try {
+    const { world, entities } = seed(48);
+    const fenceList = createSnapshotFence({ capacity: 48 });
+    const fenceWalk = createSnapshotFence({ capacity: 48 });
+    const fenceFull = createSnapshotFence({ capacity: 48 });
+    // Prime each fence independently so incremental is eligible; pack does not clear dirty.
+    for (let i = 0; i < 3; i++) {
+      setSnapshotFenceDirtySlotListForBench(true);
+      packPresentationWorldToFence(world, fenceList, i, 1);
+      setSnapshotFenceDirtySlotListForBench(false);
+      packPresentationWorldToFence(world, fenceWalk, i, 1);
+      packPresentationWorldToFence(world, fenceFull, i, 1, { forceFull: true });
+      clearDirty(world);
+    }
+    move(world, entities[0], 5);
+    move(world, entities[7], -3);
+    move(world, entities[11], 1.5);
+    assert.equal(world.dirtyCount, 3);
+
+    // Same dirty world → three pack styles must agree (pack leaves dirty bits set).
+    setSnapshotFenceDirtySlotListForBench(true);
+    packPresentationWorldToFence(world, fenceList, 10, 1);
+    setSnapshotFenceDirtySlotListForBench(false);
+    packPresentationWorldToFence(world, fenceWalk, 10, 1);
+    packPresentationWorldToFence(world, fenceFull, 10, 1, { forceFull: true });
+    assert.equal(world.dirtyCount, 3);
+
+    const a = fenceList.latestSnapshot();
+    const b = fenceWalk.latestSnapshot();
+    const c = fenceFull.latestSnapshot();
+    assert.equal(a.count, b.count);
+    assert.equal(a.count, c.count);
+    for (let i = 0; i < a.count; i++) {
+      const id = a.columns.entityId[i];
+      assert.equal(id, b.columns.entityId[i]);
+      assert.equal(id, c.columns.entityId[i]);
+      const p = i * 3;
+      assert.ok(Math.abs(a.columns.position[p] - b.columns.position[p]) < 1e-5);
+      assert.ok(Math.abs(a.columns.position[p] - c.columns.position[p]) < 1e-5);
+      assert.ok(Math.abs(a.columns.position[p + 2] - c.columns.position[p + 2]) < 1e-5);
+    }
+    const p0 = snapshotIndexOf(a, entities[0].id) * 3;
+    assert.ok(Math.abs(a.columns.position[p0] - entities[0].pos.x) < 1e-5);
+  } finally {
+    setSnapshotFenceDirtySlotListForBench(restore);
+  }
+});
+
+test('retire removes slot from dirty list', () => {
+  const { world, entities } = seed(12);
+  clearDirty(world);
+  move(world, entities[3], 2);
+  move(world, entities[4], 2);
+  assert.equal(world.dirtyCount, 2);
+  world.retire(entities[3].id);
+  assert.equal(world.dirtyCount, 1);
+  const slot4 = world.getSlotForEntityId(entities[4].id);
+  assert.equal(world.dirtySlots[0], slot4);
+});
