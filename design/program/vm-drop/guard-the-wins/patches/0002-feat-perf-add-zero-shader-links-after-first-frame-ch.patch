+#!/usr/bin/env node
+// check:zero-shader-links-after-first-frame — backlog #70 guardrail.
+//
+// Fails when any shader program links after the first presented frame. Built on the
+// mid-flight compile detector in src/testing/perf/rendererInfoMonitor.js (same signal
+// perf:renderer-info already surfaces).
+//
+// Modes:
+//   default             short headed/headless flight via probe-renderer-info, then evaluate
+//   --anomalies-json=P  evaluate a saved anomalies/summary JSON (no browser)
+//   --duration-s=N      flight sample window for live mode (default 15)
+//   --json              print the evaluation record
+
+import { spawn } from 'node:child_process';
+import { readFile, mkdir, writeFile } from 'node:fs/promises';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+import {
+  evaluateZeroShaderLinksAfterFirstFrame,
+  rendererInfoSummaryToShaderGuardInput,
+  MID_FLIGHT_SHADER_ANOMALY,
+} from './lib/guardTheWins.mjs';
+
+const ROOT = fileURLToPath(new URL('../', import.meta.url));
+const OUT_DIR = path.join(ROOT, '.devshots', 'guard-the-wins');
+
+function argValue(name) {
+  const hit = process.argv.find((a) => a.startsWith(`${name}=`));
+  return hit ? hit.slice(name.length + 1) : null;
+}
+
+const ANOMALIES_JSON = argValue('--anomalies-json');
+const DURATION_S = Number(argValue('--duration-s') || 15);
+const WANT_JSON = process.argv.includes('--json');
+const HELP = process.argv.includes('--help') || process.argv.includes('-h');
+
+if (HELP) {
+  console.log(`Usage:
+  node scripts/check-zero-shader-links-after-first-frame.mjs [--duration-s=15]
+  node scripts/check-zero-shader-links-after-first-frame.mjs --anomalies-json=path.json
+
+Fails (exit 1) when any ${MID_FLIGHT_SHADER_ANOMALY} anomaly is present — i.e. a shader
+linked after the first presented frame.`);
+  process.exit(0);
+}
+
+async function evaluateFromPayload(payload) {
+  const anomalies = payload.anomalies || payload.summary?.anomalies || [];
+  const summary = payload.summary || payload;
+  const input = rendererInfoSummaryToShaderGuardInput(summary, anomalies);
+  if (Number.isFinite(payload.shaderLinksAfterFirstPresentedFrame)) {
+    input.shaderLinksAfterFirstPresentedFrame = payload.shaderLinksAfterFirstPresentedFrame;
+  }
+  if (payload.firstPresentedFrameIndex != null) {
+    input.firstPresentedFrameIndex = payload.firstPresentedFrameIndex;
+  }
+  return evaluateZeroShaderLinksAfterFirstFrame(input);
+}
+
+async function runLiveProbe() {
+  await mkdir(OUT_DIR, { recursive: true });
+  const probePath = path.join(ROOT, 'scripts', 'probe-renderer-info.mjs');
+  const child = spawn(process.execPath, [probePath, `--duration=${DURATION_S}`], {
+    cwd: ROOT,
+    stdio: ['ignore', 'pipe', 'pipe'],
+    env: { ...process.env, SPACEFACE_RENDERER_INFO_EXIT_ON_SHADER: '1' },
+  });
+  let stdout = '';
+  let stderr = '';
+  child.stdout.on('data', (chunk) => { stdout += chunk; process.stdout.write(chunk); });
+  child.stderr.on('data', (chunk) => { stderr += chunk; process.stderr.write(chunk); });
+  const code = await new Promise((resolve) => child.on('close', resolve));
+
+  const telemetryPath = path.join(ROOT, '.devshots', 'renderer-info', 'telemetry.json');
+  let payload = null;
+  try {
+    payload = JSON.parse(await readFile(telemetryPath, 'utf8'));
+  } catch {
+    payload = { anomalies: [], summary: {}, probeExitCode: code, stdoutTail: stdout.slice(-2000) };
+  }
+  payload.probeExitCode = code;
+  const verdict = await evaluateFromPayload(payload);
+  const outPath = path.join(OUT_DIR, 'zero-shader-links.json');
+  await writeFile(outPath, `${JSON.stringify({ verdict, telemetryPath, probeExitCode: code }, null, 2)}\n`);
+  return { verdict, code, stderr };
+}
+
+async function main() {
+  let verdict;
+  if (ANOMALIES_JSON) {
+    const payload = JSON.parse(await readFile(path.resolve(ANOMALIES_JSON), 'utf8'));
+    verdict = await evaluateFromPayload(payload);
+  } else {
+    const live = await runLiveProbe();
+    verdict = live.verdict;
+  }
+
+  if (WANT_JSON) {
+    process.stdout.write(`${JSON.stringify(verdict, null, 2)}\n`);
+  } else {
+    const tag = verdict.pass ? 'PASS' : 'FAIL';
+    console.log(`[check:zero-shader-links-after-first-frame] ${tag}: ${verdict.reason}`);
+  }
+  process.exitCode = verdict.pass ? 0 : 1;
+}
+
+main().catch((err) => {
+  console.error('[check:zero-shader-links-after-first-frame]', err);
+  process.exitCode = 1;
+});
