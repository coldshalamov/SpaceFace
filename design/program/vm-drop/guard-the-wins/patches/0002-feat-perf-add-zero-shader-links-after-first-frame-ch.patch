+// Guard-the-wins (#70) — pure evaluators for the three guardrails.
+//
+// 1. Zero shader links after the first presented frame (renderer-info mid-flight detector).
+// 2. Scoreboard phase plan (one command wrapping the witness instruments).
+// 3. Resource-count plateau over a long soak (geometries / textures / programs).
+//
+// Kept dependency-free so node:test can drive the exact production logic without a browser.
+
+/** @typedef {{ type: string, frame?: number, newPrograms?: number, totalPrograms?: number, description?: string }} RendererAnomaly */
+/** @typedef {{ geometries: number, textures: number, programs: number, atMs?: number, label?: string }} ResourceSample */
+
+export const MID_FLIGHT_SHADER_ANOMALY = 'mid_flight_shader_compilation';
+
+/**
+ * Scoreboard phases from design/perf/PERF_TOP10_AND_BACKLOG_2026-09-13.md.
+ * One command runs these in order; individual probes stay the instruments of record.
+ */
+export const SCOREBOARD_PHASES = Object.freeze([
+  Object.freeze({
+    id: 'launch-to-flight',
+    title: 'Launch click to flying (main-thread profile)',
+    npmScript: null,
+    command: 'node',
+    args: Object.freeze(['scripts/probe-main-thread-profile.mjs', '--from-launch', '--flight-ms=10000']),
+    feels: Object.freeze(['Launch click to flying', 'Long freezes while loading', 'Freeze as flight begins']),
+  }),
+  Object.freeze({
+    id: 'sector-entry-witness',
+    title: 'Jump charge / busy scene (runtime witness)',
+    npmScript: 'probe:runtime-witness',
+    command: 'node',
+    args: Object.freeze(['scripts/probe-runtime-witness.mjs', '--sector-entry', '--no-sample-shots']),
+    feels: Object.freeze(['Jump charge', 'Busy scene (Ceres after the jump)']),
+  }),
+  Object.freeze({
+    id: 'zero-shader-links-after-first-frame',
+    title: 'Zero shader links after first presented frame',
+    npmScript: 'check:zero-shader-links-after-first-frame',
+    command: 'node',
+    args: Object.freeze(['scripts/check-zero-shader-links-after-first-frame.mjs', '--duration-s=15']),
+    feels: Object.freeze(['Freeze 20 s into every run', 'mid-flight shader compile hitch']),
+  }),
+]);
+
+/**
+ * Fail if renderer-info recorded any mid-flight shader compilation after the first presented frame.
+ *
+ * @param {{ anomalies?: RendererAnomaly[], shaderLinksAfterFirstPresentedFrame?: number, firstPresentedFrameIndex?: number|null }} input
+ */
+export function evaluateZeroShaderLinksAfterFirstFrame(input = {}) {
+  const anomalies = Array.isArray(input.anomalies) ? input.anomalies : [];
+  const midFlight = anomalies.filter((a) => a && a.type === MID_FLIGHT_SHADER_ANOMALY);
+  const explicit = input.shaderLinksAfterFirstPresentedFrame;
+  const explicitCount = Number.isFinite(explicit) ? Math.max(0, Number(explicit)) : null;
+  const linkedAfter = midFlight.reduce((sum, a) => sum + (Number(a.newPrograms) || 0), 0);
+  const totalLinks = explicitCount != null ? explicitCount : linkedAfter;
+  const pass = midFlight.length === 0 && totalLinks === 0;
+  return {
+    pass,
+    midFlightAnomalyCount: midFlight.length,
+    shaderLinksAfterFirstPresentedFrame: totalLinks,
+    firstPresentedFrameIndex: input.firstPresentedFrameIndex ?? null,
+    anomalies: midFlight,
+    reason: pass
+      ? 'no shader links after the first presented frame'
+      : `${midFlight.length} mid-flight shader anomal${midFlight.length === 1 ? 'y' : 'ies'}; `
+        + `${totalLinks} program(s) linked after first present`,
+  };
+}
+
+/**
+ * Decide whether a time series of renderer resource counts has plateaued.
+ *
+ * @param {ResourceSample[]} samples
+ * @param {{ warmupFraction?: number, maxGeometryDelta?: number, maxTextureDelta?: number, maxProgramDelta?: number, minSamples?: number }} [options]
+ */
+export function evaluateResourcePlateau(samples = [], options = {}) {
+  const minSamples = Number.isFinite(options.minSamples) ? options.minSamples : 6;
+  const warmupFraction = Number.isFinite(options.warmupFraction) ? options.warmupFraction : 0.35;
+  const maxGeometryDelta = Number.isFinite(options.maxGeometryDelta) ? options.maxGeometryDelta : 8;
+  const maxTextureDelta = Number.isFinite(options.maxTextureDelta) ? options.maxTextureDelta : 8;
+  const maxProgramDelta = Number.isFinite(options.maxProgramDelta) ? options.maxProgramDelta : 0;
+
+  if (!Array.isArray(samples) || samples.length < minSamples) {
+    return {
+      pass: false,
+      plateau: false,
+      reason: `need at least ${minSamples} resource samples (got ${samples?.length ?? 0})`,
+      window: null,
+      deltas: null,
+      failures: [`need at least ${minSamples} samples`],
+    };
+  }
+
+  const warmupCount = Math.min(
+    samples.length - 2,
+    Math.max(1, Math.floor(samples.length * warmupFraction)),
+  );
+  const window = samples.slice(warmupCount);
+  if (window.length < 2) {
+    return {
+      pass: false,
+      plateau: false,
+      reason: 'plateau window too short after warmup trim',
+      window: { startIndex: warmupCount, count: window.length },
+      deltas: null,
+      failures: ['plateau window too short'],
+    };
+  }
+
+  const first = window[0];
+  const last = window[window.length - 1];
+  const deltas = {
+    geometries: last.geometries - first.geometries,
+    textures: last.textures - first.textures,
+    programs: last.programs - first.programs,
+  };
+
+  const rangeOf = (key) => {
+    let min = Infinity;
+    let max = -Infinity;
+    for (const sample of window) {
+      const value = sample[key];
+      if (!Number.isFinite(value)) return { min: NaN, max: NaN, span: Infinity };
+      if (value < min) min = value;
+      if (value > max) max = value;
+    }
+    return { min, max, span: max - min };
+  };
+  const geometryRange = rangeOf('geometries');
+  const textureRange = rangeOf('textures');
+  const programRange = rangeOf('programs');
+
+  const failures = [];
+  if (!(Number.isFinite(deltas.geometries) && deltas.geometries <= maxGeometryDelta
+      && geometryRange.span <= maxGeometryDelta * 2)) {
+    failures.push(`geometries delta ${deltas.geometries} / span ${geometryRange.span} (max delta ${maxGeometryDelta})`);
+  }
+  if (!(Number.isFinite(deltas.textures) && deltas.textures <= maxTextureDelta
+      && textureRange.span <= maxTextureDelta * 2)) {
+    failures.push(`textures delta ${deltas.textures} / span ${textureRange.span} (max delta ${maxTextureDelta})`);
+  }
+  if (!(Number.isFinite(deltas.programs) && deltas.programs <= maxProgramDelta
+      && programRange.span <= maxProgramDelta)) {
+    failures.push(`programs delta ${deltas.programs} / span ${programRange.span} (max delta ${maxProgramDelta})`);
+  }
+
+  const pass = failures.length === 0;
+  return {
+    pass,
+    plateau: pass,
+    reason: pass
+      ? `resource counts plateaued over ${window.length} post-warmup samples`
+      : `resource counts did not plateau: ${failures.join('; ')}`,
+    window: { startIndex: warmupCount, count: window.length, first, last },
+    deltas,
+    ranges: { geometries: geometryRange, textures: textureRange, programs: programRange },
+    failures,
+  };
+}
+
+/**
+ * @param {{ include?: string[]|null, exclude?: string[]|Set<string> }} [options]
+ */
+export function planScoreboardPhases(options = {}) {
+  const include = options.include ? new Set(options.include) : null;
+  const exclude = options.exclude instanceof Set
+    ? options.exclude
+    : new Set(options.exclude || []);
+  return SCOREBOARD_PHASES.filter((phase) => {
+    if (exclude.has(phase.id)) return false;
+    if (include && !include.has(phase.id)) return false;
+    return true;
+  });
+}
+
+export function rendererInfoSummaryToShaderGuardInput(summary, anomalies) {
+  const list = Array.isArray(anomalies)
+    ? anomalies
+    : (Array.isArray(summary?.anomalies) ? summary.anomalies : []);
+  return {
+    anomalies: list,
+    shaderLinksAfterFirstPresentedFrame: list
+      .filter((a) => a && a.type === MID_FLIGHT_SHADER_ANOMALY)
+      .reduce((sum, a) => sum + (Number(a.newPrograms) || 0), 0),
+    firstPresentedFrameIndex: summary?.firstPresentedFrameIndex ?? null,
+  };
+}
