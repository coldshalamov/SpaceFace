@@ -0,0 +1,183 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { spawnSync } from 'node:child_process';
+import { mkdtemp, writeFile, rm } from 'node:fs/promises';
+import { tmpdir } from 'node:os';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+import {
+  MID_FLIGHT_SHADER_ANOMALY,
+  SCOREBOARD_PHASES,
+  evaluateZeroShaderLinksAfterFirstFrame,
+  evaluateResourcePlateau,
+  planScoreboardPhases,
+  rendererInfoSummaryToShaderGuardInput,
+} from '../scripts/lib/guardTheWins.mjs';
+import { RendererInfoMonitor } from '../src/testing/perf/rendererInfoMonitor.js';
+
+const ROOT = fileURLToPath(new URL('../', import.meta.url));
+
+test('evaluateZeroShaderLinksAfterFirstFrame passes when anomalies are empty', () => {
+  const verdict = evaluateZeroShaderLinksAfterFirstFrame({ anomalies: [], firstPresentedFrameIndex: 12 });
+  assert.equal(verdict.pass, true);
+  assert.equal(verdict.shaderLinksAfterFirstPresentedFrame, 0);
+  assert.match(verdict.reason, /no shader links/i);
+});
+
+test('evaluateZeroShaderLinksAfterFirstFrame fails on mid-flight shader anomaly', () => {
+  const verdict = evaluateZeroShaderLinksAfterFirstFrame({
+    anomalies: [{
+      type: MID_FLIGHT_SHADER_ANOMALY,
+      frame: 40,
+      newPrograms: 2,
+      totalPrograms: 88,
+      description: 'late link',
+    }],
+    firstPresentedFrameIndex: 10,
+  });
+  assert.equal(verdict.pass, false);
+  assert.equal(verdict.midFlightAnomalyCount, 1);
+  assert.equal(verdict.shaderLinksAfterFirstPresentedFrame, 2);
+});
+
+test('RendererInfoMonitor records mid-flight links after markFirstPresentedFrame', () => {
+  const monitor = new RendererInfoMonitor();
+  monitor.enable();
+  const fakeRenderer = (programs) => ({
+    info: {
+      render: { calls: 40, triangles: 1000, points: 0, lines: 0 },
+      memory: { geometries: 10, textures: 10 },
+      programs: Array.from({ length: programs }, (_, i) => ({ id: i })),
+    },
+  });
+
+  monitor.sample(fakeRenderer(50));
+  monitor.markFirstPresentedFrame(50);
+  monitor.sample(fakeRenderer(50));
+  assert.equal(monitor.shaderLinksAfterFirstPresentedFrame, 0);
+
+  monitor.sample(fakeRenderer(52));
+  assert.equal(monitor.shaderLinksAfterFirstPresentedFrame, 2);
+  assert.equal(monitor.anomalies.filter((a) => a.type === MID_FLIGHT_SHADER_ANOMALY).length, 1);
+
+  const summary = monitor.getSummary();
+  assert.equal(summary.shaderLinksAfterFirstPresentedFrame, 2);
+  assert.ok(summary.firstPresentedFrameIndex != null);
+
+  const guardInput = rendererInfoSummaryToShaderGuardInput(summary, summary.anomalies);
+  const verdict = evaluateZeroShaderLinksAfterFirstFrame(guardInput);
+  assert.equal(verdict.pass, false);
+});
+
+test('evaluateResourcePlateau passes a flat post-warmup series', () => {
+  const samples = [];
+  for (let i = 0; i < 4; i++) samples.push({ geometries: 100 + i * 20, textures: 80 + i * 10, programs: 40 + i });
+  for (let i = 0; i < 8; i++) samples.push({ geometries: 180, textures: 120, programs: 48 });
+  const verdict = evaluateResourcePlateau(samples);
+  assert.equal(verdict.pass, true, verdict.reason);
+  assert.equal(verdict.plateau, true);
+});
+
+test('evaluateResourcePlateau fails when programs keep climbing', () => {
+  const samples = [];
+  for (let i = 0; i < 12; i++) samples.push({ geometries: 100, textures: 80, programs: 40 + i });
+  const verdict = evaluateResourcePlateau(samples);
+  assert.equal(verdict.pass, false);
+  assert.match(verdict.reason, /programs/i);
+});
+
+test('evaluateResourcePlateau fails when geometries drift upward after warmup', () => {
+  const samples = [];
+  for (let i = 0; i < 4; i++) samples.push({ geometries: 50, textures: 40, programs: 20 });
+  for (let i = 0; i < 8; i++) samples.push({ geometries: 50 + i * 5, textures: 40, programs: 20 });
+  const verdict = evaluateResourcePlateau(samples, { maxGeometryDelta: 8 });
+  assert.equal(verdict.pass, false);
+  assert.match(verdict.reason, /geometries/i);
+});
+
+test('planScoreboardPhases returns the three #70 witness wrappers in order', () => {
+  const phases = planScoreboardPhases();
+  assert.deepEqual(phases.map((p) => p.id), SCOREBOARD_PHASES.map((p) => p.id));
+  assert.ok(phases.length >= 3);
+  assert.ok(phases.some((p) => p.id.includes('shader') || p.args.some((a) => String(a).includes('shader'))));
+  assert.ok(phases.some((p) => p.args.some((a) => String(a).includes('runtime-witness') || String(a).includes('sector-entry'))));
+  assert.ok(phases.some((p) => p.args.some((a) => String(a).includes('from-launch') || String(a).includes('main-thread'))));
+});
+
+test('planScoreboardPhases honors include / exclude filters', () => {
+  const only = planScoreboardPhases({ include: ['sector-entry-witness'] });
+  assert.equal(only.length, 1);
+  assert.equal(only[0].id, 'sector-entry-witness');
+  const skipped = planScoreboardPhases({ exclude: ['launch-to-flight'] });
+  assert.equal(skipped.some((p) => p.id === 'launch-to-flight'), false);
+});
+
+test('check:zero-shader-links-after-first-frame evaluates anomalies-json offline', async () => {
+  const dir = await mkdtemp(path.join(tmpdir(), 'sf-guard-shader-'));
+  try {
+    const bad = path.join(dir, 'bad.json');
+    await writeFile(bad, JSON.stringify({
+      anomalies: [{ type: MID_FLIGHT_SHADER_ANOMALY, newPrograms: 1, frame: 9 }],
+      firstPresentedFrameIndex: 1,
+    }));
+    const fail = spawnSync(process.execPath, [
+      path.join(ROOT, 'scripts/check-zero-shader-links-after-first-frame.mjs'),
+      `--anomalies-json=${bad}`,
+      '--json',
+    ], { encoding: 'utf8' });
+    assert.notEqual(fail.status, 0, fail.stdout + fail.stderr);
+    assert.match(fail.stdout + fail.stderr, /FAIL|mid-flight|shader/i);
+
+    const good = path.join(dir, 'good.json');
+    await writeFile(good, JSON.stringify({ anomalies: [], firstPresentedFrameIndex: 1 }));
+    const pass = spawnSync(process.execPath, [
+      path.join(ROOT, 'scripts/check-zero-shader-links-after-first-frame.mjs'),
+      `--anomalies-json=${good}`,
+    ], { encoding: 'utf8' });
+    assert.equal(pass.status, 0, pass.stdout + pass.stderr);
+    assert.match(pass.stdout, /PASS/i);
+  } finally {
+    await rm(dir, { recursive: true, force: true });
+  }
+});
+
+test('check:resource-plateau-soak evaluates samples-json offline', async () => {
+  const dir = await mkdtemp(path.join(tmpdir(), 'sf-guard-soak-'));
+  try {
+    const flat = [];
+    for (let i = 0; i < 4; i++) flat.push({ geometries: 10 + i, textures: 10, programs: 5 });
+    for (let i = 0; i < 8; i++) flat.push({ geometries: 20, textures: 10, programs: 5 });
+    const goodPath = path.join(dir, 'flat.json');
+    await writeFile(goodPath, JSON.stringify({ samples: flat }));
+    const pass = spawnSync(process.execPath, [
+      path.join(ROOT, 'scripts/check-resource-plateau-soak.mjs'),
+      `--samples-json=${goodPath}`,
+    ], { encoding: 'utf8' });
+    assert.equal(pass.status, 0, pass.stdout + pass.stderr);
