+    const badPath = path.join(dir, 'leak.json');
+    await writeFile(badPath, JSON.stringify({ samples: leak }));
+    const fail = spawnSync(process.execPath, [
+      path.join(ROOT, 'scripts/check-resource-plateau-soak.mjs'),
