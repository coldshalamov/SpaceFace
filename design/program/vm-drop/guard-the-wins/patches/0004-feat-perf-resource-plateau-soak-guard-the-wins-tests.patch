--- /dev/null
+++ b/scripts/check-resource-plateau-soak.mjs
@@ -0,0 +1,193 @@
+#!/usr/bin/env node
+// check:resource-plateau-soak — backlog #70 guardrail.
+//
+// A long soak whose geometries / textures / programs must plateau after warmup.
+// Default wall duration is 20 minutes. On soft-GPU (SwiftShader/llvmpipe) prefer:
+//
+//   node scripts/check-resource-plateau-soak.mjs --wall-s=120 --sim-minutes=20 --live
+//
+// which still asserts a meaningful plateau over the sample series, while saying
+// clearly that wall time was shortened (record that in DONE.md).
+//
+// Modes:
+//   --samples-json=P   evaluate an existing sample series (no browser) — used by tests
+//   --wall-s=N         wall-clock soak length (default 1200 = 20 min)
+//   --sim-minutes=N    label for accelerated/sim-time soaks (documented in the report)
+//   --interval-s=N     sample period (default 30)
+//   --live             drive a Playwright soak
+//   --json             print evaluation JSON
+
+import { readFile, mkdir, writeFile } from 'node:fs/promises';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { spawn } from 'node:child_process';
+
+import { evaluateResourcePlateau } from './lib/guardTheWins.mjs';
+
+const ROOT = fileURLToPath(new URL('../', import.meta.url));
+const OUT_DIR = path.join(ROOT, '.devshots', 'guard-the-wins');
+
+function argValue(name) {
+  const hit = process.argv.find((a) => a.startsWith(`${name}=`));
+  return hit ? hit.slice(name.length + 1) : null;
+}
+
+const SAMPLES_JSON = argValue('--samples-json');
+const WALL_S = Number(argValue('--wall-s') || 20 * 60);
+const SIM_MINUTES = argValue('--sim-minutes');
+const INTERVAL_S = Number(argValue('--interval-s') || 30);
+const WANT_JSON = process.argv.includes('--json');
+const HELP = process.argv.includes('--help') || process.argv.includes('-h');
+const LIVE = process.argv.includes('--live');
+
+if (HELP) {
+  console.log(`Usage:
+  node scripts/check-resource-plateau-soak.mjs --samples-json=path.json
+  node scripts/check-resource-plateau-soak.mjs [--wall-s=1200] [--interval-s=30] [--live]
+  node scripts/check-resource-plateau-soak.mjs --wall-s=120 --sim-minutes=20 --live
+
+Without --live / --samples-json this prints the contract and exits 0 (unit-tested evaluator
+is the default CI path on soft-GPU). Pass --live to drive a browser soak.`);
+  process.exit(0);
+}
+
+function summarizeMeta(samples, verdict) {
+  return {
+    schema: 'spaceface.resourcePlateauSoak.v1',
+    wallSecondsRequested: WALL_S,
+    simMinutesLabel: SIM_MINUTES ? Number(SIM_MINUTES) : null,
+    intervalSeconds: INTERVAL_S,
+    sampleCount: samples.length,
+    softGpuShortenedWall: Boolean(SIM_MINUTES) && WALL_S < 20 * 60,
+    verdict,
+  };
+}
+
+async function evaluateSamples(samples) {
+  const verdict = evaluateResourcePlateau(samples);
+  await mkdir(OUT_DIR, { recursive: true });
+  const report = summarizeMeta(samples, verdict);
+  await writeFile(path.join(OUT_DIR, 'resource-plateau.json'), `${JSON.stringify(report, null, 2)}\n`);
+  return report;
+}
+
+async function runLiveSoak() {
+  const sampler = `import { spawn } from 'node:child_process';
+import { writeFile, mkdir } from 'node:fs/promises';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { loadPlaywright } from './scripts/lib/load-playwright.mjs';
+
+const ROOT = fileURLToPath(new URL('.', import.meta.url));
+const WALL_MS = ${Math.max(5, WALL_S) * 1000};
+const INTERVAL_MS = ${Math.max(1, INTERVAL_S) * 1000};
+const PORT = Number(process.env.SPACEFACE_PORT || 8123);
+const OUT = path.join(ROOT, '.devshots', 'guard-the-wins', 'resource-plateau-samples.json');
+
+function httpGet(url) {
+  return import('node:http').then(({ get }) => new Promise((resolve) => {
+    const req = get(url, (res) => { res.resume(); resolve(res.statusCode < 500); });
+    req.on('error', () => resolve(false));
+    req.setTimeout(1000, () => { req.destroy(); resolve(false); });
+  }));
+}
+
+async function ensureServer() {
+  if (await httpGet('http://127.0.0.1:' + PORT + '/')) return null;
+  const srv = spawn('node', ['server.js', String(PORT)], { cwd: ROOT, stdio: 'ignore' });
+  for (let i = 0; i < 40; i++) {
+    await new Promise((r) => setTimeout(r, 250));
+    if (await httpGet('http://127.0.0.1:' + PORT + '/')) return srv;
+  }
+  throw new Error('server failed to start');
+}
+
+const server = await ensureServer();
+const { chromium } = await loadPlaywright(ROOT);
+const browser = await chromium.launch({
+  headless: true,
+  args: ['--enable-webgl', '--ignore-gpu-blocklist', '--use-gl=angle', '--no-sandbox'],
+});
+try {
+  const page = await browser.newPage({ viewport: { width: 1280, height: 720 } });
+  await page.goto('http://127.0.0.1:' + PORT + '/?perfmonitor=1&seed=47', { waitUntil: 'domcontentloaded', timeout: 60000 });
+  await page.waitForFunction(() => window.SF && window.SF.state, { timeout: 60000 });
+  await page.evaluate(() => { window.SF.helpers?.startNewGame?.({ seed: 47 }); });
+  await page.waitForFunction(() => window.SF.state?.mode === 'flight', { timeout: 60000 });
+  await page.evaluate(() => {
+    window.SF.perf?.renderInfo?.enable?.();
+    window.SF.perf?.renderInfo?.reset?.();
+    window.SF.perf?.renderInfo?.markWarmupComplete?.();
+    window.SF.perf?.renderInfo?.markFirstPresentedFrame?.();
+  });
+  const samples = [];
+  const started = Date.now();
+  while (Date.now() - started < WALL_MS) {
+    const snap = await page.evaluate(() => {
+      const summary = window.SF?.perf?.renderInfo?.getSummary?.(1);
+      const mem = summary?.memory || {};
+      return {
+        atMs: Date.now(),
+        geometries: mem.geometries || 0,
+        textures: mem.textures || 0,
+        programs: mem.programs || 0,
+      };
+    });
+    samples.push(snap);
+    await page.waitForTimeout(INTERVAL_MS);
+  }
+  await mkdir(path.dirname(OUT), { recursive: true });
+  await writeFile(OUT, JSON.stringify({ samples, wallMs: WALL_MS, intervalMs: INTERVAL_MS }, null, 2));
+  console.log(OUT);
+} finally {
+  await browser.close();
+  if (server) server.kill();
+}
+`;
+  const tmpPath = path.join(OUT_DIR, '_live-soak-driver.mjs');
+  await mkdir(OUT_DIR, { recursive: true });
+  await writeFile(tmpPath, sampler);
+  const child = spawn(process.execPath, [tmpPath], { cwd: ROOT, stdio: 'inherit' });
+  const code = await new Promise((resolve) => child.on('close', resolve));
+  if (code !== 0) throw new Error(`live soak driver exited ${code}`);
+  const payload = JSON.parse(await readFile(path.join(OUT_DIR, 'resource-plateau-samples.json'), 'utf8'));
+  return evaluateSamples(payload.samples || []);
+}
+
+async function main() {
+  if (SAMPLES_JSON) {
+    const payload = JSON.parse(await readFile(path.resolve(SAMPLES_JSON), 'utf8'));
+    const samples = Array.isArray(payload) ? payload : (payload.samples || []);
+    const report = await evaluateSamples(samples);
+    if (WANT_JSON) process.stdout.write(`${JSON.stringify(report, null, 2)}\n`);
+    else console.log(`[check:resource-plateau-soak] ${report.verdict.pass ? 'PASS' : 'FAIL'}: ${report.verdict.reason}`);
+    process.exitCode = report.verdict.pass ? 0 : 1;
+    return;
+  }
+
+  if (!LIVE) {
+    console.log('[check:resource-plateau-soak] contract-only mode (no browser).');
+    console.log(`  Default wall: ${20 * 60}s (20 min). This invocation wall-s=${WALL_S}`
+      + (SIM_MINUTES ? ` sim-minutes=${SIM_MINUTES}` : '') + '.');
+    console.log('  Pass --live to drive Playwright sampling, or --samples-json= for offline evaluate.');
+    console.log('  Focused tests cover evaluateResourcePlateau(); owner-GPU should run --live --wall-s=1200.');
+    process.exitCode = 0;
+    return;
+  }
+
+  const report = await runLiveSoak();
+  if (WANT_JSON) process.stdout.write(`${JSON.stringify(report, null, 2)}\n`);
+  else {
+    const tag = report.verdict.pass ? 'PASS' : 'FAIL';
+    const soft = report.softGpuShortenedWall
+      ? ` [soft-GPU shortened wall ${report.wallSecondsRequested}s for ${report.simMinutesLabel} sim-min]`
+      : '';
+    console.log(`[check:resource-plateau-soak] ${tag}: ${report.verdict.reason}${soft}`);
+  }
+  process.exitCode = report.verdict.pass ? 0 : 1;
+}
+
+main().catch((err) => {
+  console.error('[check:resource-plateau-soak]', err);
+  process.exitCode = 1;
+});
diff --git a/test/guard-the-wins.test.mjs b/test/guard-the-wins.test.mjs
