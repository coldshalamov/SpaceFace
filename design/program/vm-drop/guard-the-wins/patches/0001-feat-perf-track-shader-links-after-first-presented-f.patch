From d5e8ef0f74a55ebe9099fd11df68af10eeaf8eb1 Mon Sep 17 00:00:00 2001
From: coldshalamov <93robingattis@gmail.com>
Date: Tue, 22 Sep 2026 21:11:02 -0400
Subject: [PATCH 1/4] feat(perf): track shader links after first presented
 frame

RendererInfoMonitor now marks the first presented flight frame and counts
mid-flight program links; probe:renderer-info exits non-zero when any appear.
Backlog #70 guardrail foundation.
---
 scripts/probe-renderer-info.mjs         | 21 ++++++++++++++++++-
 src/testing/perf/rendererInfoMonitor.js | 27 +++++++++++++++++++++++++
 2 files changed, 47 insertions(+), 1 deletion(-)

diff --git a/scripts/probe-renderer-info.mjs b/scripts/probe-renderer-info.mjs
index 46ee02fcd..2e9baae4b 100644
--- a/scripts/probe-renderer-info.mjs
+++ b/scripts/probe-renderer-info.mjs
@@ -106,7 +106,9 @@ async function main() {
       if (window.SF.perf && window.SF.perf.renderInfo) {
         window.SF.perf.renderInfo.enable();
         window.SF.perf.renderInfo.reset();
-        window.SF.perf.renderInfo.markWarmupComplete();
+        // First presented flight frame = start of the zero-links window (#70).
+        const programs = window.SF.perf.renderInfo.getSummary?.(0)?.memory?.programs || 0;
+        window.SF.perf.renderInfo.markFirstPresentedFrame(programs);
       }
     });
 
@@ -179,6 +181,23 @@ async function main() {
     console.log(`Triangles: p50=${s.triangles.p50.toLocaleString()}, p95=${s.triangles.p95.toLocaleString()}`);
     console.log(`Late Shader Compiles: ${shaderCompiles.length}`);
     console.log(`Report: ${reportPath}`);
+
+    // #70: zero shader links after first presented frame — fail the process so
+    // check:zero-shader-links-after-first-frame / perf:scoreboard can gate on it.
+    const telemetryForGuard = {
+      summary: { ...s, firstPresentedFrameIndex: finalSummary.summary?.firstPresentedFrameIndex ?? 0 },
+      anomalies,
+      shaderLinksAfterFirstPresentedFrame: shaderCompiles.reduce((n, a) => n + (a.newPrograms || 0), 0),
+    };
+    await writeFile(path.join(OUT_DIR, 'telemetry.json'), JSON.stringify(telemetryForGuard, null, 2), 'utf8');
+
+    if (!passShaders) {
+      console.error(`[perf:renderer-info] FAIL: ${shaderCompiles.length} mid-flight shader link(s) after first presented frame`);
+      process.exitCode = 1;
+    } else if (!passCalls) {
+      console.error('[perf:renderer-info] FAIL: draw-call p95 over budget');
+      process.exitCode = 1;
+    }
   } finally {
     if (browser) await browser.close();
     if (serverProcess) serverProcess.kill();
diff --git a/src/testing/perf/rendererInfoMonitor.js b/src/testing/perf/rendererInfoMonitor.js
index 037333e3b..2aa2e6039 100644
--- a/src/testing/perf/rendererInfoMonitor.js
+++ b/src/testing/perf/rendererInfoMonitor.js
@@ -15,8 +15,12 @@ export class RendererInfoMonitor {
     this.anomalies = [];
     this.initialPrograms = null;
     this.isWarmupDone = false;
+    /** Frame index when the first presented flight frame was marked (null until then). */
+    this.firstPresentedFrameIndex = null;
     this.totalFramesSampled = 0;
     this.lastProgramsCount = 0;
+    /** Programs linked after first presented frame (sum of mid-flight deltas). */
+    this.shaderLinksAfterFirstPresentedFrame = 0;
   }
 
   enable() {
@@ -30,6 +34,17 @@ export class RendererInfoMonitor {
   markWarmupComplete(currentPrograms = 0) {
     this.isWarmupDone = true;
     this.initialPrograms = currentPrograms;
+    if (this.firstPresentedFrameIndex == null) {
+      this.firstPresentedFrameIndex = this.totalFramesSampled;
+    }
+  }
+
+  /**
+   * Alias used by the #70 guard: the first presented frame is the warmup boundary.
+   * Calling this after the first on-screen flight present starts the zero-links window.
+   */
+  markFirstPresentedFrame(currentPrograms = 0) {
+    this.markWarmupComplete(currentPrograms);
   }
 
   /**
@@ -71,6 +86,7 @@ export class RendererInfoMonitor {
         description: `Late shader compile detected! ${delta} new program(s) compiled mid-gameplay (causes main-thread hitch).`,
       };
       this.anomalies.push(anomaly);
+      this.shaderLinksAfterFirstPresentedFrame += delta;
       console.warn(`[SpaceFace][renderer.info] ${anomaly.description}`);
     }
 
@@ -123,6 +139,9 @@ export class RendererInfoMonitor {
         triangles: { min: 0, avg: 0, p50: 0, p95: 0, max: 0 },
         memory: { geometries: 0, textures: 0, programs: 0 },
         anomalies: [],
+        firstPresentedFrameIndex: this.firstPresentedFrameIndex,
+        shaderLinksAfterFirstPresentedFrame: this.shaderLinksAfterFirstPresentedFrame,
+        warmupComplete: this.isWarmupDone,
       };
     }
 
@@ -156,6 +175,9 @@ export class RendererInfoMonitor {
         programs: latest.programs,
       },
       anomalies: this.anomalies.slice(-20),
+      firstPresentedFrameIndex: this.firstPresentedFrameIndex,
+      shaderLinksAfterFirstPresentedFrame: this.shaderLinksAfterFirstPresentedFrame,
+      warmupComplete: this.isWarmupDone,
     };
   }
 
@@ -181,6 +203,11 @@ export class RendererInfoMonitor {
     this.history = [];
     this.anomalies = [];
     this.totalFramesSampled = 0;
+    this.firstPresentedFrameIndex = null;
+    this.shaderLinksAfterFirstPresentedFrame = 0;
+    this.isWarmupDone = false;
+    this.initialPrograms = null;
+    this.lastProgramsCount = 0;
   }
 }
 
