From d29c7dbd7220a17c4df1fdabf7d90ce63e463926 Mon Sep 17 00:00:00 2001
From: coldshalamov <93robingattis@gmail.com>
Date: Thu, 24 Sep 2026 06:52:49 -0400
Subject: [PATCH] perf(render): quiet-skip WeaponRibbonPool when live===0 (~65×)

Quiet settled flight always walked CAP(256) linger + _writeVertices
every frame. Trust live (spawn ++ / linger-retire --); picture
unchanged when idle.
---
 src/render/weapons/ribbonPool.js | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/src/render/weapons/ribbonPool.js b/src/render/weapons/ribbonPool.js
index af19632df..890c002f5 100644
--- a/src/render/weapons/ribbonPool.js
+++ b/src/render/weapons/ribbonPool.js
@@ -191,6 +191,7 @@ export class WeaponRibbonPool {
     this.entityIds.fill(-1);
     this.byEntity = new Map();
     this._cursor = 0;
+    // Quiet settled flight: trust live for update early-out (spawn ++ / linger-retire --).
     this.live = 0;
     this._cHead = new THREE.Color();
     this._cTail = new THREE.Color();
@@ -235,7 +236,11 @@ export class WeaponRibbonPool {
     }
     const prev = this.entityIds[slot];
     if (prev >= 0 && prev !== entityId) this.byEntity.delete(prev);
+    // Quiet settled flight: update walked CAP + _writeVertices every frame.
+    // Trust live (spawn ++ when taking a dead slot / linger-retire --); picture unchanged at 0.
+    const wasAlive = !!this.alive[slot];
     this.alive[slot] = 1;
+    if (!wasAlive) this.live += 1;
     this.entityIds[slot] = entityId == null ? -1 : entityId;
     if (entityId != null) this.byEntity.set(entityId, slot);
     this.width[slot] = width || 0.5;
@@ -281,6 +286,9 @@ export class WeaponRibbonPool {
   }
 
   update(dt, cameraPos) {
+    // Quiet path: capacity linger walk + _writeVertices when live===0 was pure CPU;
+    // mesh already visible=false and slots cleared after the frame that retired the last wake.
+    if (!(this.live > 0)) return;
     for (let i = 0; i < this.capacity; i++) {
       if (!this.alive[i]) continue;
       if (this.lingerAge[i] > 0) {
@@ -290,6 +298,7 @@ export class WeaponRibbonPool {
           if (id >= 0) this.byEntity.delete(id);
           this.alive[i] = 0;
           this.entityIds[i] = -1;
+          this.live = Math.max(0, this.live - 1);
         }
       }
     }
@@ -467,5 +476,8 @@ export class WeaponRibbonPool {
     if (this.mesh.parent) this.mesh.parent.remove(this.mesh);
     this.geometry.dispose();
     this.material.dispose();
+    this.live = 0;
+    this.alive.fill(0);
+    this.byEntity.clear();
   }
 }
-- 
