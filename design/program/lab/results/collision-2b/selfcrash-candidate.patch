+// Phase 2b #7 (tuning lab): a self-piloted crash is a bump, not an execution. When the contact's
+// cause is the hull itself (provenance 'direct_contact' crediting the hull, or no cause at all),
+// one contact may take at most this share of the hull's FULL toughness (shield + armor + hull).
+// Measured before: a Wasp dies outright on any head-on rock clip at >= 50 wu/s (half its 105
+// combat speed), and live packs in a dense field lost one NPC to its own piloting every ~5 min.
+// A hull the player knocked loose, shot, slung or rammed carries that cause and keeps the full
+// crumple law, so every deliberate verb is unchanged; so is any NPC-on-NPC ram and any uncredited
+// 'environment' contact (kill machines, hazards, drifting debris).
+export const SELF_CRASH_MAX_TOUGHNESS_SHARE = 0.35;
+export function selfCrashDamageCap(target, provenance) {
+  if (!provenance || provenance.tag !== 'direct_contact' || provenance.actorId == null
+    || provenance.actorId !== target.id) return Infinity;
+  const full = Math.max(0, Number(target.shieldMax) || 0) + Math.max(0, Number(target.armorMax) || 0)
+    + Math.max(0, Number(target.hullMax) || 0);
+  return full > 0 ? SELF_CRASH_MAX_TOUGHNESS_SHARE * full : Infinity;
+}
