{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KJpTGYaq4Lgo6WBEmq1U2c","type":"tool_result","content":"1\t/** Serialize late geometry uploads between presents. Loading owns its initial\n2\t * set; rocks and payloads created afterwards need a route out of pending too.\n3\t *\n4\t * The ambient lane drains one root per present — that keeps GPU uploads off the\n5\t * draw path — and its pick is a deadline choice: a hull about to cross the\n6\t * glass must not wait behind a background prop that arrived first. `priorityOf`\n7\t * re-grades the waiting set on every pick (lower wins, sequence breaks ties) so\n8\t * the order reflects where entities are NOW, not when they were noticed.\n9\t *\n10\t * `isUrgent` marks the harder deadline: a pending root already on the live\n11\t * glass. Those drain on a second lane so an ambient entry's program-link wait\n12\t * cannot hold them hostage; each urgent pick pulls every pending urgent root\n13\t * into one pass — per-root deadline compiles (floated) plus one merged\n14\t * un-sliced residency pass — so the whole burst resolves inside a couple of\n15\t * turns. */\n16\tconst EMPTY_PENDING_LIST = Object.freeze([]);\n17\t\n18\t// One reused stats result per queue instance: stats() is called every frame\n19\t// by the render diagnostics block, so it must not allocate in steady state.\n20\tconst newStatsResult = () => ({\n21\t  queued: 0, draining: false, drainingAmbient: false, drainingUrgent: false,\n22\t  urgentQueued: 0, admitted: 0, skipped: 0, urgentBatches: 0, lastBatchMs: NaN,\n23\t  enqueuedTotal: 0, dedupedTotal: 0,\n24\t  pendingIds: EMPTY_PENDING_LIST, pendingTypes: EMPTY_PENDING_LIST,\n25\t  drainStage: 'idle',\n26\t});\n27\t\n28\texport function createLiveGeometryAdmissionQueue({ compile, prepare, prepareBatch, yieldToMain, isActive, isUrgent, onReady, onError, priorityOf }) {\n29\t  const pending = [];\n30\t  // Stats memo: the pending ids/types arrays are queue-membership data, so a\n31\t  // per-frame stats() call can serve the last build until the queue mutates.\n32\t  // pendingSeq bumps on every push/splice; the urgent count still scans live\n33\t  // (isUrgent is dynamic and must stay exact) but allocates nothing.\n34\t  let pendingSeq = 0;\n35\t  let statsPendingSeq = -1;\n36\t  const statsPendingIds = [];\n37\t  const statsPendingTypes = [];\n38\t  const admissions = new WeakMap();\n39\t  // A thrown compile/upload used to stay latched in `admissions` forever — the\n40\t  // pending root could never re-enter the queue and stayed invisible. Retry a\n41\t  // few times (one attempt per drain, so a hard failure costs a few frames, not\n42\t  // a per-frame storm), then latch as before for genuinely broken uploads.\n43\t  const retryCounts = new WeakMap();\n44\t  const MAX_ADMISSION_RETRIES = 4;\n45\t  // Past the retry budget the latch used to hold the root invisible forever — a\n46\t  // transient GL failure (context pressure, a dropped upload) became a permanent\n47\t  // hole. Keep deduping but reopen one retry every cooldown window instead: a\n48\t  // broken upload costs a single slow-cadence attempt, not a per-frame loop and\n49\t  // not an invisible-forever mesh.\n50\t  const retryCooldownUntil = new WeakMap();\n51\t  const RETRY_COOLDOWN_MS = 4000;\n52\t  const nowMsRetry = () => (\n53\t    typeof performance !== 'undefined' && typeof performance.now === 'function'\n54\t      ? performance.now()\n55\t      : Date.now());\n56\t  // Two drain lanes: the ambient lane keeps its compile-before-show contract\n57\t  // (a real program link can take seconds, and off-glass roots can wait for it),\n58\t  // but that wait must not hold the queue while on-glass roots sit invisible —\n59\t  // the urgent lane batches and drains them independently. GPU work still\n60\t  // serializes at the resource level (compile tail, residency chains), so the\n61\t  // split changes ordering, not pacing.\n62\t  let drainingAmbient = false;\n63\t  let drainingUrgent = false;\n64\t  let sequence = 0;\n65\t  let admittedCount = 0;\n66\t  let skippedCount = 0;\n67\t  let urgentBatches = 0;\n68\t  let lastBatchMs = NaN;\n69\t  let enqueuedTotal = 0;\n70\t  let dedupedTotal = 0;\n71\t  let drainStage = 'idle';\n72\t  const statsResult = newStatsResult();\n73\t\n74\t  const entryPriority = (entry) => {\n75\t    if (typeof priorityOf !== 'function') return 0;\n76\t    let value;\n77\t    try {\n78\t      value = Number(priorityOf(entry.entity, entry.root));\n79\t    } catch (_) {\n80\t      return 0;\n81\t    }\n82\t    return Number.isFinite(value) ? value : 0;\n83\t  };\n84\t\n85\t  const entryUrgent = (entry) => {\n86\t    if (typeof isUrgent !== 'function') return false;\n87\t    try {\n88\t      return isUrgent(entry.entity, entry.root) === true;\n89\t    } catch (_) {\n90\t      return false;\n91\t    }\n92\t  };\n93\t  const entryNotUrgent = (entry) => !entryUrgent(entry);\n94\t\n95\t  const pickNextWhere = (predicate) => {\n96\t    let bestIndex = -1;\n97\t    let bestPriority = Infinity;\n98\t    let bestSequence = Infinity;\n99\t    for (let index = 0; index < pending.length; index++) {\n100\t      const entry = pending[index];\n101\t      if (!predicate(entry)) continue;\n102\t      const priority = entryPriority(entry);\n103\t      if (priority < bestPriority\n104\t          || (priority === bestPriority && entry.sequence < bestSequence)) {\n105\t        bestIndex = index;\n106\t        bestPriority = priority;\n107\t        bestSequence = entry.sequence;\n108\t      }\n109\t    }\n110\t    if (bestIndex < 0) return null;\n111\t    pendingSeq++;\n112\t    return pending.splice(bestIndex, 1)[0];\n113\t  };\n114\t\n115\t  const runEntry = async (entry) => {\n116\t    const active = entry.active;\n117\t    drainStage = `yield:${entry.entity && entry.entity.id}`;\n118\t    await yieldToMain();\n119\t    if (!active()) return false;\n120\t    drainStage = `compile:${entry.entity && entry.entity.id}`;\n121\t    // Off-glass ro