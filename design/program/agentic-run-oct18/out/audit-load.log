{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01E27qB7HBAYZG5RaxGAjpik","type":"tool_result","content":"120\t}\n121\t\n122\texport function presentationOwnerIsAdmitted(admission) {\n123\t  return admission === PRESENTATION_OWNER_ADMISSION.headless\n124\t    || admission === PRESENTATION_OWNER_ADMISSION.ready;\n125\t}\n126\t\n127\t/**\n128\t * Whether an entity is a mission target whose lock the renderer must keep serviceable even when\n129\t * its authored hull never publishes: a terminal 'unavailable' on a required-whole-ship mission\n130\t * hostile may still mount a drawn body (its resident stand-in or the procedural fallback) so the\n131\t * warrant can be closed — authored-or-nothing never wins over a completable mission.\n132\t * Identity arrives two ways: stamped on the record (missionTag / storyTarget) or by membership in\n133\t * a live mission's target list. Guard every access — a save restore can leave either side\n134\t * partially populated, and the renderer polls this on a real frame path.\n135\t */\n136\texport function entityIsMissionCritical(entity, state) {\n137\t  const data = entity && entity.data;\n138\t  if (data) {\n139\t    if (data.missionTag != null) return true;\n140\t    if (data.storyTarget) return true;\n141\t  }\n142\t  if (!entity || entity.id == null) return false;\n143\t  const active = state && state.missions && state.missions.active;\n144\t  if (!Array.isArray(active)) return false;\n145\t  for (const mission of active) {\n146\t    const ids = mission && mission.targetEntityIds;\n147\t    if (Array.isArray(ids) && ids.includes(entity.id)) return true;\n148\t  }\n149\t  return false;\n150\t}\n151\t\n152\texport function presentationAllowsPlayerFacingAction(entity, state) {\n153\t  if (isPhysicalMachinery(entity)) return machineryHasEffectivePresentation(entity, state);\n154\t  const indirect = entity && entity.data && entity.data.presentationOwnerWorldRecordId;\n155\t  if (indirect) {\n156\t    return presentationOwnerIsAdmitted(presentationOwnerAdmissionForWorldRecord(indirect, state));\n157\t  }\n158\t  if (!state || !state.render || !state.render.scene) return true;\n159\t  if (!entityRequiresAuthoredPresentation(entity)) return true;\n160\t  const owner = resolvePresentationAdmissionOwner(entity, state);\n161\t  return !!owner && owner.presentationAdmission === PRESENTATION_ADMISSION.ready;\n162\t}\n163\t\n164\t/**\n165\t * Targeting must not sit on empty air. A required hull whose authored identity is still pending\n166\t * stays off the lock until that same complete body publishes. Headless sim and contacts that never\n167\t * entered the authored path remain lockable. A terminal 'unavailable' verdict is not empty air by\n168\t * itself: `presentationFallbackVisible` describes what the boundary actually draws at terminal —\n169\t * the procedural fallback for non-required hulls, the ship's own resident stand-in hull, or the\n170\t * procedural body the renderer publishes for a mission-critical required hull (see\n171\t * entityIsMissionCritical). Only a verdict still drawing the abstract resolving marker — or\n172\t * nothing — keeps the lock refused.\n173\t */\n174\texport function presentationAllowsTargetLock(entity, state) {\n175\t  if (!entity || entity.alive === false) return false;\n176\t  if (isPhysicalMachinery(entity)) return machineryHasEffectivePresentation(entity, state);\n177\t  const indirect = entity.data && entity.data.presentationOwnerWorldRecordId;\n178\t  if (indirect) return presentationAllowsPlayerFacingAction(entity, state);\n179\t  if (!state || !state.render || !state.render.scene) return true;\n180\t  if (entity.type !== 'ship') return true;\n181\t  const admission = entity.presentationAdmission;\n182\t  if (admission == null) return true;\n183\t  if (admission === PRESENTATION_ADMISSION.unavailable) {\n184\t    return entity.presentationFallbackVisible === true;\n185\t  }\n186\t  return admission === PRESENTATION_ADMISSION.ready;\n187\t}\n188\t"}]},"parent_tool_use_id":null,"session_id":"c020a9ae-f380-4499-9216-2daa8d6e2392","uuid":"ebd7e761-778c-4f9d-97b9-b5d91f732994","timestamp":"2026-10-19T00:42:59.306Z","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\93rob\\Documents\\GitHub\\SpaceFace\\src\\core\\presentationAdmission.js","content":"}\n\nexport function presentationOwnerIsAdmitted(admission) {\n  return admission === PRESENTATION_OWNER_ADMISSION.headless\n    || admission === PRESENTATION_OWNER_ADMISSION.ready;\n}\n\n/**\n * Whether an entity is a mission target whose lock the renderer must keep serviceable even when\n * its authored hull never publishes: a terminal 'unavailable' on a required-whole-ship mission\n * hostile may still mount a drawn body (its resident stand-in or the procedural fallback) so the\n * warrant can be closed — authored-or-nothing never wins over a completable mission.\n * Identity arrives two ways: stamped on the record (missionTag / storyTarget) or by membership in\n * a live mission's target list. Guard every access — a save restore can leave either side\n * partially populated, and the renderer polls this on a real frame path.\n */\nexport function entityIsMissionCritical(entity, state) {\n  const data = entity && entity.data;\n  if (data) {\n    if (data.missionTag != null) return true;\n    if (data.storyTarget) return true;\n  }\n  if (!entity || entity.id == null) return false;\n  const active = state && state.missions && state.missions.active;\n  if (!Array.isArray(active)) return false;\n  for (const mission of active) {\n    const ids = mission && mission.targetEntityIds;\n    if (Array.isArray(ids) && ids.includes(entity.id)) return true;\n  }\n  return false;\n}\n\nexport function presentationAllowsPlayerFacingAction(entity, state) {\n  if (isPhysicalMachinery(entity)) return machineryHasEffectivePresentation(entity, state);\n  const indirect = entity && entity.data && entity.data.presentationOwnerWorldRecordId;\n  if (indirect) {\n    return presentationOwnerIsAdmitted(presentationOwnerAdmissionForWorldRecord(indirect, state));\n  }\n  if (!state || !state.render || !state.render.scene) return true;\n  if (!entityRequiresAuthoredPresentation(entity)) return true;\n  const owner = resolvePresentationAdmissionOwner(entity, state);\n  return !!owner && owner.presentationAdmission === PRESENTATION_ADMISSION.ready;\n}\n\n/**\n * Targeting must not sit on empty air. A required hull whose authored identity is still pending\n * stays off the lock until that same complete body publishes. Headless sim and contacts that never\n * entered the authored path remain lockable. A terminal 'unavailable' verdict is not empty air by\n * itself: `presentationFallbackVisible` describes what the boundary actually draws at terminal —\n * the procedural fallback for non-required hulls, the ship's own resident stand-in hull, or the\n * procedural body the renderer publishes for a mission-critical required hull (see\n * entityIsMissionCritical). Only a verdict still drawing the abstract resolving marker — or\n * nothing — keeps the lock refused.\n */\nexport function presentationAllowsTargetLock(entity, state) {\n  if (!entity || entity.alive === false) return false;\n  if (isPhysicalMachinery(entity)) return machineryHasEffectivePresentation(entity, state);\n  const indirect = entity.data && entity.data.presentationOwnerWorldRecordId;\n  if (indirect) return presentationAllowsPlayerFacingAction(entity, state);\n  if (!state || !state.render || !state.render.scene) return true;\n  if (entity.type !== 'ship') return true;\n  const admission = entity.presentationAdmission;\n  if (admission == null) return true;\n  if (admission === PRESENTATION_ADMISSION.unavailable) {\n    return entity.presentationFallbackVisible === true;\n  }\n  return admission === PRESENTATION_ADMISSION.ready;\n}\n","numLines":69,"startLine":120,"totalLines":188}},"tool_result_meta":[{"id":"toolu_01E27qB7HBAYZG5RaxGAjpik","permission_decision":{"decis