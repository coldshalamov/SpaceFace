{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01R6Uq7tzyEDVa8Y1fsSDsif","type":"tool_result","content":"21280\t    });\n21281\t    onBus('jump:chargeAbort', () => {\n21282\t      const incoming = this._incomingSectorPrewarm;\n21283\t      if (incoming) releaseSectorPrewarm(incoming, 'jump-charge-aborted');\n21284\t      this._incomingSectorPrewarm = null;\n21285\t    });\n21286\t    onBus('entity:spawned', ({ entity } = {}) => {\n21287\t      if (!entity) return;\n21288\t      // The residency poll is deliberately a 250 ms cadence for ambient work. A contact that\n21289\t      // spawns directly into the readable runway is already owed by the current picture, so give\n21290\t      // its mesh build a queue slot in this event turn; the normal drain still owns the bounded\n21291\t      // build budget and authored upgrade/pipeline admission remains unchanged.\n21292\t      enqueueSpawnedEntityMesh(this, entity, state);\n21293\t      const spawnedSectorId = entitySectorId(entity);\n21294\t      const pending = this._authoredSectorPrewarmPending?.active === true\n21295\t        && this._authoredSectorPrewarmPending.sectorId === String(spawnedSectorId || '')\n21296\t        ? this._authoredSectorPrewarmPending\n21297\t        : (this._incomingSectorPrewarm?.active === true\n21298\t          && this._incomingSectorPrewarm.sectorId === String(spawnedSectorId || '')\n21299\t          ? this._incomingSectorPrewarm\n21300\t          : null);\n21301\t      if (pending) {\n21302\t        appendSectorPrewarmRequests(pending, authoredPrewarmRequestsForEntities([entity], {\n21303\t          sectorId: pending.sectorId,\n21304\t          playerId: state.playerId,\n21305\t        }));\n21306\t        stageSectorPrewarmBoundaries(pending, [entity]);\n21307\t      }\n21308\t      // Event-driven decode kick: mid-flight combat cohorts (nemesis wing, bounty pair,\n21309\t      // reinforcement squads) and payoff props arrive as same-tick groups; the 0.25 s runway\n21310\t      // poll plus its 2-per-poll cap serializes them behind ambient warm. The spawn event is\n21311\t      // the earliest spec — start the hull/packaged decode now (file-deduped through the same\n21312\t      // pending set the poll uses) so the cohort decodes in parallel from tick zero.\n21313\t      kickSpawnedEntityDecode(this, entity);\n21314\t    });\n21315\t    onBus('nemesis:announced', (payload = {}) => {\n21316\t      // The tell window is exactly long enough to decode the announced roster — start the\n21317\t      // boss/escort hulls at announcement rather than at spawn so arrival shows real models.\n21318\t      warmNemesisSquadDecode(this, payload);\n21319\t    });\n21320\t    onBus('encounter:claimDefenseRoster', (payload = {}) => {\n21321\t      // The director publishes the deterministic claim-defense squad at warning onset — hold\n21322\t      // the roster so the residency pass can warm it through the countdown. The player's own\n21323\t      // arrival fires the encounter, so there is no fixed dueAt to gate on; the warning phase\n21324\t      // itself is the lead window.\n21325\t      if (!payload.encounterId || !Array.isArray(payload.archetypes) || !payload.archetypes.length) return;\n21326\t      const rosters = this._claimDefenseRosters || (this._claimDefenseRosters = new Map());\n21327\t      rosters.set(payload.encounterId, { archetypes: payload.archetypes, sectorId: payload.sectorId || null });\n21328\t    });\n21329\t    onBus('encounter:resolved', (payload = {}) => {\n21330\t      if (payload.encounterId && this._claimDefenseRosters) this._claimDefenseRosters.delete(payload.encounterId);\n21331\t    });\n21332\t    onBus('claim:defenseResolved', (payload = {}) => {\n21333\t      // Pre-engagement settlements (ignored warnings) never emit encounter:resolved — prune\n21334\t      // the roster there too so settled defenses stop feeding the warm poll.\n21335\t      if (payload.encounterId && this._claimDefenseRosters) this._claimDefenseRosters.delete(payload.encounterId);\n21336\t    });\n21337\t    onBus('heist:missionCue', ({ moment, variantId } = {}) => {\n21338\t      // Breakaway pressure spawns at capsule launch on a fixed 3-file roster — schedule\n21339\t      // acceptance is the earliest reliable signal, so the hulls decode during the countdown\n21340\t      // rather than in the frame the assembly goes loose.\n21341\t      if (moment !== 'accepted' || variantId !== BREAKAWAY_THIRD_SHIFT_VARIANT_ID) return;\n21342\t      warmEnemyRosterDecode(this,\n21343\t        [BREAKAWAY_PRESSURE.specialistTypeId, ...BREAKAWAY_PRESSURE.lightPool],\n21344\t        'heist-pressure-decode-runway');\n21345\t    });\n21346\t    onBus('heist:launchScheduleReceipt', (receipt) => {\n21347\t      // The payload the armed schedule will throw is the countdown's watched set-piece — the\n21348\t      // pressure roster warms at missionCue, but the capsule/spindle body itself only ever\n21349\t      // warmed menu-side on the opening cohort, so a session that arrives at Tethys later\n21350\t      // (or restores into it) decodes it at the glass. The receipt carries the variant; the\n21351\t      // armed schedule record is the fallback for legacy receipts without one.\n21352\t      if (!receipt || receipt.accepted !== true) return;\n21353\t      const variantId = receipt.variantId\n21354\t        || (this.state && this.state.heistFacilities && this.state.heistFacilities.schedule\n21355\t          && this.state.heistFacilities.schedule.variantId)\n21356\t        || null;\n21357\t      const payload = heistLaunchVariant(variantId).payload;\n21358\t      const assetId = payload && payload.authoredPayloadAssetId;\n21359\t      if (!assetId) return;\n21360\t      const resolved = {\n21361\t        file: authoredPayloadFileForEntity({ type: 'payload', data: { authoredPayloadAssetId: assetId } }),\n21362\t        slot: authoredPayloadSlotForEntity({ type: 'payload', data: { authoredPayloadAssetId: assetId } }),\n2