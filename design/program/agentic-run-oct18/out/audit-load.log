{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JvHWS8unimLf7fLX7uMWC8","type":"tool_result","content":"1\t// Flight-ready membership. Input may start once this set is ready; far place\n2\t// detail streams afterward. Collision/docking shells stay pinned while a\n3\t// station is interactable.\n4\t\n5\texport const PLACE_PACKAGE_LAYER = Object.freeze({\n6\t  GAMEPLAY_SHELL: 'GameplayShell',\n7\t  EXTERIOR_MID: 'ExteriorMid',\n8\t  EXTERIOR_NEAR: 'ExteriorNear',\n9\t  CLOSE_DETAIL: 'CloseDetail',\n10\t  INTERIOR: 'Interior',\n11\t});\n12\t\n13\texport const FLIGHT_READY_ROLE = Object.freeze({\n14\t  PLAYER_GAMEPLAY: 'playerGameplay',\n15\t  PLAYER_FLIGHT_PACKAGE: 'playerFlightPackage',\n16\t  GLASS_ACTORS: 'glassActors',\n17\t  COLLISION_SHELL: 'collisionShell',\n18\t  TABLE_STATION_SHELL: 'tableStationShell',\n19\t  FIRST_FRAME_BACKGROUND: 'firstFrameBackground',\n20\t  HUD_INPUT: 'hudInput',\n21\t});\n22\t\n23\texport function isPlaceLayerBlockingFlightReady(layer) {\n24\t  // The gameplay/collision shell is the only place payload allowed to hold\n25\t  // the control handoff. Exterior polish, close detail, and interiors stream\n26\t  // after flight begins; this is the shell-first rule for large places.\n27\t  return layer === PLACE_PACKAGE_LAYER.GAMEPLAY_SHELL;\n28\t}\n29\t\n30\texport function selectPlacePackageLayer(options = {}) {\n31\t  if (options.docked === true) return PLACE_PACKAGE_LAYER.INTERIOR;\n32\t  if (options.onGlass === true && Number(options.projectedPx) > 220) {\n33\t    return PLACE_PACKAGE_LAYER.EXTERIOR_NEAR;\n34\t  }\n35\t  if (options.onGlass === true) return PLACE_PACKAGE_LAYER.EXTERIOR_MID;\n36\t  if (options.onRunway === true || options.interactable === true) {\n37\t    return PLACE_PACKAGE_LAYER.GAMEPLAY_SHELL;\n38\t  }\n39\t  return null;\n40\t}\n41\t\n42\texport function isFlightReadyRoleBlocking(role) {\n43\t  return role === FLIGHT_READY_ROLE.PLAYER_GAMEPLAY\n44\t    || role === FLIGHT_READY_ROLE.PLAYER_FL