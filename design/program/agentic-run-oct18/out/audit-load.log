{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Tu4pnvbH9mn52yCdXAcAuV","type":"tool_result","content":"1\t// Submit-side visibility for presentation roots.\n2\t//\n3\t// The query retains a short approach runway for pose sync and preparation. Only\n4\t// the live camera's glass (including visual envelopes and the frame skirt)\n5\t// owns submission; the wider deterministic sim frame is a fallback for callers\n6\t// without a live camera verdict.\n7\t\n8\texport function isAuthoredPendingStatus(status) {\n9\t  return status === 'loading'\n10\t    || status === 'awaiting-authored-admission'\n11\t    || status === 'compiling-pipelines';\n12\t}\n13\t\n14\texport function shouldSubmitEntityMesh(options = {}) {\n15\t  // A missing fenced pose is a fail-closed condition for ordinary roots, but the player and\n16\t  // renderer-forced roots retain their last safe mesh state until the next completed publication.\n17\t  // Hiding one of those roots on a transient publication gap would turn a render-boundary miss\n18\t  // into a gameplay-visible disappearance.\n19\t  const protectedRoot = isProtectedEntityMesh(options);\n20\t  if (options.snapshotMissing === true && !protectedRoot) return false;\n21\t  if (protectedRoot) return true;\n22\t  // First draw of an uncompiled material links the driver program inside bloomScene.\n23\t  // Hold ordinary roots until compileObjectPipelines has actually linked them —\n24\t  // once they have, a re-admission re-links variants behind the scenes and the\n25\t  // already-linked root keeps drawing (bloom's per-material guard skips any\n26\t  // still-unlinked drawable instead of the whole root disappearing).\n27\t  if (options.pipelinesPending === true && options.sfAdmittedOnce !== true) return false;\n28\t  // Nearby opening extras that are still decoding must not enter bloomScene.\n29\t  // Their first authored draw is the 100 ms+ Intel compile brick. A resolving marker is exempt:\n30\t  // it draws from the shared, already-linked Standard family and is the only drawable in the\n31\t  // substrate, so submitting it costs nothing extra and keeps a pending contact on screen.\n32\t  if (options.authoredPending === true && !protectedRoot && options.resolvingMarker !== true) return false;\n33\t  // compile() does not upload vertex buffers. Hold ordinary rocks/props until the\n34\t  // 1x1 residency pass has registered those geometries.\n35\t  if (options.geometryPending === true && !protectedRoot) return false;\n36\t  if (options.hidden === true) return false;\n37\t  // The sim glass uses a conservative aspect and can lag camera zoom/glide. Letting its\n38\t  // membership override a measured miss submits off-screen roots; letting a stale tier\n39\t  // override a measured hit makes a ready body pop out until the next sim publication.\n40\t  if (typeof options.onLiveGlass === 'boolean') return options.onLiveGlass;\n41\t  const frame = options.activityFrame;\n42\t  const entityId = options.entityId;\n43\t  if (frame && entityId != null) {\n44\t    const glass = frame.renderGlassIds || frame.glassIds;\n45\t    const runway = frame.renderRunwayIds || frame.runwayIds;\n46\t    const has = (collection) => collection && typeof collection.has === 'function'\n47\t      ? collection.has(entityId)\n48\t      : Array.isArray(collection) && collection.includes(entityId);\n49\t    if (has(glass)) return true;\n50\t    // Runway roots remain resident for approach-time warmup but are not submitted\n51\t    // until the activity frame promotes them onto the readable glass.\n52\t    if (has(runway)) return false;\n53\t    // Ledger rows (far, field and dressing tables) are not combat-list members, so a complete\n54\t    // frame never names them. isEntityRenderRelevant keeps their mesh under distance policy; hiding\n55\t    // them here left accepted props resident on the GPU but never drawn. Their tier still decides.\n56\t    if (frame.complete === true && options.ledgerRow !== true) return false;\n57\t  }\n58\t  const tier = options.presentationTier;\n59\t  if (tier === 'R2_METADATA' || tier === 'R3_UNLOADED' || tier === 'R1_RUNWAY') return false;\n60\t  return true;\n61\t}\n62\t\n63\texport function isProtectedEntityMesh(options = {}) {\n64\t  return options.isPlayer === true || options.forceRender === true || options.neverCull === true;\n65\t}\n66\t\n67\t/**\n68\t * A body the camera is already drawing stays on the glass while the\n69\t * frustum still contains it. A pending latch or a query miss would blank that\n70\t * picture, and the reveal is the in-view pop. The hold does not reveal a root\n71\t * that has not been shown, and it does not keep a root whose pose is missing.\n72\t * Off the frustum, the ordinary submit rule releases it.\n73\t */\n74\texport function retainShownCameraGlass(options = {}) {\n75\t  if (options.alreadyVisible !== true) return false;\n76\t  if (options.onFrustum !== true) return false;\n77\t  if (options.snapshotMissing === true) return false;\n78\t  if (options.alive === false) return false;\n79\t  return true;\n80\t}\n81\t\n82\texport function retainShownSurvivalGlass(options = {}) {\n83\t  return options.survival === true && retainShownCameraGlass(options);\n84\t}\n85\t\n86\texport function applyEntityMeshVisibility(mesh, submit) {\n87\t  if (!mesh) return false;\n88\t  const next = submit !== false;\n89\t  if (mesh.visible === next) return false;\n90\t  mesh.visible = next;\n91\t  return true;\n92\t}\n93\t"}]},"parent_tool_use_id":null,"session_id":"c020a9ae-f380-4499-9216-2daa8d6e2392","uuid":"5e31ca3f-fff5-42d1-91ae-f4e0ab65e705","timestamp":"2026-10-19T00:37:53.911Z","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\93rob\\Documents\\GitHub\\SpaceFace\\src\\render\\entityMeshVisibility.js","content":"// Submit-side visibility for presentation roots.\n//\n// The query retains a short approach runway for pose sync and preparation. Only\n// the live camera's glass (including visual envelopes and the frame skirt)\n// owns submission; the wider deterministic sim frame is a fallback for callers\n// without a live camera verdict.\n\nexport function isAuthoredPendingStatus(status) {\n  return status === 'loading'\n    || status === 'awaiting-authored-admission'\n    || status === 'compiling-pipelines';\n}\n\nexport function shouldSubmitEntityMesh(options = {}) {\n  // A missing fenced pose is a fail-closed condition for ordinary roots, but the player and\n  // renderer-forced roots retain their last safe mesh state until the next completed publication.\n  // Hiding one of those roots on a transient publication gap would turn a render-boundary miss\n  // into a gameplay-visible disappearance.\n  const protectedRoot = isProtectedEntityMesh(options);\n  if (options.snapshotMissing === true && !protectedRoot) return false;\n  if (protectedRoot) return true;\n  // First draw of an uncompiled material links the driver program inside bloomScene.\n  // Hold ordinary roots until compileObjectPipelines has actually linked them —\n  // once they have, a re-admission re-links variants behind the scenes and the\n  // already-linked root keeps drawing (bloom's per-material guard skips any\n  // still-unlinked drawable instead of the whole root disappearing).\n  if (options.pipelinesPending === true && options.sfAdmittedOnce !== true) return false;\n  // Nearby opening extras that are still decoding must not enter bloomScene.\n  // Their first authored draw is the 100 ms+ Intel compile brick. A resolving marker is exempt:\n  // it draws from the shared, already-linked Standard family and is the only drawable in the\n  // substrate, so submitting it costs nothing extra and keeps a pending contact on screen.\n  if (options.authoredPending === true && !protectedRoot && options.resolvingMarker !== true) return false;\n  // compile() does not upload vertex buffers. Hold ordinary rocks/props until the\n  // 1x1 residency pass has registered those geometries.\n  if (options.geometryPending === true && !protectedRoot) return false;\n  if (options.hidden === true) return false;\n  // The sim glass uses a conservative aspect and can lag camera zoom/glide. Letting its\n  // membership override a measured miss submits off-screen roots; letting a stale tier\n  // override a measured hit makes a ready body pop out until the next sim publication.\n  if (typeof options.onLiveGlass === 'boolean') return options.onLiveGlass;\n  const frame = options.activityFrame;\n  const entityId = options.entityId;\n  if (frame && entityId != null) {\n    const glass = frame.renderGlassIds || frame.glassIds;\n    const runway = frame.renderRunwayIds || frame.runwayIds;\n    const has = (collection) => collection && typeof collection.has === 'function'\n      ? collection.has(entityId)\n      : Array.isArray(collection) && collection.includes(entityId);\n    if (has(glass)) return true;\n    // Runway roots remain resident for approach-time warmup but are not submitted\n    // until the activity frame promotes them onto the readable glass.\n    if (has(runway)) return false;\n    // Ledger rows (far, field and dressing tables) are not combat-list members, so a complete\n    // frame never names them. isEntityRenderRelevant keeps their mesh under distance policy; hiding\n    // them here left accepted props resident on the GPU but never drawn. Their tier still decides.\n    if (frame.complete === true && options.ledgerRow !== true) return false;\n  }\n  const tier = options.presentationTier;\n  if (tier === 'R2_METADATA' || tier === 'R3_UNLOADED' || tier === 'R1_RUNWAY') return false;\n  return true;\n}\n\nexport function isProtectedEntityMesh(options = {}) {\n  return options.isPlayer === true || options.forceRender === true || options.neverCull === true;\n}\n\n/**\n * A body the camera is already drawing stays on the glass while the\n * frustum still contains it. A pending latch or a query miss would blank that\n * picture, and the reveal is the in-view pop. The hold does not reveal a root\n * that has not been shown, and it does not keep a root whose pose is missing.\n * Off the frustum, the ordinary submit rule releases it.\n */\nexport function retainShownCameraGlass(options = {}) {\n  if (options.alreadyVisible !== true) return false;\n  if (options.onFrustum !== true) return false;\n  if (options.snapshotMissing === true) return false;\n  if (options.alive === false) return false;\n  return true;\n}\n\nexport function retainShownSurvivalGlass(options = {}) {\n  return options.survival === true && retainShownCameraGlass(options);\n}\n\nexport function applyEntityMeshVisibility(mesh, submit) {\n  if (!mesh) return false;\n  const next = submit !== false;\n  if (mesh.visible === next) return false;\n  mesh.visible = next;\n  return true;\n}\n","numLines":93,"startLine":1,"totalLines":93}},"tool_result_meta":[{"id":"toolu_01Tu4pnvbH9mn52yCdXAcAuV","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
