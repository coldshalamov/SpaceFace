t      // that came back off-glass returns to the compile-before-show contract.\n157\t      while (!compileSettled && !entryUrgent(entry) && active()) await yieldToMain();\n158\t      if (!active()) return false;\n159\t      if (compileError) {\n160\t        if (entryUrgent(entry)) {\n161\t          // On the glass, the latch still clears at residency — the link error\n162\t          // is logged once; a throw would retry a visible root for nothing.\n163\t          reportCompileError(compileError);\n164\t        } else {\n165\t          throw compileError;\n166\t        }\n167\t      }\n168\t      onReady(entry.entity, entry.root);\n169\t      return true;\n170\t    } finally {\n171\t      finished = true;\n172\t    }\n173\t  };\n174\t\n175\t  // One deadline pass for the whole on-glass set. The pending latch covers\n176\t  // geometry residency — an un-uploaded buffer would pay its upload inside the\n177\t  // presented frame — so residency is what the deadline waits on. Program links\n178\t  // are driver-bound work that can take seconds: compiles still run (one\n179\t  // deadline admission per root, floated on the shared tail) but never gate the\n180\t  // latch. Per-root calls matter: a merged compile would detach every root into\n181\t  // a staging group and hold each pipelinesPending latch for the SLOWEST link\n182\t  // in the batch. With separate calls a root whose program is already linked\n183\t  // clears its mark in the same turn, and only a genuinely new program waits on\n184\t  // its own link — it must, since drawing an unlinked program blocks the\n185\t  // presented frame instead.\n186\t  const runUrgentBatch = async (collectBatch) => {\n187\t    const done = new Set();\n188\t    drainStage = 'batch-yield:1';\n189\t    await yieldToMain();\n190\t    // Sweep after the yield so roots that arrived during the wait ride the\n191\t    // same pass — otherwise every latecomer pays a full extra batch cycle.\n192\t    const batch = collectBatch();\n193\t    const live = batch.filter((entry) => entry.active());\n194\t    if (live.length === 0) return { entries: batch, ready: done };\n195\t    const startedAt = typeof performance !== 'undefined' && performance && typeof performance.now === 'function'\n196\t      ? performance.now()\n197\t      : Date.now();\n198\t    drainStage = `batch-compile:${live.length}`;\n199\t    // The compiles float: failures are reported per-root (Promise.all would\n200\t    // blame the first rejection on the whole burst), and residency below does\n201\t    // not wait on any link.\n202\t    for (const entry of live) {\n203\t      if (!entry.active()) continue;\n204\t      // The queue has already classified this entry as urgent. Preserve that\n205\t      // classification at the renderer boundary; dropping it here sends the\n206\t      // root through the explicit ambient lane and can leave an on-glass body\n207\t      // behind the whole compile cohort while its residency is already ready.\n208\t      void Promise.resolve().then(() => compile(entry.root, { urgent: true })).catch((error) => {\n209\t        try { onError(error, entry.entity); } catch (_) { /* log-only path */ }\n210\t      });\n211\t    }\n212\t    if (typeof prepareBatch === 'function') {\n213\t      // Merged residency, sliced ~8 roots a pass: a large on-glass burst no\n214\t      // longer pays one count-unbounded prepare inside a single task. Each\n215\t      // chunk's onReady still clears its own latch at its own residency.\n216\t      for (let i = 0; i < live.length; i += 8) {\n217\t        const chunk = live.slice(i, i + 8);\n218\t        drainStage = `batch-prepare:${Math.min(i + 8, live.length)}/${live.length}`;\n219\t        const result = await prepareBatch(\n220\t          chunk.map((entry) => entry.root),\n221\t          {\n222\t            isActive: () => live.some((entry) => entry.active()),\n223\t            unSliced: true,\n224\t          },\n225\t        );\n226\t        for (const entry of chunk) {\n227\t          if (!entry.active() || result?.skipped === true) continue;\n228\t          onReady(entry.entity, entry.root);\n229\t          entry.readied = true;\n230\t          done.add(entry);\n231\t        }\n232\t        if (i + 8 < live.length) await yieldToMain();\n233\t      }\n234\t    } else {\n235\t      for (const entry of live) {\n236\t        if (!entry.active()) continue;\n237\t        drainStage = `batch-prepare:${entry.entity && entry.entity.id}`;\n238\t        const result = await prepare(entry.root, { isActive: entry.active, unSliced: true });\n239\t        if (!entry.active() || result?.skipped === true) continue;\n240\t        onReady(entry.entity, entry.root);\n241\t        entry.readied = true;\n242\t        done.add(entry);\n243\t      }\n244\t    }\n245\t    const endedAt = typeof performance !== 'undefined' && performance && typeof performance.now === 'function'\n246\t      ? performance.now()\n247\t      : Date.now();\n248\t    lastBatchMs = endedAt - startedAt;\n249\t    return { entries: batch, ready: done };\n250\t  };\n251\t\n252\t  const settleBatch = (batch, done) => {\n253\t    for (const item of batch) {\n254\t      const ready = done.has(item);\n255\t      if (!ready) { admissions.delete(item.root); skippedCount++; }\n256\t      else admittedCount++;\n257\t      item.resolve(ready);\n258\t    }\n259\t  };\n260\t  const failBatch = (batch, error) => {\n261\t    for (const item of batch) {\n262\t      if (item.readied === true) {\n263\t        // Already admitted before the failure — resolve honestly and leave the\n264\t        // latch in place; the error belongs to a later sibling's work.\n265\t        item.resolve(true);\n266\t        continue;\n267\t      }\n268\t      // A failed admission must not stay deduped while it is still\n269\t      // pending — release it so the next frame can re-enqueue, up to\n270\t      // the retry budget; past that, keep the latch.\n271\t      const retries = (retryCounts.get(item.root) || 0) + 1;\n272\t      retryCounts.set(item.root, retries);\n273\t      if (retries < MAX_ADMISSION_RETRIES) {\n274\t        admissions.delete(item.root);\n275\t      } else {\n276\t        retryCooldownUntil.set(item.root, nowMsRetry() + RETRY_COOLDOWN_MS);\n277\t      }\n278\t      // Resolve BEFORE the reporting calls: a throwing isActive/onError must\n279\t      // never strand the rest of the batch un-resolved and still deduped.\n280\t      item.resolve(false);\n281\t      try {\n282\t        if (item.active()) onError(error, item.entity);\n283\t      } catch (_) { /* log-only path */ }\n284\t    }\n285\t  };\n286\t\n287\t  const drainUrgentLane = async () => {\n288\t    if (drainingUrgent) return;\n289\t    drainingUrgent = true;\n290\t    try {\n291\t      for (;;) {\n292\t        const first = pickNextWhere(entryUrgent);\n293\t        if (!first) break;\n294\t        // Every other pending urgent root rides the same deadline pass — the\n295\t        // sweep runs after the batch's yield inside runUrgentBatch so roots\n296\t        // that arrived during the wait are collected too.\n297\t        let batch = [first];\n298\t        const collectBatch = () => {\n299\t          for (let index = 0; index < pending.length;) {\n300\t            if (entryUrgent(pending[index])) {\n301\t              pendingSeq++;\n302\t              batch.push(pending.splice(index, 1)[0]);\n303\t            } else index++;\n304\t          }\n305\t          return batch;\n306\t        };\n307\t        try {\n308\t          urgentBatches++;\n309\t          const result = await runUrgentBatch(collectBatch);\n310\t          settleBatch(result.entries, result.ready);\n311\t        } catch (error) {\n312\t          failBatch(batch, error);\n313\t        }\n314\t      }\n315\t      if (!drainingAmbient) drainStage = 'idle';\n316\t    } finally {\n317\t      drainingUrgent = false;\n318\t      // An urgent root enqueued during the exit window (between the last pick\n319\t      // and this flag clearing) saw the lane busy and only queued — re-check\n320\t      // so it is not stranded until the next enqueue call.\n321\t      if (pending.some(entryUrgent)) void drainUrgentLane();\n322\t    }\n323\t  };\n324\t\n325\t  const drainAmbientLane = async () => {\n326\t    if (drainingAmbient) return;\n327\t    drainingAmbient = true;\n328\t    try {\n329\t      for (;;) {\n330\t        const entry = pickNextWhere(entryNotUrgent);\n331\t        if (!entry) break;\n332\t        try {\n333\t          const ready = await runEntry(entry);\n334\t          // A pause or opening admission hold may interrupt the drain; the next\n335\t          // live frame re-enqueues the still-pending root. Genuine upload errors\n336\t          // stay in the map: retrying a failed upload every frame is a loop, not\n337\t          // a recovery.\n338\t          if (!ready) { admissions.delete(entry.root); skippedCount++; }\n339\t          else admittedCount++;\n340\t          entry.resolve(ready);\n341\t        } catch (error) {\n342\t          const retries = (retryCounts.get(entry.root) || 0) + 1;\n343\t          retryCounts.set(entry.root, retries);\n344\t          if (retries < MAX_ADMISSION_RETRIES) {\n345\t            admissions.delete(entry.root);\n346\t          } else {\n347\t            retryCooldownUntil.set(entry.root, nowMsRetry() + RETRY_COOLDOWN_MS);\n348\t          }\n349\t          entry.resolve(false);\n350\t          try {\n351\t            if (entry.active()) onError(error, entry.entity);\n352\t          } catch (_) { /* log-only path */ }\n353\t        }\n354\t      }\n355\t      if (!drainingUrgent) drainStage = 'idle';\n356\t    } finally {\n357\t      drainingAmbient = false;\n358\t      if (pending.some(entryNotUrgent)) void drainAmbientLane();\n359\t    }\n360\t  };\n361\t\n362\t  const drain = () => {\n363\t    if (pending.length === 0) return;\n364\t    if (!drainingUrgent) void drainUrgentLane();\n365\t    if (!drainingAmbient) void drainAmbientLane();\n366\t  };\n367\