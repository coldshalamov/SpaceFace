{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XERpHXft7WHHtRnpiTx16M","type":"tool_result","content":"2995\t  // ship will be a box and then it'll be a ship\". The fallback's programs are already\n2996\t  // linked (it was the visible ship an instant ago) so drawing it submits no new work.\n2997\t  // The commit swaps the fallback out and the fail path already re-shows it.\n2998\t  let fallbackHasBody = false;\n2999\t  fallbackRoot.traverse((object) => { if (object && object.isMesh) fallbackHasBody = true; });\n3000\t  // requiredWholeShip is authored-or-nothing by contract: a procedural stand-in would publish\n3001\t  // a non-authored identity for a body the rung declared must be authored-only (fail closed).\n3002\t  const fallbackHidden = options.requiredWholeShip === true\n3003\t    || requiresProductionWholeShipForEntity(entity);\n3004\t  fallbackRoot.visible = fallbackHidden ? false : fallbackHasBody;\n3005\t  if (fallbackRoot.visible) boundary.userData.authoredPendingFallbackDrawn = true;\n3006\t  boundary.add(fallbackRoot);\n3007\t  // A substrate carrying a resolving marker keeps exactly one drawable while admission is\n3008\t  // pending — the marker is abstract by design, so this never publishes a substitute identity.\n3009\t  // The per-frame visibility pass hides the marker again the moment the state is terminal.\n3010\t  if (fallbackRoot.userData && fallbackRoot.userData.authoredResolvingMarker === true) {\n3011\t    fallbackRoot.visible = true;\n3012\t  }\n3013\t  // The sim-side lock gate cannot see the scene; publish whether this hull carries a real\n3014\t  // procedural body under the boundary. A resolving marker is explicitly not one — this is the\n3015\t  // pending-window stamp only. syncResolvingMarker republishes it from the drawn truth once the\n3016\t  // verdict is terminal: the ship's own stand-in hull counts as a real body, a mission-critical\n3017\t  // required hull may still publish its procedural body, and a bare octahedron stays empty air.\n3018\t  // A non-required hull's fallback stays drawn through failure, so its settled 'unavailable'\n3019\t  // verdict leaves a visible ship that must stay lockable.\n3020\t  entity.presentationFallbackVisible = fallbackRoot.visible === true\n3021\t    && !(fallbackRoot.userData && fallbackRoot.userData.authoredResolvingMarker === true);\n3022\t\n3023\t  // Preserve the public inspection surface used by diagnostics/checks while making lifecycle hooks\n3024\t  // indirect through `active`, so the renderer never needs to know that a payload was replaced.\n3025\t  Object.assign(boundary.userData, fallbackRoot.userData || {});\n3026\t  // Per-root shadow bookkeeping is scoped to the subtree it was minted on —\n3027\t  // copying it onto the boundary would let the wrong root answer the checked\n3028\t  // sync's dirty/stamp/park reads and double-count the tally notes seam.\n3029\t  delete boundary.userData.__spacefaceShadowCasterPolicyV1;\n3030\t  delete boundary.userData.__spacefaceDepthStageSelfDirty;\n3031\t  delete boundary.userData.sfDepthUndrawableCycles;\n3032\t  delete boundary.userData.shadowMeshNotes;\n3033\t  boundary.userData.kind = 'ship';\n3034\t  boundary.userData.authoredAssetState = 'awaiting-authored-admission';\n3035\t  boundary.userData.authoredAssetMode = releaseMode ? 'release' : 'dev';\n3036\t  boundary.userData.authoredAssetContractVersion = PART_LIBRARY_CONTRACT.version;\n3037\t  boundary.userData.authoredSlots = {};\n3038\t  boundary.userData.authoredReadableFallbackRetained = false;\n3039\t  boundary.userData.authoredVisualRoot = 'none-pending-admission';\n3040\t  boundary.userData.renderContract = {\n3041\t    ...((fallbackRoot.userData && fallbackRoot.userData.renderContract) || {}),\n3042\t    assetBoundary: 'GLTFKit v2 — resolve, prepare, admit',\n3043\t    gracefulFallback: false,\n3044\t  };"}]},"parent_tool_use_id":null,"session_id":"c020a9ae-f380-4499-9216-2daa8d6e2392","uuid":"90121688-554b-4b41-9