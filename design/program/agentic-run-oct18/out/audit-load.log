{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01NfLtLBJvDTVjc1bs4ebmck","type":"tool_result","content":"8940\t * Other traffic and hostile ships remain quality-preserving on-demand upgrades and cannot hold the\n8941\t * player behind a global queue drain. */\n8942\texport function authoredCriticalVisualReadiness(state) {\n8943\t  const entities = state && state.entities;\n8944\t  const player = entities && typeof entities.get === 'function'\n8945\t    ? entities.get(state.playerId)\n8946\t    : (state && state.entityList || []).find((entity) => entity && entity.id === state.playerId);\n8947\t  const playerStatus = authoredAssetState(player);\n8948\t  const currentSectorId = state && state.world && state.world.currentSectorId;\n8949\t  const isStartingSector = currentSectorId === 'sector_helios_prime';\n8950\t  const entityList = state && state.entityList || (entities && typeof entities.values === 'function'\n8951\t    ? [...entities.values()]\n8952\t    : []);\n8953\t  const hub = isStartingSector ? entityList.find(isCriticalStartingHub) : null;\n8954\t  const needsStartingHub = !!(hub && isOpeningFlightGateEntity(hub, state));\n8955\t  const hubStatus = hub ? authoredAssetState(hub) : 'not-present';\n8956\t  const openingAssets = entityList\n8957\t    .filter((entity) => isInitialAuthoredCompositionEntity(entity, state))\n8958\t    .map((entity) => {\n8959\t      const root = entity && entity.mesh;\n8960\t      const data = entity && entity.data || {};\n8961\t      return {\n8962\t        id: entity.id,\n8963\t        type: entity.type,\n8964\t        defId: data.defId || data.actorId || data.assetRef || null,\n8965\t        status: authoredAssetState(entity),\n8966\t        hook: typeof (root && root.userData && root.userData.requestAuthoredUpgrade) === 'function',\n8967\t        promised: !!(root && root.userData && root.userData.authoredUpgradePromise),\n8968\t      };\n8969\t    });\n8970\t  const openingPending = openingAssets.filter((entry) => (\n8971\t    !isFlightReadyStatus(entry.status)\n8972\t    && !authoredOpeningFailedClosed(entry.status)\n8973\t  ));\n8974\t  const openingPipelinePending = openingAssets.filter((entry) => (\n8975\t    !authoredPipelineStaged(entry.status) && !authoredOpeningFailedClosed(entry.status)\n8976\t  ));\n8977\t  const gateIds = new Set(\n8978\t    entityList.filter((entity) => isOpeningFlightGateEntity(entity, state)).map((entity) => entity.id),\n8979\t  );\n8980\t  const openingGatePending = openingPending.filter((entry) => gateIds.has(entry.id));\n8981\t  const openingGatePipelinePending = openingPipelinePending.filter((entry) => gateIds.has(entry.id));\n8982\t  // Startup admission is an explicit set, not an inference from every object inside the opening\n8983\t  // radius. This keeps nearby traffic and far place detail streamable while retaining the player\n8984\t  // flight package and the gameplay shell needed for control/docking. A caller may opt an entity\n8985\t  // into the set with flightReadyRole when it truly owns a first-frame contract (for example a\n8986\t  // glass actor or a collision shell); ordinary opening-composition entities remain diagnostics.\n8987\t  const readySet = createFlightReadySet();\n8988\t  const blockingPipeline = [];\n8989\t  const requireRole = (role, status, entity = null) => {\n8990\t    if (!readySet.requireRole(role, status, entity && { id: entity.id, type: entity.type })) return;\n8991\t    blockingPipeline.push({ kind: 'role', role, status, pipeline: authoredPipelineStaged(status) });\n8992\t  };\n8993\t  requireRole(FLIGHT_READY_ROLE.PLAYER_GAMEPLAY, playerStatus, player);\n8994\t  requireRole(FLIGHT_READY_ROLE.PLAYER_FLIGHT_PACKAGE, playerStatus, player);\n8995\t\n8996\t  let startingHubLayer = null;\n8997\t  if (needsStartingHub) {\n8998\t    startingHubLayer = selectPlacePackageLayer({ onRunway: true, interactable: true })\n8999\t      || PLACE_PACKAGE_LAYER.GAMEPLAY_SHELL;\n9000\t    if (isPlaceLayerBlockingFlightReady(startingHubLayer)) {\n9001\t      readySet.requirePlace(\n9002\t        hub.id,\n9003\t        startingHubLayer,\n9004\t        hubStatus,\n9005\t        { type: hub.type, role: FLIGHT_READY_ROLE.TABLE_STATION_SHELL },\n9006\t      );\n9007\t      blockingPipeline.push({\n9008\t        kind: 'place',\n9009\t        id: hub.id,\n9010\t        layer: startingHubLayer,\n9011\t        status: hubStatus,\n9012\t        pipeline: authoredPipelineStaged(hubStatus),\n9013\t      });\n9014\t    }\n9015\t  }\n9016\t\n9017\t  for (const entity of entityList) {\n9018\t    const data = entity && entity.data || {};\n9019\t    // Runtime glass membership is an opening-frame contract only: it gates until the first\n9020\t    // playable picture paints, so every hull visible at the reveal is authored. After the latch,\n9021\t    // inbound traffic that drifts onto the glass is ordinary on-demand streaming (fallback hull\n9022\t    // until its authored body commits) and must not keep `ready` false for the rest of the\n9023\t    // session — otherwise a ship arriving a minute into flight re-blocks a startup verdict the\n9024\t    // route and the first-picture submission both read as point-in-time.\n9025\t    const allowRuntimeActivityGate = state && state.mode !== 'loading'\n9026\t      && !Number.isFinite(state.render && state.render.firstPlayableFrameAt);\n9027\t    const frameGlassIds = state && state.render && state.render.activityFrame\n9028\t      && state.render.activityFrame.renderGlassIds;\n9029\t    const isCurrentGlass = allowRuntimeActivityGate && (\n9030\t      frameGlassIds && typeof frameGlassIds.has === 'function'\n9031\t        ? frameGlassIds.has(entity.id)\n9032\t        : Array.isArray(frameGlassIds) && frameGlassIds.includes(entity.id)\n9033\t    );\n9034\t    // The glass auto-role only binds entities that can ever be authored. A\n9035\t    // procedural-native body on the glass — an instanced asteroid is the\n9036\t    // canonical case — has no authored variant to wait for, so requiring it\n9037\t    // makes ready permanently unreachable near any rock. Explicit\n9038\t    // flightReadyRole pins still apply regardless of pipeline eligibility.\n9039\t    const autoGlassRole = entityRequiresAuthoredPresentation(entity)\n9040\t      ? FLIGHT_READY_ROLE.GLASS_ACTORS\n9041\t      : null;\n9042\t    const role = entity && (entity.flightReadyRole || data.flightReadyRole\n9043\t      || data.renderFlightReadyRole || data.render && data.render.flightReadyRole\n9044\t      || (state && state.mode === 'loading'\n9045\t          && (entity.type === 'wreck' || entity.type === 'drone'\n9046\t            // A generic payload the packaged-prop lane can mount (packagedPropSpec is the\n9047\t            // mount hook's own predicate — attachPackagedScenarioProp no-ops without it)\n9048\t            // settles through the same authoredPackageUrl admission the wreck/drone pins\n9049\t            // ride; an on-runway tow body (survivor pod at +6/-4) holds the veil for its\n9050\t            // warm commit instead of swapping a beat after it lifts. Explicit-authored\n9051\t            // payloads already pin via entityRequiresAuthoredPresentation above.\n9052\t            // startupPayloadOwnsVeilPin is the composition's own predicate — pinning a\n9053\t            // payload the composition cannot schedule (the on-table 47-A spindle, whose\n9054\t            // admission is the post-gate first-flight cook) deadlocks this gate.\n9055\t            || startupPayloadOwnsVeilPin(entity, state))\n9056\t          && entity.alive !== false\n9057\t          && !authoredOpeningFailedClosed(authoredAssetState(entity))\n9058\t          && startupAuthoredContactOnRunway(entity, state)\n9059\t          ? FLIGHT_READY_ROLE.GLASS_ACTORS : null)\n9060\t      || ((isCurrentGlass || (allowRuntimeActivityGate\n9061\t        && entity.activity?.presentationTier === PRESENTATION_TIER.R0_GLASS))\n9062\t        ? autoGlassRole : null));\n9063\t    if (!role || role === FLIGHT_READY_ROLE.PLAYER_GAMEPLAY\n9064\t        || role === FLIGHT_READY_ROLE.PLAYER_FLIGHT_PACKAGE) continue;\n9065\t    const status = authoredAssetState(entity);\n9066\t    if (readySet.requireRole(role, status, { id: entity.id, type: entity.type })) {\n9067\t      blockingPipeline.push({ kind: 'role', role, status, pipeline: authoredPipelineStaged(status) });\n9068\t    }\n9069\t  }\n9070\t  readySet.seal();\n9071\t  const flightReadyBlockers = readySet.blockers();\n9072\t  const softwareRenderer = !!(state && state.render && state.render.gpu\n9073\t    && state.render.gpu.tier === 'software');\n9074\t  const pipelineReady = blockingPipeline.every((entry) => entry.pipeline);\n9075\t  return {\n9076\t    pipelineReady,\n9077\t    ready: readySet.isReady(),\n9078\t    playerId: player && player.id,\n9079\t    playerStatus,\n9080\t    startingHubId: hub && hub.id,\n9081\t    startingHubStatus: hubStatus,\n9082\t    startingHubRequired: needsStartingHub,\n9083\t    startingHubLayer,\n9084\t    flightReady: readySet.snapshot(),\n9085\t    flightReadyBlockers,\n9086\t    openingAssets,\n9087\t    openingPending,\n9088\t    openingPipelinePending,\n9089\t    openingGatePending,\n9090\t    openingGatePipelinePending,\n9091\t    // Compatibility diagnostic. The production gate is the explicit FlightReadySet above rather\n9092\t    // than the old boolean that widened to the entire opening composition on hardware.\n9093\t    openingGateApplies: false,\n9094\t    softwareRenderer,\n9095\t  };\n9096\t}\n9097\t\n9098\tfunction authoredPipelineStaged(status) {\n9099\t  return status === 'compiling-pipelines'"}]},"parent_tool_use_id":null,"session_id":"c020a9ae-f380-4499-9216-2daa8d6e2392","uuid":"ee3f24b8-c390-4641-b45f-9e96e1c82475","timestamp":"2026-10-19T00:41:30.546Z","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\93rob\\Documents\\GitHub\\SpaceFace\\src\\render\\partsLibrary.js","content":" * Other traffic and hostile ships remain quali