\n1622:   runtime.runwayHalfZ = submit.halfZ;\n1623:   runtime.prefetchRadiusWu = prefetchR;\n1624: \n1625:   // The incremental visit set must be able to rediscover anything whose footprint could\n1626:   // matter to this pass: inside physics reach (plus the near exit pad), inside the\n1627:   // residency prefetch disc, or inside the submit-cull corner. The widest of those is the\n1628:   // discovery radius; entityPresenceRadius then keeps big-hulled bodies (a station's dock\n1629:   // envelope) discoverable while their centre is still outside it.\n1630:   const discoverWu = Math.max(\n1631:     reach + NEAR_EXIT_PAD_WU,\n1632:     prefetchR,\n1633:     Math.hypot(submit.halfX, submit.halfZ),\n1634:   );\n1635: \n1636:   const selection = selectClassifyEntities(state, runtime, list, origin, reach, discoverWu);\n1637:   runtime.classifyMode = selection.mode;\n1638:   runtime.classifyVisits = 0;\n1639: \n1640:   const statics = runtime.physicsStatics;\n1641:   const dynamics = runtime.physicsDynamics;\n1642:   const counts = runtime.counts;\n1643:   const visit = selection.entities;\n1644:   // Hoist parked-frame retain eligibility once; rocks then only pay a pose-key map hit.\n1645:   const rockRetainFrame = rockVisitRetainGlobalsMatch(\n1646:     runtime, origin, glass, submit, prefetchR, facts, player,\n1647:   );\n1648:   const rockRetain = rockRetainFrame ? runtime._rockVisitRetain : null;\n1649:   // Full-frame retain AFTER #127: when every visit entity is stamp+pose stable, keep\n1650:   // last tick's id lists / partitions / counts and skip clear+visit republish.\n1651:   let frameRetained = false;\n1652:   if (rockRetainFrame && tryRetainClassifyFrame(runtime, visit, simTime, state)) {\n1653:     frameRetained = true;\n1654:     const pvx = finite(player && player.vel && player.vel.x);\n1655:     const pvz = finite(player && player.vel && player.vel.z);\n1656:     if ((pvx * pvx + pvz * pvz) <= 0.25) {\n1657:       armRockVisitRetain(runtime, origin, gla