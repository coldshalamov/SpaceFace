T in the sf-sim curated harness list,\n103: // so the 47-A golden never executes them. New runtime state lives under state.massline2.\n104: import { masslineThrow } from '../systems/masslineThrow.js';          // §3.3 throw/release assist + §4.1 self-sling\n105: import { bulletTime } from '../systems/bulletTime.js';                // §3.6 held time dilation via core/timeEffects\n106: import { tumbleStates } from '../systems/tumbleStates.js';            // §3.4 uncontrolled-spin states on whipped NPCs\n107: import { collisionConsequences } from '../systems/collisionConsequences.js'; // PQ-009: bounded contact momentum -> control/combat receipts\n108: import { masslineImpactDamage } from '../systems/masslineImpactDamage.js'; // §3.5 whip-recoil + tumble contact damage\n109: import { cloak } from '../systems/cloak.js';                          // §4.2 cloak module runtime + detection ring\n110: import { lootShards } from '../systems/lootShards.js';                // §4.3 kill shards over the shipped loot:drop seam\n111: import { terrainAnchors } from '../systems/terrainAnchors.js';        // §4.4 big-and-few rocks per encounter bubble\n112: import { jettisonImpulse } from '../systems/jettisonImpulse.js';      // §5.3 cargo dump reaction impulse\n113: import { volatileExposure } from '../systems/volatileExposure.js';    // NXB-008: exposure-driven volatile load state (shock/heat facts, vent/rupture)\n114: import { masslineHud } from '../ui/masslineHud.js';                   // M2 surfacing: release indicator + cloak ring + meters (DOM-guarded)\n115: import { mining } from '../systems/mining.js';\n116: import { fieldDepletion } from '../systems/fieldDepletion.js';\n117: import { cargo } from '../systems/cargo.js';\n118: import { fragileCargo } from '../systems/fragileCargo.js';\n119: import { economy, economyReadView } from '../systems/economy.js';\n120: import { automation } from '../systems/automation.js';\n121: import {\n122:   asteroidSites,\n123:   canInstallAsteroi