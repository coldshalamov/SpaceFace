   presentationDrainClaimed = true;\n529:   }\n530: \n531:   function drainPresentationTail(budget = PRESENTATION_LISTENER_DRAIN_BUDGET, maxMs = Infinity) {\n532:     const base = Math.max(1, Math.floor(Number(budget) || PRESENTATION_LISTENER_DRAIN_BUDGET));\n533:     // Depth-scaled floor: a fixed 8/frame budget makes a kill clump or sector re-entry lag\n534:     // linearly (~200ms at ~100 pending). Scaling with queued invocations caps per-emit lag at\n535:     // ~4 frames while still spending only what the caller's frame-ms gate allows.\n536:     const limit = Math.max(base, Math.ceil(pendingPresentationCount() / 4));\n537:     // Wall-clock bound alongside the count: a backlog scales the count limit into hundreds of\n538:     // listener invocations on one monotask, which is exactly the frame it must not run in.\n539:     // Checked after each listener so at least one always drains (order unchanged either way);\n540:     // undrained slices stay queued for the next frame's drain.\n541:     const deadline = Number.isFinite(maxMs) && maxMs > 0\n542:       ? performance.now() + maxMs\n543:       : Infinity;\n544:     const drainStart = performance.now();\n545:     let ran = 0;\n546:     // Bounded interleave: strict priority let a sustained destroyed burst starve the\n547:     // cosmetic lane for the burst's whole duration. After PRIORITY_INTERLEAVE consecutive\n548:     // priority invocations the cosmetic head drains once (per-lane FIFO kept, priority\n549:     // stays the major share), bounding cosmetic latency at K invocations while the burst\n550:     // still drains ~8x faster than cosmetics.\n551:     let priorityRun = 0;\n552:     while (ran < limit) {\n553:       const takePriority = presentationPriorityQueue.length > 0\n554:         && (priorityRun < PRESENTATION_PRIORITY_INTERLEAVE || presentationQueue.length === 0);\n555:       const queue = takePriority ? presentationPriorityQueue\n556:         : presentationQueue.length ? presentationQueue\n557:         : null;\n558:       if (!queue) break;\n559:       if (queue === presentationPriorityQueue) priorityRun += 1;\n560:       else priorityRun = 0;\n561:       const head = queue[0];\n562:       const fn = head.fns[head.index];\n563:       head.index += 1;\n564:       ran += 1;\n565:       invokeBusListener(fn, head.payload, head.event, 'presentation handler error');\n566:       if (head.index >= head.fns.length) recyclePresentationSlice(queue.shift());\n567:       if (performance.now() >= deadline || pacedFrameSpend() >= PACED_FRAME_BUDGET_MS) break;\n568:     }\n569:     if (ran > 0) notePacedFrameSpend(performance.now() - drainStart);\n570:     return ran;\n571:   }\n572: \n573:   function pendingPresentationCount() {\n574:     let n = 0;\n575:     for (const slice of presentationPriorityQueue) n += slice.fns.length - slice.index;\n576:     for (const slice of presentationQueue) n += slice.fns.length - slice.index;\n577:     return n;\n578:   }\n579: \n580:   /** Defer an event to the next flush() (end of sim step). */\n581:   function queue(event, payload) {\n582:     const item = deferredPool.pop() || { event: null, payload: null };\n583:     item.event = event;\n584:     item.payload = payload;\n585:     deferred.push(item);\n586:   }\n587: \n588:   function flush() {\n589:     if (!deferred.length) return;\n590:     const batch = deferred;\n591:     deferred = [];\n592:     const batchGeneration = generation;\n593:     for (let i = 0; i < batch.length; i++) {\n594:       const item = batch[i];\n595:       if (generation !== batchGeneration) {\n596:         // clear() ran while this batch was on the stack: everything still in it predates the\n597:         // teardown and must not reach listeners (re)bound on the new bus. Recycle the slot;\n598:         // events queued after clear() live in the new deferred array and flush normally.\n599:         item.event = null;\n600:         item.payload = null;\n601:         deferredPool.push(item);\n602:         contin