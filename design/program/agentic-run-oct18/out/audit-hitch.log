  pacedFrameSpend,\n  PACED_FRAME_BUDGET_MS,\n} from '../render/decodeTaskBudget.js';\n\nexport const SECTOR_ENTER_LISTENER_BUDGET = 32;\nexport const SECTOR_ENTER_DRAIN_BUDGET = 4;\n// Presentation-tier listeners (bus.on(event, fn, { presentation: true })): burst events like\n// entity:killed / entity:destroyed fan out to ~dozen presentation-pure tails that used to run\n// inside the emit — mid-tick for synchronous events, inside the flush task for queued ones.\n// Once a presentation runner claims the drain, those tails enqueue and run a bounded number","truncated":false,"loaded":[],"display":{"type":"file","path":"C:\\Users\\93rob\\Documents\\GitHub\\SpaceFace\\src\\core\\eventBus.js","text":"// Synchronous event bus with a deferred queue (ARCHITECTURE §4). Most events fire\n// synchronously; entity spawn/destroy are queued and flushed at the end of a sim step\n// so the entity set is never mutated mid-iteration.\n//\n// `sector:enter` may be count-sliced: the first budget of listeners still runs inside\n// enterSector, leftover presentation listeners drain after present. Default budget 0\n// keeps every emit fully synchronous (tests, boot, Continue).\n\nimport {\n  notePacedFrameSpend,\n  pacedFrameSpend,\n  PACED_FRAME_BUDGET_MS,\n} from '../render/decodeTaskBudget.js';\n\nexport const SECTOR_ENTER_LISTENER_BUDGET = 32;\nexport const SECTOR_ENTER_DRAIN_BUDGET = 4;\n// Presentation-tier listeners (bus.on(event, fn, { presentation: true })): burst events like\n// entity:killed / entity:destroyed fan out to ~dozen presentation-pure tails that used to run\n// inside the emit — mid-tick for synchronous events, inside the flush task for queued ones.\n// Once a presentation runner claims the drain, those tails enqueue and run a bounded number\n// per frame; the sim tail still executes in-tick exactly as before. Without a claim (headless\n// sims, tests) presentation listeners dispatch inline at emit — identical to a plain listener.\nexport const PRESENTATION_LISTENER_DRAIN_BUDGET = 8;\n// Sliced emits that stack up behind a drain that couldn't finish inside its wall-clock cap\n// queue here rather than being lost. The queue is bounded — past the cap the oldest entry is\n// delivered fully inline at push. That preserves the one contract the queue exists to keep\n// (no listener is ever skipped); it does not promise that delivery stays sliced.\nexport const MAX_QUEUED_SLICED_EMITS = 8;\n\n// A persistently-throwing listener on a hot event used to pay a full Error +\n// stack serialization per emit — emit-rate volume for the rest of the session.\n// Per-event storm dedup (the laneWarn shape): the first few faults log verbatim,\n// the storm folds into a suppressed count re-summarized on a >=1 s heartbeat.\n//\n// Rows hang off the listener itself (WeakMap → [{ label, event, ... }]) — a\n// re-registered listener folds into the same row because its fn identity never\n// changes, and the per-fault path is one map hop + a === scan instead of the\n// old `${label}|${event}|${token}` composite string mint per throw. Non-function\n// listeners (none today — defensive) hold a parallel keyed Map so WeakMap key\n// typing never breaks the fault path. The bounded index owns retained rows;\n// eviction removes the listener lookup too, so a later fault is indexed anew.\nconst BUS_ERROR_VERBATIM = 8;\nconst BUS_ERROR_CAP = 256;\nconst BUS_ERROR_INDEX_CAP = 512;\nconst busErrorRows = new WeakMap(); // fn -> [{ label, event, logged, suppressed, faults, lastWarnAt, lastErrorHead }]\nconst busErrorRowsByKey = new Map(); // non-function listener key -> same rows\nconst busErrorIndex = new Set(); // every minted row, insertion-ordered, oldest-evict at cap\n\nfunction rowsForBusListener(listener) {\n  if (typeof listener === 'function') {\n    let rows = busErrorRows.get(listener);\n    if (!rows) { rows = []; busErrorRows.set(listener, rows); }\n    return rows;\n  }\n  const key = listener === undefined ? '?' : listener;\n  let rows = busErrorRowsByKey.get(key);\n  if (!rows) {\n    if (busErrorRowsByKey.size >= BUS_ERROR_CAP) {\n      // Oldest-row evict, not clear(): a cap-hit wipe re-arms every storming\n      // key's verbatim budget simultaneously and erases accrued suppressed\n      // counts before their heartbeat can report them. The evicted key's rows\n      // leave the index too — keeping them would double-count the re-minted\n      // logical row once that listener faults again.\n      const oldest = busErrorRowsByKey.keys().next();\n      if (!oldest.done) {\n        const evicted = busErrorRowsByKey.get(oldest.value);\n        busErrorRowsByKey.delete(oldest.value);\n        if (evicted) for (const row of evicted) busErrorIndex.delete(row);\n      }\n    }\n    rows = [];\n    busErrorRowsByKey.set(key, rows);\n  }\n  return rows;\n}\n\n// Fault history may suppress logs, never delivery: the next payload can be valid,\n// and gameplay must not depend on a wall-clock cooldown or another bus's faults.\nfunction invokeBusListener(fn, payload, event, label) {\n  try { fn(payload, event); }\n  catch (err) {\n    try { noteBusHandlerError(event, err, label, fn); }\n    catch (_) { /* Diagnostics, including the logger, must never interrupt delivery. */ }\n  }\n}\n\nfunction busErrorHead(error) {\n  try {\n    const message = error?.message;\n    return (typeof message === 'string' ? message : String(error)).slice(0, 160);\n  } catch (_) {\n    return '(unprintable thrown value)';\n  }\n}\n\nfunction noteBusHandlerError(event, err, label, listener) {\n  const now = (typeof performance !== 'undefined' && typeof performance.now === 'function')\n    ? performance.now() : Date.now();\n  // Per-listener row: an event-level row let one storming handler consume the\n  // verbatim budget for every faulting listener on that event — the second\n  // distinct fault's identity never appeared verbatim.\n  const rows = rowsForBusListener(listener);\n  let entry = null;\n  for (let i = 0; i < rows.length; i++) {\n    const row = rows[i];\n    if (row.label === label && row.event === event) { entry = row; break; }\n  }\n  if (!entry) {\n    if (busErrorIndex.size >= BUS_ERROR_INDEX_CAP) {\n      const oldest = busErrorIndex.values().next();\n      if (!oldest.done) {\n        const retired = oldest.value;\n        busErrorIndex.delete(retired);\n        retired.rows.splice(retired.rows.indexOf(retired), 1);\n      }\n    }\n    entry = { rows, label, event, logged: 0, suppressed: 0, faults: 0, lastWarnAt: -Infinity, lastErrorHead: null, heartbeatMs: 1000 };\n    rows.push(entry);\n    busErrorIndex.add(entry);\n  }\n  entry.faults += 1;\n  entry.lastErrorHead = busErrorHead(err);\n  // Refresh recency: Set.add alone does not reorder, so without the delete a\n  // row that keeps storming drifts to the oldest end of the index and gets\n  // evicted mid-storm — invisible to busFaultSummary, and the splice that\n  // follows would re-arm its verbatim budget.\n  busErrorIndex.delete(entry);\n  busErrorIndex.add(entry);\n  if (entry.logged < BUS_ERROR_VERBATIM) {\n    entry.logged += 1;\n    console.error(`[bus] ${label} for \"${event}\":`, err);\n    return;\n  }\n  entry.suppressed += 1;\n  // Exponentially-backing-off heartbeat (1 s doubling to a 30 s cap — the\n  // same shape as warnDedup/tryPresentedCall): a persistently-faulting\n  // listener's storm still reports its volume without paying a flat ~1\n  // console.error+stack-serialize per second for the whole storm.\n  // Heal proxy: a >60 s quiet gap re-arms the short cadence so a fresh\n  // storm doesn't inherit the previous one's backed-off interval.\n  if (now - entry.lastWarnAt >= 60000) entry.heartbeatMs = 1000;\n  if (now - entry.lastWarnAt >= entry.heartbeatMs) {\n    entry.lastWarnAt = now;\n    entry.heartbeatMs = Math.min(entry.heartbeatMs * 2, 30000);\n    console.error(\n      `[bus] ${label} for \"${event}\": ${entry.suppressed} further fault(s) suppressed; latest:`,\n      err,\n    );\n    entry.suppressed = 0;\n  }\n}\n\n// Name the hot throwing listeners — the dominant per-fault cost (Error+stack\n// inside the thrower) is only fixable once forensics can see WHO storms. Top-N\n// by total faults, read by render diagnostics next to laneFaults.\nexport function busFaultSummary(limit = 8) {\n  const rows = [];\n  for (const entry of busErrorIndex) {\n    if (entry.faults > 0) {\n      rows.push({\n        label: entry.label,\n        event: entry.event,\n        faults: entry.faults,\n        suppressed: entry.suppressed,\n        lastErrorHead: entry.lastErrorHead,\n        lastWarnAt: entry.lastWarnAt,\n      });\n    }\n  }\n  rows.sort((a, b) => b.faults - a.faults);\n  return rows.slice(0, Math.max(0, limit | 0));\n}\n\nfunction dispatchRange(fns, payload, event, start, end) {\n  const last = Math.min(fns.length, end);\n  let i = start;\n  for (; i < last; i++) {\n    invokeBusListener(fns[i], payload, event, 'handler error');\n  }\n  return i;\n}\n\nexport function createBus() {\n  const listeners = new Map(); // event -> Set<fn>\n  const listenerSnapshots = new Map(); // event -> { dirty, fns }\n  const presentationSets = new Map(); // event -> Set<fn> (presentation-tier listeners)\n  const presentationSnaps = new Map();\n  const presentationQueue = []; // [{ event, payload, fns, index }] — drained per frame\n  // Lifecycle-class events drain ahead of cosmetic slices: entity:destroyed carries the\n  // corpse-mesh unbind (plus tag/doctrine/residency cleanup) — a starved frame that\n  // dropped its slice would leave a dead hull on the glass until the residency poll\n  // self-healed. Whole-event promotion keeps in-event FIFO; only cross-event order moves.\n  const PRESENTATION_PRIORITY_EVENTS = new Set(['entity:destroyed']);\n  const presentationPriorityQueue = [];\n  // Once-only cosmetic events (spawn tails carry materializeT0/spiralDone stamps whose loss\n  // is a permanent pop-in) get their own overflow floor above the generic cosmetic one — a\n  // sustained destroyed burst sheds lifecycle slices long before it can evict the last\n  // once-only stamps. Tracked as a count so the trim scan stays O(1) on the common path.\n  const PRESENTATION_ONCE_ONLY_EVENTS = new Set(['entity:spawned']);\n  const PRESENTATION_PRIORITY_INTERLEAVE = 8;\n  let presentationOnceOnlyCount = 0;\n  const presentationSlicePool = [];\n  // Pooled-payload events (physics:impact, combat:damage refill one record per emit) register\n  // an emit-time snapshotter: a queued presentation tail must read the fields a synchronous\n  // listener saw — not the values the next emit refilled before the frame drain ran.\n  const payloadSnapshots = new Map(); // event -> payload => clonedPayload\n  let presentationDrainClaimed = false;\n  let deferred = [];\n  const deferredPool = [];\n  const sliceBudgets = new Map();\n  let emitSlice = null;\n  // Sliced emits that arrived while a predecessor tail still lived past its\n  // wall-clock cap — started in order when that tail finishes.\n  const pendingSlicedEmits = [];\n  // The frame-loop owner suspends slicing while no presented frame exists to\n  // protect (loading, hidden, suspended): slicing's only purpose is to bound a\n  // task inside a frame, so while suspended emits deliver inline and anything\n  // already parked flushes at the transition.\n  let emitSliceSuspended = false;\n  // Bumped by clear(): a flush mid-stack that captured its batch pre-teardown must not deliver\n  // the rest of it into listeners bound on the new bus.\n  let generation = 0;\n\n  function invalidateSnapshot(snaps, event) {\n    const snap = snaps.get(event);\n    if (snap) snap.dirty = true;\n  }\n\n  function on(event, fn, opts = null) {\n    const presentation = !!(opts && opts.presentation === true);\n    const table = presentation ? presentationSets : listeners;\n    const snaps = presentation ? presentationSnaps : listenerSnapshots;\n    let set = table.get(event);\n    if (!set) { set = new Set(); table.set(event, set); }\n    set.add(fn);\n    invalidateSnapshot(snaps, event);\n    return () => off(event, fn);\n  }\n\n  function off(event, fn) {\n    for (const [table, snaps] of [[listeners, listenerSnapshots], [presentationSets, presentationSnaps]]) {\n      const set = table.get(event);\n      if (!set) continue;\n      if (set.delete(fn)) invalidateSnapshot(snaps, event);\n      if (set.size === 0) table.delete(event);\n    }\n  }\n\n  function once(event, fn) {\n    // The fired guard must be set BEFORE unsubscribing: an earlier listener that recursively\n    // re-emits snapshots this wrapper while it is still subscribed, and the outer dispatch's\n    // captured copy must find it already spent. Snapshot semantics are preserved — the wrapper\n    // may still be invoked by an in-flight array, it just no-ops.\n    let fired = false;\n    const unsub = on(event, (p, e) => {\n      if (fired) return;\n      fired = true;\n      unsub();\n      fn(p, e);\n    });\n    return unsub;\n  }\n\n  function snapshotListeners(table, snaps, event) {\n    const set = table.get(event);\n    if (!set || set.size === 0) return null;\n    let snap = snaps.get(event);\n    if (!snap) {\n      snap = { dirty: true, fns: null };\n      snaps.set(event, snap);\n    }\n    if (snap.dirty) {\n      // Publish a NEW array instead of mutating snap.fns in place: an emit already iterating the\n      // old array (re-entrant emit of the same event, or a listener that on/off's mid-dispatch)\n      // keeps its captured set, exactly like a per-emit copy — without the per-emit copy.\n      const fns = new Array(set.size);\n      let i = 0;\n      set.forEach((fn) => { fns[i++] = fn; });\n      snap.fns = fns;\n      snap.dirty = false;\n    }\n    return snap.fns;\n  }\n\n  function dispatchPresentation(event, payload) {\n    const fns = snapshotListeners(presentationSets, presentationSnaps, event);\n    if (!fns) return;\n    if (!presentationDrainClaimed) {\n      // No runner owns the frame pump — dispatch i