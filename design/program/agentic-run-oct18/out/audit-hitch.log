onAdapters.js';\n152: import { ships } from '../systems/ships.js';\n153: import { crafting } from '../systems/crafting.js';\n154: import { heat } from '../systems/heat.js';\n155: import { traffic } from '../systems/traffic.js';\n156: import { drill, drillReadView } from '../systems/drill.js';\n157: import { intervention } from '../systems/intervention.js';\n158: import { claims, claimsReadView } from '../systems/claims.js';\n159: import { beacons } from '../systems/beacons.js';\n160: import { onboarding } from '../systems/onboarding.js';\n161: // WORLD OVERHAUL / REVAMP 2.1 — Wave 1 systems (see design/revamp/REVAMP_MASTER.md).\n162: import { spawnBudget } from '../systems/spawnBudget.js';            // single ship-cap arbiter (ctx.helpers.spawnBudget)\n163: import { regionalEcology } from '../systems/regionalEcology.js';     // M4 persistent regional simulation inputs\n164: import { tensionDirector } from '../systems/tensionDirector.js'; // session-scale pacing owner\n165: import { encounterDirector } from '../systems/encounterDirector.js'; // zone-anchored living-universe encounters\n166: import { nemesis } from '../systems/nemesis.js'; // adaptive named-rival arc engine (state.nemesis)\n167: import { nemesisEncounter } from '../systems/nemesisEncounter.js'; // spawn-host adapter (state.nemesisDeployment)\n168: import { nemesisSignals } from '../systems/nemesisSignals.js'; // event-only voice/toast router\n169: import { capitalBossEncounters } from '../systems/capitalBossRuntime.js'; // packet 09 authored capital scores\n170: import { livingPoiBehaviors } from '../systems/livingPoiBehaviors.js'; // M4 six causal POI behavior families\n171: import { pirateRumor } from '../systems/pirateRumor.js';             // BP-13/B12 zone pirate rumors from real events\n172: import { ambushSignatures } from '../systems/ambushSignatures.js';   // BP-13/B14 passive pre-ambush scan tells\n173: import { bountyHunt } from '../systems/bountyHunt.js';               // BP-13/B16 neutral bounty hunter contracts\n174: import { morrow } from '../systems/morrow.js';\n175: import { vesper } from '../systems/vesper.js';\n176: import { bracket } from '../systems/bracket.js';\n177: import { ravel } from '../systems/ravel.js';\n178: import { solstice } from '../systems/solstice.js';\n179: import { rubric } from '../systems/rubric.js';\n180: import { ruckus } from '../systems/ruckus.js';\n181: import { ruud } from '../systems/ruud.js';\n182: import { salvage } from '../systems/salvage.js';                     // derelict-field discovery loop\n183: import { voiceArbiter } from '../ui/voiceArbiter.js';                // \"one voice at a time\" priority queue (ctx.helpers.voice)\n184: // BP-11 Sector Atmosphere (Wave 3, design/revamp/detail/A_sector_station.md) — SYSTEMS-only\n185: // surfacing modules (event-driven; no update; DOM fully guarded; voice via ctx.helpers.voice).\n186: import { sectorPostcard } from '../ui/sectorPostcard.js';             // A1: arrival identity card + one 'news' rumor line\n187: import { dockDenyBanner } from '../ui/dockDenyBanner.js';             // A3: dockDeny.js surfaced — scan line + one 'comms' denial\n188: import { stationBroadcast } from '../systems/stationBroadcast.js';    // A5: ambient station flavor (window-timer only; lowest voice priority)\n189: import { hazardHints } from '../data/hazardLanguage.js';               // A7: once-per-type counterplay hint (tutorial channel) + state.ui.hazardRead\n190: import { noFireAdvisory } from '../data/stationBubbles.js';            // BP-11 A2: station no-fire ring 'warn' advisory on player fire\n191: import { bulkHaulTag } from '../ui/prompts/bulkHaulTag.js';             // T3-17: TOW-THE-CHUNK oversized mining chunk prompt\n192: import { dangerGradient } from '../ui/dangerGradient.js';              // A9: dangerTier tint+badge overlay on existing starmap nodes (guarded applier)\n193: // BP-12 Causal Economy (Wave 3, design/revamp/detail/E_salvage_economy_contracts.md) — SYSTEMS-only\n194: // read layers over the shipped dangerModel/sectorSim field (\"no economy change without cause\").\n195: import { causeLedger } from '../ui/causeLedger.js';                    // E: \"why prices changed\" tooltip over the live driver tags (voice:none)\n196: // BP-12 remaining 7 packets — SYSTEMS-only surfacing + enrich modules (event-driven; no update;\n197: // DOM fully guarded; voice via ctx.helpers.voice; emit-only — single-writer honored).\n198: import { customsPrompt } from '../ui/customsPrompt.js';                // CUSTOMS_MOMENT: scan decision panel (submit/bribe/run) over the shipped runScan\n199: import { impoundPayPrompt } from '../ui/impoundPayPrompt.js';          // impound clerk counter: pay verb over the shipped _payWantedImpound (choice, not overlap)\n200: import { warrantOfferPrompt } from '../ui/warrantOfferPrompt.js';        // world-remembers: the licensed hunter's offer as deck verbs over warrant:acceptPayment\n201: import { moralTrapPrompt } from '../ui/moralTrapPrompt.js';            // moral-trap fork: deck verbs over the shipped moralTrap:choose intent\n202: import { stuckTowPrompt } from '../ui/stuckTowPrompt.js';              // FB-111: wedged-hull tow offer as deck verbs over world:stuckTowAccept\n203: import { wreckChoicePrompt } from '../ui/wreckChoicePrompt.js';        // wreck communicator/survivor-pod choices: deck verbs over wreckMission:choose + survivorPod:choose\n204: import { cargoConscience } from '../ui/cargoConscience.js';            // CARGO_REPUTATION_GLYPH: hold moral-color lean glyph (read-only)\n205: import { securityReadoutSystem } from '../ui/securityReadout.js';      // SECURITY_RESPONSE_READ: \"patrols responding\" map line over driver.danger\n206: import { priceForecastSystem } from '../ui/priceForecast.js';          // PRICE_FORECAST_CONE: rising/falling map arrow over trend.pricePressure\n207: import { contractClausesSystem } from '../systems/contractClauses.js'; // COLLATERAL_AND_CLAUSES: clause breach → contract:clauseBroken (one penalty path)\n208: import { moralTrapSystem } from '../systems/moralTrap.js';             // MORAL_TRAP_CONTRACTS: mid-run reveal + binary choice → distinct shipped consequences\n209: import { lossLedger } from '../systems/lossLedger.js';                 // BP-01.1 WRECK_PROVENANCE: event-sourced loss recorder (assetLost/outpostRaided → ring buffer + wreck tag)\n210: import { provenanceLedger } from '../systems/provenanceLedger.js';     // J10 Footprint: event-sourced act→incident→standing consequence chains\n211: import { createChronicler } from '../systems/chronicler.js';           // Genie 01: world memory — causal stories, news, legends (design/genie-returns/01-chronicler)\n212: import { isRunSealed } from './runSeal.js';\n213: import { factionPresence } from '../systems/factionPresence.js';       // Depth Program K1: five additive faction presences + service/boarding seams\n214: import { bandRadio } from '../systems/bandRadio.js';                   // Depth Program A1: deterministic in-flight radio/ticker state\n215: import { v2FlavorRuntime } from '../systems/v2FlavorRuntime.js';       // Depth Program V2 physical-carrier flavor reachability\n216: import { lossInvestigation } from '../systems/lossInvestigation.js';   // CONVOY_LOSS_INVESTIGATION: loss-ledger provenance overlay on salvage communicator offers\n217: import { salvageActions } from '../systems/salvageActions.js';         // SALVAGE_DISTINCT_FROM_MINING: wreck verb readouts + unstable reactor counterplay\n218: import { survivorPod } from '../systems/survivorPod.js';               // SURVIVOR_POD_TRIAGE: wm_survivor_pod rescue/strip backend over salvage communicators\n219: import { recoveryEncounter } from '../systems/recoveryEncounter.js';   // physical scanner-to-derelict recovery loop + durable settlement\n220: import { stationSideEventDirector } from '../systems/stationSideEventDirector.js'; // A6: seeded station side-events director (spawnBudget client)\n221: import { stationContacts } from '../systems/stationContacts.js';                   // contact memory + read-only freight receipts\n222: import { stationContactLoadBoundary } from '../systems/stationContactLoadBoundary.js'; // clear/normalize continuity at restore edge\n223: import { stationServices } from '../systems/stationServices.js';                   // station yard: berths, crews, service queue + timed repair/refuel delivery\n224: import { difficultyDirector } from '../systems/difficultyDirector.js';             // pacing director: player-state reads → bounded pressure/opportunity mults + pin release\n225: import { gateControlDirector } from '../systems/gateControlDirector.js';          // A8: seeded gate traffic-control director (toll via economy:chargeCredits)\n226: import { render } from '../render/renderer.js';\n227: import { vfx } from '../render/vfx.js';\n228: import { feel } from '../render/feel.js';\n229: import { audio } from '../audio/audioSystem.js';\n230: import { ui } from '../ui/uiRoot.js';\n231: import { save } from '../save/saveSystem.js';\n232: import { orbitalGallery } from '../gallery/orbital/system.js';\n233: import { createKineticLeague } from '../sports/kineticLeague/system.js';\n234: import { reactiveMatter } from '../systems/reactiveMatter.js';\n235: import { spectrum } from '../systems/spectrum/index.js';\n236: import { createLiveMercyServiceSystem } from '../response/mercyService/live.js';\n237: import { createWreckCourtSystem } from '../systems/wreckCourt.js';\n238: import { ensurePerfRuntime, perfNow } from './perfRuntime.js';\n239: import { runRenderUpdatePhase } from './renderUpdatePhase.js';\n240: import { resolveRuntimeManifest } from '../runtime/resolveRuntimeManifest.js';\n241: import { isNodeSafeSystemId } from '../runtime/authoritativeSystemManifest.js';\n242: import { laneRpc, laneDomEvent, laneKeepalive } from './simLaneCommands.js';\n243: import {\n244:   computeDiscoveredRoute,\n245:   activeDriveForState,\n246:   wormholeGateCheck,\n247:   machineRouteStanding,\n248: } from '../systems/routePlanner.js';\n249: import { DEFAULT_RUNTIME_PROFILE_ID } from '../runtime/runtimeProfiles.js';\n250: import { applyFeatureConfigToMaps } from '../data/featureFlags.js';\n251: import { bindRuntimeToState } from '../runtime/createAuthoritativeRuntime.js';\n252: import { partitionUpdateSystems, updateQueueForThisStep } from './catchupPolicy.js';\n253: import { shouldSkipFullTickSystems } from './presentationFreeze.js';\n254: \n255: // Genie 01: one campaign-gated Chronicler per GameState. Crucible/lab runs are run-sealed and\n256: // never chronicled. The module's default singleton export is for standalone tooling — never\n257: // import both in the same runtime.\n258: const chronicler = createChronicler({\n259:   shouldObserve: (state) => !isRunSealed(state),\n260: });\n261: \n262: /**\n263:  * Teardown dependencies are expressed as [dependent, owner] pairs. Dependents release their\n264:  * scene/GPU references before the owner that provides the resource (for example VFX before the\n265:  * renderer/context). The registry keeps this separate from init/update order so a future owner\n266:  * can add a dependency without relying on an incidental manifest-array position.\n267:  */\n268: export const TEARDOWN_DEPENDENCIES = Object.freeze([\n269:   Object.freeze(['vfx', 'render']),\n270: ]);\n271: \n272: function uniqueSystemsInOrder(systems) {\n273:   const seen = new Set();\n274:   const unique = [];\n275:   for (const system of systems || []) {\n276:     if (!system || seen.has(system)) continue;\n277:     seen.add(system);\n278:     unique.push(system);\n279:   }\n280:   return unique;\n281: }\n282: \n283: // Presentation-lane facades must hand callers detached data.  Keep the clone small and local so\n284: // read selectors cannot acquire a reference to the mirrored authority object.  The JSON fallback\n285: // is for older probe hosts that do not expose structuredClone; all mirrored values are save-safe\n286: // plain data at this boundary.\n287: function cloneReadValue(value) {\n288:   if (value === undefined || value === null) return value;\n289:   try {\n290:     if (typeof structuredClone === 'function') return structuredClone(value);\n291:   } catch (_) { /* fall through to the plain-data fallback */ }\n292:   try { return JSON.parse(JSON.stringify(value)); } catch (_) { return value; }\n293: }\n294: \n295: // asteroidSites' projection/preview methods use its transient runtime caches.  Run those methods\n296: // against an isolated prototype view over one cloned mirrored site so a presentation read cannot\n297: // normalize or reconcile the main-lane mirror.  Volatile survey state is deliberately absent here;\n298: // durable survey records still read correctly and an unknown volatile assay stays unknown.\n299: function asteroidReadViewFor(state, siteId) {\n300:   const source = getAsteroidSiteFromState(state, siteId);\n301:   if (!source || typeof source !== 'object') return null;\n302:   const sites = state && state.sites && typeof state.sites === 'object' ? state.sites : {};\n303:   const isolated = {\n304:     ...(state || {}),\n305:     sites: {\n306:       ...sites,\n307:       byId: { ...(sites.byId || {}), [siteId]: cloneReadValue(source) },\n308:     },\n309:   };\n310:   const view = Object.create(asteroidSites);\n311:   view.state = isolated;\n312:   view._rt = new Map();\n313:   view._surveyByAsteroid = new Map();\n314:   view._accessCache = null;\n315:   view.siteForAsteroid = (asteroidId) => findAsteroidSiteFromState(view.state, asteroidId);\n316:   return view;\n317: }\n318: \n319: /**\n320:  * Stable dependency ordering for shutdown. Every dependency edge is dependent → owner, so a\n321:  * depth-first walk visits all dependents before their owner while preserving the existing registry\n322:  * order for unrelated systems. Cycles are ignored at the back-edge; the declared contract remains\n323:  * deterministic and a malformed future edge cannot make shutdown recurse forever.\n324:  */\n325: export function orderSystemsForTeardown(systems, dependencies = TEARDOWN_DEPENDENCIES) {\n326:   const unique = uniqueSystemsInOrder(systems);\n327:   const byName = new Map();\n328:   for (const system of unique) {\n329:     if (typeof system.name === 'string' && system.name && !byName.has(system.name)) {\n330:       byName.set(system.name, system);\n331:     }\n332:   }\n333: \n334:   const dependentsByOwner = new Map();\n335:   for (const edge of dependencies || []) {\n336:     if (!Array.isArray(edge) || edge.length < 2) continue;\n337:     const dependent = byName.get(edge[0]);\n338:     const owner = byName.get(edge[1]);\n339:     if (!dependent || !owner || dependent === owner) continue;\n340:     const dependents = dependentsByOwner.get(owner) || [];\n341:     if (!dependents.includes(dependent)) dependents.push(dependent);\n342:     dependentsByOwner.set(owner, dependents);\n343:   }\n344: \n345:   const visiting = new Set();\n346:   const visited = new Set();\n347:   const ordered = [];\n348:   const visit = (system) => {\n349:     if (visited.has(system) || visiting.has(system)) return;\n350:     visiting.add(system);\n351:     for (const dependent of dependentsByOwner.get(system) || []) visit(dependent);\n352:     visiting.delete(system);\n353:     visited.add(system);\n354:     ordered.push(system);\n355:   };\n356:   for (const system of unique) visit(system);\n357:   return ordered;\n358: }\n359: \n360: /** Run every unique system destroy hook in the declared dependency order. */\n361: export function destroySystems(systems, dependencies = TEARDOWN_DEPENDENCIES) {\n362:   for (const system of orderSystemsForTeardown(systems, dependencies)) {\n363:     if (!system || typeof system.destroy !== 'function') continue;\n364:     try {\n365:       system.destroy();\n366:     } catch (error) {\n367:       // One broken subsystem must not strand every later owner. The shutdown caller has no useful\n368:       // recovery path here; retain the deterministic attempt order and continue.\n369:       console.error('[registry] destroy ' + (system.name || 'unnamed system'), error);\n370:     }\n371:   }\n372: }\n373: \n374: /**\n375:  * Own the registry's one-way init/destroy lifecycle. A browser registry is built around module\n376:  * singletons, so retrying a partial init or reinitializing after teardown would otherwise stack\n377:  * every event subscription those singletons install. Init failure tears down every system whose\n378:  * init was entered (including the throwing system), then permanently rejects retries.\n379:  *\n380:  * `getDestroyCandidates` is evaluated only when teardown starts. The normal registry supplies the\n381:  * manifest update order plus init order; a partial init supplies only the systems it reached.\n382:  *\n383:  * @param {{systems?: object[], context?: object, getDestroyCandidates?: function, dependencies?: Array, onTeardown?: function}} options\n384:  */\n385: export function createSystemLifecycle({\n386:   systems = [],\n387:   context = null,\n388:   getDestroyCandidates = null,\n389:   dependencies = TEARDOWN_DEPENDENCIES,\n390:   onTeardown = null,\n391: } = {}) {\n392:   const initSystems = Array.isArray(systems) ? systems : [];\n393:   const destroyCandidates = typeof getDestroyCandidates === 'function'\n394:     ? getDestroyCandidates\n395:     : () => initSystems;\n396:   let phase = 'new';\n397:   let initError = null;\n398:   let teardownStarted = false;\n399:   let pendingInit = null;\n400: \n401:   function lifecycleError(action) {\n402:     const error = new Error(`[registry] cannot ${action}: lifecycle is ${phase}`);\n403:     error.code = 'REGISTRY_LIFECYCLE_CLOSED';\n404:     error.lifecycleState = phase;\n405:     if (initError) error.cause = initError;\n406:     return error;\n407:   }\n408: \n409:   function teardown(candidates, finalPhase) {\n410:     if (teardownStarted) return;\n411:     teardownStarted = true;\n412:     phase = 'destroying';\n413:     try {\n414:       destroySystems(candidates, dependencies);\n415:     } finally {\n416:       try {\n417:         if (typeof onTeardown === 'function') onTeardown();\n418:       } finally {\n419:         phase = finalPhase;\n420:       }\n421:     }\n422:   }\n423: \n424:   function init() {\n425:     // A second call while active (or a reentrant call from an init hook) is a no-op. There is no\n426:     // second subscription pass and the original successful init keeps ownership of the runtime.\n427:     if (phase === 'active' || phase === 'initializing') return;\n428:     if (phase !== 'new') throw lifecycleError('initialize');\n429: \n430:     phase = 'initializing';\n431:     const attempted = [];\n432:     try {\n433:       for (const system of initSystems) {\n434:         if (!system || typeof system.init !== 'function') continue;\n435:         // Record before invoking init: a hook can install listeners and then throw, so its destroy\n436:         // hook is part of the partial-init rollback boundary too.\n437:         attempted.push(system);\n438:         system.init(context);\n439:       }\n440:       phase = 'active';\n441:     } catch (error) {\n442:       initError = error;\n443:       // Cleanup errors are isolated by destroySystems; preserve and rethrow the original init\n444:       // failure. `teardownStarted` makes a later destroy() unable to invoke any hook twice.\n445:       teardown(attempted, 'failed');\n446:       throw error;\n447:     }\n448:   }\n449: \n450:   function initAsync(options = {}) {\n451:     // Duplicate async callers join one pass; synchronous init() remains unchanged for sim tools.\n452:     if (phase === 'initializing' && pendingInit) return pendingInit;\n453:     if (phase === 'active') return Promise.resolve(null);\n454:     if (phase !== 'new') return Promise.reject(lifecycleError('initialize'));\n455:     phase = 'initializing';\n456:     const attempted = [];\n457:     // Assign ownership before any observer/hook can call back into initAsync().\n458:     pendingInit = Promise.resolve().then(() => runBootInitializers(initSystems, context, options, attempted))\n459:       .then((metrics) => { phase = 'active'; return metrics; })\n460:       .catch((error) => {\n461:         initError = error;\n462:         teardown(attempted, 'failed');\n463:         throw error;\n464:       });\n465:     return pendingInit;\n466:   }\n467: \n468:   function destroy() {\n469:     if (phase === 'destroyed' || phase === 'failed' || phase === 'destroying') return;\n470:     if (phase === 'initializing') throw lifecycleError('destroy');\n471:     // Preserve the historical ability to destroy a registry whose callers manually initialized\n472:     // selected systems without invoking registry.init(). A fresh registry has no lifecycle-owned\n473:     // init list, so this is the only safe compatibility path for that legacy usage.\n474:     teardown(destroyCandidates(), 'destroyed');\n475:   }\n476: \n477:   return { init, initAsync, destroy };\n478: }\n479: \n480: /**\n481:  * Build the browser/registry system lookup table. Presentation platform systems live here;\n482:  * the authoritative init/update *order* comes from the runtime manifest (Phase 2).\n483:  *\n484:  * Manifest IDs match the historical SYSTEMS source identifiers. A few systems use a different\n485:  * runtime `.name` (e.g. v2FlavorRuntime → \"v2Flavor\"); both keys are registered.\n486:  */\n487: function buildRegistrySystemLookup(aiSlot, flightSlot) {\n488:   /** @type {Array<[string, object]>} */\n489:   const entries = [\n490:     ['core', core],\n491:     ['runSession', runSession],\n492:     ['survivalWave', survivalWave],\n493:     ['survivalRewards', survivalRewards],\n494:     ['survivalHud', survivalHud],\n495:     ['swarmJuiceHud', swarmJuiceHud],\n496:     ['crucibleFocus', crucibleFocus],\n497:     ['survivalDraft', survivalDraft],\n498:     ['survivalResults', survivalResults],\n499:     ['killReplay', killReplay],\n500:     ['killcamRecorder', killcamRecorder],\n501:     ['survivalAnnounce', survivalAnnounce],\n502:     ['survivalArena', survivalArena],\n503:     ['swarmArena', swarmArena],\n504:     ['swarmSupply', swarmSupply],\n505:     ['swarmChain', swarmChain],\n506:     ['swarmJuice', swarmJuice],\n507:     ['swarmElites', swarmElites],\n508:     ['survivalRun', survivalRun],\n509:     ['voiceArbiter', voiceArbiter],\n510:     ['input', input],\n511:     ['autoTargetAssist', autoTargetAssist],\n512:     ['flybyFocus', flybyFocus],\n513:     ['bulletTime', bulletTime],\n514:     ['cloak', cloak],\n515:     ['scanner', scanner],\n516:     ['spectrum', spectrum],\n517:     ['scanReveal', scanReveal],\n518:     ['buildIdentity', buildIdentity],\n519:     ['lawSecurity', lawSecurity],\n520:     ['pirateDisguise', pirateDisguise],\n521:     ['pirateParley', pirateParley],\n522:     ['pirateDisengage', pirateDisengage],\n523:     ['aceMemory', aceMemory],\n524:     ['barkDirector', barkDirector],\n525:     ['dockingCorridor', dockingCorridor],\n526:     ['physics', physics],\n527:     ['reactiveMatter', reactiveMatter],\n528:     ['orbitalGallery', orbitalGallery],\n529:     ['kineticLeague', createKineticLeague()],\n530:     ['mercyService', createLiveMercyServiceSystem()],\n531:     ['wreckCourt', createWreckCourtSystem()],\n532:     ['aiPorts', aiPorts],\n533:     ['tumbleStates', tumbleStates],\n534:     ['collisionConsequences', collisionConsequences],\n535:     ['stuntGrammar', stuntGrammar],\n536:     ['aiEncounter', aiEncounter],\n537:     ['actions', actions],\n538:     ['cruise', cruise],\n539:     ['weapons', weapons],\n540:     ['countermeasures', countermeasures],\n541:     ['impulseCharges', impulseCharges],\n542:     ['hullBurst', hullBurst],\n543:     ['mines', mines],\n544:     ['bombs', bombs],\n545:     ['massSeed', massSeed],\n546:     ['uniqueLootAbilities', uniqueLootAbilities],\n547:     ['fields', fields],\n548:     ['gyreSnare', gyreSnare],\n549:     ['emergentPrimitives', emergentPrimitives],\n550:     ['environmentMaterials', environmentMaterials],\n551:     ['environmentalMachinery', environmentalMachinery],\n552:     ['latchNine', latchNine],\n553:     ['scissorwake', scissorwake],\n554:     ['tallyThree', tallyThree],\n555:     ['lastShift', lastShift],\n556:     ['lastShiftPrompt', lastShiftPrompt],\n557:     ['redKite', redKite],\n558:     ['redKitePrompt', redKitePrompt],\n559:     ['sableVenn', sableVenn],\n560:     ['ilexArk', ilexArk],\n561:     ['ilexArkPrompt', ilexArkPrompt],\n562:     ['kilnback', kilnback],\n563:     ['mothlight', mothlight],\n564:     ['mothlightPrompt', mothlightPrompt],\n565:     ['palletJack', palletJack],\n566:     ['palletJackPrompt', palletJackPrompt],\n567:     ['secondRinse', secondRinse],\n568:     ['towlineTable', towlineTable],\n569:     ['towlineTablePrompt', towlineTablePrompt],\n570:     ['borrowedVoice', borrowedVoice],\n571:     ['borrowedVoicePrompt', borrowedVoicePrompt],\n572:     ['planetRuntime', planetRuntime],\n573:     ['combat', combat],\n574:     ['combatOutcome', combatOutcome],\n575:     ['aftermathWrecks', aftermathWrecks],\n576:     ['uniqueWrecks', uniqueWrecks],\n577:     ['titles', titlesSystem],\n578:     ['wingMorale', wingMorale],\n579:     ['tetherGameplay', tetherGameplay],\n580:     ['surrenderRecovery', surrenderRecovery],\n581:     ['custodyConsequences', custodyConsequences],\n582:     ['masslineTelemetry', masslineTelemetry],\n583:     ['masslineThreats', masslineThreats],\n584:     ['masslineImpacts', masslineImpacts],\n585:     ['masslineSnares', masslineSnares],\n586:     ['masslineThrow', masslineThrow],\n587:     ['masslineImpactDamage', masslineImpactDamage],\n588:     ['lootShards', lootShards],\n589:     ['terrainAnchors', terrainAnchors],\n590:     ['jettisonImpulse', jettisonImpulse],\n591:     ['volatileExposure', volatileExposure],\n592:     ['mining', mining],\n593:     ['fieldDepletion', fieldDepletion],\n594:     ['cargo', cargo],\n595:     ['fragileCargo', fragileCargo],\n596:     ['economy', economy],\n597:     ['automation', automation],\n598:     ['asteroidSites', asteroidSites],\n599:     ['asteroidFormations', asteroidFormations],\n600:     ['wingmen', wingmen],\n601:     ['intervention', intervention],\n602:     ['lossLedger', lossLedger],\n603:     ['provenanceLedger', provenanceLedger],\n604:     ['chronicler', chronicler],\n605:     ['factionPresence', factionPresence],\n606:     ['spawnBudget', spawnBudget],\n607:     ['world', world],\n608:     ['heistFacilities', heistFacilities],\n609:     ['regionalEcology', regionalEcology],\n610:     ['tensionDirector', tensionDirector],\n611:     ['encounterDirector', encounterDirector],\n612:     // Nemesis packet (Counterexample): engine -> encounter host -> tacticalAI fixed-step order\n613:     // is owned by the authoritative manifest; nemesisSignals is event-only (init, no update).\n614:     ['nemesis', nemesis],\n615:     ['nemesisEncounter', nemesisEncounter],\n616:     ['nemesisSignals', nemesisSignals],\n617:     // Packet 09 (Three Capitals): executable authored capital scores. Publishes fire/move orders\n618:     // the tactical slot consumes the same fixed tick; routes all damage through the combat owner.\n619:     ['capitalBossEncounters', capitalBossEncounters],\n620:     ['routeFollower', routeFollower],\n621:     ['travelLanes', travelLanes],\n622:     ['livingPoiBehaviors', livingPoiBehaviors],\n623:     ['pirateRumor', pirateRumor],\n624:     ['ambushSignatures', ambushSignatures],\n625:     ['bountyHunt', bountyHunt],\n626:     ['stationSideEventDirector', stationSideEventDirector],\n627:     ['stationContacts', stationContacts],\n628:     ['stationContactLoadBoundary', stationContactLoadBoundary],\n629:     ['stationServices', stationServices],\n630:     ['difficultyDirector', difficultyDirector],\n631:     ['gateControlDirector', gateControlDirector],\n632:     ['morrow', morrow],\n633:     ['vesper', vesper],\n634:     ['bracket', bracket],\n635:     ['ravel', ravel],\n636:     ['solstice', solstice],\n637:     ['rubric', rubric],\n638:     ['ruckus', ruckus],\n639:     ['ruud', ruud],\n640:     ['salvage', salvage],\n641:     ['lossInvestigation', lossInvestigation],\n642:     ['salvageActions', salvageActions],\n643:     ['survivorPod', survivorPod],\n644:     ['recoveryEncounter', recoveryEncounter],\n645:     ['factions', factions],\n646:     ['sectorSim', sectorSim],\n647:     ['npcJobsRuntime', npcJobsRuntime],\n648:     ['careerOrigins', careerOrigins],\n649:     ['careerLadders', careerLadders],\n650:     ['liveCareerLadderBranches', liveCareerLadderBranches],\n651:     ['missions', missions],\n652:     ['careerContracts', careerContracts],\n653:     ['economyContracts', economyContracts],\n654:     ['postEndingReplay', postEndingReplay],\n655:     ['story', story],\n656:     ['scenarioRuntime', scenarioRuntime],\n657:     ['presentationOrchestrator', presentationOrchestrator],\n658:     ['presentationAdapters', presentationAdapters],\n659:     ['ships', ships],\n660:     ['crafting', crafting],\n661:     ['heat', heat],\n662:     ['deedRecord', deedRecord],   // THE WORLD REMEMBERS: listener-only ledger of player deeds under state.story.record\n663:     ['traffic', traffic],\n664:     ['drill', drill],\n665:     ['claims', claims],\n666:     ['beacons', beacons],\n667:     ['bandRadio', bandRadio],\n668:     ['v2FlavorRuntime', v2FlavorRuntime],\n669:     ['onboarding', onboarding],\n670:     ['masslineHud', masslineHud],\n671:     ['massSeedHud', massSeedHud],\n672:     ['fieldHud', fieldHud],\n673:     ['gyreHud', gyreHud],\n674:     ['planetHud', planetHud],\n675:     ['miningHud', miningHud],\n676:     ['sectorPostcard', sectorPostcard],\n677:     ['dockDenyBanner', dockDenyBanner],\n678:     ['stationBroadcast', stationBroadcast],\n679:     ['hazardHints', hazardHints],\n680:     ['noFireAdvisory', noFireAdvisory],\n681:     ['bulkHaulTag', bulkHaulTag],\n682:     ['dangerGradient', dangerGradient],\n683:     ['causeLedger', causeLedger],\n684:     ['customsPrompt', customsPrompt],\n685:     ['impoundPayPrompt', impoundPayPrompt],\n686:     ['warrantOfferPrompt', warrantOfferPrompt],\n687:     ['moralTrapPrompt', moralTrapPrompt],\n688:     ['stuckTowPrompt', stuckTowPrompt],\n689:     ['wreckChoicePrompt', wreckChoicePrompt],\n690:     ['cargoConscience', cargoConscience],\n691:     ['securityReadoutSystem', securityReadoutSystem],\n692:     ['priceForecastSystem', priceForecastSystem],\n693:     ['contractClausesSystem', contractClausesSystem],\n694:     ['moralTrapSystem', moralTrapSystem],\n695:     ['render', render],\n696:     ['vfx', vfx],\n697:     ['feel', feel],\n698:     ['audio', audio],\n699:     ['ui', ui],\n700:     ['save', save],\n701:   ];\n702:   const lookup = new Map();\n703:   for (const [id, system] of entries) {\n704:     if (!system) continue;\n705:     lookup.set(id, system);\n706:     if (typeof system.name === 'string' && system.name) lookup.set(system.name, system);\n707:   }\n708:   // Slot aliases: manifest IDs aiSlot/flightSlot materialize to the selected backends.\n709:   lookup.set('aiSlot', aiSlot);\n710:   lookup.set('flightSlot', flightSlot);\n711:   lookup.set('ai', aiSlot);\n712:   lookup.set('flight', flightSlot);\n713:   if (aiSlot && aiSlot.name) lookup.set(aiSlot.name, aiSlot);\n714:   if (flightSlot && flightSlot.name) lookup.set(flightSlot.name, flightSlot);\n715:   return lookup;\n716: }\n717: \n718: export function createRegistry(ctx) {\n719:   // The bore dead-drop cannot import the law system (cycle through combat and cargo): it gets the witness query here.\n720:   setDeadDropWitnessSource(lawWitnessesNear);\n721:   // The scanner cannot import the asteroid-site owner (cycle through drill, cargo and combat): same seam.\n722:   setScannerSiteProjectionSource({ find: findAsteroidSiteFromState, project: projectAsteroidSiteFromState });\n723:   const aiSlot = selectAISystem(ctx);\n724:   // Normal play is SG-06 tactical AI + Flight V3 on rapier-dynamic. Legacy/custom branches stay\n725:   // available for explicit tool/test fixtures, not player-facing settings or save restore.\n726:   const flightSlot = selectFlightSystem(ctx);\n727: \n728:   const gameplay = ctx && ctx.state && ctx.state.settings && ctx.state.settings.gameplay || {};\n729:   const profileId = gameplay.runtimeProfile || DEFAULT_RUNTIME_PROFILE_ID;\n730:   const systemLookup = buildRegistrySystemLookup(aiSlot, flightSlot);\n731:   // Backend labels from the SELECTED implementation (post-fallback), not the requested setting.\n732:   // Selectors fall back to legacy when physics is non-Rapier; recording gameplay.flightBackend='v3'\n733:   // would give the same slot identity/hash as a true V3 runtime (both systems name 'flight').\n734:   const slots = {\n735:     aiSlot,\n736:     flightSlot,\n737:     aiBackend: (aiSlot && aiSlot.name === 'tacticalAI') ? 'sg06-tactical' : 'legacy',\n738:     flightBackend: flightSlot === flightV3 ? 'v3' : 'legacy',\n739:   };\n740: \n741:   // Authoritative init + update order from the single manifest (eliminates hard-coded duplication).\n742:   const resolved = resolveRuntimeManifest({\n743:     profileId,\n744:     systemLookup,\n745:     slots,\n746:     // Browser registry path includes presentation platform systems (render/vfx/feel/audio/ui).\n747:     nodeSafeOnly: false,\n748:   });\n749: \n750:   // Seed process flag MAPS from the resolved profile so combatFlag/massline2Flag/travelFlag\n751:   // match production browser defaults without typeof window. Instance binding is also stored.\n752:   if (ctx && ctx.applyRuntimeFeatures !== false) {\n753:     applyFeatureConfigToMaps(resolved.features);\n754:   }\n755:   if (ctx && ctx.state) {\n756:     bindRuntimeToState(ctx.state, {\n757:       profileId: resolved.profileId,\n758:       features: resolved.features,\n759:       evidenceClass: resolved.evidenceClass,\n760:       exclusions: resolved.exclusions,\n761:     }, resolved);\n762:   }\n763: \n764:   // init / registration order — materialised from PRODUCTION_INIT_ORDER (or profile set)\n765:   const SYSTEMS = resolved.authoritativeSystems.slice();\n766:   // sim step order (AI submits commands, actions resolve before flight, weapons before physics) — render-phase systems excluded.\n767:   // scanReveal, buildIdentity, and pirateDisguise subscribe to scanner's scan:pulse seam. scanReveal\n768:   // writes ship contact metadata for UI readers; buildIdentity adds the BP-09.1 archetype badge to\n769:   // that scan payload; pirateDisguise can then mutate disguised pirates into ordinary scanner-readable\n770:   // hostiles without scanner/HUD special cases.\n771:   // pirateDisguise runs before AI so revealed pirates\n772:   // become ordinary scanner-readable hostiles without scanner/HUD special cases.\n773:   // pirateParley runs after scanner and before AI so toll-doctrine squads can hold fire before\n774:   // tactical AI/weapons observe them; it never spawns and only uses cargo's jettison seam.\n775:   // pirateDisengage also runs before AI; lawful patrol pressure converts pirate squads to flee\n776:   // intent before tactical AI/weapons keep pursuing the player.\n777:   // aceMemory runs at a throttled cadence: B10 listens for named-ace/encounter receipts, and B11\n778:   // consumes due ace-return schedules into spawnBudget-backed promoted crews before AI ticks.\n779:   // barkDirector runs after the tactical AI slot so state/intent transitions can enqueue one\n780:   // faction-specific bark through voiceArbiter; it writes only state.barkDirector receipts.\n781:   // combatOutcome runs after combat: it is observer-only receipt state over kill/flee/disable/surrender\n782:   // events and live forceFlee flags; it never mutates combat, AI, economy, cargo, or reputation.\n783:   // aftermathWrecks runs after combatOutcome: it observes the same live kill seam, records only\n784:   // named-zone wreck markers, and materializes them as salvageable wreck entities on sector entry.\n785:   // titles observes durable NPC combat holds and reduces the cross-faction Thunderchild title\n786:   // before wingMorale reads its nearby-allies aura on the same entity:killed event.\n787:   // wingMorale is the squad-cohesion observer: leader loss marks surviving squadmates to flee,\n788:   // escort loss enrages a ward, and comms/sensor disable blocks that squad's reinforcement hook.\n789:   // surrenderRecovery runs after tetherGameplay mirrors the authoritative player attachment. It\n790:   // turns a yielded ship into a physical reel-and-tow custody option through canonical reward seams.\n791:   // custodyConsequences stores the captured-ship record under the saved player blob and projects\n792:   // the result into sectorSim through its canonical bounded impulse event.\n793:   // fieldDepletion runs immediately after mining: asteroid:destroyed still points at an entity with\n794:   // data.fieldId, so it can emit the existing world field:depletedChanged seam without mining/world edits.\n795:   // onboarding runs last: it only reads state (proximity checks) and drives tutorial UI.\n796:   // heat runs late so piracy events from combat/factions this tick have landed before decay.\n797:   // traffic runs after world (sector:enter has spawned stations) and after heat (so piracy on a\n798:   // freighter this frame is accounted) — it only writes its own entities' intent, never player state.\n799:   // crafting now has a real update (build-queue progress) so it's in the sim order; it only mutates\n800:   // its own queues + grants products, never movement/combat state.\n801:   // intervention runs after automation (so automation:assetLost this tick has fired) and prunes\n802:   // closed salvage wrecks.\n803:   // pirateRumor runs after encounterDirector so spawned ambush events are recorded and decayed; it\n804:   // only writes state.pirateRumor + news/card events, never encounter/economy state.\n805:   // ambushSignatures runs after pirateRumor/encounterDirector; it reads pending encounter plans and\n806:   // writes only passive state.ambushSignatures tells plus scan warning events.\n807:   // bountyHunt normalizes hunter contract target context before later readers observe hostility:\n808:   // neutral quarry contracts avoid the force-hostile bounty_hunter context until the player is target.\n809:   // asteroidSites runs immediately after automation: courier sale gross funnels through\n810:   // automation.creditPassive(), whose per-minute token bucket is refilled by automation.update\n811:   // earlier in the same tick. It owns only state.sites and emits intents/events otherwise.\n812:   // claims runs late (after cargo/economy) so its refinery conversion uses fresh cargo state.\n813:   // story runs after missions (so story:beatAdvanced from missions this tick has a listener ready)\n814:   // and before ships — it only emits UI/comms/graffiti/hud events and reads state; never movement.\n815:   // sectorSim runs after world + factions so its day-tick drift reads settled sector owners + the\n816:   // freshly-recomputed faction power table; it owns ONLY state.sectorSim and affects the world by\n817:   // emitting sanctioned intents (economy:applyTradePressure, factions.addOffscreenTension,\n818:   // automation.offscreenRiskPass). It does NO per-frame work — all simulation is on day:tick /\n819:   // sector transitions / save:loaded. A bug here can never freeze the loop (try/catch in init subs).\n820:   // npcJobsRuntime (PQ-014) sits immediately after sectorSim (both in the world-adjacent block, after\n821:   // world/factions have settled the current sector + entities). It is the SOLE writer of state.npcJobs\n822:   // and drives the pure npcJobs kernel: it advances materialized miner/hauler/patrol jobs and writes\n823:   // the SAME civilian data.intent traffic writes. traffic runs later and yields (continue) for any hull\n824:   // with data.jobId, so there is exactly one intent writer per job hull per tick; passive team-2 hulls\n825:   // are already off the tactical roster (aiPorts.js:303), so tactical AI never co-writes them. Like\n826:   // sectorSim it is deliberately NOT in the sf-sim curated harness list, so the 47-A golden never runs\n827:   // it; with no jobs assigned it is a strict no-op.\n828:   // factionPresence runs immediately before the selected tactical AI slot: fixed-route anchors,\n829:   // provoked convoy state, and boarding phase transitions must settle before SG-06 samples its\n830:   // sensor/roster frame, while physics remains later in the same fixed tick to consume commands.\n831:   // routeFollower closes the world-adjacent block (after world/regionalEcology/encounterDirector),\n832:   // and that placement is a deliberate trade the ordering deserves stated plainly. The follower is a\n833:   // sequencer (ADR D6): it reads the sector the ship is actually in and writes only nav intent\n834:   // (state.nav.autopilot / nav.waypoint / its own nav.executor subtree). Its two candidate slots\n835:   // conflict, because world sits LATE in this order while flightSlot sits early:\n836:   //   • before flightSlot — the follower would arm this tick's autopilot, but it would decide which\n837:   //     leg it is on from LAST tick's sector id. Gate handoff IS a sector transition, so it would\n838:   //     mis-attribute exactly the frame that matters most and could advance a leg the ship has not\n839:   //     crossed yet.\n840:   //   • after world (chosen) — sector entry has settled, so `sector:enter` and world.currentSectorId\n841:   //     are current when the leg advances. flightSlot then consumes the armed autopilot at the top of\n842:   //     the NEXT tick, a one-tick (16.7 ms) arming latency.\n843:   // That latency is free: nav.autopilot is LEVEL state that flightSlot re-reads every tick, not an\n844:   // edge the follower must hit inside a window, and the follower only ever re-targets on leg\n845:   // boundaries — never per-frame. Correct sector attribution is worth one tick of arming delay;\n846:   // stale sector attribution is not recoverable. The follower is also a strict no-op unless\n847:   // nav.autoTravel is true AND an engaged executor exists, so it costs four field reads otherwise.\n848:   // It sits at the END of that block rather than spliced directly behind world: regionalEcology and\n849:   // encounterDirector touch no nav state, so running behind them is free, and the world/ecology/\n850:   // director run is a contiguous sequence other contracts read as a unit — a new system belongs on\n851:   // the end of it, not through the middle. (An earlier draft did splice it and broke the adjacency\n852:   // assertion at scripts/check-m4-regional-ecology.mjs:211.)\n853:   // travelLanes sits between beacons and flightSlot, and that slot is forced from BOTH sides — it is\n854:   // the only window in this order where the system can do its job at all (ADR D8, packet W3-C).\n855:   //   • It must run AFTER input. `input` is index 0 (pinned by check-input-modalities.mjs:46) and it\n856:   //     is what publishes `state.input.travelDrive`. There is no block to modify before it runs, and\n857:   //     fabricating one would make travelLanes a second owner of an axis the latch owns.\n858:   //   • It must run BEFORE flightSlot, because flightSlot forwards that same block into\n859:   //     stepPropulsion. One slot later and the lane multiplier would always be a tick stale — the\n860:   //     boost would apply to where the ship WAS, which on a lane is the one place it never is.\n861:   // Within that window the position is otherwise free, so it goes last, immediately ahead of its\n862:   // consumer: this is the same \"final writer on the flight-command membrane\" idiom beacons already\n863:   // uses two slots earlier (its lure overrides intent for this tick), and tumbleStates states\n864:   // explicitly further down. Being the last writer before the kernel reads is the property that\n865:   // makes the modifier deterministic rather than order-sensitive.\n866:   // It writes ONLY `state.input.travelDrive.{ceiling,rampMult}` (never `cap` — that is the carried\n867:   // ramp state of the input↔kernel round trip), one boolean at `state.player.travelDrive.disrupted`\n868:   // which input.js already reads, and its own `state.travelLanes` readout. It is a strict no-op\n869:   // unless `travelFlag('laneBoost')` is on AND a player exists, so it costs two reads otherwise.\n\n(Output capped at 50 KB. Showing lines 1-869. Use offset=870 to continue.)\n</content>\n\n<system-reminder>\nInstructions from: C:\\Users\\93rob\\Documents\\GitHub\\SpaceFace\\src\\core\\AGENTS.md\n# src/core/ agent notes\n\nCore owns state creation, the event bus, fixed-step loop, system registry, lifetime/physics authority,\nand shared low-level contracts.\n\n- `gameState.js` defines default state and backend flags; save normalization must agree with it.\n- `registry.js` selects the AI and flight slot objects and materializes order. The lists to edit\n  are `PRODUCTION_INIT_ORDER` and `PRODUCTION_UPDATE_ORDER` in `src/runtime/authoritativeSystemManifest.js`.\n  Reordering imports in `registry.js` does not change the tick. A new id needs a lookup entry and a\n  clock in that manifest. Hosts partition by `system.name`, which must match the manifest id or be\n  aliased in `getDeclaredSystemClock` (see `moralTrap` → `moralTrapSystem`).\n- `loop.js` is a facade. The fixed step lives in `simulationRunner.js` (`MAX_CATCHUP_STEPS` is 4;\n  hitch frames shed to 2). `presentationRunner.js` calls the sim runner, then the render phase.\n  Never make simulation frame-rate dependent.\n- `runtimeWitness.js` is the 1 Hz flight recorder (`window.__SF_WITNESS__`). It is how agents see\n  whether the 3D picture is presenting and where the last frames went. Do not guess freeze or\n  performance from source first; run `npm run probe:runtime-witness`.\n- Sim uses `state.rng` and `state.simTime`, never ambient randomness or wall time.\n- `physicsAuthority.js`/Rapier own live physics authority. Compatibility modules are not the default\n  gameplay seam.\n- `physicsBody` (schema v1) authors a body's shape plus optional `density`, `contact` overrides,\n  `impactDamageScale`, `fieldResponseMult`, and `collisionProxyManifest` — the same proxy manifest\n  shared with measured skins. Bump `physicsBody.revision` to rebuild a mutated body spec.\n- Core changes are broad: run focused tests, sim comparison, and the relevant launch/perf floor.\n- Production calendar owners run at their authored phases on every fixed tick, including catch-up; `partitionUpdateSystems(..., { state, bus }).updateDt` supplies their elapsed simulation time. Table/near/glass keep fixed dt, keepalive is separate, and New Game/save restoration reset calendar baselines. Regressions: `test/sim-clock-catchup.test.mjs` and `test/calendar-elapsed-time.test.mjs`.\n- `periodicClock.js` bounds due work per invocation without discarding valid accumulated time. Imported impossible clocks are repaired separately from runtime-corruption rejection. Focused proof: `node --test test/numeric-update-liveness.test.mjs test/calendar-elapsed-time.test.mjs`; do not replace carried backlog with a blanket elapsed-time clamp.\n\n- Contact numerical recovery checks solver-only changes against pre-solve counterpart motion and repairs position as well as velocity; queued impulses and legitimate momentum remain in the trusted prediction. Focused proof: `node --test test/sg02-contact-sanity-recovery.test.mjs test/sg02-player-contact-give.test.mjs`.\n\n\nInstructions from: C:\\Users\\93rob\\Documents\\GitHub\\SpaceFace\\src\\AGENTS.md\n# src/ agent orientation\n\nRead root `AGENTS.md` first. Use `docs/MODULE_MAP.md` to select an owner, then the nearest nested\ninstructions. Do not infer the live backend from imports; root §5 and `core/registry.js` own selection.\n\n## Layer boundaries\n\n- `core/` — state, event bus, loop facade, registry, physics/lifetime authority. Order and clocks:\n  `src/runtime/AGENTS.md`.\n- `systems/` — registered fixed-step systems and a few imported helpers.\n- `ai/` and `combat/` — shared tactical/combat libraries used by registered systems.\n- `data/` — stable IDs and data-driven definitions.\n- `render/` — Three.js presentation and runtime asset integration; never owns sim results.\n  Hazard notes also in `render/combat/`, `render/ships/`, `render/vfx/`, `render/forceLanguage/`.\n- `testing/lab/` — deterministic gameplay scenarios. `testing/AGENTS.md` points at the lab.\n- `ui/` — DOM presentation and input intents. UI may update explicitly UI/input-owned selection state\n  such as `state.player.targetId`; it must not mutate gameplay-owned outcomes.\n- `audio/`, `presentation/`, `save/`, `sim/`, `observability/` — each has an `AGENTS.md`. Audio and\n  presentation do not write outcomes. Save owns the envelope. `sim/` is tapes and pure projections.\n- `world/`, `story/`, `characters/`, `nemesis/`, `chronicler/`, `onboarding/`, `localization/` —\n  libraries. The registered writers stay in `systems/`. Read the folder note before editing.\n- `economy/`, `missions/`, `contracts/`, `careers/`, `balance/` — pure math, schemas, or harnesses.\n  `missions/AGENTS.md` also covers `law/` and `physicalCargo/` (too small for their own note).\n- Credits, cargo, WANTED heat, reputation, and derived ship stats still have one writer each in\n  `systems/`. These folders return numbers or intents.\n\n## Source rules\n\n- Sim remains deterministic and independent of Three.js.\n- Cross-domain changes follow root single-writer and event/intent contracts.\n- Compatibility flight/AI modules are tested paths, not the default gameplay owner.\n- Verify the working-tree diff before assuming `HEAD` describes the live implementation.\n- For recurring hostility, fallback, heat, save, or launcher failures, use `docs/COMMON_BUGS.md`\n  before broad search.\n\n</system-reminder>","metadata":{"preview":"// System registry: holds every system, runs init in registration order, runs the sim UPDATE_ORDER\n// each step (§2.3), and the render-phase systems each frame. main.js builds it with the ctx.\nimport { core } from './coreSystem.js';\nimport { runBootInitializers } from './bootSystemInit.js';\nimport { runSession } from '../systems/runSession.js';\nimport { survivalDraft } from '../systems/survivalDraft.js';\nimport { survivalResults } from '../systems/survivalResults.js';\nimport { killReplay } from '../systems/killReplay.js';\nimport { killcamRecorder } from '../sim/killcamTape.js';\nimport { survivalAnnounce } from '../systems/survivalAnnounce.js';\nimport { survivalArena } from '../systems/survivalArena.js';\nimport { swarmArena } from '../systems/swarmArena.js';\nimport { swarmSupply } from '../systems/swarmSupply.js';\nimport { swarmChain } from '../systems/swarmChain.js';\nimport { swarmJuice } from '../systems/swarmJuice.js';\nimport { swarmElites } from '../systems/swarmElites.js';\nimport { survivalRewards } from '../systems/survivalRewards.js';\nimport { survivalHud } from '../ui/survivalHud.js';                 // Crucible run readout (DOM-guarded)\nimport { swarmJuiceHud } from '../ui/swarmJuiceHud.js';             // Swarm arcade juice layer (DOM-guarded)\nimport { crucibleFocus } from '../ui/crucibleFocus.js';             // hides campaign chrome in a run (DOM-guarded)","truncated":true,"loaded":["C:\\Users\\93rob\\Documents\\GitHub\\SpaceFace\\src\\core\\AGENTS.md","C:\\Users\\93rob\\Documents\\GitHub\\SpaceFace\\src\\AGENTS.md"],"display":{"type":"file","path":"C:\\Users\\93rob\\Documents\\GitHub\\SpaceFace\\src\\core\\registry.js","text":"// System registry: holds every system, runs init in registration order, runs the sim UPDATE_ORDER\n// each step (§2.3), and the render-phase systems each frame. main.js builds it with the ctx.\n