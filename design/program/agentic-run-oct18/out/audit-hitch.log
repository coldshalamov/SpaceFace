{"type":"tool_use","timestamp":1792370215311,"sessionID":"ses_eae696937ffe0wN6WZCrNY9lxd","part":{"type":"tool","tool":"read","callID":"chatcmpl-tool-8a1d7050d9e515b7","state":{"status":"completed","input":{"filePath":"C:\\Users\\93rob\\Documents\\GitHub\\SpaceFace\\src\\core\\simulationRunner.js"},"output":"<path>C:\\Users\\93rob\\Documents\\GitHub\\SpaceFace\\src\\core\\simulationRunner.js</path>\n<type>file</type>\n<content>\n1: // Main-thread simulation owner. Keeps the authoritative fixed-step policy separate from presentation\n2: // scheduling so a later transport change does not need to rediscover tick, backlog, or ordering rules.\n3: import { createInputCommandSnapshotQueue } from './inputCommandSnapshot.js';\n4: \n5: export const LOOP_FIXED_DT = 1 / 60;\n6: export const MAX_CATCHUP_STEPS = 4;\n7: // A SLOW FRAME RATE IS NOT A HITCH. Four catch-up steps cover every callback down to 15 fps at\n8: // full realtime (and ~10–12 fps with one shed tick): a 30 fps frame owes two ticks and gets two.\n9: // Capping those frames (the old one-step cap after a late present, two after any frame over\n10: // 33 ms, or treating every soft-GPU ~83 ms callback as a hitch) did not make the picture arrive\n11: // sooner — drawing is the cost on those machines, not the sim — it ran the whole game at\n12: // 40–65 % speed exactly where it was already struggling.\n13: //\n14: // A hitch is a callback that arrives more than HITCH_FRAME_TICKS late (GC, a long task, a blocked\n15: // present): the picture was frozen and the pilot could not steer. Replaying all of that time\n16: // would teleport the ship through whatever was ahead of it, so a hitch resumes the world two\n17: // ticks on and the rest of the debt is shed. Threshold stays above MAX_CATCHUP_STEPS so every\n18: // frame the catch-up ceiling can fully serve is classified as a slow frame, never a hitch.\n19: // 6.5 ticks (~108 ms) keeps soft-GPU sustained ~12 fps (and down through ~10 fps) on the slow\n20: // path; a true spike (120 ms+ in continuity / crucible) still sheds.\n21: export const HITCH_FRAME_TICKS = 6.5;\n22: export const HITCH_CATCHUP_STEPS = 2;\n23: \n24: /** True when this callback's frame delta is a hitch rather than a slow-but-steady frame rate. */\n25: export function isHitchFrame(frameDt, fixedDt = LOOP_FIXED_DT) {\n26:   const dt = Number.isFinite(fixedDt) && fixedDt > 0 ? fixedDt : LOOP_FIXED_DT;\n27:   return Number.isFinite(frameDt) && frameDt > dt * HITCH_FRAME_TICKS;\n28: }\n29: \n30: /**\n31:  * Step cap for this callback's simulation advance.\n32:  * Steady frames keep the full catch-up ceiling (real-time down to 15 fps); a hitch sheds to two.\n33:  */\n34: export function frameSimStepCap({\n35:   frameDt = 0,\n36:   fixedDt = LOOP_FIXED_DT,\n37:   maxSteps = MAX_CATCHUP_STEPS,\n38: } = {}) {\n39:   const configured = Math.max(1, Math.floor(Number.isFinite(maxSteps) ? maxSteps : MAX_CATCHUP_STEPS));\n40:   return isHitchFrame(frameDt, fixedDt) ? Math.min(configured, HITCH_CATCHUP_STEPS) : configured;\n41: }\n42: \n43: const DEFAULT_COMPLETED_TICK_CAPACITY = 8;\n44: \n45: export function advanceFixedTimestep(\n46:   accumulator,\n47:   frameDt,\n48:   timeScale,\n49:   step,\n50:   out = null,\n51:   dt = LOOP_FIXED_DT,\n52:   maxSteps = MAX_CATCHUP_STEPS,\n53: ) {\n54:   const result = out || { steps: 0, shedBacklog: false, shedSteps: 0, accumulator: 0 };\n55:   result.steps = 0;\n56:   result.shedBacklog = false;\n57:   result.shedSteps = 0;\n58:   result.accumulator = Number.isFinite(accumulator) ? Math.max(0, accumulator) : 0;\n59: \n60:   const scale = Number.isFinite(timeScale) ? timeScale : 0;\n61:   const frameSeconds = Number.isFinite(frameDt) ? Math.max(0, frameDt) : 0;\n62:   const fixedDt = Number.isFinite(dt) && dt > 0 ? dt : LOOP_FIXED_DT;\n63:   // Hard cap stays at MAX_CATCHUP_STEPS (4): enough for ~15–30 fps presentation catch-up, not\n64:   // an unbounded spiral. Whole-step debt beyond the cap is shed while keeping sub-step remainder\n65:   // so the next frame can resume at the correct 60 Hz phase without wall-clock/RNG dependence.\n66:   const stepCap = Math.max(1, Math.floor(Number.isFinite(maxSteps) ? maxSteps : MAX_CATCHUP_STEPS));\n67:   if (!(scale > 0)) return result;\n68: \n69:   result.accumulator += frameSeconds * scale;\n70:   while (result.accumulator >= fixedDt && result.steps < stepCap) {\n71:     step(fixedDt);\n72:     result.accumulator -= fixedDt;\n73:     result.steps++;\n74:   }\n75: \n76:   if (result.accumulator >= fixedDt) {\n77:     // Drop overdue whole ticks but retain the sub-tick phase. Resetting all the way to zero creates\n78:     // an avoidable long interval before the next sim step after a hitch. Accounting is explicit:\n79:     // shedSteps = floor(acc/dt) whole fixed ticks discarded; remainder stays for interpolation.\n80:     const wholeLeft = Math.floor(result.accumulator / fixedDt);\n81:     const remainder = result.accumulator - wholeLeft * fixedDt;\n82:     result.shedSteps = wholeLeft;\n83:     result.accumulator = remainder < 1e-12 || fixedDt - remainder < 1e-12 ? 0 : remainder;\n84:     result.shedBacklog = true;\n85:   }\n86:   return result;\n87: }\n88: \n89: function createCompletedTickRecord() {\n90:   return {\n91:     sequence: 0,\n92:     tick: 0,\n93:     simTime: 0,\n94:     stateDigestMarker: 0,\n95:     inputSequence: 0,\n96:     inputCommandSeq: 0,\n97:     inputWallMs: 0,\n98:     lifecycleGeneration: 0,\n99:     journalStart: 0,\n100:     journalEnd: 0,\n101:     // A physical slot normally represents one fixed step.  When presentation\n102:     // is temporarily stalled, the bounded tail below represents several\n103:     // completed steps and keeps the count/range explicit for the consumer.\n104:     coalescedCount: 1,\n105:     fullRebuild: false,\n106:     fullRebuildCount: 0,\n107:     fullRebuildStart: null,\n108:     rebuildGeneration: 0,\n109:   };\n110: }\n111: \n112: function copyCompletedTick(target, source) {\n113:   target.sequence = source.sequence;\n114:   target.tick = source.tick;\n115:   target.simTime = source.simTime;\n116:   target.stateDigestMarker = source.stateDigestMarker;\n117:   target.inputSequence = source.inputSequence;\n118:   target.inputCommandSeq = source.inputCommandSeq;\n119:   target.inputWallMs = source.inputWallMs;\n120:   target.lifecycleGeneration = source.lifecycleGeneration;\n121:   target.journalStart = source.journalStart;\n122:   target.journalEnd = source.journalEnd;\n123:   // Keep the long-standing output shape for the ordinary one-tick case.  The\n124:   // optional fields are present only when a bounded tail or rebuild metadata\n125:   // makes them meaningful; delete them when a caller reuses its scratch object\n126:   // for a plain completion.\n127:   if (Number.isSafeInteger(source.coalescedCount) && source.coalescedCount > 1) {\n128:     target.coalescedCount = source.coalescedCount;\n129:   } else {\n130:     delete target.coalescedCount;\n131:   }\n132:   if (source.fullRebuild === true || (Number.isSafeInteger(source.fullRebuildCount)\n133:       && source.fullRebuildCount > 0)) {\n134:     target.fullRebuild = source.fullRebuild === true\n135:       || (Number.isSafeInteger(source.fullRebuildCount) && source.fullRebuildCount > 0);\n136:     target.fullRebuildCount = Number.isSafeInteger(source.fullRebuildCount)\n137:       ? source.fullRebuildCount : 1;\n138:     target.fullRebuildStart = Number.isSafeInteger(source.fullRebuildStart)\n139:       ? source.fullRebuildStart : target.journalStart;\n140:     target.rebuildGeneration = Number.isSafeInteger(source.rebuildGeneration)\n141:       ? source.rebuildGeneration : 0;\n142:   } else {\n143:     delete target.fullRebuild;\n144:     delete target.fullRebuildCount;\n145:     delete target.fullRebuildStart;\n146:     delete target.rebuildGeneration;\n147:   }\n148:   return target;\n149: }\n150: \n151: function completedRecordCount(record) {\n152:   return Number.isSafeInteger(record?.coalescedCount) && record.coalescedCount > 0\n153:     ? record.coalescedCount : 1;\n154: }\n155: \n156: function completedFullCount(record) {\n157:   return Number.isSafeInteger(record?.fullRebuildCount) && record.fullRebuildCount > 0\n158:     ? record.fullRebuildCount : (record?.fullRebuild === true ? 1 : 0);\n159: }\n160: \n161: /**\n162:  * Own the fixed-step accumulator and publish a bounded physical queue plus one\n163:  * coalesced metadata tail of completed ticks. The registry remains the sole\n164:  * owner of system/event order; this runner only invokes registry.step.\n165:  */\n166: export function createSimulationRunner(state, registry, deps = {}) {\n167:   if (!state || typeof state !== 'object') throw new TypeError('SimulationRunner requires state');\n168:   if (!registry || typeof registry.step !== 'function') {\n169:     throw new TypeError('SimulationRunner requires registry.step');\n170:   }\n171: \n172:   const fixedDt = Number.isFinite(deps.fixedDt) && deps.fixedDt > 0\n173:     ? deps.fixedDt\n174:     : LOOP_FIXED_DT;\n175:   const maxSteps = Math.max(1, Math.floor(Number.isFinite(deps.maxSteps)\n176:     ? deps.maxSteps\n177:     : MAX_CATCHUP_STEPS));\n178:   const completedTickCapacity = Math.max(\n179:     maxSteps,\n180:     Math.floor(Number.isFinite(deps.completedTickCapacity)\n181:       ? deps.completedTickCapacity\n182:       : DEFAULT_COMPLETED_TICK_CAPACITY),\n183:   );\n184:   let presentationJournal = deps.presentationJournal || null;\n185:   const inputCommandSnapshotCapacity = Math.max(\n186:     maxSteps,\n187:     Math.floor(Number.isFinite(deps.inputCommandSnapshotCapacity)\n188:       ? deps.inputCommandSnapshotCapacity\n189:       : completedTickCapacity),\n190:   );\n191:   let inputCommandSnapshots = deps.inputCommandSnapshots\n192:     || createInputCommandSnapshotQueue(inputCommandSnapshotCapacity);\n193:   if (typeof inputCommandSnapshots.reserve !== 'function'\n194:     || typeof inputCommandSnapshots.capture !== 'function'\n195:     || typeof inputCommandSnapshots.consume !== 'function'\n196:     || typeof inputCommandSnapshots.cancel !== 'function') {\n197:     throw new TypeError('SimulationRunner requires a bounded InputCommandSnapshot queue');\n198:   }\n199:   const onInputCommandSnapshot = typeof deps.onInputCommandSnapshot === 'function'\n200:     ? deps.onInputCommandSnapshot\n201:     : null;\n202:   const completedTicks = Array.from(\n203:     { length: completedTickCapacity },\n204:     () => createCompletedTickRecord(),\n205:   );\n206:   const advanceResult = { steps: 0, shedBacklog: false, shedSteps: 0, accumulator: 0 };\n207:   let completedRead = 0;\n208:   let completedWrite = 0;\n209:   let completedCount = 0;\n210:   // A stalled presenter must not quarantine the authoritative simulation merely\n211:   // because its fixed-step metadata ring is full.  Keep one bounded tail that\n212:   // represents all additional completions until the next presentation drain.\n213:   let completedOverflow = null;\n214:   let completedTickCoalescingEvents = 0;\n215:   let completedTickCoalescedCount = 0;\n216:   let completedFullRebuildsCoalesced = 0;\n217:   let completedSequence = 0;\n218:   let inputSequence = 0;\n219:   // P7: wall-clock stamp of the newest player input command the current tick consumed, copied\n220:   // verbatim from the input boundary onto the completed tick so presentation can name the first\n221:   // frame that reflects it. Telemetry only — never read by gameplay.\n222:   let pendingInputCommandSeq = 0;\n223:   let pendingInputWallMs = 0;\n224:   let lifecycleGeneration = 0;\n225:   let overflowCount = 0;\n226:   let consumedTickCount = 0;\n227:   let skippedPresentationTicks = 0;\n228:   let inputBoundaryCaptureCount = 0;\n229:   let inputBoundaryErrorCount = 0;\n230:   let inputSnapshotCancelCount = 0;\n231:   let inputObserverErrorCount = 0;\n232:   let lastInputObserverError = null;\n233:   let committedJournalSequence = 0;\n234:   let journalCursorAlignmentCount = 0;\n235:   let recoveryCappedAdvanceCount = 0;\n236:   let lastAdvanceStepCap = maxSteps;\n237:   let closed = false;\n238:   let closeComplete = false;\n239:   let closeCount = 0;\n240:   let closeAttemptCount = 0;\n241:   let closeFailureCount = 0;\n242:   let completedTicksPendingAtClose = 0;\n243:   let completedTicksDiscardedOnClose = 0;\n244:   let inputPendingAtClose = 0;\n245:   let inputResidualPending = 0;\n246:   let inputSnapshotsCancelledOnClose = 0;\n247:   let inputCancellationFailureCount = 0;\n248:   let closedInputCommandSnapshotDiagnostics = null;\n249:   // The step throw that triggered quarantine. Every later frame can only report\n250:   // \"SimulationRunner is closed\", so the original error must be retained here.\n251:   let closeCauseMessage = null;\n252:   // The stack's first frames name the throwing system — a bare \"x is not defined\" does not.\n253:   let closeCauseSite = null;\n254: \n255:   function assertOpen() {\n256:     if (closed) throw new Error('SimulationRunner is closed');\n257:   }\n258: \n259:   const inputTickBoundary = {\n260:     sequence: 0,\n261:     targetTick: 0,\n262:     publishedSequence: 0,\n263:     publishInputCommand(input, actualTick, activityStamp) {\n264:       assertOpen();\n265:       if (this.publishedSequence !== 0) {\n266:         inputBoundaryErrorCount++;\n267:         throw new Error(`InputCommandSnapshot ${this.sequence} published more than once`);\n268:       }\n269:       // seq mirrors the deterministic device-arbitration sequence (_activitySeq), which\n270:       // save/load already restores. wallMs arrives out-of-band from the input system —\n271:       // wall-clock fields may never live inside state.input (serialized + hashed).\n272:       pendingInputCommandSeq = Number.isSafeInteger(input && input._activitySeq)\n273:         ? input._activitySeq : 0;\n274:       pendingInputWallMs = Number.isFinite(activityStamp && activityStamp.wallMs)\n275:         ? activityStamp.wallMs : 0;\n276:       inputCommandSnapshots.capture(this.sequence, input, actualTick);\n277:       this.publishedSequence = this.sequence;\n278:       inputBoundaryCaptureCount++;\n279:     },\n280:   };\n281: \n282:   function journalSequence() {\n283:     return presentationJournal && typeof presentationJournal.getWriteSequence === 'function'\n284:       ? presentationJournal.getWriteSequence()\n285:       : 0;\n286:   }\n287: \n288:   function initialJournalCursor() {\n289:     if (presentationJournal\n290:       && typeof presentationJournal.getPendingCount === 'function'\n291:       && typeof presentationJournal.getOldestSequence === 'function'\n292:       && presentationJournal.getPendingCount() > 0) {\n293:       const oldestSequence = presentationJournal.getOldestSequence();\n294:       if (Number.isSafeInteger(oldestSequence) && oldestSequence > 0) return oldestSequence - 1;\n295:     }\n296:     return journalSequence();\n297:   }\n298: \n299:   committedJournalSequence = initialJournalCursor();\n300: \n301:   function reserveCompletedTick() {\n302:     if (completedCount >= completedTickCapacity) return null;\n303:     return completedTicks[completedWrite];\n304:   }\n305: \n306:   function writeCompletedTickFields(\n307:     target,\n308:     sequence,\n309:     tick,\n310:     simTime,\n311:     inputSequenceValue,\n312:     inputCommandSeq,\n313:     inputWallMs,\n314:     lifecycleGenerationValue,\n315:     journalStart,\n316:     journalEnd,\n317:     fullRebuild = false,\n318:     fullRebuildCount = 0,\n319:     fullRebuildStart = null,\n320:     rebuildGeneration = 0,\n321:   ) {\n322:     target.sequence = sequence;\n323:     target.tick = tick;\n324:     target.simTime = simTime;\n325:     // This is a cheap boundary marker, not an acceptance digest. PQ-034 remains the hash authority.\n326:     target.stateDigestMarker = tick;\n327:     target.inputSequence = inputSequenceValue;\n328:     target.inputCommandSeq = inputCommandSeq;\n329:     target.inputWallMs = inputWallMs;\n330:     target.lifecycleGeneration = lifecycleGenerationValue;\n331:     target.journalStart = journalStart;\n332:     target.journalEnd = journalEnd;\n333:     target.coalescedCount = 1;\n334:     target.fullRebuild = fullRebuild === true || fullRebuildCount > 0;\n335:     target.fullRebuildCount = fullRebuildCount;\n336:     target.fullRebuildStart = target.fullRebuild\n337:       ? (Number.isSafeInteger(fullRebuildStart) ? fullRebuildStart : journalStart)\n338:       : null;\n339:     target.rebuildGeneration = rebuildGeneration;\n340:   }\n341: \n342:   // The normal reserved-slot path writes directly into its preallocated\n343:   // record. This helper is reached only after that ring is full, so pressure\n344:   // traffic can retain a single bounded metadata tail without adding one\n345:   // object allocation per fixed tick.\n346:   function mergeCompletedTickValues(\n347:     target,\n348:     sequence,\n349:     tick,\n350:     simTime,\n351:     inputSequenceValue,\n352:     inputCommandSeq,\n353:     inputWallMs,\n354:     lifecycleGenerationValue,\n355:     journalStart,\n356:     journalEnd,\n357:     fullRebuild = false,\n358:     fullRebuildCount = 0,\n359:     fullRebuildStart = null,\n360:     rebuildGeneration = 0,\n361:   ) {\n362:     const targetCount = completedRecordCount(target);\n363:     const targetFull = target.fullRebuild === true || completedFullCount(target) > 0;\n364:     const incomingFull = fullRebuild === true || fullRebuildCount > 0;\n365:     const targetFullStart = Number.isSafeInteger(target.fullRebuildStart)\n366:       ? target.fullRebuildStart : null;\n367:     const incomingFullStart = Number.isSafeInteger(fullRebuildStart)\n368:       ? fullRebuildStart : null;\n369:     const targetStart = Number.isSafeInteger(target.journalStart) ? target.journalStart : 0;\n370:     const incomingStart = Number.isSafeInteger(journalStart) ? journalStart : targetStart;\n371:     const targetEnd = Number.isSafeInteger(target.journalEnd) ? target.journalEnd : targetStart;\n372:     const incomingEnd = Number.isSafeInteger(journalEnd) ? journalEnd : incomingStart;\n373:     const full = targetFull || incomingFull;\n374:     const fullStart = incomingFull\n375:       ? (incomingFullStart ?? incomingStart)\n376:       : targetFullStart;\n377:     const fullCount = completedFullCount(target) + fullRebuildCount;\n378: \n379:     // Incoming is the newest completed state for every scalar/input field.\n380:     target.sequence = sequence;\n381:     target.tick = tick;\n382:     target.simTime = simTime;\n383:     target.stateDigestMarker = tick;\n384:     target.inputSequence = inputSequenceValue;\n385:     target.inputCommandSeq = inputCommandSeq;\n386:     target.inputWallMs = inputWallMs;\n387:     target.lifecycleGeneration = lifecycleGenerationValue;\n388:     target.coalescedCount = targetCount + 1;\n389:     target.fullRebuildCount = fullCount;\n390:     target.fullRebuild = full;\n391:     target.fullRebuildStart = full\n392:       ? (Number.isSafeInteger(fullStart) ? fullStart : Math.min(targetStart, incomingStart))\n393:       : null;\n394:     target.rebuildGeneration = Math.max(\n395:       Number.isSafeInteger(target.rebuildGeneration) ? target.rebuildGeneration : 0,\n396:       Number.isSafeInteger(rebuildGeneration) ? rebuildGeneration : 0,\n397:     );\n398:     // A rebuild supersedes older journal rows still represented by this tail.\n399:     target.journalStart = full\n400:       ? (Number.isSafeInteger(fullStart) ? fullStart : Math.min(targetStart, incomingStart))\n401:       : Math.min(targetStart, incomingStart);\n402:     target.journalEnd = Math.max(targetEnd, incomingEnd);\n403:   }\n404: \n405:   function publishCompletedTick(slot, nextInputSequence, journalStart, journalEnd) {\n406:     completedSequence++;\n407:     inputSequence = nextInputSequence;\n408:     const tick = Number.isSafeInteger(state.tick) ? state.tick : 0;\n409:     const simTime = Number.isFinite(state.simTime) ? state.simTime : 0;\n410:     if (!slot) {\n411:       // Registry work and its journal writes have already committed.  The\n412:       // overflow path stores metadata only; presentation will consume the\n413:       // journal rows by this retained range and render the newest scalar state.\n414:       if (!completedOverflow) {\n415:         completedOverflow = createCompletedTickRecord();\n416:         writeCompletedTickFields(\n417:           completedOverflow,\n418:           completedSequence,\n419:           tick,\n420:           simTime,\n421:           inputSequence,\n422:           pendingInputCommandSeq,\n423:           pendingInputWallMs,\n424:           lifecycleGeneration,\n425:           journalStart,\n426:           journalEnd,\n427:         );\n428:       } else {\n429:         mergeCompletedTickValues(\n430:           completedOverflow,\n431:           completedSequence,\n432:           tick,\n433:           simTime,\n434:           inputSequence,\n435:           pendingInputCommandSeq,\n436:           pendingInputWallMs,\n437:           lifecycleGeneration,\n438:           journalStart,\n439:           journalEnd,\n440:         );\n441:       }\n442:       completedTickCoalescingEvents++;\n443:       completedTickCoalescedCount++;\n444:       overflowCount = completedTickCoalescingEvents;\n445:       committedJournalSequence = journalEnd;\n446:       return;\n447:     }\n448:     writeCompletedTickFields(\n449:       slot,\n450:       completedSequence,\n451:       tick,\n452:       simTime,\n453:       inputSequence,\n454:       pendingInputCommandSeq,\n455:       pendingInputWallMs,\n456:       lifecycleGeneration,\n457:       journalStart,\n458:       journalEnd,\n459:     );\n460:     completedWrite = (completedWrite + 1) % completedTickCapacity;\n461:     completedCount++;\n462:     committedJournalSequence = journalEnd;\n463:   }\n464: \n465:   function stepSimulation(dt) {\n466:     assertOpen();\n467:     const commandSnapshots = inputCommandSnapshots;\n468:     // Reserve the input publication before advancing authoritative state.  A\n469:     // full completion ring is handled by the bounded metadata tail in\n470:     // publishCompletedTick; the authoritative tick must continue advancing so\n471:     // a blocked presenter cannot close the game.\n472:     const slot = reserveCompletedTick();\n473:     const nextInputSequence = inputSequence + 1;\n474:     const currentTick = Number.isSafeInteger(state.tick) && state.tick >= 0\n475:       ? state.tick\n476:       : completedSequence;\n477:     const targetTick = currentTick + 1;\n478:     commandSnapshots.reserve(nextInputSequence, targetTick, lifecycleGeneration);\n479:     inputTickBoundary.sequence = nextInputSequence;\n480:     inputTickBoundary.targetTick = targetTick;\n481:     inputTickBoundary.publishedSequence = 0;\n482:     // The cursor advances only when a completed tick commits. Records published between fixed ticks\n483:     // therefore belong to the next completion instead of disappearing behind a tick-start sample.\n484:     const journalStart = committedJournalSequence;\n485: \n486:     try {\n487:       registry.step(dt, inputTickBoundary);\n488:       state.simCatchupIndex = (state.simCatchupIndex | 0) + 1;\n489:       assertOpen();\n490:       if (inputTickBoundary.publishedSequence !== nextInputSequence) {\n491:         inputBoundaryErrorCount++;\n492:         throw new Error(`InputCommandSnapshot ${nextInputSequence} was not published`);\n493:       }\n494:       const observerError = commandSnapshots.consume(\n495:         nextInputSequence,\n496:         onInputCommandSnapshot,\n497:       );\n498:       assertOpen();\n499:       inputSequence = nextInputSequence;\n500:       publishCompletedTick(slot, nextInputSequence, journalStart, journalSequence());\n501:       if (observerError) {\n502:         inputObserverErrorCount++;\n503:         lastInputObserverError = observerError instanceof Error\n504:           ? observerError.message\n505:           : String(observerError);\n506:       }\n507:     } catch (error) {\n508:       if (commandSnapshots.cancel(nextInputSequence)) inputSnapshotCancelCount++;\n509:       // registry.step may have mutated authoritative state before throwing. The accumulator is\n510:       // intentionally not committed on this path, so close the runner before rethrowing to make\n511:       // that uncommitted phase permanently non-retryable. The original error remains the caller's\n512:       // diagnostic; close() retains the existing queue/cancellation diagnostics.\n513:       if (!closed) {\n514:         closeCauseMessage = error && typeof error.message === 'string'\n515:           ? error.message.slice(0, 240)\n516:           : String(error).slice(0, 240);\n517:         const stackLines = error && typeof error.stack === 'string'\n518:           ? error.stack.split('\\n').map((l) => l.trim()).filter((l) => l.startsWith('at '))\n519:           : null;\n520:         closeCauseSite = stackLines && stackLines.length\n521:           ? stackLines.slice(0, 4).join(' | ').slice(0, 480)\n522:           : null;\n523:         try {\n524:           close();\n525:         } catch (_) {\n526:           // close() quarantines the runner before reporting residual cleanup work. Preserve the\n527:           // authoritative failure above; getDiagnostics() retains the close failure counters.\n528:         }\n529:       }\n530:       throw error;\n531:     }\n532:   }\n533: \n534:   function prepareWithoutAdvance() {\n535:     assertOpen();\n536:     advanceResult.steps = 0;\n537:     advanceResult.shedBacklog = false;\n538:     advanceResult.shedSteps = 0;\n539:     advanceResult.accumulator = Number.isFinite(state.accumulator)\n540:       ? Math.max(0, state.accumulator)\n541:       : 0;\n542:     return advanceResult;\n543:   }\n544: \n545:   function close() {\n546:     if (closeComplete) return false;\n547:     closeAttemptCount++;\n548:     if (!closed) {\n549:       closed = true;\n550:       closeCount++;\n551:       const pendingLogical = completedCount\n552:         + (completedOverflow ? completedRecordCount(completedOverflow) : 0);\n553:       completedTicksPendingAtClose = pendingLogical;\n554:       completedTicksDiscardedOnClose += pendingLogical;\n555:       completedRead = 0;\n556:       completedWrite = 0;\n557:       completedCount = 0;\n558:       completedOverflow = null;\n559:       completedTicks.length = 0;\n560:       const initialPending = inputCommandSnapshots?.getPendingCount?.();\n561:       const initialDiagnostics = inputCommandSnapshots?.getDiagnostics?.() || null;\n562:       inputPendingAtClose = Number.isFinite(initialPending)\n563:         ? Math.max(0, Math.floor(initialPending))\n564:         : Math.max(0, Math.floor(Number(initialDiagnostics?.pending) || 0));\n565:       presentationJournal = null;\n566:       inputTickBoundary.sequence = 0;\n567:       inputTickBoundary.targetTick = 0;\n568:       inputTickBoundary.publishedSequence = 0;\n569:     }\n570: \n571:     const commandSnapshots = inputCommandSnapshots;\n572:     const before = commandSnapshots?.getDiagnostics?.() || null;\n573:     const currentPending = commandSnapshots?.getPendingCount?.();\n574:     let remaining = Number.isFinite(currentPending)\n575:       ? Math.max(0, Math.floor(currentPending))\n576:       : Math.max(0, Math.floor(Number(before?.pending) || 0));\n577:     let attempts = 0;\n578:     const attemptCap = Math.max(1, Number(commandSnapshots?.capacity) || inputCommandSnapshotCapacity);\n579:     while (remaining > 0 && attempts < attemptCap) {\n580:       const snapshotDiagnostics = commandSnapshots?.getDiagnostics?.() || null;\n581:       const sequence = snapshotDiagnostics?.lastReservedSequence;\n582:       if (!Number.isSafeInteger(sequence)\n583:         || typeof commandSnapshots?.cancel !== 'function'\n584:         || commandSnapshots.cancel(sequence) !== true) {\n585:         inputCancell