ventual\n495:    // a bounded autosave never combines pre- and post-purchase inventory states.\n511:    // Death/respawn gate autosave (combat signals via events, not a state.player.dead field).\n537:      // orphan the autosave generation started by `game:new`.\n591:    // progression milestone autosaves, so a player who undocked, flew a minute, and quit lost\n605:    // Warm the save worker once at init: Continue and autosave each pay a Blob-URL spawn +\n719:        // Yield before the push — its JSON.stringify is an unsliced O(store-bytes)\n813:    if (typeof setTimeout === 'function') this._sharedStoreFlushTimer = setTimeout(flush, 0);\n817:  // Interval autosave is the only periodic job; playtime accrual is core's (§ core.preStep).\n822:    const intervalS = (st.settings?.gameplay && st.settings.gameplay.autosaveIntervalS) || 0;\n828:  /** Record a durable mutation for the next save boundary; never serializes live state here. */\n835:    // boundary; a serializer/storage failure leaves the facts queued for a later save.\n868:      ['meta', () => this._serializeMeta()],\n869:      ['player', () => this._serializePlayer()],\n870:      ['cargo', () => this._serializeCargo()],\n872:      // serializer owns the bounded source ledger; save only preserves the dependency order.\n898:      ['entities', () => this._serializeEntities()],\n","exit":0,"truncated":false},"title":"rg -n \"JSON\\.stringify|serialize|autosave|setInterval|setTimeout|structuredClone\" src/save/saveSystem.js -m 40 2>$null | head -40","time":{"start":1792370850004,"end":1792370851100}},"id":"prt_151a0b6900011i4lonO9wYwmS2","sessionID":"ses_eae696937ffe0wN6WZCrNY9lxd","messageID":"msg_151a09549001RBnC8z8jOyUCq8"}}
