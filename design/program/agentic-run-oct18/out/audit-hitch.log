rector reads, and holding it back for a full second of sim makes an\n426:     // update at the same simTime as ensure (fresh boot, the pinned test) emit nothing.\n427:     if (dir._accum < 1 && dir.sessionRhythm != null) return;  // director runs at 1 Hz after baseline\n428: \n429:     const step = dir._accum;\n430:     dir._accum = 0;\n431:     this._accrue(dir, state, step);\n432:     this._tickSessionRhythm(dir, state, now);\n433:     this._tickEscalationSeeds(dir, state, now);\n434:     this._tickDeniableClauses(dir, state, now);\n435:     // The onboarding rail suppresses ordinary pacing, not the authored opening beats:\n436:     // earlyWindowGuaranteeDay items are themselves the first-minute content the rail teaches.\n437:     if (!isDocked(state) && !raceLeaseActive(state)) this._pump(dir, state, now);\n438:     this._tickLive(dir, state, now);\n439:     this._tickStaleEncounters(dir, state, now);\n440:     this._tickHarassMercy(dir, state, now);\n441:     this._tickHostilePursuitResolution(dir, state, now);\n442:     this._tickAmbientPredation(state);\n443:     tickLootSweeps(this._lootSweepCtx());\n444:     // RW-02 second slice: a hot towed bell claims its pursuers on the doctrine clock, and a\n445:     // cooled/severed/consumed one hands them back to the hull. Seeker-round re-acquisition\n446:     // stays on the per-tick weapons path — this is the ship-side twin of the same signature.\n447:     try {\n448:       tickTowedLurePursuits(state, state.player && state.player.tether);\n449:     } catch (err) {\n450:       dedupWarn('encounterDirector/towed-lure-pursuit', '[encounterDirector] towed lure pursuit tick failed', err);\n451:     }\n452:     // CRT-03 second slice: the bought lot hull's nemesis — one cadenced find/track\n453:     // pass per director clock, spawns through the same helpers/budget the scripts use.\n454:     try {\n455:       tickImpoundGrudge(state, this._impoundGrudgeCtx());\n456:     } catch (err) {\n457:       dedupWarn('encounterDirector/impound-grudge', '[encounterDirector] impound grudge tick failed', err);\n458:     }\n459:     this._springCeresActivityAmbushOnPrey();\n460:   },\n461: \n462:   /**\n463:    * Ambient manifest predation — unscripted pirates hunting manifested civilian haulers in\n464:    * low-security, lane-adjacent space. Binding/clearing math lives in src/ai/ambientPredation.js;\n465:    * this seam only supplies the event surface and the physical cargo-pod spawn helper.\n466:    */\n467:   _ambientPredationCtx() {\n468:     return {\n469:       emit: (name, payload) => {\n470:         // Ambient stalks publish encounter:ambientPredationTelegraph. The telegraph\n471:         // path (authored motion and the rest of the convoy contract) listens for\n472:         // encounter:predationTelegraph. Forward once per raid, before the engage\n473:         // commit, without emitting that event again when the stalk commits.\n474:         if (name === 'encounter:ambientPredationTelegraph' && payload) {\n475:           emitPredationStalkTelegraph(this.state, payload, (eventName, eventPayload) => {\n476:             this.emit(eventName, eventPayload);\n477:           });\n478:         }\n479:         this.emit(name, payload);\n480:       },\n481:       docked: isDocked(this.state),\n482:       spawnCargoPod: (s, spec) => spawnJettisonedCargoPod(s, spec, this.helpers),\n483:       removeEntity: (id, opts) => (\n484:         this.helpers && typeof this.helpers.removeEntity === 'function'\n485:           ? this.helpers.removeEntity(id, opts)\n486:           : false\n487:       ),\n488:     };\n489:   },\n\n(Showing lines 400-489 of 5419. Use offset=490 to continue.)\n</content>","metadata":{"preview":"    publishEscalationSeeds([]);\n    // The tactical director reads this published phase — a stale 'quiet' from the previous run\n    // would hold its respite into the new session until the first flight tick republished.\n    publishSessionRhythmPhase(null);\n  },\n\n  update(dt, state) {\n    if (state.mode && state.mode !== 'flight') return;\n    if (state.physicsVenue?.active === true) return;\n    if (state.run?.kind === 'survival' && state.run.phase !== 'inactive') return;\n    if (this._freightCustodyRebindPasses > 0) {\n      this._freightCustodyRebindPasses--;\n      this._restorePersistedFreightCustodies();\n      this._rebindPersistedFreightCustodyCarriers();\n    }\n    const dir = ensureDirectorState(state);\n    this._sampleCeresActivityAmbush(dir, state);\n    const now = state.simTime || 0;\n    // The director is a calendar-clock owner (≈2 Hz straddle), not a per-tick system: `dt` is\n    // always one SIM_DT quantum while ~0.5 s of sim elapses between calls. A call-count","truncated":true,"loaded":[],"display":{"type":"file","path":"C:\\Users\\93rob\\Documents\\GitHub\\SpaceFace\\src\\systems\\encounterDirector.js","text":"    publishEscalationSeeds([]);\n    // The tactical director reads this published phase — a stale 'quiet' from the previous run\n    // would hold its respite into the new session until the first flight tick republished.\n    publishSessionRhythmPhase(null);\n  },\n\n  update(dt, state) {\n    if (state.mode && state.mode !== 'flight') return;\n    if (state.physicsVenue?.active === true) return;\n    if (state.run?.kind === 'survival' && state.run.phase !== 'inactive') return;\n    if (this._freightCustodyRebindPasses > 0) {\n      this._freightCustodyRebindPasses--;\n      this._restorePersistedFreightCustodies();\n      this._rebindPersistedFreightCustodyCarriers();\n    }\n    const dir = ensureDirectorState(state);\n    this._sampleCeresActivityAmbush(dir, state);\n    const now = state.simTime || 0;\n    // The director is a calendar-clock owner (≈2 Hz straddle), not a per-tick system: `dt` is\n    // always one SIM_DT quantum while ~0.5 s of sim elapses between calls. A call-count\n    // accumulator would starve the 1 Hz work to ~1/30 rate — feed it the real sim-time delta.\n    const lastNow = Number.isFinite(dir._lastUpdateNow) ? dir._lastUpdateNow : now;\n    dir._lastUpdateNow = now;\n    dir._accum = (dir._accum || 0) + Math.max(0, now - lastNow);\n    // The 1 Hz accumulator must not starve the rhythm's FIRST publish: the baseline phase is\n    // what the tactical director reads, and holding it back for a full second of sim makes an\n    // update at the same simTime as ensure (fresh boot, the pinned test) emit nothing.\n    if (dir._accum < 1 && dir.sessionRhythm != null) return;  // director runs at 1 Hz after baseline\n\n    const step = dir._accum;\n    dir._accum = 0;\n    this._accrue(dir, state, step);\n    this._tickSessionRhythm(dir, state, now);\n    this._tickEscalationSeeds(dir, state, now);\n    this._tickDeniableClauses(dir, state, now);\n    // The onboarding rail suppresses ordinary pacing, not the authored opening beats:\n    // earlyWindowGuaranteeDay items are themselves the first-minute content the rail teaches.\n    if (!isDocked(state) && !raceLeaseActive(state)) this._pump(dir, state, now);\n    this._tickLive(dir, state, now);\n    this._tickStaleEncounters(dir, state, now);\n    this._tickHarassMercy(dir, state, now);\n    this._tickHostilePursuitResolution(dir, state, now);\n    this._tickAmbientPredation(state);\n    tickLootSweeps(this._lootSweepCtx());\n    // RW-02 second slice: a hot towed bell claims its pursuers on the doctrine clock, and a\n    // cooled/severed/consumed one hands them back to the hull. Seeker-round re-acquisition\n    // stays on the per-tick weapons path — this is the ship-side twin of the same signature.\n    try {\n      tickTowedLurePursuits(state, state.player && state.player.tether);\n    } catch (err) {\n      dedupWarn('encounterDirector/towed-lure-pursuit', '[encounterDirector] towed lure pursuit tick failed', err);\n    }\n    // CRT-03 second slice: the bought lot hull's nemesis — one cadenced find/track\n    // pass per director clock, spawns through the same helpers/budget the scripts use.\n    try {\n      tickImpoundGrudge(state, this._impoundGrudgeCtx());\n    } catch (err) {\n      dedupWarn('encounterDirector/impound-grudge', '[encounterDirector] impound grudge tick failed', err);\n    }\n    this._springCeresActivityAmbushOnPrey();\n  },\n\n  /**\n   * Ambient manifest predation — unscripted pirates hunting manifested civilian haulers in\n   * low-security, lane-adjacent space. Binding/clearing math lives in src/ai/ambientPredation.js;\n   * this seam only supplies the event surface and the physical cargo-pod spawn helper.\n   */\n  _ambientPredationCtx() {\n    return {\n      emit: (name, payload) => {\n        // Ambient stalks publish encounter:ambientPredationTelegraph. The telegraph\n        // path (authored motion and the rest of the convoy contract) listens for\n        // encounter:predationTelegraph. Forward once per raid, before the engage\n        // commit, without emitting that event again when the stalk commits.\n        if (name === 'encounter:ambientPredationTelegraph' && payload) {\n          emitPredationStalkTelegraph(this.state, payload, (eventName, eventPayload) => {\n            this.emit(eventName, eventPayload);\n          });\n        }\n        this.emit(name, payload);\n      },\n      docked: isDocked(this.state),\n      spawnCargoPod: (s, spec) => spawnJettisonedCargoPod(s, spec, this.helpers),\n      removeEntity: (id, opts) => (\n        this.helpers && typeof this.helpers.removeEntity === 'function'\n          ? this.helpers.removeEntity(id, opts)\n          : false\n      ),\n    };\n  },","lineStart":400,"lineEnd":489,"totalLines":5419,"truncated":true}},"title":"src\\systems\\encounterDirector.js","time":{"start":1792371316916,"end":1792371317037}},"id":"prt_151a7d874001TllktCUU25sXHb","sessionID":"ses_eae696937ffe0wN6WZCrNY9lxd","messageID":"msg_151a75643001Oxue93J37CICZB"}}
