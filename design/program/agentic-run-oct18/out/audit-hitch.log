{"type":"tool_use","timestamp":1792370656511,"sessionID":"ses_eae696937ffe0wN6WZCrNY9lxd","part":{"type":"tool","tool":"read","callID":"chatcmpl-tool-a9e4b085932e9f07","state":{"status":"completed","input":{"filePath":"C:\\Users\\93rob\\Documents\\GitHub\\SpaceFace\\src\\systems\\mining.js","limit":160,"offset":303},"output":"<path>C:\\Users\\93rob\\Documents\\GitHub\\SpaceFace\\src\\systems\\mining.js</path>\n<type>file</type>\n<content>\n303:   update(dt, state) {\n304:     resetMiningDiagnostics(this._diag);\n305:     const player = state.entities.get(state.playerId);\n306:     const firing = !!player && player.alive && !player.flags.docked\n307:       && state.mode === 'flight' && state.input.fireGroup === 2;\n308:     if (!firing) {\n309:       this._beamRefusalTold = null;\n310:       this._beamSpentThisHold = false;\n311:       this._emptyBeamTicks = 0;\n312:     }\n313: \n314:     let beam = null;\n315:     if (player) beam = this._beamRuntime(player);\n316: \n317:     // FB-090 quiet latch. Every piece of the tail is provably a no-op at rest when ALL of these\n318:     // hold; the first unlatched tick is what settles them (creates the miningNoise field, emits\n319:     // the beam-cold receipt, parks nothing), so they are arm conditions, not skips-with-drift:\n320:     //   • !firing && !this._beaming        — no beam edge to process\n321:     //   • beam heat fully cooled AND the cold receipt already emitted (else the emit edge is due)\n322:     //   • miningNoise field exists at exactly 0 (undefined refuses so the first write lands)\n323:     //   • richCore absent or resolved; parked ore lists empty; pickup+payload index empty\n324:     //   • entity-index version stable and inside the 0.5 s rescan window\n325:     // The gate below keeps all the real writes on the unlatched path; while latched, every\n326:     // skipped call would only re-derive identical zeros.\n327:     const membership = miningEntityIndexVersion(state);\n328:     const tick = state.tick | 0;\n329:     const heatIdle = beam == null || (!(beam.heat > 0) && this._heatEmitPct === 0);\n330:     const noiseIdle = !!(state.player && state.player.miningNoise === 0);\n331:     const richCore = state.player && state.player.mining && state.player.mining.richCore;\n332:     const coreIdle = !richCore || richCore.resolved === true;\n333:     const parkedIdle = !(this._parkedAsteroids && this._parkedAsteroids.length)\n334:       && !(this._unreleasedOre && this._unreleasedOre.length);\n335:     const pickupsIdle = hasAuthoritativeEmptyPickupIndex(state);\n336:     const stillQuiet = !firing\n337:       && !this._beaming\n338:       && heatIdle\n339:       && noiseIdle\n340:       && coreIdle\n341:       && parkedIdle\n342:       && pickupsIdle\n343:       && membership != null;\n344:     if (MINING_QUIET_LATCH !== false) {\n345:       const quiet = this._miningQuiet;\n346:       if (quiet\n347:           && stillQuiet\n348:           && quiet.membership === membership\n349:           && ((tick - (quiet.armedTick | 0)) < MINING_QUIET_RESCAN_TICKS)) {\n350:         publishMiningQuiet(state, true);\n351:         return;\n352:       }\n353:       this._miningQuiet = stillQuiet ? { membership, armedTick: tick } : null;\n354:       publishMiningQuiet(state, !!this._miningQuiet);\n355:     } else if (this._miningQuiet) {\n356:       this._miningQuiet = null;\n357:       publishMiningQuiet(state, false);\n358:     }\n359: \n360:     this._flushParkedOre();\n361:     if (player) {\n362:       // Heat never gates the beam: a pegged gauge keeps extracting at full rate for as long as the\n363:       // player holds the tool on the rock. The old peg-lockout read heat as a circuit breaker and\n364:       // cut the beam off mid-hold, punishing exactly the sustained mining the tool exists for.\n365:       if (firing && beam) this._runPlayerBeam(player, beam, dt, state);\n366:       else this._stopBeam();\n367:     }\n368:     // Heat runs after the beam so the vent evaluated on a release edge reads the heat the player\n369:     // actually let go at, and so cooling keeps ticking on every frame the beam is off.\n370:     this._updateBeamHeat(beam, this._beaming, dt, state);\n371:     this._updateRichCoreCharge(firing, dt, state);\n372:     this._updateMiningNoise(this._beaming, dt, state);\n373: \n374:     const cargoDirty = collectDirtyIds(state, DIRTY.CARGO | DIRTY.POSE | DIRTY.MEMBERSHIP, this._miningDirtyScratch || (this._miningDirtyScratch = []));\n375:     if (firing || cargoDirty.length > 0 || !hasAuthoritativeEmptyPickupIndex(state)) {\n376:       this._updatePickups(dt, state);\n377:     }\n378:   },\n379: \n380:   // ---- beam runtime resolution ----------------------------------------------\n381:   // The beam's mutable runtime (directToCargo/tierId) lives on the player record;\n382:   // dps/range come from the BEAMS tier table keyed by tierId.\n383:   _beamRuntime(player) {\n384:     const beam = (player.data && player.data.miningBeam) || this.state.player.miningBeam;\n385:     if (!beam) return null;\n386:     const tier = BEAM_BY_ID.get(beam.tierId) || BEAM_BY_ID.get('beam_mk1');\n387:     if (tier) {\n388:       if (!beam.dps) beam.dps = tier.dps;\n389:       if (!beam.range) beam.range = tier.range;\n390:       // Heat is beam-tier state, not a per-save authored value: default it from the table but let an\n391:       // outfitting/module pass override it by writing the field first.\n392:       if (!(beam.heatMax > 0)) beam.heatMax = tier.heatMax || BEAM_HEAT_MAX;\n393:       if (!(beam.heatRate > 0)) beam.heatRate = tier.heatRate || BEAM_HEAT_RATE;\n394:       if (!(beam.coolRate > 0)) beam.coolRate = tier.coolRate || BEAM_COOL_RATE;\n395:     }\n396:     if (!Number.isFinite(beam.heat)) beam.heat = 0;\n397:     return beam;\n398:   },\n399: \n400:   _noteBeamRefusal(reason) {\n401:     const text = BEAM_REFUSAL_TEXT[reason];\n402:     if (!text || !this.bus || this._beamRefusalTold === reason) return;\n403:     this._beamRefusalTold = reason;\n404:     this.bus.emit('toast', { text, kind: 'warn', ttl: 1.6 });\n405:   },\n406: \n407:   _runPlayerBeam(player, beam, dt, state) {\n408:     const target = this._acquireTarget(player, beam.range, state);\n409:     if (!target) {\n410:       this._stopBeam();\n411:       if (!this._beamSpentThisHold) {\n412:         this._emptyBeamTicks = (this._emptyBeamTicks || 0) + 1;\n413:         if (this._emptyBeamTicks >= 2) this._noteBeamRefusal('no-target');\n414:       }\n415:       return;\n416:     }\n417:     this._emptyBeamTicks = 0;\n418:     this._beamSpentThisHold = false;\n419: \n420:     // F12: the same beam, aimed at a jettisoned cargo pod, cracks it open — it never reaches the\n421:     // verb resolver (pods are not mined), never consumes ammo, and never gains a lockout.\n422:     if (isBeamSplittableCargoPod(target)) {\n423:       return this._runCargoPodBeam(player, target, beam, dt, state);\n424:     }\n425: \n426:     // A source-tagged Orchard frame is not a generic salvage wreck. Its selected socket uses the\n427:     // same contextual site beam input, but the native finite ledger and body owner remain the only\n428:     // owners of opening progress and fixed-to-dynamic pod custody.\n429:     if (isOrchardFrameClaim(target)) {\n430:       return this._runOrchardBeam(player, target, beam, dt, state);\n431:     }\n432: \n433:     const desc = describeEntity(state, target);\n434:     if (target.data && target.data.worldSiteId && target.data.worldSiteComponentId) {\n435:       return this._runWorldSiteBeam(player, target, desc, beam, dt, state);\n436:     }\n437:     const toolState = {\n438:       mode: (state.ui && state.ui.beamMode) || (state.player && state.player.beamMode) || 'auto',\n439:       selectedComponentId: (state.ui && state.ui.componentSelection && state.ui.componentSelection.componentId) || null,\n440:       credits: (state.player && state.player.credits) || 0,\n441:       cargo: (state.player && state.player.cargo && state.player.cargo.items) || {},\n442:       receiver: (state.input && state.input.receiver) || null,\n443:     };\n444:     const resolved = resolveBeamVerb(desc, toolState);\n445: \n446:     if (!resolved.ok) {\n447:       this._stopBeam();\n448:       this.bus.emit('beam:denied', { minerId: player.id, targetId: target.id, verb: resolved.verb, reason: resolved.reason });\n449:       this._noteBeamRefusal(resolved.reason);\n450:       return;\n451:     }\n452: \n453:     if (!this._beaming || this._lockTargetId !== target.id || this._activeVerb !== resolved.verb) {\n454:       this._setLockTargetId(target.id);\n455:       this._activeVerb = resolved.verb;\n456:       this.bus.emit('mining:start', {\n457:         minerId: player.id,\n458:         targetId: target.id,\n459:         verb: resolved.verb,\n460:         position: { x: target.pos.x, z: target.pos.z }\n461:       });\n462:     }\n\n(Showing lines 303-462 of 3464. Use offset=463 to continue.)\n</content>","metadata":{"preview":"  update(dt, state) {\n    resetMiningDiagnostics(this._diag);\n    const player = state.entities.get(state.playerId);\n    const firing = !!player && player.alive && !player.flags.docked\n      && state.mode === 'flight' && state.input.fireGroup === 2;\n    if (!firing) {\n      this._beamRefusalTold = null;\n      this._beamSpentThisHold = false;\n      this._emptyBeamTicks = 0;\n    }\n\n    let beam = null;\n    if (player) beam = this._beamRuntime(player);\n\n    // FB-090 quiet latch. Every piece of the tail is provably a no-op at rest when ALL of these\n    // hold; the first unlatched tick is what settles them (creates the miningNoise field, emits\n    // the beam-cold receipt, parks nothing), so they are arm conditions, not skips-with-drift:\n    //   • !firing && !this._beaming        — no beam edge to process\n    //   • beam heat fully cooled AND the cold receipt already emitted (else the emit edge is due)\n    //   • miningNoise field exists at exactly 0 (undefined refuses so the first write lands)","truncated":true,"loaded":[],"display":{"type":"file","path":"C:\\Users\\93rob\\Documents\\GitHub\\SpaceFace\\src\\systems\\mining.js","text":"  update(dt, state) {\n    resetMiningDiagnostics(this._diag);\n    const player = state.entities.get(state.playerId);\n    const firing = !!player && player.alive && !player.flags.docked\n      && state.mode === 'flight' && state.input.fireGroup === 2;\n    if (!firing) {\n      this._beamRefusalTold = null;\n      this._beamSpentThisHold = false;\n      this._emptyBeamTicks = 0;\n    }\n\n    let beam = null;\n    if (player) beam = this._beamRuntime(player);\n\n    // FB-090 quiet latch. Every piece of the tail is provably a no-op at rest when ALL of these\n    // hold; the first unlatched tick is what settles them (creates the miningNoise field, emits\n    // the beam-cold receipt, parks nothing), so they are arm conditions, not skips-with-drift:\n    //   • !firing && !this._beaming        — no beam edge to process\n    //   • beam heat fully cooled AND the cold receipt already emitted (else the emit edge is due)\n    //   • miningNoise field exists at exactly 0 (undefined refuses so the first write lands)\n    //   • richCore absent or resolved; parked ore lists empty; pickup+payload index empty\n    //   • entity-index version stable and inside the 0.5 s rescan window\n    // The gate below keeps all the real writes on the unlatched path; while latched, every\n    // skipped call would only re-derive identical zeros.\n    const membership = miningEntityIndexVersion(state);\n    const tick = state.tick | 0;\n    const heatIdle = beam == null || (!(beam.heat > 0) && this._heatEmitPct === 0);\n    const noiseIdle = !!(state.player && state.player.miningNoise === 0);\n    const richCore = state.player && state.player.mining && state.player.mining.richCore;\n    const coreIdle = !richCore || richCore.resolved === true;\n    const parkedIdle = !(this._parkedAsteroids && this._parkedAsteroids.length)\n      && !(this._unreleasedOre && this._unreleasedOre.length);\n    const pickupsIdle = hasAuthoritativeEmptyPickupIndex(state);\n    const stillQuiet = !firing\n      && !this._beaming\n      && heatIdle\n      && noiseIdle\n      && coreIdle\n      && parkedIdle\n      && pickupsIdle\n      && membership != null;\n    if (MINING_QUIET_LATCH !== false) {\n      const quiet = this._miningQuiet;\n      if (quiet\n          && stillQuiet\n          && quiet.membership === membership\n          && ((tick - (quiet.armedTick | 0)) < MINING_QUIET_RESCAN_TICKS)) {\n        publishMiningQuiet(state, true);\n        return;\n      }\n      this._miningQuiet = stillQuiet ? { membership, armedTick: tick } : null;\n      publishMiningQuiet(state, !!this._miningQuiet);\n    } else if (this._miningQuiet) {\n      this._miningQuiet = null;\n      publishMiningQuiet(state, false);\n    }\n\n    this._flushParkedOre();\n    if (player) {\n      // Heat never gates the beam: a pegged gauge keeps extracting at full rate for as long as the\n      // player holds the tool on the rock. The old peg-lockout read heat as a circuit breaker and\n      // cut the beam off mid-hold, punishing exactly the sustained mining the tool exists for.\n      if (firing && beam) this._runPlayerBeam(player, beam, dt, state);\n      else this._stopBeam();\n    }\n    // Heat runs after the beam so the vent evaluated on a release edge reads the heat the player\n    // actually let go at, and so cooling keeps ticking on every frame the beam is off.\n    this._updateBeamHeat(beam, this._beaming, dt, state);\n    this._updateRichCoreCharge(firing, dt, state);\n    this._updateMiningNoise(this._beaming, dt, state);\n\n    const cargoDirty = collectDirtyIds(state, DIRTY.CARGO | DIRTY.POSE | DIRTY.MEMBERSHIP, this._miningDirtyScratch || (this._miningDirtyScratch = []));\n    if (firing || cargoDirty.length > 0 || !hasAuthoritativeEmptyPickupIndex(state)) {\n      this._updatePickups(dt, state);\n    }\n  },\n\n  // ---- beam runtime resolution ----------------------------------------------\n  // The beam's mutable runtime (directToCargo/tierId) lives on the player record;\n  // dps/range come from the BEAMS tier table keyed by tierId.\n  _beamRuntime(player) {\n    const beam = (player.data && player.data.miningBeam) || this.state.player.miningBeam;\n    if (!beam) return null;\n    const tier = BEAM_BY_ID.get(beam.tierId) || BEAM_BY_ID.get('beam_mk1');\n    if (tier) {\n      if (!beam.dps) beam.dps = tier.dps;\n      if (!beam.range) beam.range = tier.range;\n      // Heat is beam-tier state, not a per-save authored value: default it from the table but let an\n      // outfitting/module pass override it by writing the field first.\n      if (!(beam.heatMax > 0)) beam.heatMax = tier.heatMax || BEAM_HEAT_MAX;\n      if (!(beam.heatRate > 0)) beam.heatRate = tier.heatRate || BEAM_HEAT_RATE;\n      if (!(beam.coolRate > 0)) beam.coolRate = tier.coolRate || BEAM_COOL_RATE;\n    }\n    if (!Number.isFinite(beam.heat)) beam.heat = 0;\n    return beam;\n  },\n\n  _noteBeamRefusal(reason) {\n    const text = BEAM_REFUSAL_TEXT[reason];\n    if (!text || !this.bus || this._beamRefusalTold === reason) return;\n    this._beamRefusalTold = reason;\n    this.bus.emit('toast', { text, kind: 'warn', ttl: 1.6 });\n  },\n\n  _runPlayerBeam(player, beam, dt, state) {\n    const target = this._acquireTarget(player, beam.range, state);\n    if (!target) {\n      this._stopBeam();\n      if (!this._beamSpentThisHold) {\n        this._emptyBeamTicks = (this._emptyBeamTicks || 0) + 1;\n        if (this._emptyBeamTicks >= 2) this._noteBeamRefusal('no-target');\n      }\n      return;\n    }\n    this._emptyBeamTicks = 0;\n    this._beamSpentThisHold = false;\n\n    // F12: the same beam, aimed at a jettisoned cargo pod, cracks it open — it never reaches the\n    // verb resolver (pods are not mined), never consumes ammo, and never gains a lockout.\n    if (isBeamSplittableCargoPod(target)) {\n      return this._runCargoPodBeam(player, target, beam, dt, state);\n    }\n\n    // A source-tagged Orchard frame is not a generic salvage wreck. Its selected socket uses the\n    // same contextual site beam input, but the native finite ledger and body owner remain the only\n    // owners of opening progress and fixed-to-dynamic pod custody.\n    if (isOrchardFrameClaim(target)) {\n      return this._runOrchardBeam(player, target, beam, dt, state);\n    }\n\n    const desc = describeEntity(state, target);\n    if (target.data && target.data.worldSiteId && target.data.worldSiteComponentId) {\n      return this._runWorldSiteBeam(player, target, desc, beam, dt, state);\n    }\n    const toolState = {\n      mode: (state.ui && state.ui.beamMode) || (state.player && state.player.beamMode) || 'auto',\n      selectedComponentId: (state.ui && state.ui.componentSelection && state.ui.componentSelection.componentId) || null,\n      credits: (state.player && state.player.credits) || 0,\n      cargo: (state.player && state.player.cargo && state.player.cargo.items) || {},\n      receiver: (state.input && state.input.receiver) || null,\n    };\n    const resolved = resolveBeamVerb(desc, toolState);\n\n    if (!resolved.ok) {\n      this._stopBeam();\n      this.bus.emit('beam:denied', { minerId: player.id, targetId: target.id, verb: resolved.verb, reason: resolved.reason });\n      this._noteBeamRefusal(resolved.reason);\n      return;\n    }\n\n    if (!this._beaming || this._lockTargetId !== target.id || this._activeVerb !== resolved.verb) {\n      this._setLockTargetId(target.id);\n      this._activeVerb = resolved.verb;\n      this.bus.emit('mining:start', {\n        minerId: player.id,\n        targetId: target.id,\n        verb: resolved.verb,\n        position: { x: target.pos.x, z: target.pos.z }\n      });\n    }","lineStart":303,"lineEnd":462,"totalLines":3464,"truncated":true}},"title":"src\\systems\\mining.js","time":{"start":1792370656395,"end":1792370656504}},"id":"prt_1519dc2d2001QAzN9yBqG2v2aL","sessionID":"ses_eae696937ffe0wN6WZCrNY9lxd","messageID":"msg_1519dae92001h0c465WmUOSko2"}}
{"type":"tool_use","timestamp":1792370656857,"sessionID":"ses_eae696937ffe0wN6WZCrNY9lxd","part":{"type":"tool","tool":"read","callID":"chatcmpl-tool-8f0b7e5de58e9781","state":{"status":"completed","input":{"filePath":"C:\\Users\\93rob\\Documents\\GitHub\\SpaceFace\\src\\systems\\wingmen.js","limit":110,"offset":173},"output":"<path>C:\\Users\\93rob\\Documents\\GitHub\\SpaceFace\\src\\systems\\wingmen.js</path>\n<type>file</type>\n<content>\n173:   update(dt, state) {\n174:     if (state.mode !== 'flight') return;\n175:     const fleet = state.automation && state.automation.fleet;\n176:     if (!fleet || !fleet.length) {\n177:       if (this._wingmenQuiet) { this._wingmenQuiet = null; }\n178:       publishWingmenQuiet(state, true);\n179:       return;\n180:     }\n181: \n182:     // FB-090 quiet latch: while no fleet row carries a live entity, every row below hits the\n183:     // `!fs._liveId → continue` arm — a proven no-op except the ordered-fleet rebuild itself.\n184:     // Wake paths: sector:enter/despawn/order subscribers clear the latch; a fleet row gaining a\n185:     // live id is detected by the live-row count (the latch stores fleet identity+size so ledger\n186:     // membership edits also disarm), and the 30-tick rescan bounds any silent ledger mutation.\n187:     const tick = state.tick | 0;\n188:     let liveRows = 0;\n189:     for (const fs of fleet) { if (fs._liveId) liveRows++; }\n190:     if (WINGMEN_QUIET_LATCH !== false) {\n191:       const quiet = this._wingmenQuiet;\n192:       if (quiet\n193:           && liveRows === 0\n194:           && quiet.fleet === fleet\n195:           && quiet.size === fleet.length\n196:           && ((tick - (quiet.armedTick | 0)) < WINGMEN_QUIET_RESCAN_TICKS)) {\n197:         publishWingmenQuiet(state, true);\n198:         return;\n199:       }\n200:       this._wingmenQuiet = (liveRows === 0)\n201:         ? { fleet, size: fleet.length, armedTick: tick }\n202:         : null;\n203:       publishWingmenQuiet(state, !!this._wingmenQuiet);\n204:     }\n205: \n206:     // Sync live wingman hull% back to the fleet ledger, and detect deaths. We track the live entity\n207:     // id on the fleet entry (fs._liveId) at spawn time; here we read it back.\n208:     const orderedFleet = this._orderedFleetFor(fleet);\n209:     const player = state.entities.get(state.playerId);\n210:     for (let index = 0; index < orderedFleet.length; index++) {\n211:       const fs = orderedFleet[index];\n212:       if (!fs._liveId) continue;\n213:       const e = state.entities.get(fs._liveId);\n214:       if (!e || !e.alive) {\n215:         this._clearBrace(fs, e);\n216:         // Wingman died in combat. Route through the existing onHitAsset path so the ledger stays\n217:         // consistent + the LOST/asset-lost flow fires (same as the pre-P1-8 passive path).\n218:         fs.hp = 0; fs.hullPct = 0;\n219:         this.bus.emit('combat:hitAsset', { assetKind: 'fleet', assetId: fs.id, dmg: 9999, killerId: null });\n220:         // One named line per death. Clearing _liveId below keeps later ticks silent.\n221:         const name = (fs.customName || fs.name) || 'Wingman';\n222:         this.bus.emit('toast', { text: 'Wingman down — ' + name, kind: 'error', ttl: 4 });\n223:         fs._liveId = null;\n224:         continue;\n225:       }\n226:       if (player) {\n227:         if (fs.order === 'mine') {\n228:           this._clearBrace(fs, e);\n229:           this._applyMiningOrder(fs, e, player, dt, state);\n230:         } else this._applyWingOrder(fs, e, player, index, orderedFleet.length);\n231:       }\n232:       // Sync hull% so the AutomationPanel health bar reflects live combat damage.\n233:       fs.hullPct = e.hullMax > 0 ? Math.max(0, e.hull / e.hullMax) : 0;\n234:       fs.hp = fs.hullPct;\n235:       fs.status = e.alive ? (fs.order || 'escort') : 'lost';\n236:     }\n237:   },\n238: \n239:   _spawnWingmen() {\n240:     // Sync lane (emit listener): drain the chunked steps inline — the census\n241:     // drive holds the same generator across its slices.\n242:     for (const _ of this._spawnWingmenSteps()) { /* inline */ }\n243:   },\n244: \n245:   *_spawnWingmenSteps() {\n246:     const state = this.state;\n247:     const fleet = state.automation && state.automation.fleet;\n248:     if (!fleet || !fleet.length) return;\n249:     const player = state.entities.get(state.playerId);\n250:     if (!player) return;\n251: \n252:     let spawned = 0;\n253:     const ordered = this._orderedFleetFor(fleet);\n254:     for (const fs of fleet.slice()) {\n255:       yield;\n256:       if (fs._liveId) continue; // already live (continuous handoff or same-sector re-enter)\n257:       const spec = this._buildWingmanSpec(fs, player);\n258:       if (!spec) continue;\n259:       const e = this.helpers.spawnEntity(spec);\n260:       fs._liveId = e.id;\n261:       e.data.wingmanOf = fs.id; // link live entity → fleet ledger entry\n262:       e.data.isWingman = true;  // flag for render/AI (friend marker, no bounty, no loot)\n263:       this._applyWingOrder(fs, e, player, ordered.indexOf(fs), ordered.length);\n264:       spawned++;\n265:     }\n266:     // Toast only when new wingmen materialize — continuous membership re-entry must not re-bark.\n267:     if (spawned > 0) {\n268:       this.bus.emit('toast', { text: spawned + ' wingman' + (spawned > 1 ? 's' : '') + ' deployed', kind: 'good', ttl: 3 });\n269:     }\n270:   },\n271: \n272:   _despawnWingmen() {\n273:     const state = this.state;\n274:     const fleet = state.automation && state.automation.fleet;\n275:     if (!fleet) return;\n276:     for (const fs of fleet) {\n277:       if (fs._liveId && state.entities) {\n278:         this._clearBrace(fs, state.entities.get(fs._liveId));\n279:         const e = state.entities.get(fs._liveId);\n280:         // Capture the last hit even when a hard transition lands before our next update.\n281:         // This is the same persisted fraction used by the normal live synchro