ime.classifiedTick = -1;\n2118:   runtime.classifiedStaticAuthority = null;\n2119:   runtime._staticMembershipDirty = true;\n2120:   if (runtime._dynamicEntities) runtime._dynamicEntities.length = 0;\n2121:   // A restore can keep the index version unchanged while the id set moved — force the next\n2122:   // classify pass to run the prune sweep rather than trusting the carried membership stamp.\n2123:   runtime._lastPruneMembership = undefined;\n2124:   runtime._lastPruneLiveCount = -1;\n2125:   return true;\n2126: }\n2127: \n2128: /**\n2129:  * Return the live owner view for this tick. These arrays are scratch-owned by the activity pass;\n2130:  * callers must consume them synchronously and never persist or mutate the array itself.\n2131:  */\n2132: export function getActivityOwnerEntities(state, owner = 'ai') {\n2133:   const runtime = ensureActivityClassified(state);\n2134:   if (!runtime) return [];\n2135:   consumeActivityWakesAtOwnerBoundary(state, runtime);\n2136:   return owner === 'traffic' ? runtime.activeTrafficEntities : runtime.activeAiEntities;\n2137: }\n2138: \n2139: function setDueLiveWake(entity, simTime, nextEventAtT) {\n2140:   if (!entity) return;\n2141:   const next = Number.isFinite(nextEventAtT) && nextEventAtT > simTime ? nextEventAtT : null;\n2142:   const activity = entity.activity;\n2143:   if (activity && dueAt(activity.nextEventAtT, simTime) != null) {\n2144:     activity.nextEventAtT = next == null ? -1 : next;\n2145:   }\n2146:   const data = entity.data;\n2147:   if (data && dueAt(data.nextEventAtT, simTime) != null) data.nextEventAtT = next;\n2148:   const ai = ownerAiRecord(entity);\n2149:   if (ai && dueAt(ai.nextEventAtT, simTime) != null) ai.nextEventAtT = next;\n2150:   const aiActivity = ai && ai.activity && typeof ai.activity === 'object' ? ai.activity : null;\n2151:   if (aiActivity && dueAt(aiActivity.nextEventAtT, simTime) != null) {\n2152:     aiActivity.nextEventAtT = next == null ? -1 : next;\n2153:   }\n2154: }\n2155: 