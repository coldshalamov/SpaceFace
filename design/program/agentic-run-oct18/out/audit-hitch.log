{"type":"tool_use","timestamp":1792370215551,"sessionID":"ses_eae696937ffe0wN6WZCrNY9lxd","part":{"type":"tool","tool":"read","callID":"chatcmpl-tool-b9db19e4f7b7692a","state":{"status":"completed","input":{"filePath":"C:\\Users\\93rob\\Documents\\GitHub\\SpaceFace\\src\\core\\eventBus.js"},"output":"<path>C:\\Users\\93rob\\Documents\\GitHub\\SpaceFace\\src\\core\\eventBus.js</path>\n<type>file</type>\n<content>\n1: // Synchronous event bus with a deferred queue (ARCHITECTURE §4). Most events fire\n2: // synchronously; entity spawn/destroy are queued and flushed at the end of a sim step\n3: // so the entity set is never mutated mid-iteration.\n4: //\n5: // `sector:enter` may be count-sliced: the first budget of listeners still runs inside\n6: // enterSector, leftover presentation listeners drain after present. Default budget 0\n7: // keeps every emit fully synchronous (tests, boot, Continue).\n8: \n9: import {\n10:   notePacedFrameSpend,\n11:   pacedFrameSpend,\n12:   PACED_FRAME_BUDGET_MS,\n13: } from '../render/decodeTaskBudget.js';\n14: \n15: export const SECTOR_ENTER_LISTENER_BUDGET = 32;\n16: export const SECTOR_ENTER_DRAIN_BUDGET = 4;\n17: // Presentation-tier listeners (bus.on(event, fn, { presentation: true })): burst events like\n18: // entity:killed / entity:destroyed fan out to ~dozen presentation-pure tails that used to run\n19: // inside the emit — mid-tick for synchronous events, inside the flush task for queued ones.\n20: // Once a presentation runner claims the drain, those tails enqueue and run a bounded number\n21: // per frame; the sim tail still executes in-tick exactly as before. Without a claim (headless\n22: // sims, tests) presentation listeners dispatch inline at emit — identical to a plain listener.\n23: export const PRESENTATION_LISTENER_DRAIN_BUDGET = 8;\n24: // Sliced emits that stack up behind a drain that couldn't finish inside its wall-clock cap\n25: // queue here rather than being lost. The queue is bounded — past the cap the oldest entry is\n26: // delivered fully inline at push. That preserves the one contract the queue exists to keep\n27: // (no listener is ever skipped); it does not promise that delivery stays sliced.\n28: export const MAX_QUEUED_SLICED_EMITS = 8;\n29: \n30: // A persistently-throwing listener on a hot event used to pay a full Error +\n31: // stack serialization per emit — emit-rate volume for the rest of the session.\n32: // Per-event storm dedup (the laneWarn shape): the first few faults log verbatim,\n33: // the storm folds into a suppressed count re-summarized on a >=1 s heartbeat.\n34: //\n35: // Rows hang off the listener itself (WeakMap → [{ label, event, ... }]) — a\n36: // re-registered listener folds into the same row because its fn identity never\n37: // changes, and the per-fault path is one map hop + a === scan instead of the\n38: // old `${label}|${event}|${token}` composite string mint per throw. Non-function\n39: // listeners (none today — defensive) hold a parallel keyed Map so WeakMap key\n40: // typing never breaks the fault path. The bounded index owns retained rows;\n41: // eviction removes the listener lookup too, so a later fault is indexed anew.\n42: const BUS_ERROR_VERBATIM = 8;\n43: const BUS_ERROR_CAP = 256;\n44: const BUS_ERROR_INDEX_CAP = 512;\n45: const busErrorRows = new WeakMap(); // fn -> [{ label, event, logged, suppressed, faults, lastWarnAt, lastErrorHead }]\n46: const busErrorRowsByKey = new Map(); // non-function listener key -> same rows\n47: const busErrorIndex = new Set(); // every minted row, insertion-ordered, oldest-evict at cap\n48: \n49: function rowsForBusListener(listener) {\n50:   if (typeof listener === 'function') {\n51:     let rows = busErrorRows.get(listener);\n52:     if (!rows) { rows = []; busErrorRows.set(listener, rows); }\n53:     return rows;\n54:   }\n55:   const key = listener === undefined ? '?' : listener;\n56:   let rows = busErrorRowsByKey.get(key);\n57:   if (!rows) {\n58:     if (busErrorRowsByKey.size >= BUS_ERROR_CAP) {\n59:       // Oldest-row evict, not clear(): a cap-hit wipe re-arms every storming\n60:       // key's verbatim budget simultaneously and erases accrued suppressed\n61:       // counts before their heartbeat can report them. The evicted key's rows\n62:       // leave the index too — keeping them would double-count the re-minted\n63:       // logical row once that listener faults again.\n64:       const oldest = busErrorRowsByKey.keys().next();\n65:       if (!oldest.done) {\n66:         const evicted = busErrorRowsByKey.get(oldest.value);\n67:         busErrorRowsByKey.delete(oldest.value);\n68:         if (evicted) for (const row of evicted) busErrorIndex.delete(row);\n69:       }\n70:     }\n71:     rows = [];\n72:     busErrorRowsByKey.set(key, rows);\n73:   }\n74:   return rows;\n75: }\n76: \n77: // Fault history may suppress logs, never delivery: the next payload can be valid,\n78: // and gameplay must not depend on a wall-clock cooldown or another bus's faults.\n79: function invokeBusListener(fn, payload, event, label) {\n80:   try { fn(payload, event); }\n81:   catch (err) {\n82:     try { noteBusHandlerError(event, err, label, fn); }\n83:     catch (_) { /* Diagnostics, including the logger, must never interrupt delivery. */ }\n84:   }\n85: }\n86: \n87: function busErrorHead(error) {\n88:   try {\n89:     const message = error?.message;\n90:     return (typeof message === 'string' ? message : String(error)).slice(0, 160);\n91:   } catch (_) {\n92:     return '(unprintable thrown value)';\n93:   }\n94: }\n95: \n96: function noteBusHandlerError(event, err, label, listener) {\n97:   const now = (typeof performance !== 'undefined' && typeof performance.now === 'function')\n98:     ? performance.now() : Date.now();\n99:   // Per-listener row: an event-level row let one storming handler consume the\n100:   // verbatim budget for every faulting listener on that event — the second\n101:   // distinct fault's identity never appeared verbatim.\n102:   const rows = rowsForBusListener(listener);\n103:   let entry = null;\n104:   for (let i = 0; i < rows.length; i++) {\n105:     const row = rows[i];\n106:     if (row.label === label && row.event === event) { entry = row; break; }\n107:   }\n108:   if (!entry) {\n109:     if (busErrorIndex.size >= BUS_ERROR_INDEX_CAP) {\n110:       const oldest = busErrorIndex.values().next();\n111:       if (!oldest.done) {\n112:         const retired = oldest.value;\n113:         busErrorIndex.delete(retired);\n114:         retired.rows.splice(retired.rows.indexOf(retired), 1);\n115:       }\n116:     }\n117:     entry = { rows, label, event, logged: 0, suppressed: 0, faults: 0, lastWarnAt: -Infinity, lastErrorHead: null, heartbeatMs: 1000 };\n118:     rows.push(entry);\n119:     busErrorIndex.add(entry);\n120:   }\n121:   entry.faults += 1;\n122:   entry.lastErrorHead = busErrorHead(err);\n123:   // Refresh recency: Set.add alone does not reorder, so without the delete a\n124:   // row that keeps storming drifts to the oldest end of the index and gets\n125:   // evicted mid-storm — invisible to busFaultSummary, and the splice that\n126:   // follows would re-arm its verbatim budget.\n127:   busErrorIndex.delete(entry);\n128:   busErrorIndex.add(entry);\n129:   if (entry.logged < BUS_ERROR_VERBATIM) {\n130:     entry.logged += 1;\n131:     console.error(`[bus] ${label} for \"${event}\":`, err);\n132:     return;\n133:   }\n134:   entry.suppressed += 1;\n135:   // Exponentially-backing-off heartbeat (1 s doubling to a 30 s cap — the\n136:   // same shape as warnDedup/tryPresentedCall): a persistently-faulting\n137:   // listener's storm still reports its volume without paying a flat ~1\n138:   // console.error+stack-serialize per second for the whole storm.\n139:   // Heal proxy: a >60 s quiet gap re-arms the short cadence so a fresh\n140:   // storm doesn't inherit the previous one's backed-off interval.\n141:   if (now - entry.lastWarnAt >= 60000) entry.heartbeatMs = 1000;\n142:   if (now - entry.lastWarnAt >= entry.heartbeatMs) {\n143:     entry.lastWarnAt = now;\n144:     entry.heartbeatMs = Math.min(entry.heartbeatMs * 2, 30000);\n145:     console.error(\n146:       `[bus] ${label} for \"${event}\": ${entry.suppressed} further fault(s) suppressed; latest:`,\n147:       err,\n148:     );\n149:     entry.suppressed = 0;\n150:   }\n151: }\n152: \n153: // Name the hot throwing listeners — the dominant per-fault cost (Error+stack\n154: // inside the thrower) is only fixable once forensics can see WHO storms. Top-N\n155: // by total faults, read by render diagnostics next to laneFaults.\n156: export function busFaultSummary(limit = 8) {\n157:   const rows = [];\n158:   for (const entry of busErrorIndex) {\n159:     if (entry.faults > 0) {\n160:       rows.push({\n161:         label: entry.label,\n162:         event: entry.event,\n163:         faults: entry.faults,\n164:         suppressed: entry.suppressed,\n165:         lastErrorHead: entry.lastErrorHead,\n166:         lastWarnAt: entry.lastWarnAt,\n167:       });\n168:     }\n169:   }\n170:   rows.sort((a, b) => b.faults - a.faults);\n171:   return rows.slice(0, Math.max(0, limit | 0));\n172: }\n173: \n174: function dispatchRange(fns, payload, event, start, end) {\n175:   const last = Math.min(fns.length, end);\n176:   let i = start;\n177:   for (; i < last; i++) {\n178:     invokeBusListener(fns[i], payload, event, 'handler error');\n179:   }\n180:   return i;\n181: }\n182: \n183: export function createBus() {\n184:   const listeners = new Map(); // event -> Set<fn>\n185:   const listenerSnapshots = new Map(); // event -> { dirty, fns }\n186:   const presentationSets = new Map(); // event -> Set<fn> (presentation-tier listeners)\n187:   const presentationSnaps = new Map();\n188:   const presentationQueue = []; // [{ event, payload, fns, index }] — drained per frame\n189:   // Lifecycle-class events drain ahead of cosmetic slices: entity:destroyed carries the\n190:   // corpse-mesh unbind (plus tag/doctrine/residency cleanup) — a starved frame that\n191:   // dropped its slice would leave a dead hull on the glass until the residency poll\n192:   // self-healed. Whole-event promotion keeps in-event FIFO; only cross-event order moves.\n193:   const PRESENTATION_PRIORITY_EVENTS = new Set(['entity:destroyed']);\n194:   const presentationPriorityQueue = [];\n195:   // Once-only cosmetic events (spawn tails carry materializeT0/spiralDone stamps whose loss\n196:   // is a permanent pop-in) get their own overflow floor above the generic cosmetic one — a\n197:   // sustained destroyed burst sheds lifecycle slices long before it can evict the last\n198:   // once-only stamps. Tracked as a count so the trim scan stays O(1) on the common path.\n199:   const PRESENTATION_ONCE_ONLY_EVENTS = new Set(['entity:spawned']);\n200:   const PRESENTATION_PRIORITY_INTERLEAVE = 8;\n201:   let presentationOnceOnlyCount = 0;\n202:   const presentationSlicePool = [];\n203:   // Pooled-payload events (physics:impact, combat:damage refill one record per emit) register\n204:   // an emit-time snapshotter: a queued presentation tail must read the fields a synchronous\n205:   // listener saw — not the values the next emit refilled before the frame drain ran.\n206:   const payloadSnapshots = new Map(); // event -> payload => clonedPayload\n207:   let presentationDrainClaimed = false;\n208:   let deferred = [];\n209:   const deferredPool = [];\n210:   const sliceBudgets = new Map();\n211:   let emitSlice = null;\n212:   // Sliced emits that arrived while a predecessor tail still lived past its\n213:   // wall-clock cap — started in order when that tail finishes.\n214:   const pendingSlicedEmits = [];\n215:   // The frame-loop owner suspends slicing while no presented frame exists to\n216:   // protect (loading, hidden, suspended): slicing's only purpose is to bound a\n217:   // task inside a frame, so while suspended emits deliver inline and anything\n218:   // already parked flushes at the transition.\n219:   let emitSliceSuspended = false;\n220:   // Bumped by clear(): a flush mid-stack that captured its batch pre-teardown must not deliver\n221:   // the rest of it into listeners bound on the new bus.\n222:   let generation = 0;\n223: \n224:   function invalidateSnapshot(snaps, event) {\n225:     const snap = snaps.get(event);\n226:     if (snap) snap.dirty = true;\n227:   }\n228: \n229:   function on(event, fn, opts = null) {\n230:     const presentation = !!(opts && opts.presentation === true);\n231:     const table = presentation ? presentationSets : listeners;\n232:     const snaps = presentation ? presentationSnaps : listenerSnapshots;\n233:     let set = table.get(event);\n234:     if (!set) { set = new Set(); table.set(event, set); }\n235:     set.add(fn);\n236:     invalidateSnapshot(snaps, event);\n237:     return () => off(event, fn);\n238:   }\n239: \n240:   function off(event, fn) {\n241:     for (const [table, snaps] of [[listeners, listenerSnapshots], [presentationSets, presentationSnaps]]) {\n242:       const set = table.get(event);\n243:       if (!set) continue;\n244:       if (set.delete(fn)) invalidateSnapshot(snaps, event);\n245:       if (set.size === 0) table.delete(event);\n246:     }\n247:   }\n248: \n249:   function once(event, fn) {\n250:     // The fired guard must be set BEFORE unsubscribing: an earlier listener that recursively\n251:     // re-emits snapshots this wrapper while it is still subscribed, and the outer dispatch's\n252:     // captured copy must find it already spent. Snapshot semantics are preserved — the wrapper\n253:     // may still be invoked by an in-flight array, it just no-ops.\n254:     let fired = false;\n255:     const unsub = on(event, (p, e) => {\n256:       if (fired) return;\n257:       fired = true;\n258:       unsub();\n259:       fn(p, e);\n260:     });\n261:     return unsub;\n262:   }\n263: \n264:   function snapshotListeners(table, snaps, event) {\n265:     const set = table.get(event);\n266:     if (!set || set.size === 0) return null;\n267:     let snap = snaps.get(event);\n268:     if (!snap) {\n269:       snap = { dirty: true, fns: null };\n270:       snaps.set(event, snap);\n271:     }\n272:     if (snap.dirty) {\n273:       // Publish a NEW array instead of mutating snap.fns in place: an emit already iterating the\n274:       // old array (re-entrant emit of the same event, or a listener that on/off's mid-dispatch)\n275:       // keeps its captured set, exactly like a per-emit copy — without the per-emit copy.\n276:       const fns = new Array(set.size);\n277:       let i = 0;\n278:       set.forEach((fn) => { fns[i++] = fn; });\n279:       snap.fns = fns;\n280:       snap.dirty = false;\n281:     }\n282:     return snap.fns;\n283:   }\n284: \n285:   function dispatchPresentation(event, payload) {\n286:     const fns = snapshotListeners(presentationSets, presentationSnaps, event);\n287:     if (!fns) return;\n288:     if (!presentationDrainClaimed) {\n289:       // No runner owns the frame pump — dispatch inline so headless sims and tests observe the\n290:       // same synchronous listener contract they always had.\n291:       dispatchRange(fns, payload, event, 0, fns.length);\n292:       return;\n293:     }\n294:     const snapshot = payloadSnapshots.get(event);\n295:     const slice = presentationSlicePool.pop() || { event: null, payload: null, fns: null, index: 0 };\n296:     slice.event = event;\n297:     slice.payload = snapshot ? snapshot(payload) : payload;\n298:     slice.fns = fns;\n299:     slice.index = 0;\n300:     const priority = PRESENTATION_PRIORITY_EVENTS.has(event);\n301:     (priority ? presentationPriorityQueue : presentationQueue).push(slice);\n302:     if (!priority && PRESENTATION_ONCE_ONLY_EVENTS.has(event)) presentationOnceOnlyCount += 1;\n303:     // A claimed-but-unpumped drain (hidden tab, suspended shell) must not accumulate\n304:     // unboundedly: drop the oldest slices past the cap — losing a mid-burst visual tail is\n305:     // cheaper than minutes of deferred drain when the pump resumes. Cosmetic slices drop\n306:     // first, but only down to a floor: spawn tails carry once-only stamps (materializeT0,\n307:     // spiralDone) whose loss is a permanent pop-in, while a dropped lifecycle slice leaves a\n308:     // dead hull the residency poll self-heals. Once-only cosmetics get their own deeper\n309:     // floor — while it holds, the priority lane sheds its own oldest instead of evicting\n310:     // the last spawn stamps.\n311:     const COSMETIC_OVERFLOW_FLOOR = 16;\n312:     const ONCE_ONLY_OVERFLOW_FLOOR = 32;\n313:     let overflow = presentationQueue.length + presentationPriorityQueue.length - 64;\n314:     while (overflow-- > 0) {\n315:       const dropCosmetic = presentationPriorityQueue.length === 0\n316:         || presentationQueue.length > COSMETIC_OVERFLOW_FLOOR;\n317:       if (dropCosmetic) {\n318:         let dropIndex = -1;\n319:         // Prefer the oldest non-once-only cosmetic whether or not the priority lane is\n320:         // populated — a lifecycle slice self-heals (the residency poll re-stamps), while\n321:         // a once-only spawn stamp is a permanent pop-in.\n322:         for (let i = 0; i < presentationQueue.length; i++) {\n323:           if (!PRESENTATION_ONCE_ONLY_EVENTS.has(presentationQueue[i].event)) {\n324:             dropIndex = i;\n325:             break;\n326:           }\n327:         }\n328:         // Every retained cosmetic is once-only: shed its oldest only past the deeper\n329:         // floor; below it the priority lane pays instead (self-healing hull residue\n330:         // before permanent spawn-stamp loss).\n331:         if (dropIndex === -1 && presentationOnceOnlyCount > ONCE_ONLY_OVERFLOW_FLOOR) {\n332:           dropIndex = 0;\n333:         }\n334:         // Belt-and-braces: a floor that could stall the trim reintroduces the unbounded\n335:         // drain debt the cap exists to prevent — with no priority lane to pay, the cap\n336:         // forces the shed anyway.\n337:         if (dropIndex === -1 && presentationPriorityQueue.length === 0) dropIndex = 0;\n338:         if (dropIndex !== -1) {\n339:           const dropped = presentationQueue.splice(dropIndex, 1)[0];\n340:           recyclePresentationSlice(dropped);\n341:           continue;\n342:         }\n343:       }\n344:       recyclePresentationSlice(presentationPriorityQueue.shift());\n345:     }\n346:   }\n347: \n348:   function recyclePresentationSlice(slice) {\n349:     if (!slice) return;\n350:     if (!PRESENTATION_PRIORITY_EVENTS.has(slice.event)\n351:         && PRESENTATION_ONCE_ONLY_EVENTS.has(slice.event)) {\n352:       presentationOnceOnlyCount -= 1;\n353:     }\n354:     slice.event = null;\n355:     slice.payload = null;\n356:     slice.fns = null;\n357:     slice.index = 0;\n358:     presentationSlicePool.push(slice);\n359:   }\n360: \n361:   // Emitter-side pooled-payload contract: registers the snapshot a deferred tail should read.\n362:   // Registering the same fn again is a no-op, so pool owners may re-arm cheaply after clear().\n363:   function setPayloadSnapshot(event, fn) {\n364:     if (typeof fn !== 'function') { payloadSnapshots.delete(event); return; }\n365:     if (payloadSnapshots.get(event) === fn) return;\n366:     payloadSnapshots.set(event, fn);\n367:   }\n368: \n369:   function emitAll(event, payload) {\n370:     const fns = snapshotListeners(listeners, listenerSnapshots, event);\n371:     if (fns) dispatchRange(fns, payload, event, 0, fns.length);\n372:     dispatchPresentation(event, payload);\n373:   }\n374: \n375:   function startEmitSlice(event, payload, budget, maxMs) {\n376:     // A second sliced emit while a predecessor still has a deferred tail used to discard that\n377:     // tail outright — every listener past the cut never heard the first sector:enter. Drain the\n378:     // remainder synchronously so no listener is ever skipped — but bound the flush to one\n379:     // thin slice: a tail that outlives the wall-clock cap queues the NEW emit behind the\n380:     // drain (ordering still holds emit-by-emit) instead of holding this frame hostage.\n381:     // A bounded caller threads its remaining deadline in maxMs — both the forced flush and\n382:     // the fresh slice must fit inside it, or a ≤4ms pump call pays a whole first slice inline.\n383:     const flushCap = Number.isFinite(maxMs) && maxMs > 0 ? Math.min(4, maxMs) : 4;\n384:     // One deadline shared by the forced flush, the fresh slice, and any listenerless queued\n385:     // restart — forwarding the original maxMs down the chain would re-mint a full window per\n386:     // hop and overspend the caller's bound by up to a window each hop.\n387:     const windowEnd = Number.isFinite(maxMs) && maxMs > 0\n388:       ? performance.now() + maxMs\n389:       : Infinity;\n390:     const remainingMs = () => Number.isFinite(windowEnd)\n391:       ? Math.max(0.001, windowEnd - performance.now())\n392:       : Infinity;\n393:     if (emitSlice) drainEmitSlice(Number.MAX_SAFE_INTEGER, flushCap);\n394:     if (emitSlice) {\n395:       if (pendingSlicedEmits.length >= MAX_QUEUED_SLICED_EMITS) {\n396:         // Backlog bounded: the oldest queued emit is delivered fully inline so a pathological\n397:         // stack of enters can't grow the queue without bound (see MAX_QUEUED_SLICED_EMITS).\n398:         const oldest = pendingSlicedEmits.shift();\n399:         emitAll(oldest.event, oldest.payload);\n400:       }\n401:       pendingSlicedEmits.push({ event, payload, budget });\n402:       return;\n403:     }\n404:     const fns = snapshotListeners(listeners, listenerSnapshots, event);\n405:     if (!fns) {\n406:       dispatchPresentation(event, payload);\n407:       if (pendingSlicedEmits.length) {\n408:         const next = pendingSlicedEmits.shift();\n409:         startEmitSlice(next.event, next.payload, next.budget, remainingMs());\n410:       }\n411:       return;\n412:     }\n413:     emitSlice = { event, payload, fns, index: 0 };\n414:     drainEmitSlice(budget, remainingMs());\n415:     dispatchPresentation(event, payload);\n416:   }\n417: \n418:   function emit(event, payload) {\n419:     const budget = emitSliceSuspended ? 0 : sliceBudgets.get(event) | 0;\n420:     // sector:exit joins the slice set for the restore session specifically: inside a\n421:     // restore the sim is frozen, departure listeners observe no arrival state, and the\n422:     // restore generator itself drains the parked tail at its yields.\n423:     if (budget > 0 && (event === 'sector:enter' || event === 'save:loaded' || event === 'sector:exit'\n424:         || event === 'mode:changed')) {\n425:       startEmitSlice(event, payload, budget);\n426:       return;\n427:     }\n428:     emitAll(event, payload);\n429:   }\n430: \n431:   // Non-presenting tasks have no frame deadline to overrun, so unlike\n432:   // drainEmitSlice this ignores the paced ledger and runs each tail to\n433:   // completion — the point is to finish before the caller's task ends.\n434:   function flushSlicedEmits() {\n435:     let guard = 0;\n436:     while (emitSlice || pendingSlicedEmits.length) {\n437:       if (guard++ > 64) break; // a listener that keeps re-emitting can't wedge the flush\n438:       if (emitSlice) {\n439:         const slice = emitSlice;\n440:         while (emitSlice === slice && slice.index < slice.fns.length) {\n441:           const fn = slice.fns[slice.index];\n442:           slice.index += 1;\n443:           invokeBusListener(fn, slice.payload, slice.event, 'handler error');\n444:         }\n445:         if (emitSlice === slice) emitSlice = null;\n446:         else break; // clear() or a re-entrant sliced emit swapped the global — stop here\n447:       }\n448:       if (pendingSlicedEmits.length) {\n449:         const next = pendingSlicedEmits.shift();\n450:         emitAll(next.event, next.payload);\n451:       }\n452:     }\n453:   }\n454: \n455:   function setEmitSliceSuspended(suspended) {\n456:     emitSliceSuspended = suspended === true;\n457:     if (emitSliceSuspended) flushSlicedEmits();\n458:   }\n459: \n460:   function setEmitSliceBudget(event, budget) {\n461:     const n = Math.max(0, Math.floor(Number(budget) || 0));\n462:     if (n <= 0) sliceBudgets.delete(event);\n463:     else sliceBudgets.set(event, n);\n464:     return n;\n465:   }\n466: \n467:   function drainEmitSlice(budget = SECTOR_ENTER_DRAIN_BUDGET, maxMs = Infinity) {\n468:     // Capture the slice locally: a listener that clear()s the bus (screen teardown mid-present)\n469:     // or starts a re-entrant sliced emit nulls/replaces `emitSlice` while this drain is on the\n470:     // stack — writing through the global here crashed on the stale null (seen on glass would be\n471:     // a hard TypeError inside the frame).\n472:     const slice = emitSlice;\n473:     if (!slice) return 0;\n474:     const base = Math.max(1, Math.floor(Number(budget) || SECTOR_ENTER_DRAIN_BUDGET));\n475:     // Depth-scaled like the presentation drain: a fixed count makes a ~100-listener backlog\n476:     // take ~25 frames while the wall-clock deadline (not the count) is what actually bounds\n477:     // each frame's spend. ceil/4 keeps per-frame cost identical at small depths.\n478:     const limit = Math.max(base, Math.ceil(pendingEmitSliceCount() / 4));\n479:     // Optional wall-clock budget alongside the listener count: a single heavyweight listener\n480:     // can blow a count-only slice past the paint deadline. Checked after each listener so at\n481:     // least one always runs per drain call (listener order is unchanged either way).\n482:     const deadline = Number.isFinite(maxMs) && maxMs > 0\n483:       ? performance.now() + maxMs\n484:       : Infinity;\n485:     const drainStart = performance.now();\n486:     let ran = 0;\n487:     while (emitSlice === slice && ran < limit && slice.index < slice.fns.length) {\n488:       const fn = slice.fns[slic