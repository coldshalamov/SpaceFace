onor universal modal escape below.\n319:     const t = ev.target;\n320:     const textEntry = isTextEntryTarget(t);\n321: \n322:     const key = ev.key;\n323:     const code = ev.code;\n324:     const modalOpen = screenManager.isOpen();\n325: \n326:     // Fulfillment transit is a deterministic simulation event, not a paused screen. It still owns\n327:     // every player-facing command surface until the boarding FSM releases the wake_pending phase.\n328:     if (isUiInteractionFenced(state)) { ev.preventDefault(); return; }\n329: \n330:     // If a shared confirm dialog is open (UX-2), let it own ALL keys — its own handler traps\n331:     // Esc/Enter/Tab. Bail here so the modal screen underneath doesn't also react to the keystroke.\n332:     // The dialog owns this key. Stopping it here keeps a cancel from also reaching a\n333:     // station or flight listener that is registered further along the same event.\n334:     if (isConfirmOpen()) {\n335:       if (typeof ev.stopPropagation === 'function') ev.stopPropagation();\n336:       ev.preventDefault();\n337:       return;\n338:     }\n339: \n340:     // --- if a modal is open, route to its handler, ESC = back ---\n341:     if (modalOpen) {\n342:       // Own the keydown before any close runs. popScreen clears ui-modal-open in this same\n343:       // turn, and the flight listener is on window — if the bubble continues, a remapped\n344:       // close key (Escape bound to drop a bomb) becomes a flight press as the screen goes away.\n345:       // Later document listeners on this node still run; the event does not continue upward.\n346:       if (typeof ev.stopPropagation === 'function') ev.stopPropagation();\n347:       bus.emit('ui:closeCargo');\n348:       const def = screenManager.getActiveScreenDef();\n349:       if (key === 'Escape') {\n350:         ev.preventDefault();\n351:         // A screen mid-gesture gets first refusal before the generic back/pop (J6): the chart's\n352:         // laid line / filling hold cancels here, so the first Escape undoes the player's current\n353:         // intention instead of losing the whole screen. Locked surfaces keep precedence — a\n354:         // screen that traps ESC (root title, mid-transaction) never receives the refusal.\n355:         const lockedNow = !!(\n356:           (screenManager.locked && screenManager.locked()) || (def && def.data && def.data.locked)\n357:         );\n358:         if (!lockedNow && def && typeof def.onEscape === 'function') {\n359:           try { if (def.onEscape(ev, ctx) === true) return; }\n360:           catch (e) { dedupError('uiInput.screen-escape', '[uiInput] screen onEscape error:', e); }\n361:         }\n362:         closeActiveModal(def);\n363:         return;\n364:       }\n365:       // Map toggle (M/N) must still close the map when search (or any text field) is focused.\n366:       // Without this, open → autofocus/search → second M types \"m\" instead of toggling closed.\n367:       // Escape already bypasses textEntry above; treat map bindings the same on map surfaces.\n368:       const mapToggleWhileTyping = !!(\n369:         textEntry\n370:         && def\n371:         && isMapScreenId(def.id)\n372:         && (matchesBinding(ev, BINDINGS.starmap) || matchesBinding(ev, BINDINGS.localmap))\n373:       );\n374:       // F1 is not a text character; keep Help toggleable even from a search field.\n375:       const helpToggleWhileTyping = !!(textEntry && def && def.id === 'help' && key === 'F1');\n376:       if (textEntry && !mapToggleWhileTyping && !helpToggleWhileTyping) return;\n377:       // Mirror the live interact binding while docked: E docks from flight and undocks from the\n378:       // station hub, preserving one airlock muscle-memory action. Leave Enter alone here so focused\n379:       // station buttons and rail tabs keep normal keyboard activation.\n380:       if (def && def.id === 'station' && matchesBinding(ev, BINDINGS.dock)) {\n381:         ev.preventDefault();\n382:         undock();\n383:         bus.emit('audio:cue', { id: 'ui_back' });\n384:         return;\n385:       }\n386:       if (def && typeof def.onKey === 'function') {\n387:         try { if (def.onKey(ev, ctx) === true) { ev.preventDefault(); return; } }\n388:         catch (e) { dedupError('uiInput.screen-key', '[uiInput] screen onKey error:', e); }\n389:       }\n390:       // PQ-183.02: one key finds anything, from anywhere — over a modal screen the palette mounts\n391:       // inside that screen so the dossier still has a host. Runs after def.onKey so a screen that\n392:       // already binds `/` to its own in-context find (the chart's target search) keeps it — one\n393:       // key still finds, it just finds the thing the player is looking at.\n394:       if (matchesBinding(ev, BINDINGS.find)) {\n395:         ev.preventDefault();\n396:         bus.emit('ui:globalFind', {});\n397:         return;\n398:       }\n399:       // Repeat the open binding to close the same instrument (mission log already does this in\n400:       // onKey; maps do it above). Without this, T/K/F1 open a screen they cannot close.\n401:       if (def && def.id === 'techTree' && matchesBinding(ev, BINDINGS.techTree)) {\n402:         ev.preventDefault();\n403:         closeActiveModal(def);\n404:         return;\n405:       }\n406:       if (def && def.id === 'codex' && matchesBinding(ev, BINDINGS.codex)) {\n407:         ev.preventDefault();\n408:         closeActiveModal(def);\n409:         return;\n410:       }\n411:       if (def && def.id === 'help' && (key === 'F1' || key === 'h' || key === 'H')) {\n412:         ev.preventDefault();\n413:         closeActiveModal(def);\n414:         return;\n415:       }\n416:       // The Pause menu labels Mission Log with the live binding. Keep that promise there and in\n417:       // the station hub, without teaching root/title/setup modals to open an in-run objective log.\n418:       if (allowsMissionLogShortcut(def) && matchesBinding(ev, BINDINGS.missionLog)) {\n419:         ev.preventDefault();\n420:         screenManager.pushScreen('missionLog');\n421:         bus.emit('audio:cue', { id: 'ui_open' });\n422:         return;\n423:       }\n424:       if (def && def.id === 'station' && matchesBinding(ev, BINDINGS.codex)) {\n425:         ev.preventDefault();\n426:         screenManager.pushScreen('codex');\n427:         bus.emit('audio:cue', { id: 'ui_open' });\n428:         return;\n429:       }\n430:       // global quick-save/load still work over a modal\n431:       if (key === 'F5') { ev.preventDefault(); bus.emit('game:save', { slot: 'quick' }); return; }\n432:       if (key === 'F9') { ev.preventDefault(); bus.emit('game:load', { slot: 'quick' }); return; }\n433:       return;\n434:     }\n435: \n436:     if (textEntry) return;\n437: \n438:     // --- pure flight: UI-owned global keys only (mode must be flight) ---\n439:     if (state.mode !== 'flight') return;\n440: \n441:     if (matchesBinding(ev, BINDINGS.steeringView)) {\n442:       if (ev.repeat || ev.shiftKey || ev.ctrlKey || ev.altKey || ev.metaKey) return;\n443:       ev.preventDefault();\n444:       if (typeof ev.stopPropagation === 'function') ev.stopPropagation();\n445:       bus.emit('race:toggleView', { source: 'keyboard' });\n446:       return;\n447:     }\n448:     if (matchesBinding(ev, BINDINGS.band)) {\n449:       ev.preventDefault();\n450:       bus.emit('band:cycle', { source: 'keyboard' });\n451:       return;\n452:     }\n453: \n454:     if (matchesBinding(ev, BINDINGS.recallObjective)) {\n455:       ev.preventDefault();\n456:       if (typeof ev.stopPropagation === 'function') ev.stopPropagation();\n457:       bus.emit('hud:recallObjective');\n458:       return;\n459:     }\n460: \n461:     // PQ-183.02: one key finds anything. In flight the palette mounts on #screens itself and\n462:     // carries the .screen marker so the dossier drawer still has a host.\n463:     if (matchesBinding(ev, BINDINGS.find)) {\n464:       ev.preventDefault();\n465:       bus.emit('ui:globalFind', {});\n466:       return;\n467:     }\n468: \n469:     // PRO-09: dismiss the one-voice floor pill. The arbiter owns what may be cleared (danger and\n470:     // the onboarding floor are protected); the key just asks.\n471:     if (matchesBinding(ev, BINDINGS.dismissVoice)) {\n472:       ev.preventDefault();\n473:       bus.emit('voice:dismiss', { source: 'keyboard' });\n474:       return;\n475:     }\n476: \n477:     switch (key) {\n478:       case 'Escape':\n479:         if (state.ui && state.ui.commsBacklogOpen) {\n480:           ev.preventDefault();\n481:           bus.emit('ui:closeComms');\n482:           return;\n483:         }\n484:         if (state.ui && state.ui.cargoPanelOpen) {\n485:           ev.preventDefault();\n486:           bus.emit('ui:closeCargo');\n487:           return;\n488:         }\n489:         // fall through to Pause when no flight overlay owns Escape\n490:       case 'p': case 'P':\n491:         ev.preventDefault();\n492:         screenManager.pushScreen('pause');\n493:         bus.emit('audio:cue', { id: 'ui_open' });\n494:         return;\n495:       // Map authority: M → galaxyMap LOCAL (near-field first); N → galaxyMap GALAXY (star chart).\n496:       // Legacy localmap/starmap screens remain registered for tools/checks only.\n497:       case BINDINGS.localmap.key:\n498:       case BINDINGS.localmap.label:\n499:         ev.preventDefault();\n500:         openGalaxyMap({ state, bus, screenManager }, { focus: MAP_FOCUS.LOCAL, source: 'keyboard' });\n501:         return;\n502:       case BINDINGS.starmap.key:\n503:       case BINDINGS.starmap.label:\n504:         ev.preventDefault();\n505:         openGalaxyMap({ state, bus, screenManager }, { focus: MAP_FOCUS.GALAXY, source: 'keyboard' });\n506:         return;\n507:       case BINDINGS.techTree.key:\n508:       case BINDINGS.techTree.label:\n509:         ev.preventDefault(); screenManager.pushScreen('techTree'); return;\n510:       case 