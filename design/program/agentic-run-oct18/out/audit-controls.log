;\n1103:     }\n1104: \n1105:     stage.appendChild(list);\n1106:     column.appendChild(stage);\n1107: \n1108:     // ORRERY: the verbs ride the emblem's dial like the title's, one tick per group (the group's\n1109:     // name engraved over its row) with Resume leading as the one lit verb; the brief, which the dial\n1110:     // would cover, becomes a reading on the right. Same list, same roving focus, same buttons.\n1111:     injectOrreryScreens();\n1112:     injectPauseLayouts();\n1113:     // A phone has no room for the dial: the verbs stay the plain banked Deckplate column and the brief stays\n1114:     // above them in it, like the title's phone composition.\n1115:     const phone = isPhoneLayout();\n1116:     // add/remove, not toggle: the headless shims the pause tests mount on carry no classList.toggle\n1117:     rootEl.classList.add(phone ? 'orr-pause--phone' : 'orr-pause');\n1118:     const brief = briefKicker.parentElement;\n1119:     if (brief && !phone) { brief.classList.add('orr-brief'); rootEl.appendChild(brief); }\n1120:     if (pauseRail) { pauseRail.dispose(); pauseRail = null; }\n1121:     // One stop per group (ORRERY 3.2: an arc carries at most nine): Resume leads, then each group is one\n1122:     // tick with its name as the row's legend and its verbs on one line after it. The Hand swings to the row;\n1123:     // within it only the awake verb lights. Up/down steps between rows, left/right along one.\n1124:     // a smaller dial, higher: its lowest tick clears the key strip at every height\n1125:     pauseRail = phone ? null : createArcRail({ host: stage, list, frame: rootEl, grouped: true, dense: true, span: 56,\n1126:       place: (W, H) => ({ pivot: { x: Math.min(112, Math.max(56, Math.round(W * 0.056))), y: Math.round(H * 0.55) }, re: Math.round(H * 0.3), centerDeg: 90 }) });\n1127: \n1128:     // The column ends in a legend strip, not an air gap: the keys that are live while this modal\n1129:     // is up as machined caps, then the build mark — the two .k-fine lines the pause grid's foot\n1130:     // area is sized for.\n1131:     const foot = el('footer', 'sf-pause-foot dp-frame__foot');\n1132:     const keysLine = el('p', 'dp-bar sf-pause-foot__keys');\n1133:     const keyHint = (cap, verb) => {\n1134:       keysLine.appendChild(el('span', 'dp-kbd sf-pause-key', cap));\n1135:       keysLine.appendChild(el('span', 'dp-etch sf-pause-key-verb', verb));\n1136:     };\n1137:     keyHint('Esc', 'Resume');\n1138:     keyHint('P', 'Photo');\n1139:     keyHint('F5', 'Quick Save');\n1140:     keyHint('F9', 'Quick Load');\n1141:     // the dial is two levels deep, and the strip says so: up/down steps between the categories on\n1142:     // the rim, left/right along the one you are in. Without this the arrow keys read as a mystery.\n1143:     keyHint('↑↓', 'Category');\n1144:     keyHint('←→', 'Item');\n1145:     foot.appendChild(keysLine);\n1146:     const version = el('p', 'dp-etch dp-bar--end');\n1147:     version.dataset.role = 'version';\n1148:     const versionText = el('span', '', leftoverVersionDisplay(CREDITS));\n1149:     versionText.title = leftoverVersionLabel(CREDITS);\n1150:     version.appendChild(versionText);\n1151:     // PRO-19: the active run seed beside the build mark. Same etched line, no restyle —\n1152:     // a plain span carrying only the session seed (never rng internals).\n1153:     const seedText = el('span', '', '');\n1154:     seedText.dataset.role = 'run-seed';\n1155:     paintPauseRunSeed(seedText, ctx && ctx.state);\n1156:     version.appendChild(seedText);\n1157:     foot.appendChild(version);\n1158:     rootEl.appendChild(foot);\n1159:     rootEl.setAttribute('aria-keyshortcuts', 'Escape');\n1160: \n1161:     const bResume = list.querySelector(`[data-action=\"${resumeAction}\"]`);\n1162:     els = { bResume, title, stage, briefObjective, briefNext, briefSave, versionText, seedText };\n1163:     briefLast.objective = undefined;\n1164:     briefLast.next = undefined;\n1165:     briefLast.save = undefined;\n1166:     briefLast.hit = undefined;\n1167:     renderFlightBrief(ctx);\n1168:     this._loadVersion();\n1169:   },\n1170: \n1171:   _resume(ctx) {\n1172:     if (ctx.state.mode === 'paused') laneSetMode(ctx.state, ctx.bus, 'flight');\n1173:     nav(ctx, 'popScreen');\n1174:   },\n1175: \n1176:   _toMenu(ctx) {\n1177:     if (ctx && ctx.bus && typeof ctx.bus.emit === 'function') {\n1178:       ctx.bus.emit('game:exitToMenu', { source: 'pause' });\n1179:     } else {\n1180:       laneSetMode(ctx.state, ctx.bus, 'menu');\n1181:     }\n1182:     const mgr = getManager(ctx);\n1183:     if (mgr) {\n1184:       if (mgr.closeAll) mgr.closeAll();\n1185:       if (mgr.replaceScreen) mgr.replaceScreen('mainMenu');\n1186:       else if (mgr.pushScreen) mgr.pushScreen('mainMenu');\n1187:     } else {\n1188:       nav(ctx, 'replaceScreen', 'mainMenu');\n1189:     }\n1190:   },\n1191: \n1192:   onShow(ctx) {\n1193:     if (ctx.state.mode === 'flight') laneSetMode(ctx.state, ctx.bus, 'paused');\n1194:     // The Ending Archive row was gated at mount; a finale filed in a later session of this\n1195:     // mounted sheet must open the row. Remount once on the transition — mount owns the whole\n1196:     // sheet build, and the focus/settle work below lands on the fresh frame.\n1197:     if (!this._endingArchiveAtMount && pauseRootEl) {\n1198:       const finale = ctx && ctx.state && ctx.state.story ? ctx.state.story.writtenFinale : null;\n1199:       if (writtenEndingArchive(finale)) {\n1200:         this._endingArchiveAtMount = true;\n1201:         this.mount(pauseRootEl, ctx);\n1202:       }\n1203:     }\n1204:     // The only load reachable from here is F9's 'quick' — start its envelope decode during\n1205:     // the pause dwell instead of on the keypress.\n1206:     if (ctx.bus && typeof ctx.bus.emit === 'function') {\n1207:       ctx.bus.emit('save:loadSpeculationTarget', { slot: 'quick' });\n1208:     }\n1209:     renderFlightBrief(ctx);\n1210:     syncPauseRunSeed(ctx);\n1211:     if (els) {\n1212:       if (els.title) settle(els.title, { from: 'left', state: 'pause-title' });\n1213:       if (els.stage) settle(els.stage, { from: 'left', delay: 60, state: 'pause-words' });\n1214:       if (els.bResume) try { els.bResume.focus(); } catch (e) {}\n1215:     }\n1216:     // The world behind the pause is the live flight picture, not a mount of its own: the frame is\n1217:     // ready as soon as the words are (KIT_SPEC §11.7 capture contract).\n1218:     if (els && els.title && els.title.parentElement) els.title.parentElement.dataset.kReady = '1';\n1219:     // FB-085: P (BINDINGS.photo) opens photo mode over this screen — capture phase, ahead of the\n1220:     // uiInput route that would read the same press as \"open pause\" again. The photo overlay's own\n1221:     // Esc route returns here. Photo mode owns the keys while it is up, so a live session ignores it.\n1222:     if (!pausePhotoKeyHandler && typeof window !== 'undefined' && typeof window.addEventListener === 'function') {\n1223:       pausePhotoKeyHandler = (ev) => {\n1224:         if (photo || !isPhotoBindingKey(ev)) return;\n1225:         const target = ev.target;\n1226:         const tag = target && typeof target.tagName === 'string' ? target.tagName.toLowerCase() : '';\n1227:         if (tag === 'input' || tag === 'textarea' || (target && target.isContentEditable)) return;\n1228:         ev.preventDefault();\n1229:         if (typeof ev.stopImmediatePropagation === 'function') ev.stopImmediatePropagation();\n1230:         else if (typeof ev.stopPropagation === 'function') ev.stopPropagation();\n1231:         if (pauseRootEl) enterPhoto(pauseRootEl, ctx);\n1232:       };\n1233:       window.addEventListener('keydown', pausePhotoKeyHandler, true);\n1234:     }\n1235:     this._loadVersion();\n1236:     cue('open');\n1237:   },\n1238: \n1239:   _loadVersion() {\n1240:     if (!els) return;\n1241:     const target = els.versionText;\n1242:     void paintLeftoverVersion(target, () => els && els.versionText === target);\n1243:   },\n1244: \n1245:   onHide(ctx) {\n1246:     // Leaving the stack while in photo mode (a bus-driven exit) must not strand body.k-photo.\n1247:     if (photo) exitPhoto(photo.rootEl, ctx);\n1248:     // FB-085: the P route is live only while this screen is top.\n1249:     if (pausePhotoKeyHandler) {\n1250:       window.removeEventListener('keydown', pausePhotoKeyHandler, true);\n1251:       pausePhotoKeyHandler = null;\n1252:     }\n1253:     // Replay/Clips are sibling overlays, not stacked screens — they must close with pause.\n1254:     forceCloseReplay();\n1255:     forceCloseClips();\n1256:     cue('close');\n1257:   },\n1258:   refresh(ctx) { renderFlightBrief(ctx); syncPauseRunSeed(ctx); },\n1259: };\n\n(End of file - total 1259 lines)\n</content>","metadata":{"preview":"      // the grid ONE_PHOTOGRAPH.md section 4.2 kills, and on the screen a player opens most often\n      // after flight. Nothing here changes the world; every verb opens something. So every verb is\n      // a word that lights, the groups keep their etched heads, and the runs that were chips bank\n      // into wrapping lines. RESUME stays the one primary because it is the only lit lamp.\n      system: 'light',\n      size: 'emph',\n      onPick: (action) => {\n        const run = handlers.get(action);\n        if (typeof run === 'function') run();\n      },\n    });\n    list.classList.add('sf-pause-words', 'dp-menu--banked');\n    // ORRERY tiers: Resume is the lamp key; the interruption choices (Game) and the way out (Exit)\n    // are mid; the Ship, Reference, Media and Dev verbs are the quiet tier.\n    const LOW_TIER = new Set(['Ship', 'Reference', 'Media', 'Dev']);\n    for (const item of items) {\n      const button = list.querySelector(`[data-action=\"${item.action}\"]`);\n      if (!button) continue;\n      if (item.dev) button.classList.add('k-38');\n      if (item.keys) button.setAttribute('aria-keyshortcuts', item.keys);","truncated":false,"loaded":[],"display":{"type":"file","path":"C:\\Users\\93rob\\Documents\\GitHub\\SpaceFace\\src\\ui\\screens\\pause.js","text":"      // the grid ONE_PHOTOGRAPH.md section 4.2 kills, and on the screen a player opens most often\n      // after flight. Nothing here changes the world; every verb opens something. So every verb is\n      // a word that lights, the groups keep their etched heads, and the runs that were chips bank\n      // into wrapping lines. RESUME stays the one primary because it is the only lit lamp.\n      system: 'light',\n      size: 'emph',\n      onPick: (action) => {\n        const run = handlers.get(action);\n        if (typeof run === 'function') run();\n      },\n    });\n    list.classList.add('sf-pause-words', 'dp-menu--banked');\n    // ORRERY tiers: Resume is the lamp key; the interruption choices (Game) and the way out (Exit)\n    // are mid; the Ship, Reference, Media and Dev verbs are the quiet tier.\n    const LOW_TIER = new Set(['Ship', 'Reference', 'Media', 'Dev']);\n    for (const item of items) {\n      const button = list.querySelector(`[data-action=\"${item.action}\"]`);\n      if (!button) continue;\n      if (item.dev) button.classList.add('k-38');\n      if (item.keys) button.setAttribute('aria-keyshortcuts', item.keys);\n      // parentElement, not closest(): the headless shims the pause tests mount on have no closest()\n      const li = button.parentElement;\n      if (li && li.dataset) li.dataset.tier = item.primary ? 'high' : (LOW_TIER.has(item.group) ? 'low' : 'mid');\n    }\n\n    stage.appendChild(list);\n    column.appendChild(stage);\n\n    // ORRERY: the verbs ride the emblem's dial like the title's, one tick per group (the group's\n    // name engraved over its row) with Resume leading as the one lit verb; the brief, which the dial\n    // would cover, becomes a reading on the right. Same list, same roving focus, same buttons.\n    injectOrreryScreens();\n    injectPauseLayouts();\n    // A phone has no room for the dial: the verbs stay the plain banked Deckplate column and the brief stays\n    // above them in it, like the title's phone composition.\n    const phone = isPhoneLayout();\n    // add/remove, not toggle: the headless shims the pause tests mount on carry no classList.toggle\n    rootEl.classList.add(phone ? 'orr-pause--phone' : 'orr-pause');\n    const brief = briefKicker.parentElement;\n    if (brief && !phone) { brief.classList.add('orr-brief'); rootEl.appendChild(brief); }\n    if (pauseRail) { pauseRail.dispose(); pauseRail = null; }\n    // One stop per group (ORRERY 3.2: an arc carries at most nine): Resume leads, then each group is one\n    // tick with its name as the row's legend and its verbs on one line after it. The Hand swings to the row;\n    // within it only the awake verb lights. Up/down steps between rows, left/right along one.\n    // a smaller dial, higher: its lowest tick clears the key strip at every height\n    pauseRail = phone ? null : createArcRail({ host: stage, list, frame: rootEl, grouped: true, dense: true, span: 56,\n      place: (W, H) => ({ pivot: { x: Math.min(112, Math.max(56, Math.round(W * 0.056))), y: Math.round(H * 0.55) }, re: Math.round(H * 0.3), centerDeg: 90 }) });\n\n    // The column ends in a legend strip, not an air gap: the keys that are live while this modal\n    // is up as machined caps, then the build mark — the two .k-fine lines the pause grid's foot\n    // area is sized for.\n    const foot = el('footer', 'sf-pause-foot dp-frame__foot');\n    const keysLine = el('p', 'dp-bar sf-pause-foot__keys');\n    const keyHint = (cap, verb) => {\n      keysLine.appendChild(el('span', 'dp-kbd sf-pause-key', cap));\n      keysLine.appendChild(el('span', 'dp-etch sf-pause-key-verb', verb));\n    };\n    keyHint('Esc', 'Resume');\n    keyHint('P', 'Photo');\n    keyHint('F5', 'Quick Save');\n    keyHint('F9', 'Quick Load');\n    // the dial is two levels deep, and the strip says so: up/down steps between the categories on\n    // the rim, left/right along the one you are in. Without this the arrow keys read as a mystery.\n    keyHint('↑↓', 'Category');\n    keyHint('←→', 'Item');\n    foot.appendChild(keysLine);\n    const version = el('p', 'dp-etch dp-bar--end');\n    version.dataset.role = 'version';\n    const versionText = el('span', '', leftoverVersionDisplay(CREDITS));\n    versionText.title = leftoverVersionLabel(CREDITS);\n    version.appendChild(versionText);\n    // PRO-19: the active run seed beside the build mark. Same etched line, no restyle —\n    // a plain span carrying only the session seed (never rng internals).\n    const seedText = el('span', '', '');\n    seedText.dataset.role = 'run-seed';\n    paintPauseRunSeed(seedText, ctx && ctx.state);\n    version.appendChild(seedText);\n    foot.appendChild(version);\n    rootEl.appendChild(foot);\n    rootEl.setAttribute('aria-keyshortcuts', 'Escape');\n\n    const bResume = list.querySelector(`[data-action=\"${resumeAction}\"]`);\n    els = { bResume, title, stage, briefObjective, briefNext, briefSave, versionText, seedText };\n    briefLast.objective = undefined;\n    briefLast.next = undefined;\n    briefLast.save = undefined;\n    briefLast.hit = undefined;\n    renderFlightBrief(ctx);\n    this._loadVersion();\n  },\n\n  _resume(ctx) {\n    if (ctx.state.mode === 'paused') laneSetMode(ctx.state, ctx.bus, 'flight');\n    nav(ctx, 'popScreen');\n  },\n\n  _toMenu(ctx) {\n    if (ctx && ctx.bus && typeof ctx.bus.emit === 'function') {\n      ctx.bus.emit('game:exitToMenu', { source: 'pause' });\n    } else {\n      laneSetMode(ctx.state, ctx.bus, 'menu');\n    }\n    const mgr = getManager(ctx);\n    if (mgr) {\n      if (mgr.closeAll) mgr.closeAll();\n      if (mgr.replaceScreen) mgr.replaceScreen('mainMenu');\n      else if (mgr.pushScreen) mgr.pushScreen('mainMenu');\n    } else {\n      nav(ctx, 'replaceScreen', 'mainMenu');\n    }\n  },\n\n  onShow(ctx) {\n    if (ctx.state.mode === 'flight') laneSetMode(ctx.state, ctx.bus, 'paused');\n    // The Ending Archive row was gated at mount; a finale filed in a later session of this\n    // mounted sheet must open the row. Remount once on the transition — mount owns the whole\n    // sheet build, and the focus/settle work below lands on the fresh frame.\n    if (!this._endingArchiveAtMount && pauseRootEl) {\n      const finale = ctx && ctx.state && ctx.state.story ? ctx.state.story.writtenFinale : null;\n      if (writtenEndingArchive(finale)) {\n        this._endingArchiveAtMount = true;\n        this.mount(pauseRootEl, ctx);\n      }\n    }\n    // The only load reachable from here is F9's 'quick' — start its envelope decode during\n    // the pause dwell instead of on the keypress.\n    if (ctx.bus && typeof ctx.bus.emit === 'function') {\n      ctx.bus.emit('save:loadSpeculationTarget', { slot: 'quick' });\n    }\n    renderFlightBrief(ctx);\n    syncPauseRunSeed(ctx);\n    if (els) {\n      if (els.title) settle(els.title, { from: 'left', state: 'pause-title' });\n      if (els.stage) settle(els.stage, { from: 'left', delay: 60, state: 'pause-words' });\n      if (els.bResume) try { els.bResume.focus(); } catch (e) {}\n    }\n    // The world behind the pause is the live flight picture, not a mount of its own: the frame is\n    // ready as soon as the words are (KIT_SPEC §11.7 capture contract).\n    if (els && els.title && els.title.parentElement) els.title.parentElement.dataset.kReady = '1';\n    // FB-085: P (BINDINGS.photo) opens photo mode over this screen — capture phase, ahead of the\n    // uiInput route that would read the same press as \"open pause\" again. The photo overlay's own\n    // Esc route returns here. Photo mode owns the keys while it is up, so a live session ignores it.\n    if (!pausePhotoKeyHandler && typeof window !== 'undefined' && typeof window.addEventListener === 'function') {\n      pausePhotoKeyHandler = (ev) => {\n        if (photo || !isPhotoBindingKey(ev)) return;\n        const target = ev.target;\n        const tag = target && typeof target.tagName === 'string' ? target.tagName.toLowerCase() : '';\n        if (tag === 'input' || tag === 'textarea' || (target && target.isContentEditable)) return;\n        ev.preventDefault();\n        if (typeof ev.stopImmediatePropagation === 'function') ev.stopImmediatePropagation();\n        else if (typeof ev.stopPropagation === 'function') ev.stopPropagation();\n        if (pauseRootEl) enterPhoto(pauseRootEl, ctx);\n      };\n      window.addEventListener('keydown', pausePhotoKeyHandler, true);\n    }\n    this._loadVersion();\n    cue('open');\n  },\n\n  _loadVersion() {\n    if (!els) return;\n    const target = els.versionText;\n    void paintLeftoverVersion(target, () => els && els.versionText === target);\n  },\n\n  onHide(ctx) {\n    // Leaving the stack while in photo mode (a bus-driven exit) must not strand body.k-photo.\n    if (photo) exitPhoto(photo.rootEl, ctx);\n    // FB-085: the P route is live only while this screen is top.\n    if (pausePhotoKeyHandler) {\n      window.removeEventListener('keydown', pausePhotoKeyHandler, true);\n      pausePhotoKeyHandler = null;\n    }\n    // Replay/Clips are sibling overlays, not stacked screens — they must close with pause.\n    forceCloseReplay();\n    forceCloseClips();\n    cue('close');\n  },\n  refresh(ctx) { renderFlightBrief(ctx); syncPauseRunSeed(ctx); },\n};","lineStart":1080,"lineEnd":1259,"totalLines":1259,"truncated":false}},"title":"src\\ui\\screens\\pause.js","time":{"start":1792370370630,"end":1792370370805}},"id":"prt_1519967ea001WNyrjKyHyJeNzQ","sessionID":"ses_eae696a14ffehCxB980snPYjCy","messageID":"msg_151994094001pUPvlieyTvuQ4T"}}
