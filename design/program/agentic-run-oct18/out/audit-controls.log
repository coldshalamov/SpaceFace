ries rather than registered ticks. Confirm importers in `docs/SYSTEM_REGISTRY.md`\nor with `rg` before changing cadence/ownership. Examples include danger/economy-cycle, alphabet,\ngamepad, telemetry, and touch helpers.\n\n## Verification\n\nRun the narrow subsystem test/check, then sim comparison for sim-affecting changes. AI/combat/flight\nfeel also requires a representative encounter or player-route proof.\n\n</system-reminder>","metadata":{"preview":"\n  /**\n   * Browser-only: wire keyboard/pointer/gamepad listeners. Must not run under Node.\n   * @param {Record<string, boolean>} keys\n   */\n  _attachDomInputAdapter(keys) {\n    const windowTarget = typeof window !== 'undefined' ? window : null;\n    const bindings = (this._domBindings = []);\n    this._m2UsesUiClock = !!(windowTarget\n      && typeof windowTarget.setTimeout === 'function'\n      && typeof windowTarget.clearTimeout === 'function');\n    this._m2TimerTarget = this._m2UsesUiClock ? windowTarget : null;\n    const listen = (target, type, listener, options) => {\n      if (!target || typeof target.addEventListener !== 'function') return;\n      target.addEventListener(type, listener, options);\n      bindings.push({ target, type, listener, options });\n    };\n\n    // Re-evaluate on resize (phone rotate / tablet dock) unless the player set an explicit choice.\n    listen(windowTarget, 'resize', () => this.touch.autoDetect());","truncated":true,"loaded":["C:\\Users\\93rob\\Documents\\GitHub\\SpaceFace\\src\\systems\\AGENTS.md"],"display":{"type":"file","path":"C:\\Users\\93rob\\Documents\\GitHub\\SpaceFace\\src\\systems\\input.js","text":"\n  /**\n   * Browser-only: wire keyboard/pointer/gamepad listeners. Must not run under Node.\n   * @param {Record<string, boolean>} keys\n   */\n  _attachDomInputAdapter(keys) {\n    const windowTarget = typeof window !== 'undefined' ? window : null;\n    const bindings = (this._domBindings = []);\n    this._m2UsesUiClock = !!(windowTarget\n      && typeof windo