{"type":"tool_use","timestamp":1792370455591,"sessionID":"ses_eae696a14ffehCxB980snPYjCy","part":{"type":"tool","tool":"bash","callID":"call_00_crqpktygw1ur4wtcw6vl1ju8","state":{"status":"completed","input":{"command":"rg -n \"addEventListener\\(\" src/ui/input.js | head -40; echo ---; rg -n \"addEventListener\\(\" src/systems/input.js | head -40"},"output":"876:  document.addEventListener('keydown', onBlackoutKeyDown, true);\n878:    document.addEventListener(type, onBlackoutPointerEvent, { capture: true, passive: false });\n880:  document.addEventListener('keydown', onKeyDown);\n881:  window.addEventListener('wheel', onWheel, { passive: false });\n888:  document.addEventListener('pointerdown', clearGamepadFocus, true);\n---\r\n1210:      target.addEventListener(type, listener, options);\n","metadata":{"output":"876:  document.addEventListener('keydown', onBlackoutKeyDown, true);\n878:    document.addEventListener(type, onBlackoutPointerEvent, { capture: true, passive: false });\n880:  document.addEventListener('keydown', onKeyDown);\n881:  window.addEventListener('wheel', onWheel, { passive: false });\n888:  document.addEventListener('pointerdown', clearGamepadFocus, true);\n---\r\n1210:      target.addEventListener(type, listener, options);\n","exit":0,"truncated":false},"title":"rg -n \"addEventListener\\(\" src/ui/input.js | head -40; echo ---; rg -n \"addEventListener\\(\" src/systems/input.js | head -40","time":{"start":1792370455057,"end":1792370455584}},"id":"prt_1519ab1ca001oYDPlKQZ8bmZpk","sessionID":"ses_eae696a14ffehCxB980snPYjCy","messageID":"msg_1519a99a7001xIFRnZroMVHD6O"}}
