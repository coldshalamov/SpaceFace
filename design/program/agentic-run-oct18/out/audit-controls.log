g FSM releases the wake_pending phase.\n328:     if (isUiInteractionFenced(state)) { ev.preventDefault(); return; }\n329: \n330:     // If a shared confirm dialog is open (UX-2), let it own ALL keys — its own handler traps\n331:     // Esc/Enter/Tab. Bail here so the modal screen underneath doesn't also react to the keystroke.\n332:     // The dialog owns this key. Stopping it here keeps a cancel from also reaching a\n333:     // station or flight listener that is registered further along the same event.\n334:     if (isConfirmOpen()) {\n335:       if (typeof ev.stopPropagation === 'function') ev.stopPropagation();\n336:       ev.preventDefault();\n337:       return;\n338:     }\n339: \n340:     // --- if a modal is open, route to its handler, ESC = back ---\n341:     if (modalOpen) {\n342:       // Own the keydown before any close runs. popScreen clears ui-modal-open in this same\n343:       // turn, and the flight listener is on window — if the bubble continues, a remapped\n344:       // close key (Escape bound to drop a bomb) becomes a flight press as the screen goes away.\n345:       // Later document listeners on this node still run; the event does not continue upward.\n346:       if (typeof ev.stopPropagation === 'function') ev.stopPropagation();\n347:       bus.emit('ui:closeCargo');\n348:       const def = screenManager.getActiveScreenDef();\n349:       if (key === 'Escape') {\n350:         ev.preventDefault();\n351:         // A screen mid-gesture gets first refusal before the generic back/pop (J6): the chart's\n352:         // laid line / filling hold cancels here, so the first Escape undoes the player's current\n353:         // intention instead of losing the whole screen. Locked surfaces keep precedence — a\n354:         // screen that traps ESC (root title, mid-transaction) never receives the refusal.\n355:         const lockedNow = !!(\n356:           (screenManager.locked && screenManager.locked()) || (def && def.data && def.data.locked)\n357:        