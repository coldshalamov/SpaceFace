      case 'Tab':\n519:         ev.preventDefault();\n520:         bus.emit('ui:cycleTarget', { dir: ev.shiftKey ? -1 : 1 });\n521:         return;\n522:       case 'Backspace':\n523:         ev.preventDefault();\n524:         bus.emit('ui:clearTarget');\n525:         return;\n526:       // Dock / interact: default binding is `E` (spec §15.4), sourced from the live binding\n527:       // registry so the prompt and handler can never drift. Enter remains a secondary trigger.\n528:       case BINDINGS.dock.key:\n529:       case BINDINGS.dock.label:\n530:       case 'Enter':\n531:         if (dockInRange) {\n532:           ev.preventDefault();\n533:           // preventDefault() is NOT suppression in this codebase: the window-level flight adapter\n534:           // (src/systems/input.js) never inspects defaultPrevented — its only gates are\n535:           // modalInputActive / text-entry / ui-command targets. So the dock key also reached the\n536:           // flight verbs, and since `strafeRight` is KeyE in both the pilot (default) and classic\n537:           // schemes, pressing E to dock ALSO strafed the ship right, exactly while the player was\n538:           // trying to hold a docking line. stopPropagation() from this document-level listener is\n539:           // what actually keeps the window-level one from seeing it — the same idiom claimBase uses\n540:           // a few cases above. No stuck-key risk: the flight adapter never sets KeyE down, so there\n541:           // is nothing for keyup to clear, and out of dock range this case falls through untouched\n542:           // so ordinary strafing is unaffected.\n543:           if (typeof ev.stopPropagation === 'function') ev.stopPropagation();\n544:           doDock();\n545:         }\n546:         return;\n547:       case 'F2':\n548:         // THE SHIP (grammar §10.5 canonical key table; build map §11.3). Pausing by owner ruling —\n549:         // full-depth strategic screen. F1 (help) and F7 (debug) are the ad