{"type":"tool_use","timestamp":1792370384033,"sessionID":"ses_eae696a14ffehCxB980snPYjCy","part":{"type":"tool","tool":"read","callID":"call_00_e281fdqq0i33hcv2m81evrxl","state":{"status":"completed","input":{"filePath":"C:\\Users\\93rob\\Documents\\GitHub\\SpaceFace\\src\\ui\\bindings.js"},"output":"<path>C:\\Users\\93rob\\Documents\\GitHub\\SpaceFace\\src\\ui\\bindings.js</path>\n<type>file</type>\n<content>\n1: // Live interaction binding labels (spec §15.4: \"prompts use live bindings; docking defaults to E\").\n2: //\n3: // A single source of truth for the key a player presses to perform a context action. Prompts\n4: // (alerts), the help screen, and the input handler all read from here, so changing a binding in one\n5: // place updates every prompt automatically — there is no hardcoded \"[ ENTER ]\" string that can drift\n6: // out of sync with the actual handler. This is the lightweight \"live binding registry\" the spec asks\n7: // for: prompts render from this registry, not from literal key names.\n8: \n9: import {\n10:   GAMEPAD_BUTTON_LABELS,\n11:   GAMEPAD_DEFAULT_BINDINGS,\n12:   GAMEPAD_VERB_ALIASES,\n13:   gamepadFaceButtonLabel,\n14:   gamepadButtonLabels,\n15:   normalizeGamepadGlyphSet,\n16: } from '../systems/gamepad.js';\n17: \n18: export const BINDINGS = Object.freeze({\n19:   // Default interact/dock action is `E` (spec §15.4 / INTEGRATION_MAP §5). The input handler in\n20:   // src/ui/input.js must keep its case clause in sync with this value.\n21:   dock: { key: 'e', code: 'KeyE', label: 'E' },\n22:   // M is the primary \"map\" key — open at LOCAL (near-field). N is the star chart (galaxy scale).\n23:   localmap: { key: 'm', code: 'KeyM', label: 'M' },\n24:   starmap: { key: 'n', code: 'KeyN', label: 'N' },\n25:   techTree: { key: 't', code: 'KeyT', label: 'T' },\n26:   missionLog: { key: 'j', code: 'KeyJ', label: 'J' },\n27:   drill: { key: 'b', code: 'KeyB', label: 'B' },\n28:   // U (was C): the C key is the flight-verb SCANNER PULSE in the 2.0 input contract (GDD §7.1);\n29:   // claim-base is a rare contextual action and yields the prime key.\n30:   claimBase: { key: 'u', code: 'KeyU', label: 'U' },\n31:   cargo: { key: 'i', code: 'KeyI', label: 'I' },\n32:   comms: { key: 'l', code: 'KeyL', label: 'L' },\n33:   codex: { key: 'k', code: 'KeyK', label: 'K' },\n34:   // O remains the spec-locked overview pin. The Band takes the modified chord so both persistent\n35:   // flight tools retain a discoverable keyboard path without stealing a gameplay verb.\n36:   band: { key: 'O', code: 'KeyO', label: 'Shift+O', shift: true },\n37:   // Wingman command radial (Micro-Loops). The comms LOG owns L, so the quick fleet-comms radial\n38:   // lives on Z — a free key next to the movement cluster for a thumb-reachable \"hands stay on the\n39:   // stick\" fleet command.\n40:   fleetCommand: { key: 'z', code: 'KeyZ', label: 'Z' },\n41:   // G9: bring the flight objective back. Semicolon is free of the verb tables and does not\n42:   // open the mission log.\n43:   recallObjective: { key: ';', code: 'Semicolon', label: ';' },\n44:   // PQ-183.02 global find. Slash is the classic find key (EVE, vim, quick-find) and free\n45:   // repo-wide; text entry still wins, so typing '/' into a field never opens the palette.\n46:   find: { key: '/', code: 'Slash', label: '/' },\n47:   // PRO-09: the voice floor's pill is dismissable. Every letter belongs to a verb table, so it\n48:   // sits on Delete — free in flight (the drill screen that owns it there is modal) and reads as\n49:   // \"clear this\" without costing a letter key.\n50:   dismissVoice: { key: 'Delete', code: 'Delete', label: 'DEL' },\n51:   // F6 is the second dismiss binding, matched from the voice arbiter's own keydown hook\n52:   // (voiceDismissBindingMatches/emitVoiceDismissFromBinding) rather than the UI key router —\n53:   // the router does not own function keys.\n54:   voiceDismiss: { key: 'F6', code: 'F6', label: 'F6' },\n55:   // Every letter already owns a flight verb; backslash is the camera-only shortcut.\n56:   steeringView: { key: '\\\\', code: 'Backslash', label: '\\\\' },\n57:   // FB-085: photo mode is a sub-state of the pause screen, so the pause route owns P the same\n58:   // way the UI router owns dock/localmap only where the verb lives. No flight verb claims P\n59:   // (VERB_BINDINGS moved the deploy row to digits precisely because P is the pause key).\n60:   photo: { key: 'p', code: 'KeyP', label: 'P' },\n61: });\n62: \n63: /** True when this keydown is the floor-voice dismiss binding and not a chord. */\n64: export function voiceDismissBindingMatches(ev) {\n65:   const binding = BINDINGS.voiceDismiss;\n66:   if (!ev || !binding || binding.shift || binding.ctrl || binding.alt || binding.meta) return false;\n67:   if (ev.repeat || ev.shiftKey || ev.ctrlKey || ev.altKey || ev.metaKey) return false;\n68:   const target = ev.target;\n69:   const tag = target && target.tagName;\n70:   if (tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT') return false;\n71:   if (target && target.isContentEditable) return false;\n72:   const key = ev.key != null ? String(ev.key) : '';\n73:   const code = ev.code != null ? String(ev.code) : '';\n74:   return key === binding.key || key.toLowerCase() === String(binding.key).toLowerCase() || code === binding.code;\n75: }\n76: \n77: /** Emit voice:dismiss once when the registered binding matches. Returns whether it emitted. */\n78: export function emitVoiceDismissFromBinding(bus, ev) {\n79:   if (!bus || typeof bus.emit !== 'function' || !voiceDismissBindingMatches(ev)) return false;\n80:   bus.emit('voice:dismiss', { source: 'binding', binding: 'voiceDismiss' });\n81:   return true;\n82: }\n83: \n84: // --- Device-aware prompt glyphs (PQ-164.01) ----------------------------------------------------\n85: // The bracket chip follows the last-used input device: ui/input.js owns device arbitration and\n86: // pushes it here (plus the resolved pad map, so a remapped button prints its own glyph), and\n87: // every caller of promptLabel() gets the live answer without threading a device argument.\n88: \n89: // UI actions that a single pad button performs directly. Verbs with no pad route (drill, cargo,\n90: // comms…) fall back to the keyboard label rather than print a pad lie.\n91: const PAD_ACTION_FOR = Object.freeze({\n92:   dock: 'dock',\n93:   localmap: 'map',\n94:   starmap: 'map',\n95:   codex: 'codex',\n96:   steeringView: 'steeringView',\n97: });\n98: \n99: // The touch overlay's own button captions for the UI actions it covers.\n100: const TOUCH_LABEL_FOR = Object.freeze({\n101:   dock: 'Dock',\n102:   localmap: 'Map',\n103:   starmap: 'Star',\n104:   missionLog: 'Log',\n105:   steeringView: 'View',\n106: });\n107: \n108: let _promptDevice = 'kbm';\n109: let _padMap = null;            // resolved gamepad action -> [std button names]\n110: let _padGlyphSet = 'xb';       // settings.controls.gamepad.glyphSet, pushed by the device arbiter\n111: let _padCaptureHandler = null; // Settings pad-remap capture (one at a time)\n112: \n113: export function setPromptDevice(device) {\n114:   _promptDevice = (device === 'gamepad' || device === 'touch') ? device : 'kbm';\n115: }\n116: export function getPromptDevice() {\n117:   return _promptDevice;\n118: }\n119: export function setGamepadPromptBindings(map) {\n120:   _padMap = map || null;\n121: }\n122: export function setGamepadGlyphSet(set) {\n123:   _padGlyphSet = normalizeGamepadGlyphSet(set);\n124: }\n125: export function getGamepadGlyphSet() {\n126:   return _padGlyphSet;\n127: }\n128: export function setGamepadCaptureHandler(fn) {\n129:   _padCaptureHandler = typeof fn === 'function' ? fn : null;\n130: }\n131: export function getGamepadCaptureHandler() {\n132:   return _padCaptureHandler;\n133: }\n134: \n135: /** Glyph for the first button bound to a gamepad action under the live (or given) map.\n136:  *  Keyboard-verb names resolve through GAMEPAD_VERB_ALIASES so 'tether' prints the\n137:  *  Massline button, never a blank; the face label honors the player's glyph set. */\n138: export function gamepadGlyphForAction(action, map) {\n139:   const src = map || _padMap || GAMEPAD_DEFAULT_BINDINGS;\n140:   const padAction = GAMEPAD_VERB_ALIASES[action] || action;\n141:   const name = src && src[padAction] && src[padAction][0];\n142:   return (name && (gamepadFaceButtonLabel(name, _padGlyphSet) || GAMEPAD_BUTTON_LABELS[name])) || '';\n143: }\n144: \n145: // Render a bracketed prompt label, e.g. \"[ E ] DOCK AT STATION\" — or \"[ A ]\" on a gamepad.\n146: export function promptLabel(action, device) {\n147:   const dev = device || _promptDevice;\n148:   const b = BINDINGS[action];\n149:   if (dev === 'gamepad') {\n150:     const padAction = PAD_ACTION_FOR[action];\n151:     const glyph = padAction === 'steeringView'\n152:       ? gamepadButtonLabels(padAction, _padMap || GAMEPAD_DEFAULT_BINDINGS, { glyphSet: _padGlyphSet })[0] || ''\n153:       : padAction ? gamepadGlyphForAction(padAction) : '';\n154:     if (glyph) return `[ ${glyph} ]`;\n155:   } else if (dev === 'touch') {\n156:     const label = TOUCH_LABEL_FOR[action];\n157:     if (label) return `[ ${label} ]`;\n158:   }\n159:   return b ? `[ ${b.label} ]` : '';\n160: }\n\n(End of file - total 160 lines)\n</content>","metadata":{"preview":"// Live interaction binding labels (spec §15.4: \"prompts use live bindings; docking defaults to E\").\n//\n// A single source of truth for the key a player presses to perform a context action. Prompts\n// (alerts), the help screen, and the input handler all read from here, so changing a binding in one\n// place updates every prompt automatically — there is no hardcoded \"[ ENTER ]\" string that can drift\n// out of sync with the actual handler. This is the lightweight \"live binding registry\" the spec asks\n// for: prompts render from this registry, not from literal key names.\n\nimport {\n  GAMEPAD_BUTTON_LABELS,\n  GAMEPAD_DEFAULT_BINDINGS,\n  GAMEPAD_VERB_ALIASES,\n  gamepadFaceButtonLabel,\n  gamepadButtonLabels,\n  normalizeGamepadGlyphSet,\n} from '../systems/gamepad.js';\n\nexport const BINDINGS = Object.freeze({\n  // Default interact/dock action is `E` (spec §15.4 / INTEGRATION_MAP §5). The input handler in\n  // src/ui/input.js must keep its case clause in sync with this value.","truncated":false,"loaded":[],"display":{"type":"file","path":"C:\\Users\\93rob\\Documents\\GitHub\\SpaceFace\\src\\ui\\bindings.js","text":"// Live interaction binding labels (spec §15.4: \"prompts use live bindings; docking defaults to E\").\n//\n// A single source of truth for the key a player presses to perform a context action. Prompts\n// (alerts), the help screen, and the input handler all read from here, so changing a binding in one\n// place updates every prompt automatically — there is no hardcoded \"[ ENTER ]\" string that can drift\n// out of sync with the actual handler. This is the lightweight \"live binding registry\" the spec asks\n// for: prompts render from this registry, not from literal key names.\n\nimport {\n  GAMEPAD_BUTTON_LABELS,\n  GAMEPAD_DEFAULT_BINDINGS,\n  GAMEPAD_VERB_ALIASES,\n  gamepadFaceButtonLabel,\n  gamepadButtonLabels,\n  normalizeGamepadGlyphSet,\n} from '../systems/gamepad.js';\n\nexport const BINDINGS = Object.freeze({\n  // Default interact/dock action is `E` (spec §15.4 / INTEGRATION_MAP §5). The input handler in\n  // src/ui/input.js must keep its case clause in sync with this value.\n  dock: { key: 'e', code: 'KeyE', label: 'E' },\n  // M is the primary \"map\" key — open at LOCAL (near-field). N is the star chart (galaxy scale).\n  localmap: { key: 'm', code: 'KeyM', label: 'M' },\n  starmap: { key: 'n', code: 'KeyN', label: 'N' },\n  techTree: { key: 't', code: 'KeyT', label: 'T' },\n  missionLog: { key: 'j', code: 'KeyJ', label: 'J' },\n  drill: { key: 'b', code: 'KeyB', label: 'B' },\n  // U (was C): the C key is the flight-verb SCANNER PULSE in the 2.0 input contract (GDD §7.1);\n  // claim-base is a rare contextual action and yields the prime key.\n  claimBase: { key: 'u', code: 'KeyU', label: 'U' },\n  cargo: { key: 'i', code: 'KeyI', label: 'I' },\n  comms: { key: 'l', code: 'KeyL', label: 'L' },\n  codex: { key: 'k', code: 'KeyK', label: 'K' },\n  // O remains the spec-locked overview pin. The Band takes the modified chord so both persistent\n  // flight tools retain a discoverable keyboard path without stealing a gameplay verb.\n  band: { key: 'O', code: 'KeyO', label: 'Shift+O', shift: true },\n  // Wingman command radial (Micro-Loops). The comms LOG owns L, so the quick fleet-comms radial\n  // lives on Z — a free key next to the movement cluster for a thumb-reachable \"hands stay on the\n  // stick\" fleet command.\n  fleetCommand: { key: 'z', code: 'KeyZ', label: 'Z' },\n  // G9: bring the flight objective back. Semicolon is free of the verb tables and does not\n  // open the mission log.\n  recallObjective: { key: ';', code: 'Semicolon', label: ';' },\n  // PQ-183.02 global find. Slash is the classic find key (EVE, vim, quick-find) and free\n  // repo-wide; text entry still wins, so typing '/' into a field never opens the palette.\n  find: { key: '/', code: 'Slash', label: '/' },\n  // PRO-09: the voice floor's pill is dismissable. Every letter belongs to a verb table, so it\n  // sits on Delete — free in flight (the drill screen that owns it there is modal) and reads as\n  // \"clear this\" without costing a letter key.\n  dismissVoice: { key: 'Delete', code: 'Delete', label: 'DEL' },\n  // F6 is the second dismiss binding, matched from the voice arbiter's own keydown hook\n  // (voiceDismissBindingMatches/emitVoiceDismissFromBinding) rather than the UI key router —\n  // the router does not own function keys.\n  voiceDismiss: { key: 'F6', code: 'F6', label: 'F6' },\n  // Every letter already owns a flight verb; backslash is the camera-only shortcut.\n  steeringView: { key: '\\\\', code: 'Backslash', label: '\\\\' },\n  // FB-085: photo mode is a sub-state of the pause screen, so the pause route owns P the same\n  // way the UI router owns dock/localmap only where the verb lives. No flight verb claims P\n  // (VERB_BINDINGS moved the deploy row to digits precisely because P is the pause key).\n  photo: { key: 'p', code: 'KeyP', label: 'P' },\n});\n\n/** True when this keydown is the floor-voice dismiss binding and not a chord. */\nexport function voiceDismissBindingMatches(ev) {\n  const binding = BINDINGS.voiceDismiss;\n  if (!ev || !binding || binding.shift || binding.ctrl || binding.alt || binding.meta) return false;\n  if (ev.repeat || ev.shiftKey || ev.ctrlKey || ev.altKey || ev.metaKey) return false;\n  const target = ev.target;\n  const tag = target && target.tagName;\n  if (tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT') return false;\n  if (target && target.isContentEditable) return false;\n  const key = ev.key != null ? String(ev.key) : '';\n  const code = ev.code != null ? String(ev.code) : '';\n  return key === binding.key || key.toLowerCase() === String(binding.key).toLowerCase() || code === binding.code;\n}\n\n/** Emit voice:dismiss once when the registered binding matches. Returns whether it emitted. */\nexport function emitVoiceDismissFromBinding(bus, ev) {\n  if (!bus || typeof bus.emit !== 'function' || !voiceDismissBindingMatches(ev)) return false;\n  bus.emit('voice:dismiss', { source: 'binding', binding: 'voiceDismiss' });\n  return true;\n}\n\n// --- Device-aware prompt glyphs (PQ-164.01) ----------------------------------------------------\n// The bracket chip follows the last-used input device: ui/input.js owns device arbitration and\n// pushes it here (plus the resolved pad map, so a remapped button prints its own glyph), and\n// every caller of promptLabel() gets the live answer without threading a device argument.\n\n// UI actions that a single pad button performs directly. Verbs with no pad route (drill, cargo,\n// comms…) fall back to the keyboard label rather than print a pad lie.\nconst PAD_ACTION_FOR = Object.freeze({\n  dock: 'dock',\n  localmap: 'map',\n  starmap: 'map',\n  codex: 'codex',\n  steeringView: 'steeringView',\n});\n\n// The touch overlay's own button captions for the UI actions it covers.\nconst TOUCH_LABEL_FOR = Object.freeze({\n  dock: 'Dock',\n  localmap: 'Map',\n  starmap: 'Star',\n  missionLog: 'Log',\n  steeringView: 'View',\n});\n\nlet _promptDevice = 'kbm';\nlet _padMap = null;            // resolved gamepad action -> [std button names]\nlet _padGlyphSet = 'xb';       // settings.controls.gamepad.glyphSet, pushed by the device arbiter\nlet _padCaptureHandler = null; // Settings pad-remap capture (one at a time)\n\nexport function setPromptDevice(device) {\n  _promptDevice = (device === 'gamepad' || device === 'touch') ? device : 'kbm';\n}\nexport function getPromptDevice() {\n  return _promptDevice;\n}\nexport function setGamepadPromptBindings(map) {\n  _padMap = map || null;\n}\nexport function setGamepadGlyphSet(set) {\n  _padGlyphSet = normalizeGamepadGlyphSet(set);\n}\nexport function getGamepadGlyphSet() {\n  return _padGlyphSet;\n}\nexport function setGamepadCaptureHandler(fn) {\n  _padCaptureHandler = typeof fn === 'function' ? fn : null;\n}\nexport function getGamepadCaptureHandler() {\n  return _padCaptureHandler;\n}\n\n/** Glyph for the first button bound to a gamepad action under the live (or given) map.\n *  Keyboard-verb names resolve through GAMEPAD_VERB_ALIASES so 'tether' prints the\n *  Massline button, never a blank; the face label honors the player's glyph set. */\nexport function gamepadGlyphForAction(action, map) {\n  const src = map || _padMap || GAMEPAD_DEFAULT_BINDINGS;\n  const padAction = GAMEPAD_VERB_ALIASES[action] || action;\n  const name = src && src[padAction] && src[padAction][0];\n  return (name && (gamepadFaceButtonLabel(name, _padGlyphSet) || GAMEPAD_BUTTON_LABELS[name])) || '';\n}\n\n// Render a bracketed prompt label, e.g. \"[ E ] DOCK AT STATION\" — or \"[ A ]\" on a gamepad.\nexport function promptLabel(action, device) {\n  const dev = device || _promptDevice;\n  const b = BINDINGS[action];\n  if (dev === 'gamepad') {\n    const padAction = PAD_ACTION_FOR[action];\n    const glyph = padAction === 'steeringView'\n      ? gamepadButtonLabels(padAction, _padMap || GAMEPAD_DEFAULT_BINDINGS, { glyphSet: _padGlyphSet })[0] || ''\n      : padAction ? gamepadGlyphForAction(padAction) : '';\n    if (glyph) return `[ ${glyph} ]`;\n  } else if (dev === 'touch') {\n    const label = TOUCH_LABEL_FOR[action];\n    if (label) return `[ ${label} ]`;\n  }\n  return b ? `[ ${b.label} ]` : '';\n}","lineStart":1,"lineEnd":160,"totalLines":160,"truncated":false}},"title":"src\\ui\\bindings.js","time":{"start":1792370383783,"end":1792370384016}},"id":"prt_151999b5c001nclAwmp8yXMlWa","sessionID":"ses_eae696a14ffehCxB980snPYjCy","messageID":"msg_151997842001Kfk98vP7Vvpe0J"}}
