rom anywhere — over a modal screen the palette mounts\n391:       // inside that screen so the dossier still has a host. Runs after def.onKey so a screen that\n392:       // already binds `/` to its own in-context find (the chart's target search) keeps it — one\n393:       // key still finds, it just finds the thing the player is looking at.\n394:       if (matchesBinding(ev, BINDINGS.find)) {\n395:         ev.preventDefault();\n396:         bus.emit('ui:globalFind', {});\n397:         return;\n398:       }\n399:       // Repeat the open binding to close the same instrument (mission log already does this in\n400:       // onKey; maps do it above). Without this, T/K/F1 open a screen they cannot close.\n401:       if (def && def.id === 'techTree' && matchesBinding(ev, BINDINGS.techTree)) {\n402:         ev.preventDefault();\n403:         closeActiveModal(def);\n404:         return;\n405:       }\n406:       if (def && def.id === 'codex' && matchesBinding(ev, BINDINGS.codex)) {\n407:         ev.preventDefault();\n408:         closeActiveModal(def);\n409:         return;\n410:       }\n411:       if (def && def.id === 'help' && (key === 'F1' || key === 'h' || key === 'H')) {\n412:         ev.preventDefault();\n413:         closeActiveModal(def);\n414:         return;\n415:       }\n416:       // The Pause menu labels Mission Log with the live binding. Keep that promise there and in\n417:       // the station hub, without teaching root/title/setup modals to open an in-run objective log.\n418:       if (allowsMissionLogShortcut(def) && matchesBinding(ev, BINDINGS.missionLog)) {\n419:         ev.preventDefault();\n420:         screenManager.pushScreen('missionLog');\n421:         bus.emit('audio:cue', { id: 'ui_open' });\n422:         return;\n423:       }\n424:       if (def && def.id === 'station' && matchesBinding(ev, BINDINGS.codex)) {\n425:         ev.preventDefault();\n426:         screenManager.pushScreen('codex');\n427:         bus.emit('audio:cue', { id: 'ui_open'