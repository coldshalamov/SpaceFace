{"type":"tool_use","timestamp":1792370221584,"sessionID":"ses_eae696a14ffehCxB980snPYjCy","part":{"type":"tool","tool":"read","callID":"call_00_uxuepz9sbywlz5668geil1iw","state":{"status":"completed","input":{"filePath":"C:\\Users\\93rob\\Documents\\GitHub\\SpaceFace\\src\\systems\\input.js"},"output":"<path>C:\\Users\\93rob\\Documents\\GitHub\\SpaceFace\\src\\systems\\input.js</path>\n<type>file</type>\n<content>\n1: import { isPlayerSaucer } from '../data/saucer.js';\n2: import { projectSaucerControls } from '../core/flight/saucerControl.js';\n3: // Input system: samples keyboard + mouse, projects the cursor to the world plane, and writes\n4: // state.input each tick. THREE control schemes, picked by settings.gameplay.controlScheme\n5: // ('pilot' default | 'helm-assist' | 'classic'):\n6: //\n7: //   PILOT (default) — KEYBOARD FLIES, MOUSE FIGHTS. The mouse never steers the nose: it aims\n8: //   weapons, picks targets and throws the Massline. W/↑ thrust, S/↓ brakes/reverses.\n9: //   A/D and ←/→ always YAW the nose, thrust held or not, so a turn is one clean arc. They must\n10: //   not become a strafe while W is held: that aimed the path about 45° off the hull, the nose\n11: //   stayed cocked out of the vapor trail for as long as the key was down, and it only evened\n12: //   out after the key came up. Q/E is the strafe in every state. LMB fire.\n13: //\n14: //   HELM ASSIST — the ship's NOSE FOLLOWS THE MOUSE CURSOR (rate-limited by the ship's\n15: //   own turn stats, so mass still reads). W thrusts, S/↓ brakes/reverses, A/D lateral strafe.\n16: //   Braking is computed through the normal thrust pipeline — heavy ships brake\n17: //   heavy). LMB fire. Arrows also fly: up/down thrust, left/right strafe while forward thrust is\n18: //   held; left/right arrows yaw the ship when forward thrust is not held so keyboard pilots still\n19: //   have direct nose control.\n20: //\n21: //   CLASSIC — the 1.x scheme: ↑/W throttle, A/D yaw the nose (bank into turns), Q/E strafe,\n22: //   mouse aims weapons independently, LMB fires. The arrow cluster keeps the same flight split:\n23: //   bare ←/→ yaw, W/↑ + ←/→ strafe.\n24: //\n25: //   ALL schemes: RMB mining beam (group 2) · Shift boost/dash · X countermeasure · G auto-target\n26: //   toggle (owned by autoTargetAssist — guns lead the lock and relative motion becomes a dynamic combat stick) ·\n27: //   Space/F Massline (tap latch/cut, hold line control) · Q charge throw (helm) · R detonate\n28: //   charges · C scanner pulse · V cruise.\n29: //   New verbs land on state.input.actions.* as edge-triggered flags (the LOCKED input contract in\n30: //   BUILD_PLAN_2_0 §0) — consumer systems (tetherGameplay, impulseCharges, scanner, cruise) read\n31: //   them; input never calls those systems directly.\n32: // Flight/combat keys are owned here; UI-owned global keys are handled in src/ui/input.js.\n33: // NOTE: NPC ships NEVER read state.input — they write e.data.intent directly (ai.js), so this\n34: // control remap does not affect them.\n35: //\n36: // REBINDING (V2 §12): flight actions are resolved through a bindings map keyed by action id. The\n37: // defaults below are mirrored as `settings.controls.bindings` on first run; the Settings/Controls\n38: // tab captures a new key per action and persists it. Input reads state.settings.controls.bindings\n39: // (falling back to DEFAULT_BINDINGS) so changes take effect immediately, no restart needed.\n40: \n41: // Action -> default KeyboardEvent.code. A binding may map to MULTIPLE codes (e.g. throttle uses\n42: // both KeyW and ArrowUp) so WASD-and-arrows both work out of the box. The settings layer stores an\n43: // array per action; the UI lets the player set a primary + keeps the arrow-cluster as a secondary\n44: // for movement so arrow-key players aren't stranded.\n45: import { emptyDrawFlightPath, emptyDrawFlightGesture } from './drawFlightInput.js';\n46: import { projectDynamicFlightStick, recordDynamicFlightStick, resetDynamicFlightStick } from './dynamicFlightStick.js';\n47: import {\n48:   createGamepad,\n49:   normalizePadCurve,\n50:   normalizePadSensitivity,\n51:   shapePadAxis,\n52:   shapePadVector,\n53: } from './gamepad.js';\n54: import { createTouch } from './touch.js';\n55: import { createMasslineInputGrammar } from './masslineInputGrammar.js';\n56: import { wrapAngle } from '../core/rng.js';\n57: import { massline2Flag, travelFlag } from '../data/featureFlags.js';\n58: import { TRAVEL_DRIVE_STATES } from '../core/flight/propulsionKernel.js';\n59: import { isHostileToPlayer } from './scanner.js';\n60: import { isBeamTargetEligible } from './mining.js';\n61: import { interactionProfileForEntity } from '../data/entityInteractionProfiles.js';\n62: import { resolveWorldPresentationEntity } from '../world/presentationSources.js';\n63: import { resolveSteeringView } from './racingSteer.js';\n64: import { noteSwarmPilotAction, swarmPilotIsActing } from './swarmSafety.js';\n65: \n66: // Helm-assist steering: turnIntent saturates at ±1 beyond this much nose-to-cursor error (rad),\n67: // so the ship's own yaw controller (rate caps, banking, class tuning) shapes the actual turn.\n68: const HELM_SOFT_ANGLE = 0.55;\n69: \n70: const WORLD_TOOL_HOLD_S = 0.28;\n71: const HELM_DEADBAND = 0.012;   // rad — below this the nose is \"on\" the cursor; stops micro-jitter\n72: const BRAKE_SOFT_SPEED = 24;   // wu/s — counter-thrust ramps down below this for a smooth settle\n73: \n74: \n75: // ---- Travel Burn latch (atlas D5 / W1-5) ------------------------------------------------------\n76: // The kernel is PURE and only ever shapes the governor cap; the state machine, its timers and its\n77: // bindings live here with the input owner (propulsionKernel.js:22-24). `TRAVEL_DRIVE_STATES` is\n78: // imported rather than redeclared so there is exactly one spelling of the axis in the tree.\n79: //\n80: // Spool is a deliberate commitment window, not a loading bar: engaging costs you ~1.6 s during\n81: // which you are still fully manoeuvrable but not yet gaining cap, so committing to a burn in a\n82: // hot sector is a real decision. Cooldown is the price of breaking it.\n83: const TRAVEL_SPOOL_S = 1.6;\n84: const TRAVEL_COOLDOWN_S = 3;\n85: // Below this the pilot is not really \"braking\" — it keeps a feathered retro-touch from dropping a\n86: // long haul, while a deliberate brake still breaks the latch instantly.\n87: const TRAVEL_BRAKE_BREAK_EPS = 0.08;\n88: \n89: function neutralTravelDrive() {\n90:   return {\n91:     // --- kernel-facing contract (propulsionKernel.js normalizeTravelDrive). Extra keys below are\n92:     // ignored by the kernel, so HUD/diagnostic fields can share this one published address.\n93:     state: 'off',\n94:     cap: 0,          // carried ramp state: the kernel advances it, we feed it straight back\n95:     rampMult: 1,     // lane infrastructure (D8) multiplies this; nothing does yet\n96:     // --- latch-owned timers and provenance (never read by the kernel)\n97:     spoolT: 0,\n98:     cooldownT: 0,\n99:     engagedT: 0,\n100:     breakReason: null,\n101:   };\n102: }\n103: \n104: /**\n105:  * True when the pilot is actively braking hard enough to break the latch.\n106:  *\n107:  * D5's feel rule is an ASYMMETRY and it is the whole point of the feature: **braking breaks the\n108:  * latch, steering does not.** So this reads the brake actuator and reverse throttle ONLY — it must\n109:  * never consult `turnIntent` or `moveX`. A pilot correcting course, carving, or spinning the nose\n110:  * mid-burn keeps the burn; a pilot who reaches for the brake has decided to stop travelling.\n111:  */\n112: function travelBrakeBreaks(inp) {\n113:   if (!inp) return false;\n114:   if (inp.brake) return true;\n115:   return finiteOr(inp.moveZ, 0) < -TRAVEL_BRAKE_BREAK_EPS;\n116: }\n117: \n118: /**\n119:  * Interdiction seam (D5: \"Damage or lane disruption forces Cooldown — that is the interdiction\n120:  * hook\"). Wired now, triggered by nothing yet: D8's lane prototype and the damage path are the\n121:  * intended writers. Both a level flag and a one-shot request are honoured so a future disruptor\n122:  * can either hold the drive down or knock it out once.\n123:  */\n124: function travelDisrupted(state) {\n125:   const p = state && state.player;\n126:   if (!p) return false;\n127:   const drive = p.travelDrive;\n128:   if (drive && (drive.disrupted === true || drive.disruptRequest === true)) return true;\n129:   return false;\n130: }\n131: \n132: function travelDisruptionReason(state) {\n133:   const p = state && state.player;\n134:   const drive = p && p.travelDrive;\n135:   if (!drive) return null;\n136:   if (drive.disruptRequest === true) return drive.disruptReason || 'disrupted';\n137:   if (drive.disrupted === true) return 'disrupted';\n138:   return null;\n139: }\n140: \n141: function clearTravelDisruptRequest(state) {\n142:   const drive = state && state.player && state.player.travelDrive;\n143:   if (drive && drive.disruptRequest === true) {\n144:     drive.disruptRequest = false;\n145:     drive.disruptReason = null;\n146:   }\n147: }\n148: \n149: function finiteOr(v, fallback) { return Number.isFinite(v) ? v : fallback; }\n150: \n151: /**\n152:  * Advance the travel-drive latch one tick and publish `state.input.travelDrive` for the kernel.\n153:  *\n154:  * THE CARRIED-CAP ROUND TRIP IS THE WHOLE RAMP. The kernel is pure: it consumes `travelDrive.cap`,\n155:  * advances it one step toward the ceiling, and republishes it at `result.telemetry.travelCap`\n156:  * (kernel :324-325, :871). Nobody persists it in between — we read last tick's published value back\n157:  * off the player's flight frame and hand it in again. `input` is first in UPDATE_ORDER and\n158:  * `flightSlot` is later, so \"last tick\" is exactly right; dropping this feedback would leave the\n159:  * cap pinned at its seed and the drive would do nothing at all.\n160:  *\n161:  * Everything here is gated on `travelFlag('travelBurn')` read at CALL TIME. Under node the flag is\n162:  * false, so not one key is written and the sim goldens cannot see this system.\n163:  */\n164: function stepTravelLatch(host, state, inp, dt, lineOwnsAxis = false) {\n165:   if (!travelFlag('travelBurn')) {\n166:     // Flag off: leave no trace at all, and drop any latch state a flag flip mid-session left behind.\n167:     if (inp.travelDrive) delete inp.travelDrive;\n168:     host._travel = null;\n169:     return;\n170:   }\n171: \n172:   const drive = host._travel || (host._travel = neutralTravelDrive());\n173:   const step = Math.max(0, finiteOr(dt, 0));\n174:   const pressed = host._travelEdge;\n175:   const disrupted = travelDisrupted(state);\n176:   const disruptionReason = travelDisruptionReason(state);\n177:   // Line control spends reverse on the rope. That axis is not a decision to drop the burn.\n178:   // A dedicated brake button still breaks it, because the caller leaves lineOwnsAxis false then.\n179:   const braking = lineOwnsAxis ? false : travelBrakeBreaks(inp);\n180:   // Forward the LEVEL flag on the published block, not just the one-shot latch transition: the\n181:   // kernel's normalizeTravelDrive consumes `disrupted` to hold the ramp down AND (D8) to treat\n182:   // the dead beacon as the environmental force that spends overspeed toward the falling ceiling.\n183:   drive.disrupted = disrupted;\n184: \n185:   // Feed the kernel's published ramp back in. Reading the frame the kernel actually wrote (rather\n186:   // than re-deriving a ramp here) keeps ONE owner of the ramp maths — the kernel.\n187:   const player = state.entities && state.entities.get ? state.entities.get(state.playerId) : null;\n188:   const frame = player && player._flightFrame;\n189:   if (frame && Number.isFinite(frame.travelCap)) drive.cap = Math.max(0, frame.travelCap);\n190:   if (frame && Number.isFinite(frame.travelCeiling)) drive.ceiling = frame.travelCeiling;\n191: \n192:   const toCooldown = (reason) => {\n193:     drive.state = 'cooldown';\n194:     drive.cooldownT = 0;\n195:     drive.engagedT = 0;\n196:     drive.spoolT = 0;\n197:     drive.breakReason = reason;\n198:   };\n199: \n200:   switch (drive.state) {\n201:     case 'off':\n202:       if (disrupted) { toCooldown(disruptionReason || 'disrupted'); break; }\n203:       if (pressed) { drive.state = 'spooling'; drive.spoolT = 0; drive.breakReason = null; }\n204:       break;\n205: \n206:     case 'spooling':\n207:       // Disruption and braking both kill a spool. A second press is a CANCEL, not a disengage:\n208:       // nothing was earned yet, so it costs no cooldown — the punishment is for breaking a burn.\n209:       if (disrupted) { toCooldown(disruptionReason || 'disrupted'); break; }\n210:       if (braking) { toCooldown('brake'); break; }\n211:       if (pressed) { drive.state = 'off'; drive.spoolT = 0; drive.breakReason = 'cancelled'; break; }\n212:       drive.spoolT += step;\n213:       if (drive.spoolT >= TRAVEL_SPOOL_S) {\n214:         drive.state = 'engaged';\n215:         drive.spoolT = TRAVEL_SPOOL_S;\n216:         drive.engagedT = 0;\n217:         drive.breakReason = null;\n218:       }\n219:       break;\n220: \n221:     case 'engaged':\n222:       if (disrupted) { toCooldown(disruptionReason || 'disrupted'); break; }\n223:       if (braking) { toCooldown('brake'); break; }\n224:       if (pressed) { toCooldown('pilot'); break; }\n225:       drive.engagedT += step;\n226:       break;\n227: \n228:     case 'cooldown':\n229:     default:\n230:       drive.cooldownT += step;\n231:       // A live disruption holds the drive down rather than letting the timer run out under it.\n232:       if (disrupted) drive.cooldownT = 0;\n233:       else if (drive.cooldownT >= TRAVEL_COOLDOWN_S) {\n234:         drive.state = 'off';\n235:         drive.cooldownT = 0;\n236:         // The break reason PERSISTS while the disengaged cap record decays: the kernel spends\n237:         // overspeed toward the falling ceiling only for a world-caused break (D8 disruption), and\n238:         // it must still know that after the ship has coasted clear of the dead segment. A pilot\n239:         // reason ('pilot'/'brake') keeps the settle-to-rest coast. The next press overwrites it.\n240:       }\n241:       break;\n242:   }\n243: \n244:   clearTravelDisruptRequest(state);\n245:   if (!TRAVEL_DRIVE_STATES.includes(drive.state)) drive.state = 'off';\n246: \n247:   // One published address, kernel-shaped. Extra keys are ignored by normalizeTravelDrive and are\n248:   // what the HUD reads, so the latch has a single source of truth.\n249:   inp.travelDrive = drive;\n250: }\n251: \n252: // Verb keys shared by both schemes (GDD 2.0 physics verbs + sensors).\n253: //\n254: // THE NUMBER ROW IS THE ORDNANCE HOTBAR (1–9). The rank on the HUD (powerRail.js / the ORRERY\n255: // Cluster's ordnance crescent) is nine verbs in four bands, and a player reads that shelf as a\n256: // hotbar — pressing 1–3 and getting nothing was the resulting defect. Digit1–3 therefore carry the\n257: // three ORDNANCE verbs alongside their original keys (Y/R/Space stay primary so nothing already\n258: // taught or remapped is lost; the digit is a real second code in the same multi-code array idiom\n259: // travelBurn already uses). Digit4–9 were already the deployable row.\n260: //\n261: // Prompt answers still win the row while a decision is live: contactHail/promptDeck/wingmanRadial\n262: // capture and swallow their digits on document capture, and flight input is neutralized under\n263: // modals (`modalInputActive`) — the same slot-claim contract the rail was designed around.\n264: const VERB_BINDINGS = {\n265:   siteBeam:       ['KeyB'],   // level: contextual beam for an explicitly selected World Site proxy\n266:   tether:         ['Space', 'KeyF', 'Digit3'], // PQ-003: Space primary, F retained as a permanent alias\n267:   chargeDetonate: ['KeyR', 'Digit2'],   // edge: detonate owned armed drift bombs and impulse charges\n268:   scanPulse:      ['KeyC'],   // edge: scanner pulse (8 s cd owned by scanner system)\n269:   cruise:         ['KeyV'],   // edge: toggle cruise charge (cruise system owns state)\n270:   autopursuit:    [],         // retired; retained as an inert save/input compatibility field.\n271:   deployBeacon:   ['KeyU'],   // edge: drop a claim beacon in open space (beacons system owns cost/cap).\n272:                               //   The UI router owns U only when a claimable body is in range; in open\n273:                               //   space it falls through to this flight verb (see check-claim-base-input).\n274:   // Massline Physics Identity (Wave M2). Every letter key is spoken for, so the two new verbs sit\n275:   // on the free left-pinky cluster next to WASD; both are rebindable like every other action.\n276:   bulletTime:     ['CapsLock'],   // level: hold for time dilation (bulletTime system owns meter)\n277:   cloak:          ['Backquote'],  // edge: toggle the cloak module (cloak system owns energy/gating)\n278:   // PQ-011/SF-11 deployable anchor Mass Seed. Every letter code is claimed (P alone would collide\n279:   // with the UI pause route), so the verb ships on Digit4: left-hand reachable off WASD, free\n280:   // repo-wide (Digit1–3 carry the ORDNANCE band; flight verbs are suppressed under modals),\n281:   // and rebindable like every other flight verb.\n282:   // Edge: launch the seed toward the aim point (massSeed system owns lifecycle/cooldown/cap).\n283:   deployMassSeed: ['Digit4'],\n284:   // PQ-012/SF-12 continuous field tools. Digit5-7 are free repo-wide (checked against both scheme\n285:   // tables and ui/bindings.js, same as Digit4), left-hand reachable off WASD, and rebindable like\n286:   // every flight verb. The fields system owns lifecycle/cooldown/cap for all three.\n287:   deployWell:         ['Digit5'], // edge: deploy an attractive Well at the aim point (PULL)\n288:   deployRepulsor:     ['Digit6'], // edge: drop a Repulsor at the ship (outward SHOVE)\n289:   toggleClearingCone: ['Digit7'], // edge: toggle the ship-attached forward Clearing Cone (snowplow)\n290:   // PQ-013/SF-14 planetary skim collector. Digit8 is free repo-wide (checked against both scheme\n291:   // tables and ui/bindings.js, same audit as Digit4-7) and sits with the deployable family. The\n292:   // planetRuntime system owns the collector state; yield is path x density, never a hold timer.\n293:   toggleSkimCollector: ['Digit8'], // edge: toggle the atmospheric skim collector (The Anvil bands)\n294:   // The Gyre Snare — held-key telekinetic katamari lash (gyreSnare system owns the state).\n295:   // Quote (') is free repo-wide (checked against both scheme tables, ui/bindings.js, and the\n296:   // UI key router): every letter is claimed, and 'o' in particular was triple-claimed\n297:   // (Band cycle on Shift+O + the overview-pin toggle on plain 'o'). Quote is right-pinky\n298:   // reachable, a natural hold verb, and carries no modifier alias or UI claim. Level verb:\n299:   // hold to beam + hold the clump, release to bowl it; hold-to-toggle latch opt-in via\n300:   // accessibility.holdToToggle.gyreSnare.\n301:   gyreSnare:          ['Quote'],    // level: hold to pull/snag/grow a ball, release to bowl it\n302:   // Drift-bomb bay (design/ORDNANCE_BOMBS_SPEC.md). Digit9 is free repo-wide (same audit as\n303:   // Digit4-8; Digit1-3 carry the ORDNANCE band) and completes the deployable row.\n304:   // Comma is free repo-wide (checked against both scheme tables and ui/bindings.js) and sits\n305:   // next to the deployable row as the bay's cycle key. The bombs system owns\n306:   // lifecycle/fuze/payload; both are ordinary rebindable edge verbs.\n307:   dropBomb:  ['Digit9'], // edge: release the selected drift bomb at current ship velocity\n308:   cycleBomb: ['Comma'],  // edge: cycle the bomb bay's selected payload\n309:   // VERB-13: one flight key dumps the selected hold lot as the payload body cargo already spawns.\n310:   // Period is free of the verb tables and the UI bindings. Cargo owns the dump.\n311:   jettisonLot: ['Period'],\n312:   // The hull burst has NO verb of its own (owner principle 2026-09-30): the fitted boost upgrade\n313:   // rides the boost itself, and the hullBurst system polls the player's boost flag. There is no\n314:   // burst key to bind on keyboard, mouse or pad.\n315:   // Travel Burn latch (atlas D5 / W1-5). Num Lock is the authored default: it is a genuine latch\n316:   // key on a full keyboard, it is never used for anything else in this game, and it carries a\n317:   // physical indicator light that matches \"the drive is engaged\". Many laptops have no Num Lock\n318:   // key at all (or bury it behind Fn), so a second code ships in the SAME array — the existing\n319:   // multi-code idiom this table already uses for WASD-and-arrows, not a parallel laptop scheme.\n320:   // KeyH is free repo-wide (checked against both VERB/scheme tables and ui/bindings.js) and sits\n321:   // under the right index finger on the home row, so it is reachable on any chassis.\n322:   travelBurn:     ['NumLock', 'KeyH'],   // edge: toggle the travel drive (latch owns the state machine)\n323: };\n324: \n325: const DEFAULT_BINDINGS = {   // CLASSIC scheme (1.x) + the new verbs\n326:   forward:  ['KeyW', 'ArrowUp'],\n327:   reverse:  ['KeyS', 'ArrowDown'],\n328:   yawRight: ['KeyD', 'ArrowRight'],\n329:   yawLeft:  ['KeyA', 'ArrowLeft'],\n330:   strafeLeft:  ['KeyQ'],\n331:   strafeRight: ['KeyE'],\n332:   boost:    ['ShiftLeft', 'ShiftRight'],\n333:   fire:     [],                 // LMB fires; Space is the new-profile Massline action\n334:   brake:    ['Digit0'],         // dedicated zero-thrust brake; S/Down remains reverse + brake\n335:   autoFire: ['KeyG'],\n336:   countermeasure: ['KeyX'],    // deploy chaff/ECM (P1-7) — X by default, remappable\n337:   chargeThrow: ['KeyY', 'Digit1'],       // classic: Q/E are strafe and T is the tech-tree UI key, so throw lives on Y; Digit1 is the hotbar seat\n338:   // VERB-14: the winch needs keys every player has. BracketLeft/Right are free repo-wide\n339:   // (no flight verb, no UI shortcut, no help copy claims them) and sit as a natural in/out pair\n340:   // on any layout. Rebindable like every other flight verb; the hold-grammar line-control path stays.\n341:   reelIn:  ['BracketLeft'],\n342:   reelOut: ['BracketRight'],\n343:   ...VERB_BINDINGS,\n344:   // Mouse buttons (LMB=fire, RMB=group2/mine) are not remappable in this pass — they're ergonomic\n345:   // constants. Keyboard equivalents (Space to fire) ARE remappable.\n346: };\n347: \n348: const HELM_BINDINGS = {      // HELM ASSIST (default): mouse owns the nose\n349:   forward:  ['KeyW', 'ArrowUp'],\n350:   reverse:  ['KeyS', 'ArrowDown'],\n351:   yawRight: [],                // nose follows cursor — yaw keys retired in this scheme\n352:   yawLeft:  [],\n353:   strafeLeft:  ['KeyA', 'ArrowLeft'],\n354:   strafeRight: ['KeyD', 'ArrowRight'],\n355:   boost:    ['ShiftLeft', 'ShiftRight'],\n356:   fire:     [],                // LMB only\n357:   brake:    ['Digit0'],        // dedicated zero-thrust brake; S/Down remains reverse + brake\n358:   autoFire: ['KeyG'],\n359:   countermeasure: ['KeyX'],\n360:   chargeThrow: ['KeyQ', 'Digit1'],\n361:   reelIn:  ['BracketLeft'],\n362:   reelOut: ['BracketRight'],\n363:   ...VERB_BINDINGS,\n364: };\n365: \n366: export const PILOT_BINDINGS = {     // PILOT (default): keyboard flies, mouse fights\n367:   forward:  ['KeyW', 'ArrowUp'],\n368:   reverse:  ['KeyS', 'ArrowDown'],\n369:   yawRight: ['KeyD', 'ArrowRight'],  // yaw, including under thrust; Q/E is the strafe\n370:   yawLeft:  ['KeyA', 'ArrowLeft'],\n371:   strafeLeft:  ['KeyQ'],             // explicit strafe in every state (pursuit orbit-adjust)\n372:   strafeRight: ['KeyE'],\n373:   boost:    ['ShiftLeft', 'ShiftRight'],\n374:   fire:     [],                      // LMB fires — the mouse is a weapon, not a rudder\n375:   brake:    ['Digit0'],              // dedicated zero-thrust brake; S/Down remains reverse + brake\n376:   autoFire: ['KeyG'],\n377:   countermeasure: ['KeyX'],\n378:   chargeThrow: ['KeyY', 'Digit1'],             // Q/E are strafe here, so throw lives on Y (classic parity); Digit1 is the hotbar seat\n379:   reelIn:  ['BracketLeft'],\n380:   reelOut: ['BracketRight'],\n381:   ...VERB_BINDINGS,\n382: };\n383: \n384: const SCHEME_BINDINGS = { pilot: PILOT_BINDINGS, classic: DEFAULT_BINDINGS, 'helm-assist': HELM_BINDINGS };\n385: \n386: // Active control scheme; pilot is the default — flight physics is the game's toy, and the toy\n387: // is played with the keyboard while the mouse targets/fires/grapples. Helm-assist (mouse-nose)\n388: // remains selectable for players who prefer cursor steering.\n389: function activeScheme(state) {\n390:   const s = state.settings && state.settings.gameplay && state.settings.gameplay.controlScheme;\n391:   return SCHEME_BINDINGS[s] ? s : 'pilot';\n392: }\n393: \n394: /**\n395:  * Pure Pilot keyboard projection after rebind resolution.\n396:  *\n397:  * The live input tick and deterministic public-control harness share this one semantic owner:\n398:  * A/D always yaws, Q/E always strafes, and S is reverse/brake. A/D must not strafe under\n399:  * thrust. Vectoring would then aim the path at nose + atan2(strafe, throttle), the hull would\n400:  * sit out of its trail while the key was held, and the lead bound would not see it.\n401:  */\n402: export function projectPilotFlightControls({\n403:   forward = false,\n404:   reverse = false,\n405:   brakeHeld = false,\n406:   yawLeft = false,\n407:   yawRight = false,\n408:   strafeLeft = false,\n409:   strafeRight = false,\n410:   boost = false,\n411: } = {}, out = null) {\n412:   const side = (yawRight ? 1 : 0) - (yawLeft ? 1 : 0);\n413:   const explicit = (strafeRight ? 1 : 0) - (strafeLeft ? 1 : 0);\n414:   const projected = out && typeof out === 'object' ? out : {};\n415:   projected.moveX = explicit;\n416:   projected.moveZ = (forward ? 1 : 0) - (reverse ? 1 : 0);\n417:   projected.turnIntent = side;\n418:   projected.lineOrbit = side;\n419:   projected.boost = boost === true;\n420:   projected.brake = reverse === true || brakeHeld === true;\n421:   return projected;\n422: }\n423: \n424: // Resolve the live binding for an action: player rebinds (settings) win, then the active scheme's\n425: // table, then classic defaults. Always returns an array of codes.\n426: function binding(state, action) {\n427:   const cfg = state.settings && state.settings.controls && state.settings.controls.bindings;\n428:   const scheme = SCHEME_BINDINGS[activeScheme(state)];\n429:   const list = (cfg && cfg[action]) || scheme[action] || DEFAULT_BINDINGS[action];\n430:   return Array.isArray(list) ? list : (list ? [list] : []);\n431: }\n432: \n433: export const DEFAULTS = { BINDINGS: DEFAULT_BINDINGS, SCHEMES: SCHEME_BINDINGS };\n434: \n435: const ARROW_GLYPHS = Object.freeze({\n436:   ArrowUp: '↑', ArrowDown: '↓', ArrowLeft: '←', ArrowRight: '→',\n437: });\n438: const ARROW_WORDS = Object.freeze({\n439:   ArrowUp: 'Up', ArrowDown: 'Down', ArrowLeft: 'Left', ArrowRight: 'Right',\n440: });\n441: \n442: /** Mouse buttons are not remappable; empty `fire` still means the left mouse button. */\n443: export const MOUSE_ACTION_LABELS = Object.freeze({ fire: 'LMB', mine: 'RMB' });\n444: \n445: /** Flight actions the default route teaches. Interface keys live in `src/ui/bindings.js`. */\n446: export const TAUGHT_FLIGHT_ACTIONS = Object.freeze([\n447:   'forward', 'reverse', 'brake', 'yawLeft', 'yawRight', 'strafeLeft', 'strafeRight',\n448:   'boost', 'fire', 'autoFire', 'countermeasure', 'tether', 'reelIn', 'reelOut', 'deployMassSeed',\n449:   'siteBeam', 'scanPulse', 'cruise', 'dropBomb', 'cycleBomb', 'chargeDetonate',\n450: ]);\n451: \n452: /**\n453:  * Live bound KeyboardEvent.code list for a flight action.\n454:  * Player rebinds win, then the active scheme, then classic defaults.\n455:  */\n456: export function resolveActionCodes(state, action) {\n457:   return binding(state, action);\n458: }\n459: \n460: /** Short player-facing name for one KeyboardEvent.code. */\n461: export function formatBindingCode(code, { arrows = 'glyph' } = {}) {\n462:   if (!code) return '';\n463:   if (/^Key[A-Z]$/.test(code)) return code.slice(3);\n464:   if (/^Digit\\d$/.test(code)) return code.slice(5);\n465:   if (/^Numpad\\d$/.test(code)) return `Num ${code.slice(6)}`;\n466:   if (code.startsWith('Arrow')) {\n467:     const table = arrows === 'word' ? ARROW_WORDS : ARROW_GLYPHS;\n468:     return table[code] || code;\n469:   }\n470:   if (code === 'Space') return 'Space';\n471:   if (code === 'ShiftLeft') return 'L-Shift';\n472:   if (code === 'ShiftRight') return 'R-Shift';\n473:   if (code === 'ControlLeft') return 'L-Ctrl';\n474:   if (code === 'ControlRight') return 'R-Ctrl';\n475:   if (code === 'AltLeft') return 'L-Alt';\n476:   if (code === 'AltRight') return 'R-Alt';\n477:   if (code === 'NumLock') return 'Num Lock';\n478:   if (code === 'CapsLock') return 'Caps Lock';\n479:   if (code === 'Backquote') return '`';\n480:   if (code === 'Quote') return \"'\";\n481:   if (code === 'Backslash' || code === 'IntlBackslash') return '\\\\';\n482:   if (code === 'BracketLeft') return '[';\n483:   if (code === 'BracketRight') return ']';\n484:   if (code === 'Comma') return ',';\n485:   if (code === 'Period') return '.';\n486:   if (code === 'Minus') return '-';\n487:   if (code === 'Equal') return '=';\n488:   if (code === 'Semicolon') return ';';\n489:   if (code === 'Quote') return \"'\";\n490:   if (code === 'Slash') return '/';\n491:   if (code === 'MetaLeft') return 'L-Meta';\n492:   if (code === 'MetaRight') return 'R-Meta';\n493:   if (code === 'Enter') return 'Enter';\n494:   if (code === 'NumpadEnter') return 'Num Enter';\n495:   if (code === 'NumpadAdd') return 'Num +';\n496:   if (code === 'NumpadSubtract') return 'Num -';\n497:   if (code === 'NumpadMultiply') return 'Num *';\n498:   if (code === 'NumpadDivide') return 'Num /';\n499:   if (code === 'NumpadDecimal') return 'Num .';\n500:   if (code === 'PageUp') return 'Pg Up';\n501:   if (code === 'PageDown') return 'Pg Dn';\n502:   if (code === 'Insert') return 'Ins';\n503:   if (code === 'Delete') return 'Del';\n504:   if (code === 'Home') return 'Home';\n505:   if (code === 'End') return 'End';\n506:   if (code === 'Tab') return 'Tab';\n507:   if (code === 'Escape') return 'Esc';\n508:   if (code === 'Backspace') return 'Bksp';\n509:   if (code === 'PrintScreen') return 'PrtSc';\n510:   if (code === 'ScrollLock') return 'ScrLk';\n511:   if (code === 'Pause') return 'Pause';\n512:   if (code === 'ContextMenu') return 'Menu';\n513:   if (code === 'Mouse0' || code === 'mouse0') return MOUSE_ACTION_LABELS.fire;\n514:   if (code === 'Mouse2' || code === 'mouse2') return MOUSE_ACTION_LABELS.mine;\n515:   // Last resort is never the raw DOM code: strip the mechanical prefix and split the camel case\n516:   // ('NumpadEnter' never reaches here, 'IntlRo' → 'Ro', 'LaunchApp1' → 'Launch App').\n517:   return code.replace(/^(Key|Digit|Numpad)/, '').replace(/([a-z])([A-Z])/g, '$1 $2') || code;\n518: }\n519: \n520: /**\n521:  * The label every HUD / help / prompt surface must print for a flight action.\n522:  * Empty `fire` is LMB (the mouse is not remappable). Other empty bindings print `empty`.\n523:  */\n524: export function resolveActionLabel(state, action, { sep = '/', arrows = 'glyph', empty = '' } = {}) {\n525:   const codes = binding(state, action);\n526:   if (!codes.length) {\n527:     if (action === 'fire') return MOUSE_ACTION_LABELS.fire;\n528:     return empty;\n529:   }\n530:   // Two codes that print the same glyph (Backslash / IntlBackslash) are one label, not \"\\/\\\\\".\n531:   return Array.from(new Set(codes.map((c) => formatBindingCode(c, { arrows })).filter(Boolean))).join(sep);\n532: }\n533: \n534: const KEY_CODE_FALLBACKS = {\n535:   w: 'KeyW',\n536:   a: 'KeyA',\n537:   s: 'KeyS',\n538:   d: 'KeyD',\n539:   q: 'KeyQ',\n540:   e: 'KeyE',\n541:   f: 'KeyF',\n542:   c: 'KeyC',\n543:   x: 'KeyX',\n544:   g: 'KeyG',\n545:   r: 'KeyR',\n546:   v: 'KeyV',\n547:   t: 'KeyT',\n548:   '0': 'Digit0',\n549:   ' ': 'Space',\n550:   space: 'Space',\n551:   arrowup: 'ArrowUp',\n552:   arrowdown: 'ArrowDown',\n553:   arrowleft: 'ArrowLeft',\n554:   arrowright: 'ArrowRight',\n555:   shift: 'ShiftLeft',\n556: };\n557: \n558: const OPPOSING_ACTIONS = new Map([\n559:   ['forward', 'reverse'],\n560:   ['reverse', 'forward'],\n561:   ['yawRight', 'yawLeft'],\n562:   ['yawLeft', 'yawRight'],\n563:   ['strafeRight', 'strafeLeft'],\n564:   ['strafeLeft', 'strafeRight'],\n565: ]);\n566: \n567: export function eventCode(e) {\n568:   if (e && e.code) return e.code;\n569:   const key = e && typeof e.key === 'string' ? e.key.toLowerCase() : '';\n570:   return KEY_CODE_FALLBACKS[key] || '';\n571: }\n572: \n573: function actionForCode(state, code) {\n574:   for (const action of Object.keys(DEFAULT_BINDINGS)) {\n575:     if (binding(state, action).includes(code)) return action;\n576:   }\n577:   return null;\n578: }\n579: \n580: function clearActionCodes(state, keys, action, exceptCode) {\n581:   for (const code of binding(state, action)) {\n582:     if (code !== exceptCode) keys[code] = false;\n583:   }\n584: }\n585: \n586: /**\n587:  * Deterministic keyboard event transition shared by the DOM listener and fixed-tick harnesses.\n588:  * Ordinary opposing axes retain last-input-wins; a player saucer keeps both for cancellation.\n589:  * Dedicated actions such as\n590:  * brake do not need an impossible simultaneous-axis state.\n591:  */\n592: export function transitionFlightKeyState(\n593:   state,\n594:   currentKeys = {},\n595:   {\n596:     code = '',\n597:     pressed = false,\n598:     blocked = false,\n599:   } = {},\n600: ) {\n601:   const nextKeys = Object.assign(Object.create(null), currentKeys);\n602:   if (typeof code !== 'string' || code.length === 0) return nextKeys;\n603:   if (blocked || pressed !== true) {\n604:     nextKeys[code] = false;\n605:     return nextKeys;\n606:   }\n607:   const action = actionForCode(state, code);\n608:   const opposingAction = action && OPPOSING_ACTIONS.get(action);\n609:   // A disc averages physically held directions. Conventional ships retain last-input-wins.\n610:   const saucer = isPlayerSaucer(state?.entities?.get?.(state?.playerId));\n611:   if (opposingAction && !saucer) {\n612:     clearActionCodes(state, nextKeys, opposingAction, code);\n613:   }\n614:   nextKeys[code] = true;\n615:   return nextKeys;\n616: }\n617: \n618: function applyFlightKeyTransition(keys, nextKeys) {\n619:   for (const code of Object.keys(nextKeys)) keys[code] = nextKeys[code];\n620: }\n621: \n622: // Verbs that must not collapse into the key map. Movement stays on the map itself.\n623: const SAMPLED_EDGE_ACTIONS = new Set([\n624:   'tether', 'chargeThrow', 'chargeDetonate', 'scanPulse', 'cruise', 'deployBeacon',\n625:   'deployMassSeed', 'deployWell', 'deployRepulsor', 'toggleClearingCone',\n626:   'toggleSkimCollector', 'dropBomb', 'cycleBomb', 'cloak', 'travelBurn', 'jettisonLot',\n627: ]);\n628: \n629: // Pad verbs that must re-prove a deliberate press after a lifecycle reset (blur, dock, resume).\n630: // The first connected sample must be neutral before a held button can re-arm an edge verb — a\n631: // chord physically held across a dock or a tab-hide must not fire the moment the pad publishes\n632: // again. The bomb bay verbs always read this gate; adding them here repairs a silent no-op.\n633: // Continuous pad controls use the same fence. Their raw gamepad samples remain truthful, but a\n634: // held trigger, shoulder or stick must not become flight authority again until a connected neutral\n635: // sample proves the physical control was released. The modal/mode fence reapplies this set while\n636: // flight is unavailable, so a press made inside a screen cannot arm the next flight tick.\n637: const GAMEPAD_LIFECYCLE_CONTINUOUS_ACTIONS = Object.freeze([\n638:   'fire', 'mine', 'boost', 'brake', 'leftStick', 'rightStick',\n639: ]);\n640: \n641: const GAMEPAD_LIFECYCLE_QUARANTINE_ACTIONS = Object.freeze([\n642:   'massline', 'countermeasure', 'travelBurn', 'autoTarget', 'chargeDetonate', 'deployRepulsor',\n643:   'dropBomb', 'cycleBomb',\n644:   'scanPulse', 'cruise', 'deployBeacon', 'deployMassSeed', 'deployWell', 'toggleClearingCone',\n645:   'toggleSkimCollector', 'siteBeam', 'bulletTime', 'cloak', 'chargeThrow', 'jettisonLot',\n646:   // gyreSnare is a held pad chord (RB+Y): a grip held across a dock or tab-hide must not\n647:   // re-fire the beam the moment the pad publishes again.\n648:   'gyreSnare',\n649:   ...GAMEPAD_LIFECYCLE_CONTINUOUS_ACTIONS,\n650: ]);\n651: \n652: function freshGamepadLifecycleQuarantine({ continuous = false } = {}) {\n653:   // A plain object, not Object.create(null): the lifecycle suites deep-compare this map against\n654:   // an object literal, and the keys are a fixed internal table, never player-supplied names.\n655:   const q = {};\n656:   for (const action of GAMEPAD_LIFECYCLE_QUARANTINE_ACTIONS) {\n657:     q[action] = continuous || !GAMEPAD_LIFECYCLE_CONTINUOUS_ACTIONS.includes(action);\n658:   }\n659:   return q;\n660: }\n661: \n662: // FB-113: hold verbs a player may opt into press-to-toggle latches for. `massline` is the\n663: // tether/Massline hold; reelIn/reelOut are the dedicated winch keys. Defaults are all off —\n664: // accessibility.holdToToggle[verb] flips one on. A latch survives until the next press edge or\n665: // a context change (dock, death, any screen/modal, lifecycle reset).\n666: export const HOLD_TO_TOGGLE_ACTIONS = Object.freeze([\n667:   'boost', 'brake', 'bulletTime', 'gyreSnare', 'massline', 'reelIn', 'reelOut',\n668: ]);\n669: \n670: function holdToToggleEnabled(state) {\n671:   const map = state && state.settings && state.settings.accessibility\n672:     && state.settings.accessibility.holdToToggle;\n673:   return (verb) => !!(map && map[verb] === true);\n674: }\n675: \n676: /**\n677:  * FB-113: merge a physical hold with its opt-in latch. `held` is the merged physical sample this\n678:  * tick; `prev` tracks the previous physical sample so a fresh press edge flips the latch; `latch`\n679:  * owns the toggled state. A verb not enabled never latches (returns the physical value).\n680:  */\n681: function applyHoldToggle(latches, edges, verb, held, enabled) {\n682:   const prev = !!edges[verb];\n683:   edges[verb] = !!held;\n684:   if (!enabled) {\n685:     latches[verb] = false;\n686:     return !!held;\n687:   }\n688:   if (held && !prev) latches[verb] = !latches[verb];\n689:   return !!held || latches[verb] === true;\n690: }\n691: \n692: function resetHoldToggleLatches(latches, edges) {\n693:   if (latches) for (const verb of HOLD_TO_TOGGLE_ACTIONS) latches[verb] = false;\n694:   if (edges) for (const verb of HOLD_TO_TOGGLE_ACTIONS) edges[verb] = false;\n695: }\n696: const KEY_EDGE_CAP = 64;\n697: \n698: function flightEdgeQueue(host) {\n699:   return host._keyEdgeQueue || (host._keyEdgeQueue = []);\n700: }\n701: \n702: /**\n703:  * One keyboard transition in the order it was sampled. Repeat packets and a press that\n704:  * started under a modal, text field, or button are not flight edges. timeStamp is ignored.\n705:  */\n706: export function applyFlightKeyEvent(host, event = {}) {\n707:   if (!host || !host._keys) return false;\n708:   const code = event.code;\n709:   if (typeof code !== 'string' || code.length === 0) return false;\n710:   const keys = host._keys;\n711:   const pressed = event.pressed === true;\n712:   const blocked = event.blocked === true;\n713:   const swallowed = host._swallowedFlightKeys || (host._swallowedFlightKeys = Object.create(null));\n714:   // Repeats are not edges. A held movement key still has to mark the keyboard live, or a\n715:   // quiet pad steals the helm for the rest of the hold.\n716:   if (pressed && event.repeat === true) {\n717:     if (!blocked && !swallowed[code]) host._kbmActivityPending = true;\n718:     return false;\n719:   }\n720:   if (pressed && blocked) {\n721:     swallowed[code] = true;\n722:     keys[code] = false;\n723:     return false;\n724:   }\n725:   if (!pressed && swallowed[code]) {\n726:     delete swallowed[code];\n727:     keys[code] = false;\n728:     return false;\n729:   }\n730:   const wasDown = !!keys[code];\n731:   applyFlightKeyTransition(keys, transitionFlightKeyState(host.state, keys, {\n732:     code, pressed, blocked: false,\n733:   }));\n734:   if (!pressed && !wasDown) return false;\n735:   if (pressed) host._kbmActivityPending = true;\n736:   const action = actionForCode(host.state, code);\n737:   if (!SAMPLED_EDGE_ACTIONS.has(action)) return true;\n738:   if (!pressed && action !== 'tether') return true;\n739:   const queue = flightEdgeQueue(host);\n740:   queue.push({ code, pressed, action });\n741:   if (queue.length > KEY_EDGE_CAP) queue.splice(0, queue.length - KEY_EDGE_CAP);\n742:   return true;\n743: }\n744: \n745: function takeSampledPress(host, state, action) {\n746:   const queue = host._keyEdgeQueue;\n747:   if (!queue || queue.length === 0 || action === 'tether') return false;\n748:   const index = queue.findIndex((edge) => edge.pressed && edge.action === action);\n749:   if (index < 0) return false;\n750:   queue.splice(index, 1);\n751:   return true;\n752: }\n753: \n754: function takeOldestTetherEdge(host) {\n755:   const queue = host._keyEdgeQueue;\n756:   if (!queue || queue.length === 0) return null;\n757:   const index = queue.findIndex((edge) => edge.action === 'tether');\n758:   if (index < 0) return null;\n759:   return queue.splice(index, 1)[0];\n760: }\n761: \n762: // Focus loss releases keys that are still down. Drop only the unmatched press for those\n763: // keys so the hold cannot latch after the window is gone. A tap that already released\n764: // stays queued and still reaches the next sim step.\n765: function dropUnreleasedHeldEdges(queue, keys) {\n766:   if (!queue || queue.length === 0 || !keys) return;\n767:   const lastPress = Object.create(null);\n768:   for (let i = 0; i < queue.length; i += 1) {\n769:     const edge = queue[i];\n770:     if (!edge || typeof edge.code !== 'string') continue;\n771:     lastPress[edge.code] = edge.pressed ? i : -1;\n772:   }\n773:   const drop = [];\n774:   for (const code in keys) {\n775:     if (!keys[code]) continue;\n776:     const index = lastPress[code];\n777:     if (index >= 0) drop.push(index);\n778:   }\n779:   if (drop.length === 0) return;\n780:   const skip = new Set(drop);\n781:   let write = 0;\n782:   for (let i = 0; i < queue.length; i += 1) {\n783:     if (skip.has(i)) continue;\n784:     queue[write] = queue[i];\n785:     write += 1;\n786:   }\n787:   queue.length = write;\n788: }\n789: \n790: export function isTextEntryTarget(target) {\n791:   if (!target || typeof target.closest !== 'function') return false;\n792:   return !!target.closest('input, textarea, select, [contenteditable=\"true\"], [contenteditable=\"\"], [data-text-input]');\n793: }\n794: \n795: export function isUiCommandTarget(target) {\n796:   if (!target || typeof target.closest !== 'function') return false;\n797:   return !!target.closest('button, [role=\"button\"], a[href], input, textarea, select, [contenteditable=\"true\"], [contenteditable=\"\"], #ui-root, #screens');\n798: }\n799: \n800: // --- sim-lane overrides ------------------------------------------------------\n801: // When the whole sim runs in a worker (simLane=worker), DOM facts the reducer\n802: // needs — viewport size and the modal-body latch — cannot be read there. The\n803: // main lane ships them in as lane overrides; `null` keeps the DOM read for the\n804: // main lane. The fold arrives over the command channel before any tick applies\n805: // it, so both lanes reduce identical inputs.\n806: let _laneViewport = null;      // {width, height} — replaces innerWidth/innerHeight\n807: let _laneModalActive = null;   // boolean — replaces the document.body class read\n808: \n809: export function setLaneViewport(width, height) {\n810:   _laneViewport = Number.isFinite(width) && Number.isFinite(height)\n811:     ? { width, height }\n812:     : null;\n813: }\n814: \n815: export function setLaneModalActive(active) {\n816:   _laneModalActive = active === null || active === undefined ? null : active === true;\n817: }\n818: \n819: export function modalInputActive() {\n820:   if (_laneModalActive !== null) return _laneModalActive;\n821:   const body = typeof document !== 'undefined' ? document.body : null;\n822:   if (!body || !body.classList || typeof body.classList.contains !== 'function') return false;\n823:   // Pausing modals AND live overlays both own the keyboard: a screen over a running sim must not\n824:   // double as flight input (FRONTEND_DIRECTION §3.5 un-blinds the player, it does not hand the\n825:   // stick back while a map is open).\n826:   return body.classList.contains('ui-modal-open') || body.classList.contains('ui-live-screen');\n827: }\n828: \n829: function syncPointerScreen(state, x, y) {\n830:   if (!state || !state.input || !Number.isFinite(x) || !Number.isFinite(y)) return;\n831:   const pointerScreen = state.input.pointerScreen || (state.input.pointerScreen = { x: 0, y: 0, active: false });\n832:   pointerScreen.x = x;\n833:   pointerScreen.y = y;\n834:   pointerScreen.active = true;\n835: }\n836: \n837: function viewportSize() {\n838:   if (_laneViewport) return { width: _laneViewport.width, height: _laneViewport.height };\n839:   return {\n840:     width: typeof innerWidth === 'number' ? Math.max(1, innerWidth) : 1,\n841:     height: typeof innerHeight === 'number' ? Math.max(1, innerHeight) : 1,\n842:   };\n843: }\n844: \n845: function centeredPointer() {\n846:   const { width, height } = viewportSize();\n847:   return {\n848:     width,\n849:     height,\n850:     cx: width * 0.5,\n851:     cy: height * 0.5,\n852:   };\n853: }\n854: \n855: function neutralAutoTargetVector() {\n856:   return { active: false, screenX: 0, screenY: 0, worldX: 0, worldZ: 0, magnitude: 0 };\n857: }\n858: \n859: export function shouldNeutralizeFlightInput(state, modalActive = false) {\n860:   const stack = state && state.ui && state.ui.screenStack;\n861:   return !state || state.mode !== 'flight' || !!(stack && stack.length)\n862:     || modalActive === true || !!(state.input && state.input.blocked);\n863: }\n864: \n865: function writeAutoTargetVector(\n866:   inp,\n867:   worldX = 0,\n868:   worldZ = 0,\n869:   active = false,\n870:   screenX = worldX,\n871:   screenY = worldZ,\n872:   magnitudeOverride = null,\n873: ) {\n874:   const vector = inp.autoTargetVector && typeof inp.autoTargetVector === 'object'\n875:     ? inp.autoTargetVector\n876:     : (inp.autoTargetVector = neutralAutoTargetVector());\n877:   const x = Number.isFinite(worldX) ? worldX : 0;\n878:   const z = Number.isFinite(worldZ) ? worldZ : 0;\n879:   const magnitude = active\n880:     ? Math.min(1, Number.isFinite(magnitudeOverride) ? magnitudeOverride : Math.hypot(x, z))\n881:     : 0;\n882:   vector.active = magnitude > 0.001;\n883:   vector.screenX = Number.isFinite(screenX) ? Math.max(-1, Math.min(1, screenX)) : 0;\n884:   vector.screenY = Number.isFinite(screenY) ? Math.max(-1, Math.min(1, screenY)) : 0;\n885:   vector.worldX = vector.active ? x : 0;\n886:   vector.worldZ = vector.active ? z : 0;\n887:   vector.magnitude = vector.active ? magnitude : 0;\n888:   return vector;\n889: }\n890: \n891: function resetAutoTargetPath(host, state = host && host.state) {\n892:   host._autoTargetGesture = emptyDrawFlightGesture();\n893:   if (state?.input) {\n894:     state.input.autoTargetPath = emptyDrawFlightPath();\n895:     if (state.input.drawFlight) delete state.input.drawFlight;\n896:   }\n897: }\n898: \n899: // A map, a pause, or a focus loss used to keep the G-mode knob where the pilot left it.\n900: // The next flight tick then republished that shove as thrust. Discard the knob and the\n901: // vector it already published. The mode itself stays; only a fresh packet steers again.\n902: function discardCombatStick(host) {\n903:   const { width, height } = centeredPointer();\n904:   resetDynamicFlightStick(host, width, height);\n905:   const inp = host && host.state && host.state.input;\n906:   if (inp) writeAutoTargetVector(inp);\n907: }\n908: \n909: function stickViewport() {\n910:   // Pass a collapsed window through as itself. viewportSize() floors at 1px for the pointer,\n911:   // which would turn a minimize into a real radius and keep commanding thrust.\n912:   if (_laneViewport) return { width: _laneViewport.width, height: _laneViewport.height };\n913:   const width = typeof innerWidth === 'number' ? innerWidth : 1;\n914:   const height = typeof innerHeight === 'number' ? innerHeight : 1;\n915:   return { width, height };\n916: }\n917: \n918: function recordAutoTargetStick(host, movementX, movementY) {\n919:   const { width, height } = stickViewport();\n920:   return recordDynamicFlightStick(host, movementX, movementY, width, height);\n921: }\n922: \n923: function publishAutoTargetStick(host, inp) {\n924:   const { width, height } = stickViewport();\n925:   const vector = projectDynamicFlightStick(host, width, height);\n926:   return writeAutoTargetVector(\n927:     inp,\n928:     vector.worldX,\n929:     vector.worldZ,\n930:     vector.active,\n931:     vector.screenX,\n932:     vector.screenY,\n933:     vector.magnitude,\n934:   );\n935: }\n936: \n937: /** Deterministic ms clock from simTime (gameplay paths). N2. */\n938: function simClockMs(state) {\n939:   const t = state && Number.isFinite(state.simTime) ? state.simTime : 0;\n940:   return t * 1000;\n941: }\n942: \n943: // Presentation-relative intent only: raw device axes and the propulsion owner stay untouched.\n944: function stickWorldDirection(host, state, player, axes) {\n945:   const out = host._stickWorld || (host._stickWorld = { x: 0, z: 0 });\n946:   out.x = axes.x; out.z = axes.y;\n947:   if (resolveSteeringView(state) !== 'racing') return out;\n948:   const projected = host.helpers?.screenToWorldDirection?.(axes, out);\n949:   if (projected && Number.isFinite(projected.x) && Number.isFinite(projected.z)) return projected;\n950:   // Input-only hosts have no rendered camera; the stern convention follows the hull.\n951:   const yaw = Number.isFinite(player.rot) ? player.rot : 0;\n952:   out.x = Math.cos(yaw) * axes.y - Math.sin(yaw) * axes.x;\n953:   out.z = Math.sin(yaw) * axes.y + Math.cos(yaw) * axes.x;\n954:   return out;\n955: }\n956: \n957: // --- normalized DOM-event reducers -------------------------------------------\n958: // One DOM event, one descriptor, one reducer — shared by the real DOM adapter\n959: // (descriptors built from live events on the presenting lane) and the sim-lane\n960: // path (descriptors shipped to the sim's realm via ingestLaneDomEvent). Field\n961: // names are the wire contract. `uiCommand`/`offCanvas`/`neutralize` are computed\n962: // on the realm that owns the DOM — the sim realm replays them verbatim.\n963: export function domKeyEvent(host, d = {}) {\n964:   applyFlightKeyEvent(host, {\n965:     code: d.code,\n966:     pressed: d.pressed === true,\n967:     repeat: d.repeat === true,\n968:     blocked: d.blocked === true,\n969:   });\n970: }\n971: \n972: export function domPointerMoveEvent(host, d = {}) {\n973:   if (!host || !Number.isFinite(d.clientX) || !Number.isFinite(d.clientY)) return;\n974:   const geometry = centeredPointer();\n975:   if (host.state && host.state.input && host.state.input.autoFire) {\n976:     if (d.neutralize === true || d.uiCommand === true) return;\n977:     // Dynamic combat-stick input records from the mousemove stream ONLY. Browsers\n978:     // dispatch a compatibility mousemove for every pointermove, so accepting both\n979:     // would double the stick displacement whenever pointer lock is absent.\n980:     if (d.type === 'pointermove') return;\n981:     const movementX = Number.isFinite(d.movementX) ? d.movementX : 0;\n982:     const movementY = Number.isFinite(d.movementY) ? d.movementY : 0;\n983:     if (movementX === 0 && movementY === 0) return;\n984:     recordAutoTargetStick(host, movementX, movementY);\n985:     host._screen.x = geometry.cx;\n986:     host._screen.y = geometry.cy;\n987:     host._screen.active = true;\n988:     host._ndc.x = 0;\n989:     host._ndc.y = 0;\n990:   } else {\n991:     host._screen.x = d.clientX;\n992:     host._screen.y = d.clientY;\n993:     host._screen.active = true;\n994:     host._ndc.x = (host._screen.x / geometry.width) * 2 - 1;\n995:     host._ndc.y = -(host._screen.y / geometry.height) * 2 + 1;\n996:   }\n997:   syncPointerScreen(host.state, host._screen.x, host._screen.y);\n998:   // noteFlightPointer equivalent — uiCommand already computed on the DOM realm.\n999:   if (d.uiCommand !== true) {\n1000:     host._kbmActivityPending = true;\n1001:     host._pointerHelmEdge = true;\n1002:   }\n1003: }\n1004: \n1005: export function domMouseDownEvent(host, d = {}) {\n1006:   if (!host) return;\n1007:   domPointerMoveEvent(host, d);\n1008:   if (d.offCanvas === true || (!host._canvas && d.uiCommand === true)) {\n1009:     host._m0 = false; host._m1 = false; host._m2 = false;\n1010:     host._clearM2HoldClock();\n1011:     return;\n1012:   }\n1013:   if (d.button === 0) host._m0 = true;\n1014:   if (d.button === 1) host._m1 = true;\n1015:   if (d.button === 2) {\n1016:     host._m2 = true; host._m2HeldS = 0; host._m2ToolLane = null; host._m2SlingTargetId = null;\n1017:     host._clearM2HoldClock();\n1018:     const clockTarget = host._m2TimerTarget;\n1019:     if (host._m2UsesUiClock && clockTarget && typeof clockTarget.setTimeout === 'function') {\n1020:       const epoch = host._m2HoldEpoch;\n1021:       try {\n1022:         host._m2HoldTimer = clockTarget.setTimeout(() => {\n1023:           if (host._initialized && host._m2 === true && host._m2HoldEpoch === epoch) {\n1024:             host._m2HoldReady = true;\n1025:           }\n1026:         }, WORLD_TOOL_HOLD_S * 1000);\n1027:       } catch (_) { host._m2HoldTimer = null; }\n1028:     }\n1029:   }\n1030:   host._kbmActivityPending = true;\n1031: }\n1032: \n1033: export function domMouseUpEvent(host, d = {}) {\n1034:   if (!host) return;\n1035:   if (d.button === 0) host._m0 = false;\n1036:   if (d.button === 1) host._m1 = false;\n1037:   if (d.button === 2) { host._m2 = false; host._clearM2HoldClock(); }\n1038: }\n1039: \n1040: export const input = {\n1041:   name: 'input',\n1042:   init(ctx) {\n1043:     if (this._initialized || this._domAdapterAttached\n1044:       || (Array.isArray(this._domBindings) && this._domBindings.length > 0)) {\n1045:       this.destroy();\n1046:     }\n1047:     this._initialized = true;\n1048:     this._inputContext = ctx;\n1049:     this.state = ctx.state;\n1050:     this.bus = ctx.bus;\n1051:     this.helpers = ctx.helpers;\n1052:     this._bindInterruptControlRelease();\n1053:     this._domBindings = [];\n1054:     const keys = (this._keys = Object.create(null));\n1055:     this._ndc = { x: 0, y: 0 };\n1056:     this._laneCursorProjection = null;\n1057:     const initViewport = _laneViewport || null;\n1058:     const viewportW = initViewport ? initViewport.width\n1059:       : (typeof innerWidth === 'number' ? innerWidth : 0);\n1060:     const viewportH = initViewport ? initViewport.height\n1061:       : (typeof innerHeight === 'number' ? innerHeight : 0);\n1062:     this._screen = { x: Math.floor(viewportW * 0.5), y: Math.floor(viewportH * 0.5), active: false };\n1063:     resetAutoTargetPath(this, this.state);\n1064:     resetDynamicFlightStick(this, Math.max(1, viewportW), Math.max(1, viewportH));\n1065:     this._m0 = false; this._m1 = false; this._m2 = false;\n1066:     this._m2HeldS = 0;\n1067:     this._m2ToolLane = null;\n1068:     this._m2SlingTargetId = null;\n1069:     this._m2HoldReady = false;\n1070:     this._m2HoldTimer = null;\n1071:     this._m2UsesUiClock = false;\n1072:     this._m2TimerTarget = null;\n1073:     this._cmHeld = false;\n1074:     this._gamepadLifecycleQuarantine = freshGamepadLifecycleQuarantine();\n1075:     this._holdToggleLatches = Object.create(null);\n1076:     this._holdToggleEdges = Object.create(null);\n1077:     this._masslineGrammar = createMasslineInputGrammar();\n1078:     // F4/G9: device arbitration uses deterministic (tick, sequence) activity stamps shared\n1079:     // across keyboard/gamepad/touch — never performance.now()/Date.now(). Sequence reflects\n1080:     // actual event order within a tick (not device-type priority).\n1081:     this._lastKbmTick = -1;\n1082:     this._lastKbmSeq = -1;\n1083:     this._kbmActivityPending = false;\n1084:     this._inputActivitySeq = 0;\n1085:     this._lastInputWallMs = 0;\n1086:     this._canvas = (typeof document !== 'undefined') ? document.getElementById('gl-canvas') : null;\n1087:     // Worker realm (simLane=worker): no window/document, but self carries real timers —\n1088:     // the m2 world-tool hold clock keeps its wall-duration semantics inside the sim realm.\n1089:     if (typeof window === 'undefined' && typeof self !== 'undefined'\n1090:         && typeof self.setTimeout === 'function' && typeof self.clearTimeout === 'function') {\n1091:       this._m2UsesUiClock = true;\n1092:       this._m2TimerTarget = self;\n1093:     }\n1094: \n1095:     this.gamepad = createGamepad(ctx);\n1096:     ctx.gamepad = this.gamepad;\n1097: \n1098:     // Touch layer (P1-12): virtual dual-stick + buttons for touchscreens. Auto-detects on touch\n1099:     // devices; the overlay is built lazily. Merged below alongside gamepad so gameplay is unchanged.\n1100:     this.touch = createTouch(ctx);\n1101:     ctx.touch = this.touch;\n1102:     this.touch.autoDetect();\n1103: \n1104:     // H3: DOM adapter is browser-only. Deterministic grammar/key state initializes without window.\n\n(Output capped at 50 KB. Showing lines 1-1104. Use offset=1105 to continue.)\n</content>\n\n<system-reminder>\nInstructions from: C:\\Users\\93rob\\Documents\\GitHub\\SpaceFace\\src\\systems\\AGENTS.md\n# src/systems/ agent orientation\n\nRegistered systems implement `init(ctx)` and `update(dt, state)` and run in the order owned by\n`src/core/registry.js`. Use generated `docs/SYSTEM_REGISTRY.md` for navigation; do not copy the order\ninto this file.\n\n## Important routing\n\n- Flight: `flightV3.js`; shared math in `src/core/flight/`. `flight.js` is compatibility/test scope.\n- AI: `tacticalAI.js` + `src/ai/`; `aiPorts.js` executes decisions. `ai.js` is compatibility scope.\n- Hostility/fire authority: `src/ai/engagementAuthority.js`; read `docs/COMMON_BUGS.md` before edits.\n- Combat: registered `combat.js` plus shared `src/combat/` library.\n- Tether: `tetherGameplay.js` coordinating combat attachments, weapons, physics, and focus/camera.\n- Economy/cargo/factions/heat/ships: honor the root single-writer contract.\n- Missions/story/onboarding: verify public-route reachability and ordering, not only generated offers.\n- Presentation orchestrators consume presentation data; they do not replace render/UI ownership.\n\n## Imported helpers in this directory\n\nSome files are libraries rather than registered ticks. Confirm importers in `docs/SYSTEM_REGISTRY.md`\nor with `rg` before changing cadence/ownership. Examples include danger/economy-cycle, alphabet,\ngamepad, telemetry, and touch helpers.\n\n## Verification\n\nRun the narrow subsystem test/check, then sim comparison for sim-affecting changes. AI/combat/flight\nfeel also requires a representative encounter or player-route proof.\n\n\nInstructions from: C:\\Users\\93rob\\Documents\\GitHub\\SpaceFace\\src\\AGENTS.md\n# src/ agent orientation\n\nRead root `AGENTS.md` first. Use `docs/MODULE_MAP.md` to select an owner, then the nearest nested\ninstructions. Do not infer the live backend from imports; root §5 and `core/registry.js` own selection.\n\n## Layer boundaries\n\n- `core/` — state, event bus, loop facade, registry, physics/lifetime authority. Order and clocks:\n  `src/runtime/AGENTS.md`.\n- `systems/` — registered fixed-step systems and a few imported helpers.\n- `ai/` and `combat/` — shared tactical/combat libraries used by registered systems.\n- `data/` — stable IDs and data-driven definitions.\n- `render/` — Three.js presentation and runtime asset integration; never owns sim results.\n  Hazard notes also in `render/combat/`, `render/ships/`, `render/vfx/`, `render/forceLanguage/`.\n- `testing/lab/` — deterministic gameplay scenarios. `testing/AGENTS.md` points at the lab.\n- `ui/` — DOM presentation and input intents. UI may update explicitly UI/input-owned selection state\n  such as `state.player.targetId`; it must not mutate gameplay-owned outcomes.\n- `audio/`, `presentation/`, `save/`, `sim/`, `observability/` — each has an `AGENTS.md`. Audio and\n  presentation do not write outcomes. Save owns the envelope. `sim/` is tapes and pure projections.\n- `world/`, `story/`, `characters/`, `nemesis/`, `chronicler/`, `onboarding/`, `localization/` —\n  libraries. The registered writers stay in `systems/`. Read the folder note before editing.\n- `economy/`, `missions/`, `contracts/`, `careers/`, `balance/` — pure math, schemas, or harnesses.\n  `missions/AGENTS.md` also covers `law/` and `physicalCargo/` (too small for their own note).\n- Credits, cargo, WANTED heat, reputation, and derived ship stats still have one writer each in\n  `systems/`. These folders return numbers or intents.\n\n## Source rules\n\n- Sim remains deterministic and independent of Three.js.\n- Cross-domain changes follow root single-writer and event/intent contracts.\n- Compatibility flight/AI modules are tested paths, not the default gameplay owner.\n- Verify the working-tree diff before assuming `HEAD` describes the live implementation.\n- For recurring hostility, fallback, heat, save, or launcher failures, use `docs/COMMON_BUGS.md`\n  before broad search.\n\n</system-reminder>","metadata":{"preview":"import { isPlayerSaucer } from '../data/saucer.js';\nimport { projectSaucerControls } from '../core/flight/saucerControl.js';\n// Input system: samples keyboard + mouse, projects the cursor to the world plane, and writes\n// state.input each tick. THREE control schemes, picked by settings.gameplay.controlScheme\n// ('pilot' default | 'helm-assist' | 'classic'):\n//\n//   PILOT (default) — KEYBOARD FLIES, MOUSE FIGHTS. The mouse never steers the nose: it aims\n//   weapons, picks targets and throws the Massline. W/↑ thrust, S/↓ brakes/reverses.\n//   A/D and ←/→ always YAW the nose, thrust held or not, so a turn is one clean arc. They must\n//   not become a strafe while W is held: that aimed the path about 45° off the hull, the nose\n//   stayed cocked out of the vapor trail for as long as the key was down, and it only evened\n//   out after the key came up. Q/E is the strafe in every state. LMB fire.\n//\n//   HELM ASSIST — the ship's NOSE FOLLOWS THE MOUSE CURSOR (rate-limited by the ship's\n//   own turn stats, so mass still reads). W thrusts, S/↓ brakes/reverses, A/D lateral strafe.\n//   Braking is computed through the normal thrust pipeline — heavy ships brake\n//   heavy). LMB fire. Arrows also fly: up/down thrust, left/right strafe while forward thrust is\n//   held; left/right arrows yaw the ship when forward thrust is not held so keyboard pilots still\n//   have direct nose control.\n//","truncated":true,"loaded":["C:\\Users\\93rob\\Documents\\GitHub\\SpaceFace\\src\\systems\\AGENTS.md","C:\\Users\\93rob\\Documents\\GitHub\\SpaceFace\\src\\AGENTS.md"],"display":{"type":"file","path":"C:\\Users\\93rob\\Documents\\GitHub\\SpaceFace\\src\\systems\\input.js","text":"import { isPlayerSaucer } from '../data/saucer.js';\nimport { projectSaucerControls } from '../core/flight/saucerControl.js';\n// Input system: samples keyboard + mouse, projects the cursor to the world plane, and writes\n// state.input each tick. THREE control schemes, picked by settings.gameplay.controlScheme\n// ('pilot' default | 'helm-assist' | 'classic'):\n//\n//   PILOT (default) — KEYBOARD FLIES, MOUSE FIGHTS. The mouse never steers the nose: it aims\n//   weapons, picks targets and throws the Massline. W/↑ thrust, S/↓ brakes/reverses.\n//   A/D and ←/→ always YAW the nose, thrust held or not, so a turn is one clean arc. They must\n//   not become a strafe while W is held: that aimed the path about 45° off the hull, the nose\n//   stayed cocked out of the vapor trail for as long as the key was down, and it only evened\n//   out after the key came up. Q/E is the strafe in every state. LMB fire.\n//\n//   HELM ASSIST — the ship's NOSE FOLLOWS THE MOUSE CURSOR (rate-limited by the ship's\n//   own turn stats, so mass still reads). W thrusts, S/↓ brakes/reverses, A/D lateral strafe.\n//   Braking is computed through the normal thrust pipeline — heavy ships brake\n//   heavy). LMB fire. Arrows also fly: up/down thrust, left/right strafe while forward thrust is\n//   held; left/right arrows yaw the ship when forward thrust is not held so keyboard pilots still\n//   have direct nose control.\n//\n//   CLASSIC — the 1.x scheme: ↑/W throttle, A/D yaw the nose (bank into turns), Q/E strafe,\n//   mouse aims weapons independently, LMB fires. The arrow cluster keeps the same flight split:\n//   bare ←/→ yaw, W/↑ + ←/→ strafe.\n//\n//   ALL schemes: RMB mining beam (group 2) · Shift boost/dash · X countermeasure · G auto-target\n//   toggle (owned by autoTargetAssist — guns lead the lock and relative motion becomes a dynamic combat stick) ·\n//   Space/F Massline (tap latch/cut, hold line control) · Q charge throw (helm) · R detonate\n//   charges · C scanner pulse · V cruise.\n//   New verbs land on state.input.actions.* as edge-triggered flags (the LOCKED input contract in\n//   BUILD_PLAN_2_0 §0) — consumer systems (tetherGameplay, impulseCharges, scanner, cruise) read\n//   them; input never calls those systems directly.\n// Flight/combat keys are owned here; UI-owned global keys are handled in src/ui/input.js.\n// NOTE: NPC ships NEVER read state.input — they write e.data.intent directly (ai.js), so this\n// control remap does not affect them.\n//\n// REBINDING (V2 §12): flight actions are resolved through a bindings map keyed by action id. The\n// defaults below are mirrored as `settings.controls.bindings` on first run; the Settings/Controls\n// tab captures a new key per action and persists it. Input reads state.settings.controls.bindings\n// (falling back to DEFAULT_BINDINGS) so changes take effect immediately, no restart needed.\n\n// Action -> default KeyboardEvent.code. A binding may map to MULTIPLE codes (e.g. throttle uses\n// both KeyW and ArrowUp) so WASD-and-arrows both work out of the box. The settings layer stores an\n// array per action; the UI lets the player set a primary + keeps the arrow-cluster as a secondary\n// for movement so arrow-key players aren't stranded.\nimport { emptyDrawFlightPath, emptyDrawFlightGesture } from './drawFlightInput.js';\nimport { projectDynamicFlightStick, recordDynamicFlightStick, resetDynamicFlightStick } from './dynamicFlightStick.js';\nimport {\n  createGamepad,\n  normalizePadCurve,\n  normalizePadSensitivity,\n  shapePadAxis,\n  shapePadVector,\n} from './gamepad.js';\nimport { createTouch } from './touch.js';\nimport { createMasslineInputGrammar } from './masslineInputGrammar.js';\nimport { wrapAngle } from '../core/rng.js';\nimport { massline2Flag, travelFlag } from '../data/featureFlags.js';\nimport { TRAVEL_DRIVE_STATES } from '../core/flight/propulsionKernel.js';\nimport { isHostileToPlayer } from './scanner.js';\nimport { isBeamTargetEligible } from './mining.js';\nimport { interactionProfileForEntity } from '../data/entityInteractionProfiles.js';\nimport { resolveWorldPresentationEntity } from '../world/presentationSources.js';\nimport { resolveSteeringView } from './racingSteer.js';\nimport { noteSwarmPilotAction, swarmPilotIsActing } from './swarmSafety.js';\n\n// Helm-assist steering: turnIntent saturates at ±1 beyond this much nose-to-cursor error (rad),\n// so the ship's own yaw controller (rate caps, banking, class tuning) shapes the actual turn.\nconst HELM_SOFT_ANGLE = 0.55;\n\nconst WORLD_TOOL_HOLD_S = 0.28;\nconst HELM_DEADBAND = 0.012;   // rad — below this the nose is \"on\" the cursor; stops micro-jitter\nconst BRAKE_SOFT_SPEED = 24;   // wu/s — counter-thrust ramps down below this for a smooth settle\n\n\n// ---- Travel Burn latch (atlas D5 / W1-5) ------------------------------------------------------\n// The kernel is PURE and only ever shapes the governor cap; the state machine, its timers and its\n// bindings live here with the input owner (propulsionKernel.js:22-24). `TRAVEL_DRIVE_STATES` is\n// imported rather than redeclared so there is exactly one spelling of the axis in the tree.\n//\n// Spool is a deliberate commitment window, not a loading bar: engaging costs you ~1.6 s during\n// which you are still fully manoeuvrable but not yet gaining cap, so committing to a burn in a\n// hot sector is a real decision. Cooldown is the price of breaking it.\nconst TRAVEL_SPOOL_S = 1.6;\nconst TRAVEL_COOLDOWN_S = 3;\n// Below this the pilot is not really \"braking\" — it keeps a feathered retro-touch from dropping a\n// long haul, while a deliberate brake still breaks the latch instantly.\nconst TRAVEL_BRAKE_BREAK_EPS = 0.08;\n\nfunction neutralTravelDrive() {\n  return {\n    // --- kernel-facing contract (propulsionKernel.js normalizeTravelDrive). Extra keys below are\n    // ignored by the kernel, so HUD/diagnostic fields can share this one published address.\n    state: 'off',\n    cap: 0,          // carried ramp state: the kernel advances it, we feed it straight back\n    rampMult: 1,     // lane infrastructure (D8) multiplies this; nothing does yet\n    // --- latch-owned timers and provenance (never read by the kernel)\n    spoolT: 0,\n    cooldownT: 0,\n    engagedT: 0,\n    breakReason: null,\n  };\n}\n\n/**\n * True when the pilot is actively braking hard enough to break the latch.\n *\n * D5's feel rule is an ASYMMETRY and it is the whole point of the feature: **braking breaks the\n * latch, steering does not.** So this reads the brake actuator and reverse throttle ONLY — it must\n * never consult `turnIntent` or `moveX`. A pilot correcting course, carving, or spinning the nose\n * mid-burn keeps the burn; a pilot who reaches for the brake has decided to stop travelling.\n */\nfunction travelBrakeBreaks(inp) {\n  if (!inp) return false;\n  if (inp.brake) return true;\n  return finiteOr(inp.moveZ, 0) < -TRAVEL_BRAKE_BREAK_EPS;\n}\n\n/**\n * Interdiction seam (D5: \"Damage or lane disruption forces Cooldown — that is the interdiction\n * hook\"). Wired now, triggered by nothing yet: D8's lane prototype and the damage path are the\n * intended writers. Both a level flag and a one-shot request are honoured so a future disruptor\n * can either hold the drive down or knock it out once.\n */\nfunction travelDisrupted(state) {\n  const p = state && state.player;\n  if (!p) return false;\n  const drive = p.travelDrive;\n  if (drive && (drive.disrupted === true || drive.disruptRequest === true)) return true;\n  return false;\n}\n\nfunction travelDisruptionReason(state) {\n  const p = state && state.player;\n  const drive = p && p.travelDrive;\n  if (!drive) return null;\n  if (drive.disruptRequest === true) return drive.disruptReason || 'disrupted';\n  if (drive.disrupted === true) return 'disrupted';\n  return null;\n}\n\nfunction clearTravelDisruptRequest(state) {\n  const drive = state && state.player && state.player.travelDrive;\n  if (drive && drive.disruptRequest === true) {\n    drive.disruptRequest = false;\n    drive.disruptReason = null;\n  }\n}\n\nfunction finiteOr(v, fallback) { return Number.isFinite(v) ? v : fallback; }\n\n/**\n * Advance the travel-drive latch one tick and publish `state.input.travelDrive` for the kernel.\n *\n * THE CARRIED-CAP ROUND TRIP IS THE WHOLE RAMP. The kernel is pure: it consumes `travelDrive.cap`,\n * advances it one step toward the ceiling, and republishes it at `result.telemetry.travelCap`\n * (kernel :324-325, :871). Nobody persists it in between — we read last tick's published value back\n * off the player's flight frame and hand it in again. `input` is first in UPDATE_ORDER and\n * `flightSlot` is later, so \"last tick\" is exactly right; dropping this feedback would leave the\n * cap pinned at its seed and the drive would do nothing at all.\n *\n * Everything here is gated on `travelFlag('travelBurn')` read at CALL TIME. Under node the flag is\n * false, so not one key is written and the sim goldens cannot see this system.\n */\nfunction stepTravelLatch(host, state, inp, dt, lineOwnsAxis = false) {\n  if (!travelFlag('travelBurn')) {\n    // Flag off: leave no trace at all, and drop any latch state a flag flip mid-session left behind.\n    if (inp.travelDrive) delete inp.travelDrive;\n    host._travel = null;\n    return;\n  }\n\n  const drive = host._travel || (host._travel = neutralTravelDrive());\n  const step = Math.max(0, finiteOr(dt, 0));\n  const pressed = host._travelEdge;\n  const disrupted = travelDisrupted(state);\n  const disruptionReason = travelDisruptionReason(state);\n  // Line control spends reverse on the rope. That axis is not a decision to drop the burn.\n  // A dedicated brake button still breaks it, because the caller leaves lineOwnsAxis false then.\n  const braking = lineOwnsAxis ? false : travelBrakeBreaks(inp);\n  // Forward the LEVEL flag on the published block, not just the one-shot latch transition: the\n  // kernel's normalizeTravelDrive consumes `disrupted` to hold the ramp down AND (D8) to treat\n  // the dead beacon as the environmental force that spends overspeed toward the falling ceiling.\n  drive.disrupted = disrupted;\n\n  // Feed the kernel's published ramp back in. Reading the frame the kernel actually wrote (rather\n  // than re-deriving a ramp here) keeps ONE owner of the ramp maths — the kernel.\n  const player = state.entities && state.entities.get ? state.entities.get(state.playerId) : null;\n  const frame = player && player._flightFrame;\n  if (frame && Number.isFinite(frame.travelCap)) drive.cap = Math.max(0, frame.travelCap);\n  if (frame && Number.isFinite(frame.travelCeiling)) drive.ceiling = frame.travelCeiling;\n\n  const toCooldown = (reason) => {\n    drive.state = 'cooldown';\n    drive.cooldownT = 0;\n    drive.engagedT = 0;\n    drive.spoolT = 0;\n    drive.breakReason = reason;\n  };\n\n  switch (drive.state) {\n    case 'off':\n      if (disrupted) { toCooldown(disruptionReason || 'disrupted'); break; }\n      if (pressed) { drive.state = 'spooling'; drive.spoolT = 0; drive.breakReason = null; }\n      break;\n\n    case 'spooling':\n      // Disruption and braking both kill a spool. A second press is a CANCEL, not a disengage:\n      // nothing was earned yet, so it costs no cooldown — the punishment is for breaking a burn.\n      if (disrupted) { toCooldown(disruptionReason || 'disrupted'); break; }\n      if (braking) { toCooldown('brake'); break; }\n      if (pressed) { drive.state = 'off'; drive.spoolT = 0; drive.breakReason = 'cancelled'; break; }\n      drive.spoolT += step;\n      if (drive.spoolT >= TRAVEL_SPOOL_S) {\n        drive.state = 'engaged';\n        drive.spoolT = TRAVEL_SPOOL_S;\n        drive.engagedT = 0;\n        drive.breakReason = null;\n      }\n      break;\n\n    case 'engaged':\n      if (disrupted) { toCooldown(disruptionReason || 'disrupted'); break; }\n      if (braking) { toCooldown('brake'); break; }\n      if (pressed) { toCooldown('pilot'); break; }\n      drive.engagedT += step;\n      break;\n\n    case 'cooldown':\n    default:\n      drive.cooldownT += step;\n      // A live disruption holds the drive down rather than letting the timer run out under it.\n      if (disrupted) drive.cooldownT = 0;\n      else if (drive.cooldownT >= TRAVEL_COOLDOWN_S) {\n        drive.state = 'off';\n        drive.cooldownT = 0;\n        // The break reason PERSISTS while the disengaged cap record decays: the kernel spends\n        // overspeed toward the falling ceiling only for a world-caused break (D8 disruption), and\n        // it must still know that after the ship has coasted clear of the dead segment. A pilot\n        // reason ('pilot'/'brake') keeps the settle-to-rest coast. The next press overwrites it.\n      }\n      break;\n  }\n\n  clearTravelDisruptRequest(state);\n  if (!TRAVEL_DRIVE_STATES.includes(drive.state)) drive.state = 'off';\n\n  // One published address, kernel-shaped. Extra keys are ignored by normalizeTravelDrive and are\n  // what the HUD reads, so the latch has a single source of truth.\n  inp.travelDrive = drive;\n}\n\n// Verb keys shared by both schemes (GDD 2.0 physics verbs + sensors).\n//\n// THE NUMBER ROW IS THE ORDNANCE HOTBAR (1–9). The rank on the HUD (powerRail.js / the ORRERY\n// Cluster's ordnance crescent) is nine verbs in four bands, and a player reads that shelf as a\n// hotbar — pressing 1–3 and getting nothing was the resulting defect. Digit1–3 therefore carry the\n// three ORDNANCE verbs alongside their original keys (Y/R/Space stay primary so nothing already\n// taught or remapped is lost; the digit is a real second code in the same multi-code array idiom\n// travelBurn already uses). Digit4–9 were already the deployable row.\n//\n// Prompt answers still win the row while a decision is live: contactHail/promptDeck/wingmanRadial\n// capture and swallow their digits on document capture, and flight input is neutralized under\n// modals (`modalInputActive`) — the same slot-claim contract the rail was designed around.\nconst VERB_BINDINGS = {\n  siteBeam:       ['KeyB'],   // level: contextual beam for an explicitly selected World Site proxy\n  tether:         ['Space', 'KeyF', 'Digit3'], // PQ-003: Space primary, F retained as a permanent alias\n  chargeDetonate: ['KeyR', 'Digit2'],   // edge: detonate owned armed drift bombs and impulse charges\n  scanPulse:      ['KeyC'],   // edge: scanner pulse (8 s cd owned by scanner system)\n  cruise:         ['KeyV'],   // edge: toggle cruise charge (cruise system owns state)\n  autopursuit:    [],         // retired; retained as an inert save/input compatibility field.\n  deployBeacon:   ['KeyU'],   // edge: drop a claim beacon in open space (beacons system owns cost/cap).\n                              //   The UI router owns U only when a claimable body is in range; in open\n                              //   space it falls through to this flight verb (see check-claim-base-input).\n  // Massline Physics Identity (Wave M2). Every letter key is spoken for, so the two new verbs sit\n  // on the free left-pinky cluster next to WASD; both are rebindable like every other action.\n  bulletTime:     ['CapsLock'],   // level: hold for time dilation (bulletTime system owns meter)\n  cloak:          ['Backquote'],  // edge: toggle the cloak module (cloak system owns energy/gating)\n  // PQ-011/SF-11 deployable anchor Mass Seed. Every letter code is claimed (P alone would collide\n  // with the UI pause route), so the verb ships on Digit4: left-hand reachable off WASD, free\n  // repo-wide (Digit1–3 carry the ORDNANCE band; flight verbs are suppressed under modals),\n  // and rebindable like every other flight verb.\n  // Edge: launch the seed toward the aim point (massSeed system owns lifecycle/cooldown/cap).\n  deployMassSeed: ['Digit4'],\n  // PQ-012/SF-12 continuous field tools. Digit5-7 are free repo-wide (checked against both scheme\n  // tables and ui/bindings.js, same as Digit4), left-hand reachable off WASD, and rebindable like\n  // every flight verb. The fields system owns lifecycle/cooldown/cap for all three.\n  deployWell:         ['Digit5'], // edge: deploy an attractive Well at the aim point (PULL)\n  deployRepulsor:     ['Digit6'], // edge: drop a Repulsor at the ship (outward SHOVE)\n  toggleClearingCone: ['Digit7'], // edge: toggle the ship-attached forward Clearing Cone (snowplow)\n  // PQ-013/SF-14 planetary skim collector. Digit8 is free repo-wide (checked against both scheme\n  // tables and ui/bindings.js, same audit as Digit4-7) and sits with the deployable family. The\n  // planetRuntime system owns the collector state; yield is path x density, never a hold timer.\n  toggleSkimCollector: ['Digit8'], // edge: toggle the atmospheric skim collector (The Anvil bands)\n  // The Gyre Snare — held-key telekinetic katamari lash (gyreSnare system owns the state).\n  // Quote (') is free repo-wide (checked against both scheme tables, ui/bindings.js, and the\n  // UI key router): every letter is claimed, and 'o' in particular was triple-claimed\n  // (Band cycle on Shift+O + the overview-pin toggle on plain 'o'). Quote is right-pinky\n  // reachable, a natural hold verb, and carries no modifier alias or UI claim. Level verb:\n  // hold to beam + hold the clump, release to bowl it; hold-to-toggle latch opt-in via\n  // accessibility.holdToToggle.gyreSnare.\n  gyreSnare:          ['Quote'],    // level: hold to pull/snag/grow a ball, release to bowl it\n  // Drift-bomb bay (design/ORDNANCE_BOMBS_SPEC.md). Digit9 is free repo-wide (same audit as\n  // Digit4-8; Digit1-3 carry the ORDNANCE band) and completes the deployable row.\n  // Comma is free repo-wide (checked against both scheme tables and ui/bindings.js) and sits\n  // next to the deployable row as the bay's cycle key. The bombs system owns\n  // lifecycle/fuze/payload; both are ordinary rebindable edge verbs.\n  dropBomb:  ['Digit9'], // edge: release the selected drift bomb at current ship velocity\n  cycleBomb: ['Comma'],  // edge: cycle the bomb bay's selected payload\n  // VERB-13: one flight key dumps the selected hold lot as the payload body cargo already spawns.\n  // Period is free of the verb tables and the UI bindings. Cargo owns the dump.\n  jettisonLot: ['Period'],\n  // The hull burst has NO verb of its own (owner principle 2026-09-30): the fitted boost upgrade\n  // rides the boost itself, and the hullBurst system polls the player's boost flag. There is no\n  // burst key to bind on keyboard, mouse or pad.\n  // Travel Burn latch (atlas D5 / W1-5). Num Lock is the authored default: it is a genuine latch\n  // key on a full keyboard, it is never used for anything else in this game, and it carries a\n  // physical indicator light that matches \"the drive is engaged\". Many laptops have no Num Lock\n  // key at all (or bury it behind Fn), so a second code ships in the SAME array — the existing\n  // multi-code idiom this table already uses for WASD-and-arrows, not a parallel laptop scheme.\n  // KeyH is free repo-wide (checked against both VERB/scheme tables and ui/bindings.js) and sits\n  // under the right index finger on the home row, so it is reachable on any chassis.\n  travelBurn:     ['NumLock', 'KeyH'],   // edge: toggle the travel drive (latch owns the state machine)\n};\n\nconst DEFAULT_BINDINGS = {   // CLASSIC scheme (1.x) + the new verbs\n  forward:  ['KeyW', 'ArrowUp'],\n  reverse:  ['KeyS', 'ArrowDown'],\n  yawRight: ['KeyD', 'ArrowRight'],\n  yawLeft:  ['KeyA', 'ArrowLeft'],\n  strafeLeft:  ['KeyQ'],\n  strafeRight: ['KeyE'],\n  boost:    ['ShiftLeft', 'ShiftRight'],\n  fire:     [],                 // LMB fires; Space is the new-profile Massline action\n  brake:    ['Digit0'],         // dedicated zero-thrust brake; S/Down remains reverse + brake\n  autoFire: ['KeyG'],\n  countermeasure: ['KeyX'],    // deploy chaff/ECM (P1-7) — X by default, remappable\n  chargeThrow: ['KeyY', 'Digit1'],       // classic: Q/E are strafe and T is the tech-tree UI key, so throw lives on Y; Digit1 is the hotbar seat\n  // VERB-14: the winch needs keys every player has. BracketLeft/Right are free repo-wide\n  // (no flight verb, no UI shortcut, no help copy claims them) and sit as a natural in/out pair\n  // on any layout. Rebindable like every other flight verb; the hold-grammar line-control path stays.\n  reelIn:  ['BracketLeft'],\n  reelOut: ['BracketRight'],\n  ...VERB_BINDINGS,\n  // Mouse buttons (LMB=fire, RMB=group2/mine) are not remappable in this pass — they're ergonomic\n  // constants. Keyboard equivalents (Space to fire) ARE remappable.\n};\n\nconst HELM_BINDINGS = {      // HELM ASSIST (default): mouse owns the nose\n  forward:  ['KeyW', 'ArrowUp'],\n  reverse:  ['KeyS', 'ArrowDown'],\n  yawRight: [],                // nose follows cursor — yaw keys retired in this scheme\n  yawLeft:  [],\n  strafeLeft:  ['KeyA', 'ArrowLeft'],\n  strafeRight: ['KeyD', 'ArrowRight'],\n  boost:    ['ShiftLeft', 'ShiftRight'],\n  fire:     [],                // LMB only\n  brake:    ['Digit0'],        // dedicated zero-thrust brake; S/Down remains reverse + brake\n  autoFire: ['KeyG'],\n  countermeasure: ['KeyX'],\n  chargeThrow: ['KeyQ', 'Digit1'],\n  reelIn:  ['BracketLeft'],\n  reelOut: ['BracketRight'],\n  ...VERB_BINDINGS,\n};\n\nexport const PILOT_BINDINGS = {     // PILOT (default): keyboard flies, mouse fights\n  forward:  ['KeyW', 'ArrowUp'],\n  reverse:  ['KeyS', 'ArrowDown'],\n  yawRight: ['KeyD', 'ArrowRight'],  // yaw, including under thrust; Q/E is the strafe\n  yawLeft:  ['KeyA', 'ArrowLeft'],\n  strafeLeft:  ['KeyQ'],             // explicit strafe in every state (pursuit orbit-adjust)\n  strafeRight: ['KeyE'],\n  boost:    ['ShiftLeft', 'ShiftRight'],\n  fire:     [],                      // LMB fires — the mouse is a weapon, not a rudder\n  brake:    ['Digit0'],              // dedicated zero-thrust brake; S/Down remains reverse + brake\n  autoFire: ['KeyG'],\n  countermeasure: ['KeyX'],\n  chargeThrow: ['KeyY', 'Digit1'],             // Q/E are strafe here, so throw lives on Y (classic parity); Digit1 is the hotbar seat\n  reelIn:  ['BracketLeft'],\n  reelOut: ['BracketRight'],\n  ...VERB_BINDINGS,\n};\n\nconst SCHEME_BINDINGS = { pilot: PILOT_BINDINGS, classic: DEFAULT_BINDINGS, 'helm-assist': HELM_BINDINGS };\n\n// Active control scheme; pilot is the default — flight physics is the game's toy, and the toy\n// is played with the keyboard while the mouse targets/fires/grapples. Helm-assist (mouse-nose)\n// remains selectable for players who prefer cursor steering.\nfunction activeScheme(state) {\n  const s = state.settings && state.settings.gameplay && state.settings.gameplay.controlScheme;\n  return SCHEME_BINDINGS[s] ? s : 'pilot';\n}\n\n/**\n * Pure Pilot keyboard projection after rebind resolution.\n *\n * The live input tick and deterministic public-control harness share this one semantic owner:\n * A/D always yaws, Q/E always strafes, and S is reverse/brake. A/D must not strafe under\n * thrust. Vectoring would then aim the path at nose + atan2(strafe, throttle), the hull would\n * sit out of its trail while the key was held, and the lead bound would not see it.\n */\nexport function projectPilotFlightControls({\n  forward = false,\n  reverse = false,\n  brakeHeld = false,\n  yawLeft = false,\n  yawRight = false,\n  strafeLeft = false,\n  strafeRight = false,\n  boost = false,\n} = {}, out = null) {\n  const side = (yawRight ? 1 : 0) - (yawLeft ? 1 : 0);\n  const explicit = (strafeRight ? 1 : 0) - (strafeLeft ? 1 : 0);\n  const projected = out && typeof out === 'object' ? out : {};\n  projected.moveX = explicit;\n  projected.moveZ = (forward ? 1 : 0) - (reverse ? 1 : 0);\n  projected.turnIntent = side;\n  projected.lineOrbit = side;\n  projected.boost = boost === true;\n  projected.brake = reverse === true || brakeHeld === true;\n  return projected;\n}\n\n// Resolve the live binding for an action: player rebinds (settings) win, then the active scheme's\n// table, then classic defaults. Always returns an array of codes.\nfunction binding(state, action) {\n  const cfg = state.settings && state.settings.controls && state.settings.controls.bindings;\n  const scheme = SCHEME_BINDINGS[activeScheme(state)];\n  const list = (cfg && cfg[action]) || scheme[action] || DEFAULT_BINDINGS[action];\n  return Array.isArray(list) ? list : (list ? [list] : []);\n}\n\nexport const DEFAULTS = { BINDINGS: DEFAULT_BINDINGS, SCHEMES: SCHEME_BINDINGS };\n\nconst ARROW_GLYPHS = Object.freeze({\n  ArrowUp: '↑', ArrowDown: '↓', ArrowLeft: '←', ArrowRight: '→',\n});\nconst ARROW_WORDS = Object.freeze({\n  ArrowUp: 'Up', ArrowDown: 'Down', ArrowLeft: 'Left', ArrowRight: 'Right',\n});\n\n/** Mouse buttons are not remappable; empty `fire` still means the left mouse button. */\nexport const MOUSE_ACTION_LABELS = Object.freeze({ fire: 'LMB', mine: 'RMB' });\n\n/** Flight actions the default route teaches. Interface keys live in `src/ui/bindings.js`. */\nexport const TAUGHT_FLIGHT_ACTIONS = Object.freeze([\n  'forward', 'reverse', 'brake', 'yawLeft', 'yawRight', 'strafeLeft', 'strafeRight',\n  'boost', 'fire', 'autoFire', 'countermeasure', 'tether', 'reelIn', 'reelOut', 'deployMassSeed',\n  'siteBeam', 'scanPulse', 'cruise', 'dropBomb', 'cycleBomb', 'chargeDetonate',\n]);\n\n/**\n * Live bound KeyboardEvent.code list for a flight action.\n * Player rebinds win, then the active scheme, then classic defaults.\n */\nexport function resolveActionCodes(state, action) {\n  return binding(state, action);\n}\n\n/** Short player-facing name for one KeyboardEvent.code. */\nexport function formatBindingCode(code, { arrows = 'glyph' } = {}) {\n  if (!code) return '';\n  if (/^Key[A-Z]$/.test(code)) return code.slice(3);\n  if (/^Digit\\d$/.test(code)) return code.slice(5);\n  if (/^Numpad\\d$/.test(code)) return `Num ${code.slice(6)}`;\n  if (code.startsWith('Arrow')) {\n    const table = arrows === 'word' ? ARROW_WORDS : ARROW_GLYPHS;\n    return table[code] || code;\n  }\n  if (code === 'Space') return 'Space';\n  if (code === 'ShiftLeft') return 'L-Shift';\n  if (code === 'ShiftRight') return 'R-Shi