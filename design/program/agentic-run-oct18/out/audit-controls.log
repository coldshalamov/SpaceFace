{"type":"tool_use","timestamp":1792370427365,"sessionID":"ses_eae696a14ffehCxB980snPYjCy","part":{"type":"tool","tool":"read","callID":"call_00_uaa47w7mzf5mx7zuf4xbqdh2","state":{"status":"completed","input":{"filePath":"C:\\Users\\93rob\\Documents\\GitHub\\SpaceFace\\src\\ui\\screens\\settings.js","limit":180,"offset":1290},"output":"<path>C:\\Users\\93rob\\Documents\\GitHub\\SpaceFace\\src\\ui\\screens\\settings.js</path>\n<type>file</type>\n<content>\n1290:     // PQ-164.02: one Deck/trackpad row. Gestures write the existing Massline key seams\n1291:     // (Space latch, W/S reel, Y throw, G-stroke) — they do not add a second grammar.\n1292:     const deckHeader = build.header(STEAM_DECK_HEADER);\n1293:     if (deckHeader && typeof deckHeader.setAttribute === 'function') {\n1294:       deckHeader.setAttribute('data-sf-deck', 'header');\n1295:     }\n1296:     const deckNote = build.note(STEAM_DECK_NOTE);\n1297:     if (deckNote && typeof deckNote.setAttribute === 'function') {\n1298:       deckNote.setAttribute('data-sf-deck', 'note');\n1299:     }\n1300:   },\n1301: \n1302:   _renderFixedShortcuts(pane, build = paneBuilder(pane)) {\n1303:     build.break();\n1304:     const header = build.header('Ship/System Shortcuts');\n1305:     header.parentElement.classList.add('sf-controls-fixed-shortcuts');\n1306:     CONTROL_SHORTCUTS.forEach((shortcut) => {\n1307:       build.shortcut(shortcut.label, shortcut.key, shortcut.note);\n1308:     });\n1309:     build.note('Flight keys above can be rebound here. These interface shortcuts are for reference.');\n1310:   },\n1311: \n1312:   // Live rebind UI for flight actions. Reads defaults from input.js + any saved overrides in\n1313:   // settings.controls.bindings. Capture-on-press: a pressed word enters \"listening\" mode and the\n1314:   // next keydown sets the binding (with conflict detection — can't bind the same key to two actions\n1315:   // in the movement cluster). Escape cancels capture, Backspace clears the binding to default.\n1316:   _renderControlsRebind(ctx, pane, build = paneBuilder(pane)) {\n1317:     const s = ctx.state.settings;\n1318:     if (!s.controls) s.controls = { bindings: null };\n1319:     const { base, live } = mergedBindingsFor(s);\n1320: \n1321:     build.break();\n1322:     REBINDABLE.forEach((action) => {\n1323:       const codes = live[action] || [];\n1324:       const keyText = reelRebindText(action, codes)\n1325:         || codes.map((code) => formatBindingCode(code) || '—').join(' / ') || '—';\n1326:       // `.sf-bind-btn--digit` marks a bare digit key (a hook kept from the legacy chip styling).\n1327:       build.key(REBIND_LABELS[action] || action, keyText,\n1328:         (btn) => this._capture(ctx, btn, action, live, base),\n1329:         { digit: /^\\d$/.test(keyText) });\n1330:     });\n1331: \n1332:     // reset word\n1333:     build.word('Reset key bindings', () => {\n1334:       s.controls.bindings = null;\n1335:       s.controls.masslineBindingProfile = MASSLINE_BINDING_PROFILE_SPACE;\n1336:       laneWriteSetting(ctx.state, 'settings.controls.bindings', null);\n1337:       laneWriteSetting(ctx.state, 'settings.controls.masslineBindingProfile', MASSLINE_BINDING_PROFILE_SPACE);\n1338:       ctx.bus.emit('settings:changed', { section: 'controls', key: 'bindings', value: null });\n1339:       this._render(ctx);\n1340:     }, 'Arrow keys always also work for movement.');\n1341:   },\n1342: \n1343:   // Capture the next keydown as the new binding for `action`. Only ONE code per action in the UI\n1344:   // (we keep arrow-cluster compatibility by leaving movement's secondary arrow code alone if the\n1345:   // primary is being rebound — simplest mental model: \"set the WASD key\").\n1346:   _capture(ctx, btn, action, live, base) {\n1347:     if (this._capturing) return;\n1348:     this._capturing = true;\n1349:     const prev = btn.textContent;\n1350:     btn.textContent = 'Press a key…';\n1351:     btn.classList.add('sf-bind-btn--capture');\n1352:     btn.setAttribute('aria-pressed', 'true'); // the kit lights a pressed word: this one is listening\n1353:     const preview = refs && refs.preview;\n1354:     try { if (preview) preview.listen(true, btn.closest ? btn.closest('.k-row') : null); } catch (e) { /* cosmetic */ }\n1355: \n1356:     const done = (commit) => {\n1357:       // A stale close (the conflict label's 900 ms timer, a second Escape) must never touch a\n1358:       // newer capture's button or handle: only the capture that owns the slot may close it (J5).\n1359:       if (this._activeCapture !== done) return;\n1360:       try { if (preview) preview.listen(false); } catch (e) { /* cosmetic */ }\n1361:       this._capturing = false;\n1362:       btn.classList.remove('sf-bind-btn--capture');\n1363:       btn.removeAttribute('aria-pressed');\n1364:       window.removeEventListener('keydown', onKey, true);\n1365:       window.removeEventListener('mousedown', onClickAway, true);\n1366:       this._activeCapture = null;\n1367:       if (!commit) btn.textContent = prev;\n1368:     };\n1369:     const onKey = (ev) => {\n1370:       ev.preventDefault(); ev.stopPropagation();\n1371:       // Escape cancels; Backspace resets this action to default.\n1372:       if (ev.code === 'Escape') { done(false); return; }\n1373:       if (ev.code === 'Backspace' || ev.code === 'Delete') {\n1374:         // J4: restoring the default must pass the same conflict rule as an ordinary rebind —\n1375:         // a key the player deliberately gave another verb keeps its owner; the reset names it.\n1376:         const def = (base && base[action]) || DEFAULT_BINDINGS[action] || [];\n1377:         const ownerOf = (code) => REBINDABLE.find((other) => other !== action && (live[other] || []).includes(code));\n1378:         const clashOwner = def.map(ownerOf).find(Boolean);\n1379:         if (clashOwner) {\n1380:           const conflict = settingsInUseLabel(REBIND_LABELS[clashOwner] || clashOwner);\n1381:           btn.textContent = conflict;\n1382:           announceBindingConflict(btn, conflict);\n1383:           cue('deny');\n1384:           setTimeout(() => done(false), 900);\n1385:           return;\n1386:         }\n1387:         this._commitBind(ctx, action, null, live, base);\n1388:         done(true);\n1389:         return;\n1390:       }\n1391:       // Conflict check: the same code must not appear ANYWHERE in another action's binding —\n1392:       // checking only index 0 let a rebind collide with a secondary (e.g. binding an action to\n1393:       // ArrowUp while movement still keeps ArrowUp as its secondary), so one key fired two verbs.\n1394:       for (const other of REBINDABLE) {\n1395:         if (other === action) continue;\n1396:         if ((live[other] || []).includes(ev.code)) {\n1397:           const conflict = settingsInUseLabel(REBIND_LABELS[other] || other);\n1398:           btn.textContent = conflict;\n1399:           announceBindingConflict(btn, conflict);\n1400:           cue('deny');\n1401:           setTimeout(() => done(false), 900);\n1402:           return;\n1403:         }\n1404:       }\n1405:       this._commitBind(ctx, action, ev.code, live, base);\n1406:       done(true);\n1407:     };\n1408:     const onClickAway = (ev) => { if (ev.target !== btn) done(false); };\n1409:     // Registered before any close path can arm: the guard in `done` compares against this slot.\n1410:     this._activeCapture = done;\n1411:     window.addEventListener('keydown', onKey, true);\n1412:     window.addEventListener('mousedown', onClickAway, true);\n1413:   },\n1414: \n1415:   // Persist a new primary binding for `action` into settings.controls.bindings. We preserve any\n1416:   // secondary code (e.g. ArrowUp alongside KeyW) so arrow players keep working after a rebind.\n1417:   _commitBind(ctx, action, code, live, base) {\n1418:     const s = ctx.state.settings;\n1419:     if (!s.controls) s.controls = {};\n1420:     if (!s.controls.bindings) s.controls.bindings = {};\n1421:     const schemeBase = base || schemeBindingsFor(s);\n1422:     const def = (schemeBase && schemeBase[action]) || DEFAULT_BINDINGS[action] || [];\n1423:     if (code == null) {\n1424:       delete s.controls.bindings[action]; // reset to default\n1425:       live[action] = def.slice();\n1426:     } else {\n1427:       // keep the arrow-cluster secondary if the default had one and it's not the code being set\n1428:       const secondary = def.length > 1 ? def[1] : null;\n1429:       const arr = (secondary && secondary !== code) ? [code, secondary] : [code];\n1430:       s.controls.bindings[action] = arr;\n1431:       live[action] = arr;\n1432:     }\n1433:     // Ship the whole binding map: the delete-to-default path removes the key\n1434:     // entirely, which a leaf write cannot express. Spread — the envelope must\n1435:     // not carry a live reference (the map keeps mutating per bind).\n1436:     laneWriteSetting(ctx.state, 'settings.controls.bindings', { ...s.controls.bindings });\n1437:     ctx.bus.emit('settings:changed', { section: 'controls', key: action, value: s.controls.bindings[action] });\n1438:     this._render(ctx); // refresh the rows to show the new label\n1439:   },\n1440: \n1441:   // --- Gamepad rebinding (PQ-164.01) ---\n1442:   // Capture the next pad button press as the new binding for `action`. Pad buttons are not DOM\n1443:   // events: the press edge is recorded by src/systems/gamepad.js and forwarded by the UI input\n1444:   // tick (src/ui/input.js) to the capture handler registered on the binding registry. While the\n1445:   // handler is registered the pad's actions are inert (captureMode), so the press cannot also\n1446:   // fire its current verb. Escape cancels, Backspace restores the default, a 30 s timeout or a\n1447:   // click away ends the listen so a pad-only player is never trapped in capture.\n1448:   _capturePad(ctx, btn, action, liveMap) {\n1449:     if (this._capturing) return;\n1450:     this._capturing = true;\n1451:     // Take effect immediately — don't wait a frame for the UI tick to mirror the handler.\n1452:     if (ctx.gamepad) ctx.gamepad.captureMode = true;\n1453:     const prev = btn.textContent;\n1454:     btn.textContent = 'Press a pad button…';\n1455:     btn.classList.add('sf-bind-btn--capture');\n1456:     btn.setAttribute('aria-pressed', 'true'); // listening\n1457:     const preview = refs && refs.preview;\n1458:     try { if (preview) preview.listen(true, btn.closest ? btn.closest('.k-row') : null); } catch (e) { /* cosmetic */ }\n1459: \n1460:     const done = (commit) => {\n1461:       // Same ownership guard as the keyboard capture: a stale conflict timer must never close a\n1462:       // newer pad capture's listen (J5).\n1463:       if (this._activeCapture !== done) return;\n1464:       try { if (preview) preview.listen(false); } catch (e) { /* cosmetic */ }\n1465:       this._capturing = false;\n1466:       btn.classList.remove('sf-bind-btn--capture');\n1467:       btn.removeAttribute('aria-pressed');\n1468:       setGamepadCaptureHandler(null);\n1469:       clearTimeout(timer);\n\n(Showing lines 1290-1469 of 1564. Use offset=1470 to continue.)\n</content>\n\n<system-reminder>\nInstructions from: C:\\Users\\93rob\\Documents\\GitHub\\SpaceFace\\src\\ui\\AGENTS.md\n# src/ui/ — Agent Notes\n\nDOM/CSS overlay. Reads state and emits gameplay intents. Narrow direct-write exception:\nUI/input-owned selection such as `state.player.targetId`. Root `AGENTS.md` §6 first.\n**ORRERY (`design/frontend/ORRERY.md`, `src/ui/orrery/`) over Deckplate (`src/ui/deckplate/`) is the live design system.**\nEvery colour, size, duration, face, and instrument recipe on a player surface comes from `--dp-*`\ntokens (`src/ui/deckplate/tokens.js` + `src/ui/orrery/tokens.js`), the ORRERY instrument library\n(`src/ui/orrery/`), and the shared `.dp-*` / `.k-*` / `.orr-*` classes. Adding another token root is\na defect. The active direction is [`../../design/frontend/ORRERY.md`](../../design/frontend/ORRERY.md)\n(handoff & lane status: [`../../design/frontend/ORRERY_HANDOFF.md`](../../design/frontend/ORRERY_HANDOFF.md)).\n`THE_BAR.md`, `ONE_PHOTOGRAPH.md`, and `FIELD_HARDWARE_PROGRAM.md` are superseded as direction (only\ntheir no-fake-CSS-material law and the `12px` type floor in `scripts/check-type-floor.mjs` still bind).\n\nScreen composition and responsive placement live in `src/ui/orrery/*Layouts.js` (and `src/ui/deckplate/screens.js`\nfor legacy Deckplate placements). When narrow viewports squeeze a column, condense `Archivo`'s\nvariable width (`\"wdth\" 82–100`) and letter-spacing (`.04–.08em`) rather than dropping below the\n`12px` type floor (`node scripts/check-type-floor.mjs`).\n\n## Standing rules\n\n- **Clean NON-diegetic HUD.** No visor/cockpit/helmet framing, screen-edge arcs, or pilot portraits.\n- Panel treatment comes from the system (`dp-plate`, `dp-glass`, `dp-mfd`): pick the material that\n  fits the job, never mix a new one. Measure compositor cost; no `backdrop-filter` in flight.\n- Match the surface to the decision (HUD, card, modal, full screen). Avoid duplicate simultaneous copy.\n- **Flight transient routing (HUD_FLIGHT_ATTENTION):** a timed decision with verbs → the prompt\n  deck; a fact/result → a receipt line (`toasts.js` / `admitReceipt`); continuous state → a HUD\n  instrument; an alarm → `alerts.js`; a moment → its own presenter. Never a new hand-styled card.\n- Combat and economy feedback stay configurable and legible.\n- Motion follows purpose and `motionReduce`/`flashReduce` in `accessibility.js`.\n- Player-facing strings pass `check:player-facing-labels`.\n\n## Non-obvious owners\n\n- `uiRoot.js` / `screenManager.js` — mount and one-visible-screen switching.\n- `promptDeck.js` — the ONE flight decision surface (ladder, z 20, Digit1-9, gamepad, lifecycle).\n  The encounter / lawful-inspection / parley / signal / recovery / customs modules are thin\n  adapters that normalize their bus events into `offerDecision` specs; they own no DOM, no keys,\n  no placement. Receipts never go on the deck. Styling: `styles/prompt-deck.css` on the glass\n  tokens (no backdrop-filter — flight floor §7).\n- `commandDeckRefit.js` — additive presentation/interaction layer (PR #113). Does not own transactions.\n- `hud.js` — always-mounted flight HUD. Attention pass: `design/HUD_FLIGHT_ATTENTION.md`.\n- `input.js` here is UI input; `src/systems/input.js` owns the sim contract.\n- `asteroid/` is live Asteroid Works (`drill` screen). `screens/drill.js` is a helper, not the shell.\n  Campaign: `design/program/ASTEROID_WORKS_PLAYFIELD.md` / `PQ-130`.\n\nDOM layering (ARCHITECTURE §1.2): canvas z0 < vignette z5 < hud+receipts z10–11 < prompt-deck z20\n< modal-backdrop z90 < screens z100 < alerts z1100. `#ui-root` is `pointer-events:none`;\ninteractive children opt in.\n\n## Seeing the UI before changing it\n\nThe iteration system is [`../../docs/UI_VISUAL_ITERATION.md`](../../docs/UI_VISUAL_ITERATION.md). You are the reviewer: open the PNG in the same pass, and walk every control on the screens you changed.\n\n```\nnode scripts/ui-bench.mjs --shot=pause\nnode scripts/ui-bench.mjs --shot=station-market --walk\nnode scripts/ui-bench.mjs --list\n```\n\nThe bench mounts the real screen module with a real `GameState` over a frozen still. It does not boot the game. Synthetic state is evidence of composition, type, spacing, hover, and what a control asks for. Behaviour on the live route, for a screen the bench cannot mount, is `node scripts/ui-look.mjs --only=<id>`.\n\nA control that does nothing visible is a defect. Layout measurement for a check is `npm run check:ui:layout`.\n\n## Verification\n\n`check:ui-a11y`, `check:wcag-contrast`, `check:ui:perf`, `check:player-facing-labels`,\n`check:ui-identity`, `node scripts/check-ui-screen-imports.mjs`. Do not revive a windshield key list\nto satisfy one-voice; Help/Settings owns the bind sheet.\n\n\nInstructions from: C:\\Users\\93rob\\Documents\\GitHub\\SpaceFace\\src\\AGENTS.md\n# src/ agent orientation\n\nRead root `AGENTS.md` first. Use `docs/MODULE_MAP.md` to select an owner, then the nearest nested\ninstructions. Do not infer the live backend from imports; root §5 and `core/registry.js` own selection.\n\n## Layer boundaries\n\n- `core/` — state, event bus, loop facade, registry, physics/lifetime authority. Order and clocks:\n  `src/runtime/AGENTS.md`.\n- `systems/` — registered fixed-step systems and a few imported helpers.\n- `ai/` and `combat/` — shared tactical/combat libraries used by registered systems.\n- `data/` — stable IDs and data-driven definitions.\n- `render/` — Three.js presentation and runtime asset integration; never owns sim results.\n  Hazard notes also in `render/combat/`, `render/ships/`, `render/vfx/`, `render/forceLanguage/`.\n- `testing/lab/` — deterministic gameplay scenarios. `testing/AGENTS.md` points at the lab.\n- `ui/` — DOM presentation and input intents. UI may update explicitly UI/input-owned selection state\n  such as `state.player.targetId`; it must not mutate gameplay-owned outcomes.\n- `audio/`, `presentation/`, `save/`, `sim/`, `observability/` — each has an `AGENTS.md`. Audio and\n  presentation do not write outcomes. Save owns the envelope. `sim/` is tapes and pure projections.\n- `world/`, `story/`, `characters/`, `nemesis/`, `chronicler/`, `onboarding/`, `localization/` —\n  libraries. The registered writers stay in `systems/`. Read the folder note before editing.\n- `economy/`, `missions/`, `contracts/`, `careers/`, `balance/` — pure math, schemas, or harnesses.\n  `missions/AGENTS.md` also covers `law/` and `physicalCargo/` (too small for their own note).\n- Credits, cargo, WANTED heat, reputation, and derived ship stats still have one writer each in\n  `systems/`. These folders return numbers or intents.\n\n## Source rules\n\n- Sim remains deterministic and independent of Three.js.\n- Cross-domain changes follow root single-writer and event/intent contracts.\n- Compatibility flight/AI modules are tested paths, not the default gameplay owner.\n- Verify the working-tree diff before assuming `HEAD` describes the live implementation.\n- For recurring hostility, fallback, heat, save, or launcher failures, use `docs/COMMON_BUGS.md`\n  before broad search.\n\n</system-reminder>","metadata":{"preview":"    // PQ-164.02: one Deck/trackpad row. Gestures write the existing Massline key seams\n    // (Space latch, W/S reel, Y throw, G-stroke) — they do not add a second grammar.\n    const deckHeader = build.header(STEAM_DECK_HEADER);\n    if (deckHeader && typeof deckHeader.setAttribute === 'function') {\n      deckHeader.setAttribute('data-sf-deck', 'header');\n    }\n    const deckNote = build.note(STEAM_DECK_NOTE);\n    if (deckNote && typeof deckNote.setAttribute === 'function') {\n      deckNote.setAttribute('data-sf-deck', 'note');\n    }\n  },\n\n  _renderFixedShortcuts(pane, build = paneBuilder(pane)) {\n    build.break();\n    const header = build.header('Ship/System Shortcuts');\n    header.parentElement.classList.add('sf-controls-fixed-shortcuts');\n    CONTROL_SHORTCUTS.forEach((shortcut) => {\n      build.shortcut(shortcut.label, shortcut.key, shortcut.note);\n    });\n    build.note('Flight keys above can be rebound here. These interface shortcuts are for reference.');","truncated":true,"loaded":["C:\\Users\\93rob\\Documents\\GitHub\\SpaceFace\\src\\ui\\AGENTS.md","C:\\Users\\93rob\\Documents\\GitHub\\SpaceFace\\src\\AGENTS.md"],"display":{"type":"file","path":"C:\\Users\\93rob\\Documents\\GitHub\\SpaceFace\\src\\ui\\screens\\settings.js","text":"    // PQ-164.02: one Deck/trackpad row. Gestures write the existing Massline key seams\n    // (Space latch, W/S reel, Y throw, G-stroke) — they do not add a second grammar.\n    const deckHeader = build.header(STEAM_DECK_HEADER);\n    if (deckHeader && typeof deckHeader.setAttribute === 'function') {\n      deckHeader.setAttribute('data-sf-deck', 'header');\n    }\n    const deckNote = build.note(STEAM_DECK_NOTE);\n    if (deckNote && typeof deckNote.setAttribute === 'function') {\n      deckNote.setAttribute('data-sf-deck', 'note');\n    }\n  },\n\n  _renderFixedShortcuts(pane, build = paneBuilder(pane)) {\n    build.break();\n    const header = build.header('Ship/System Shortcuts');\n    header.parentElement.classList.add('sf-controls-fixed-shortcuts');\n    CONTROL_SHORTCUTS.forEach((shortcut) => {\n      build.shortcut(shortcut.label, shortcut.key, shortcut.note);\n    });\n    build.note('Flight keys above can be rebound here. These interface shortcuts are for reference.');\n  },\n\n  // Live rebind UI for flight actions. Reads defaults from input.js + any saved overrides in\n  // settings.controls.bindings. Capture-on-press: a pressed word enters \"listening\" mode and the\n  // next keydown sets the binding (with conflict detection — can't bind the same key to two actions\n  // in the movement cluster). Escape cancels capture, Backspace clears the binding to default.\n  _renderControlsRebind(ctx, pane, build = paneBuilder(pane)) {\n    const s = ctx.state.settings;\n    if (!s.controls) s.controls = { bindings: null };\n    const { base, live } = mergedBindingsFor(s);\n\n    build.break();\n    REBINDABLE.forEach((action) => {\n      const codes = live[action] || [];\n      const keyText = reelRebindText(action, codes)\n        || codes.map((code) => formatBindingCode(code) || '—').join(' / ') || '—';\n      // `.sf-bind-btn--digit` marks a bare digit key (a hook kept from the legacy chip styling).\n      build.key(REBIND_LABELS[action] || action, keyText,\n        (btn) => this._capture(ctx, btn, action, live, base),\n        { digit: /^\\d$/.test(keyText) });\n    });\n\n    // reset word\n    build.word('Reset key bindings', () => {\n      s.controls.bindings = null;\n      s.controls.masslineBindingProfile = MASSLINE_BINDING_PROFILE_SPACE;\n      laneWriteSetting(ctx.state, 'settings.controls.bindings', null);\n      laneWriteSetting(ctx.state, 'settings.controls.masslineBindingProfile', MASSLINE_BINDING_PROFILE_SPACE);\n      ctx.bus.emit('settings:changed', { section: 'controls', key: 'bindings', value: null });\n      this._render(ctx);\n    }, 'Arrow keys always also work for movement.');\n  },\n\n  // Capture the next keydown as the new binding for `action`. Only ONE code per action in the UI\n  // (we keep arrow-cluster compatibility by leaving movement's secondary arrow code alone if the\n  // primary is being rebound — simplest mental model: \"set the WASD key\").\n  _capture(ctx, btn, action, live, base) {\n    if (this._capturing) return;\n    this._capturing = true;\n    const prev = btn.textContent;\n    btn.textContent = 'Press a key…';\n    btn.classList.add('sf-bind-btn--capture');\n    btn.setAttribute('aria-pressed', 'true'); // the kit lights a pressed word: this one is listening\n    const preview = refs && refs.preview;\n    try { if (preview) preview.listen(true, btn.closest ? btn.closest('.k-row') : null); } catch (e) { /* cosmetic */ }\n\n    const done = (commit) => {\n      // A stale close (the conflict label's 900 ms timer, a second Escape) must never touch a\n      // newer capture's button or handle: only the capture that owns the slot may close it (J5).\n      if (this._activeCapture !== done) return;\n      try { if (preview) preview.listen(false); } catch (e) { /* cosmetic */ }\n      this._capturing = false;\n      btn.classList.remove('sf-bind-btn--capture');\n      btn.removeAttribute('aria-pressed');\n      window.removeEventListener('keydown', onKey, true);\n      window.removeEventListener('mousedown', onClickAway, true);\n      this._activeCapture = null;\n      if (!commit) btn.textContent = prev;\n    };\n    const onKey = (ev) => {\n      ev.preventDefault(); ev.stopPropagation();\n      // Escape cancels; Backspace resets this action to default.\n      if (ev.code === 'Escape') { done(false); return; }\n      if (ev.code === 'Backspace' || ev.code === 'Delete') {\n        // J4: restoring the default must pass the same conflict rule as an ordinary rebind —\n        // a key the player deliberately gave another verb keeps its owner; the reset names it.\n        const def = (base && base[action]) || DEFAULT_BINDINGS[action] || [];\n        const ownerOf = (code) => REBINDABLE.find((other) => other !== action && (live[other] || []).includes(code));\n        const clashOwner = def.map(ownerOf).find(Boolean);\n        if (clashOwner) {\n          const conflict = settingsInUseLabel(REBIND_LABELS[clashOwner] || clashOwner);\n          btn.textContent = conflict;\n          announceBindingConflict(btn, conflict);\n          cue('deny');\n          setTimeout(() => done(false), 900);\n          return;\n        }\n        this._commitBind(ctx, action, null, live, base);\n        done(true);\n        return;\n      }\n      // Conflict check: the same code must not appear ANYWHERE in another action's binding —\n      // checking only index 0 let a rebind collide with a secondary (e.g. binding an action to\n      // ArrowUp while movement still keeps ArrowUp as its secondary), so one key fired two verbs.\n      for (const other of REBINDABLE) {\n        if (other === action) continue;\n        if ((live[other] || []).includes(ev.code)) {\n          const conflict = settingsInUseLabel(REBIND_LABELS[other] || other);\n          btn.textContent = conflict;\n          announceBindingConflict(btn, conflict);\n          cue('deny');\n          setTimeout(() => done(false), 900);\n          return;\n        }\n      }\n      this._commitBind(ctx, action, ev.code, live, base);\n      done(true);\n    };\n    const onClickAway = (ev) => { if (ev.target !== btn) done(false); };\n    // Registered before any close path can arm: the guard in `done` compares against this slot.\n    this._activeCapture = done;\n    window.addEventListener('keydown', onKey, true);\n    window.addEventListener('mousedown', onClickAway, true);\n  },\n\n  // Persist a new primary binding for `action` into settings.controls.bindings. We preserve any\n  // secondary code (e.g. ArrowUp alongside KeyW) so arrow players keep working after a rebind.\n  _commitBind(ctx, action, code, live, base) {\n    const s = ctx.state.settings;\n    if (!s.controls) s.controls = {};\n    if (!s.controls.bindings) s.controls.bindings = {};\n    const schemeBase = base || schemeBindingsFor(s);\n    const def = (schemeBase && schemeBase[action]) || DEFAULT_BINDINGS[action] || [];\n    if (code == null) {\n      delete s.controls.bindings[action]; // reset to default\n      live[action] = def.slice();\n    } else {\n      // keep the arrow-cluster secondary if the default had one and it's not the code being set\n      const secondary = def.length > 1 ? def[1] : null;\n      const arr = (secondary && secondary !== code) ? [code, secondary] : [code];\n      s.controls.bindings[action] = arr;\n      live[action] = arr;\n    }\n    // Ship the whole binding map: the delete-to-default path removes the key\n    // entirely, which a leaf write cannot express. Spread — the envelope must\n    // not carry a live reference (the map keeps mutating per bind).\n    laneWriteSetting(ctx.state, 'settings.controls.bindings', { ...s.controls.bindings });\n    ctx.bus.emit('settings:changed', { section: 'controls', key: action, value: s.controls.bindings[action] });\n    this._render(ctx); // refresh the rows to show the new label\n  },\n\n  // --- Gamepad rebinding (PQ-164.01) ---\n  // Capture the next pad button press as the new binding for `action`. Pad buttons are not DOM\n  // events: the press edge is recorded by src/systems/gamepad.js and forwarded by the UI input\n  // tick (src/ui/input.js) to the capture handler registered on the binding registry. While the\n  // handler is registered the pad's actions are inert (captureMode), so the press cannot also\n  // fire its current verb. Escape cancels, Backspace restores the default, a 30 s timeout or a\n  // click away ends the listen so a pad-only player is never trapped in capture.\n  _capturePad(ctx, btn, action, liveMap) {\n    if (this._capturing) return;\n    this._capturing = true;\n    // Take effect immediately — don't wait a frame for the UI tick to mirror the handler.\n    if (ctx.gamepad) ctx.gamepad.captureMode = true;\n    const prev = btn.textContent;\n    btn.textContent = 'Press a pad button…';\n    btn.classList.add('sf-bind-btn--capture');\n    btn.setAttribute('aria-pressed', 'true'); // listening\n    const preview = refs && refs.preview;\n    try { if (preview) preview.listen(true, btn.closest ? btn.closest('.k-row') : null); } catch (e) { /* cosmetic */ }\n\n    const done = (commit) => {\n      // Same ownership guard as the keyboard capture: a stale conflict timer must never close a\n      // newer pad capture's listen (J5).\n      if (this._activeCapture !== done) return;\n      try { if (preview) preview.listen(false); } catch (e) { /* cosmetic */ }\n      this._capturing = false;\n      btn.classList.remove('sf-bind-btn--capture');\n      btn.removeAttribute('aria-pressed');\n      setGamepadCaptureHandler(null);\n      clearTimeout(timer);","lineStart":1290,"lineEnd":1469,"totalLines":1564,"truncated":true}},"title":"src\\ui\\screens\\settings.js","time":{"start":1792370427329,"end":1792370427336}},"id":"prt_1519a457b0014xgomW656b3Qoo","sessionID":"ses_eae696a14ffehCxB980snPYjCy","messageID":"msg_1519a2832001hz0iWaTYCBOGLS"}}
