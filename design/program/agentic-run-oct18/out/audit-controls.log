m\u001b[0mordinary \u001b[0m\r\n\u001b[7m\u001b[0more \u001b[0m\u001b[7m\u001b[0mas \u001b[0m\u001b[7m\u001b[0ma \u001b[0m\u001b[7m\u001b[0msurface \u001b[0m\u001b[7m\u001b[0mtag \u001b[0m\u001b[7m\u001b[0m(since \u001b[0m\u001b[7m\u001b[0mcommit \u001b[0m\u001b[7m\u001b[0m7a2389fe3f4, \u001b[0m\u001b[7m\u001b[0m2026-10-10), \u001b[0m\u001b[7m\u001b[0mwhile \u001b[0m\u001b[7m\u001b[0m`src/systems/mining.js` \u001b[0m\u001b[7m\u001b[0mrefuses \u001b[0m\u001b[7m\u001b[0many \u001b[0m\u001b[7m\u001b[0masteroid \u001b[0m\u001b[7m\u001b[0mwith \u001b[0m\u001b[7m\u001b[0ma \u001b[0m\r\n\u001b[7m\u001b[0mtruthy \u001b[0m\u001b[7m\u001b[0m`data.opticMaterial` \u001b[0m\u001b[7m\u001b[0mas \u001b[0m\u001b[7m\u001b[0m\"not \u001b[0m\u001b[7m\u001b[0more\" \u001b[0m\u001b[7m\u001b[0m(`applyMining` \u001b[0m\u001b[7m\u001b[0m~:1052, \u001b[0m\u001b[7m\u001b[0m`_acquireTarget` \u001b[0m\u001b[7m\u001b[0m~:1010, \u001b[0m\u001b[7m\u001b[0m`_isValidMineableTarget` \u001b[0m\r\n\u001b[7m\u001b[0m~:2991, \u001b[0m\u001b[7m\u001b[0mthe \u001b[0m\u001b[7m\u001b[0min-range \u001b[0m\u001b[7m\u001b[0mscan \u001b[0m\u001b[7m\u001b[0m~:3078 \u001b[0m\u001b[7m\u001b[0m- \u001b[0m\u001b[7m\u001b[0mthe \u001b[0m\u001b[7m\u001b[0mguard's \u001b[0m\u001b[7m\u001b[0mintent \u001b[0m\u001b[7m\u001b[0mis \u001b[0m\u001b[7m\u001b[0moptic \u001b[0m\u001b[7m\u001b[0mLATTICE \u001b[0m\u001b[7m\u001b[0mcells, \u001b[0m\u001b[7m\u001b[0mwhich \u001b[0m\u001b[7m\u001b[0mcarry \u001b[0m\u001b[7m\u001b[0m`opticStructureId`; \u001b[0m\r\n\u001b[7m\u001b[0m`isOpticRockData` \u001b[0m\u001b[7m\u001b[0min \u001b[0m\u001b[7m\u001b[0msrc/world/asteroidField.js:412 \u001b[0m\u001b[7m\u001b[0malready \u001b[0m\u001b[7m\u001b[0mdocuments \u001b[0m\u001b[7m\u001b[0mthe \u001b[0m\u001b[7m\u001b[0mdistinction) \u001b[0m\u001b[7m\u001b[0m| \u001b[0m\u001b[7m\u001b[0mWhat \u001b[0m\u001b[7m\u001b[0ma \u001b[0m\u001b[7m\u001b[0mstranger \u001b[0m\u001b[7m\u001b[0msees: \u001b[0m\u001b[7m\u001b[0mevery \u001b[0m\r\n\u001b[7m\u001b[0m`ast_metallic` \u001b[0m\u001b[7m\u001b[0mrock \u001b[0m\u001b[7m\u001b[0m(all \u001b[0m\u001b[7m\u001b[0mof \u001b[0m\u001b[7m\u001b[0mf_ceres_1/f_ceres_3, \u001b[0m\u001b[7m\u001b[0mf_vesta_1/2, \u001b[0m\u001b[7m\u001b[0mf_pallas_1, \u001b[0m\u001b[7m\u001b[0mf_io_1, \u001b[0m\u001b[7m\u001b[0mf_charon_2, \u001b[0m\u001b[7m\u001b[0mf_helios_outer \u001b[0m\u001b[7m\u001b[0m- \u001b[0m\u001b[7m\u001b[0m143 \u001b[0m\u001b[7m\u001b[0mof \u001b[0m\r\n\u001b[7m\u001b[0m254 \u001b[0m\u001b[7m\u001b[0mfield \u001b[0m\u001b[7m\u001b[0mrocks \u001b[0m\u001b[7m\u001b[0mon \u001b[0m\u001b[7m\u001b[0mseed \u001b[0m\u001b[7m\u001b[0m4242) \u001b[0m\u001b[7m\u001b[0mcannot \u001b[0m\u001b[7m\u001b[0mbe \u001b[0m\u001b[7m\u001b[0mtargeted \u001b[0m\u001b[7m\u001b[0mor \u001b[0m\u001b[7m\u001b[0mcut; \u001b[0m\u001b[7m\u001b[0mthe \u001b[0m\u001b[7m\u001b[0mbeam \u001b[0m\u001b[7m\u001b[0mpasses \u001b[0m\u001b[7m\u001b[0mover \u001b[0m\u001b[7m\u001b[0mthem. \u001b[0m\u001b[7m\u001b[0mCheapest \u001b[0m\u001b[7m\u001b[0mrepro \u001b[0m\u001b[7m\u001b[0m(repo \u001b[0m\u001b[7m\u001b[0mroot): \u001b[0m\u001b[7m\u001b[0mboot \u001b[0m\r\n\u001b[7m\u001b[0mseed \u001b[0m\u001b[7m\u001b[0m4242 \u001b[0m\u001b[7m\u001b[0mwith \u001b[0m\u001b[7m\u001b[0msystems \u001b[0m\u001b[7m\u001b[0m[physics, \u001b[0m\u001b[7m\u001b[0mworld, \u001b[0m\u001b[7m\u001b[0mmining], \u001b[0m\u001b[7m\u001b[0menter \u001b[0m\u001b[7m\u001b[0mCeres, \u001b[0m\u001b[7m\u001b[0mpromote \u001b[0m\u001b[7m\u001b[0many \u001b[0m\u001b[7m\u001b[0mf_ceres_1 \u001b[0m\u001b[7m\u001b[0mrock, \u001b[0m\u001b[7m\u001b[0m`applyMining(id, \u001b[0m\u001b[7m\u001b[0m50, \u001b[0m\u001b[7m\u001b[0m1)` \u001b[0m\r\n\u001b[7m\u001b[0mreturns \u001b[0m\u001b[7m\u001b[0m0 \u001b[0m\u001b[7m\u001b[0mand \u001b[0m\u001b[7m\u001b[0mthe \u001b[0m\u001b[7m\u001b[0mrock \u001b[0m\u001b[7m\u001b[0mcarries \u001b[0m\u001b[7m\u001b[0m`data.opticMaterial: \u001b[0m\u001b[7m\u001b[0m'metal'`. \u001b[0m\u001b[7m\u001b[0mNot \u001b[0m\u001b[7m\u001b[0mfixed \u001b[0m\u001b[7m\u001b[0mby \u001b[0m\u001b[7m\u001b[0mthe \u001b[0m\u001b[7m\u001b[0mlogging \u001b[0m\u001b[7m\u001b[0msitting \u001b[0m\u001b[7m\u001b[0mbecause \u001b[0m\r\n\u001b[7m\u001b[0m`src/systems/mining.js` \u001b[0m\u001b[7m\u001b[0mis \u001b[0m\u001b[7m\u001b[0moutside \u001b[0m\u001b[7m\u001b[0mthat \u001b[0m\u001b[7m\u001b[0munit's \u001b[0m\u001b[7m\u001b[0mnamed \u001b[0m\u001b[7m\u001b[0mowners. \u001b[0m\u001b[7m\u001b[0m| \u001b[0m\u001b[7m\u001b[0mCeres/Vesta/Pallas \u001b[0m\u001b[7m\u001b[0mmining \u001b[0m\u001b[7m\u001b[0m- \u001b[0m\u001b[7m\u001b[0mthe \u001b[0m\u001b[7m\u001b[0mmetallic \u001b[0m\u001b[7m\u001b[0mhalf \u001b[0m\u001b[7m\u001b[0mof \u001b[0m\u001b[7m\u001b[0mthe \u001b[0m\r\n\u001b[7m\u001b[0more \u001b[0m\u001b[7m\u001b[0meconomy, \u001b[0m\u001b[7m\u001b[0mand \u001b[0m\u001b[7m\u001b[0mevery \u001b[0m\u001b[7m\u001b[0mbulk-haul \u001b[0m\u001b[7m\u001b[0msource \u001b[0m\u001b[7m\u001b[0mexcept \u001b[0m\u001b[7m\u001b[0mthe \u001b[0m\u001b[7m\u001b[0mstarter \u001b[0m\u001b[7m\u001b[0mseam's \u001b[0m\u001b[7m\u001b[0mauthored \u001b[0m\u001b[7m\u001b[0mboulders \u001b[0m\u001b[7m\u001b[0m(which \u001b[0m\u001b[7m\u001b[0mpin \u001b[0m\u001b[7m\u001b[0m`material: \u001b[0m\u001b[7m\u001b[0m'rock'` \u001b[0m\u001b[7m\u001b[0mto \u001b[0m\r\n\u001b[7m\u001b[0mstay \u001b[0m\u001b[7m\u001b[0mcuttable) \u001b[0m\u001b[7m\u001b[0m| \u001b[0m\u001b[7m\u001b[0mOPEN: \u001b[0m\u001b[7m\u001b[0mretarget \u001b[0m\u001b[7m\u001b[0mthe \u001b[0m\u001b[7m\u001b[0mfour \u001b[0m\u001b[7m\u001b[0mmining \u001b[0m\u001b[7m\u001b[0mguards \u001b[0m\u001b[7m\u001b[0mfrom \u001b[0m\u001b[7m\u001b[0m`data.opticMaterial` \u001b[0m\u001b[7m\u001b[0mto \u001b[0m\u001b[7m\u001b[0m`data.opticStructureId` \u001b[0m\u001b[7m\u001b[0m(the \u001b[0m\r\n\u001b[7m\u001b[0mlattice \u001b[0m\u001b[7m\u001b[0mmarker), \u001b[0m\u001b[7m\u001b[0mkeep \u001b[0m\u001b[7m\u001b[0mlattice \u001b[0m\u001b[7m\u001b[0mcells \u001b[0m\u001b[7m\u001b[0mexcluded, \u001b[0m\u001b[7m\u001b[0mrerun \u001b[0m\u001b[7m\u001b[0mthe \u001b[0m\u001b[7m\u001b[0mmining/tow \u001b[0m\u001b[7m\u001b[0mchecks, \u001b[0m\u001b[7m\u001b[0mdelete \u001b[0m\u001b[7m\u001b[0mthis \u001b[0m\u001b[7m\u001b[0mrow \u001b[0m\u001b[7m\u001b[0min \u001b[0m\u001b[7m\u001b[0mthe \u001b[0m\u001b[7m\u001b[0mfixing \u001b[0m\u001b[7m\u001b[0mcommit. \u001b[0m\u001b[7m\u001b[0m|\u001b[0m\r\ndesign\\program\\DEMO_READINESS_2026-09-20.md:245:\u001b[7m| \u001b[0m\u001b[7m\u001b[0mD228 \u001b[0m\u001b[7m\u001b[0m| \u001b[0m\u001b[7m\u001b[0mTwo \u001b[0m\u001b[7m\u001b[0mauthoring \u001b[0m\u001b[7m\u001b[0mintents \u001b[0m\u001b[7m\u001b[0mfor \u001b[0m\u001b[7m\u001b[0mthe \u001b[0m\u001b[7m\u001b[0mCeres \u001b[0m\u001b[7m\u001b[0mthroughline \u001b[0m\u001b[7m\u001b[0mambush \u001b[0m\u001b[7m\u001b[0mhave \u001b[0m\r\n\u001b[7m\u001b[0mcollided \u001b[0m\u001b[7m\u001b[0min \u001b[0m\u001b[7m\u001b[0mthe \u001b[0m\u001b[7m\u001b[0mseed-47 \u001b[0m\u001b[7m\u001b[0macceptance \u001b[0m\u001b[7m\u001b[0mcorridor: \u001b[0m\u001b[7m\u001b[0m`test/ceres-five-minute-acceptance.test.mjs` \u001b[0m\r\n\u001b[7m\u001b[0m`runSeed47ToolkitCameraReposition` \u001b[0m\u001b[7m\u001b[0m(`:7006`) \u001b[0m\u001b[7m\u001b[0maccepts \u001b[0m\u001b[7m\u001b[0monly \u001b[0m\u001b[7m\u001b[0ma \u001b[0m\u001b[7m\u001b[0mone-or-two-hostile \u001b[0m\u001b[7m\u001b[0mcohort \u001b[0m\u001b[7m\u001b[0m(`:7007` \u001b[0m\u001b[7m\u001b[0m\"accepts \u001b[0m\u001b[7m\u001b[0monly \u001b[0m\u001b[7m\u001b[0mthe \u001b[0m\r\n\u001b[7m\u001b[0mauthored \u001b[0m\u001b[7m\u001b[0mone-or-two-hostile \u001b[0m\u001b[7m\u001b[0mcohort\") \u001b[0m\u001b[7m\u001b[0mand \u001b[0m\u001b[7m\u001b[0mits \u001b[0m\u001b[7m\u001b[0mdirector \u001b[0m\u001b[7m\u001b[0massertions \u001b[0m\u001b[7m\u001b[0mpin \u001b[0m\u001b[7m\u001b[0msingleton \u001b[0m\u001b[7m\u001b[0mauthority \u001b[0m\u001b[7m\u001b[0m(`initialCount \u001b[0m\u001b[7m\u0