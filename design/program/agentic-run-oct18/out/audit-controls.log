ge && pointerOwnsHelm);\n1823:     this._pointerHelmEdge = false;\n1824:     resolveMovementOwner(this, { kbdDrive, gp, tp, pointerHelmEdge, pointerOwnsHelm });\n1825:     let keyboardBrake = isPlayerSaucer(p) ? !!kbdBrakeHeld : (helm || pilot)\n1826:       ? !!(pilotProjection ? pilotProjection.brake : (down || kbdBrakeHeld))\n1827:       : !!(down || kbdBrakeHeld);\n1828:     // Ownership gates the drive vector only (turn/move axes). Boost and brake are modifiers,\n1829:     // not drive authority — like fire and mine they merge from whichever device holds them,\n1830:     // owner or not. Gating them by owner made a boot-claimed pad's boost unreachable whenever\n1831:     // a stale source (e.g. keyboard) was latched.\n1832:     if (this._movementSource === 'gamepad' || this._movementSource === 'touch') {\n1833:       kbdTurn = 0; kbdMoveX = 0; kbdMoveZ = 0;\n1834:       kbdLineOrbit = 0;\n1835:     }\n1836:     if (this._movementSource !== 'gamepad') {\n1837:       gpTurn = 0; gpMoveX = 0; gpMoveZ = 0;\n1838:     }\n1839:     if (this._movementSource !== 'touch') {\n1840:       tpTurn = 0; tpMoveZ = 0; tpMoveX = 0;\n1841:     }\n1842: \n1843:     inp.turnIntent = kbdTurn || gpTurn || tpTurn;\n1844:     inp.turnIntentFromAim = false;\n1845:     inp.moveX = kbdMoveX || gpMoveX || tpMoveX;\n1846:     // Twin-stick keeps the authored drive vector under the brake — LB decomposes counter-\n1847:     // velocity below rather than forcing a flat reverse, and hard stick-down is a legit\n1848:     // drive direction, not the drive scheme's brake gesture.\n1849:     inp.moveZ = kbdMoveZ || (gpBrake && padScheme !== 'twinstick' ? -1 : gpMoveZ) || tpMoveZ;\n1850:     // FB-113: opt-in press-to-toggle latches for the hold verbs. The raw samples above are\n1851:     // untouched — the latch only adds an alternative \"held\" after a fresh press edge, until the\n1852:     // next press or a context change (the neutralize branch drops every latch outright).\n1853:     const toggl