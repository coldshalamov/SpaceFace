{"type":"tool_use","timestamp":1792370398896,"sessionID":"ses_eae696a14ffehCxB980snPYjCy","part":{"type":"tool","tool":"read","callID":"call_00_ix9kejj40i2je69bgcwyck27","state":{"status":"completed","input":{"filePath":"C:\\Users\\93rob\\Documents\\GitHub\\SpaceFace\\src\\ui\\screens\\settings.js","limit":130,"offset":236},"output":"<path>C:\\Users\\93rob\\Documents\\GitHub\\SpaceFace\\src\\ui\\screens\\settings.js</path>\n<type>file</type>\n<content>\n236: // --- Key rebinding (V2 §12) ---\n237: // input.js owns the binding tables; the settings UI mirrors the active control scheme and overlays\n238: // saved custom keys so \"reset to defaults\" means the defaults for the selected scheme.\n239: const DEFAULT_BINDINGS = INPUT_DEFAULTS.BINDINGS;\n240: // Flight actions the player may rebind. Mouse buttons stay out of the grid; Space is the\n241: // new-profile Massline primary and F remains its permanent alias.\n242: export const REBINDABLE = ['forward', 'reverse', 'yawLeft', 'yawRight', 'strafeLeft', 'strafeRight', 'boost', 'autoFire',\n243:   'brake', 'siteBeam', 'tether', 'chargeThrow', 'chargeDetonate', 'scanPulse', 'cruise', 'reelIn', 'reelOut',\n244:   'dropBomb', 'cycleBomb', 'bulletTime', 'cloak', 'travelBurn', 'deployMassSeed', 'deployWell', 'deployRepulsor', 'toggleClearingCone',\n245:   // The rest of the live bound verbs: rebindable in data (input.js VERB_BINDINGS; countermeasure\n246:   // sits in the scheme tables) but until now with no row here — \"rebindable in data but no row\n247:   // is not rebindable to a player\" (below).\n248:   'countermeasure', 'toggleSkimCollector', 'deployBeacon', 'jettisonLot', 'gyreSnare'];\n249: export const REBIND_LABELS = {\n250:   forward: 'Throttle up',\n251:   reverse: 'Throttle down (reverse)',\n252:   yawLeft: 'Steer left (Classic scheme)',\n253:   yawRight: 'Steer right (Classic scheme)',\n254:   strafeLeft: 'Lateral thrust left',\n255:   strafeRight: 'Lateral thrust right',\n256:   boost: 'Boost / dash',\n257:   autoFire: 'Toggle auto-target / draw-to-fly',\n258:   brake: 'Brake (0; S / Down also reverse)',\n259:   siteBeam: 'World Site beam (selected target)',\n260:   tether: 'Massline: tap latch/cut; hold line control',\n261:   chargeThrow: 'Impulse charge: throw',\n262:   chargeDetonate: 'Ordnance: detonate armed bombs and charges',\n263:   scanPulse: 'Scanner pulse',\n264:   cruise: 'Cruise drive (charge/drop)',\n265:   reelIn: 'Tether winch in',\n266:   reelOut: 'Tether winch out',\n267:   bulletTime: 'Bullet time (hold)',\n268:   cloak: 'Cloak toggle',\n269:   // W1-5. A latch that is rebindable in data but has no row here is not rebindable to a player.\n270:   travelBurn: 'Travel drive (burn latch)',\n271:   // PQ-011. Keyboard verb (same reachability posture as the impulse-charge verbs): no standard\n272:   // gamepad button remains unclaimed, so the pad row stays unbound rather than commandeered.\n273:   deployMassSeed: 'Anchor Mass Seed: deploy',\n274:   // PQ-012 continuous field tools.\n275:   deployWell: 'Field: deploy attractive Well',\n276:   deployRepulsor: 'Field: deploy Repulsor',\n277:   toggleClearingCone: 'Field: toggle Clearing Cone',\n278:   // The Gyre Snare is a held verb: grip to beam/hold, release to bowl the clump.\n279:   gyreSnare: 'Gyre Snare: hold to lash, release to bowl',\n280:   dropBomb: 'Bomb bay: drop bomb',\n281:   cycleBomb: 'Bomb bay: cycle payload',\n282:   // Labels mirror the pad grid's names for the same verbs (one verb, one name across devices).\n283:   countermeasure: 'Countermeasure',\n284:   toggleSkimCollector: 'Field: toggle skim collector',\n285:   deployBeacon: 'Nav beacon: deploy',\n286:   jettisonLot: 'Cargo: jettison lot',\n287: };\n288: \n289: // PQ-164.01 pad remap. Every gamepad action is rebindable; labels describe the verb, not the\n290: // default button (the live resolved map prints the button on the right of each row). FB-003 adds\n291: // the chord layer: every keyboard flight verb has a pad route, and capture accepts a held\n292: // modifier + a tapped key as a 'mod+key' chord.\n293: export const GAMEPAD_REBINDABLE = [\n294:   'accept', 'cancel', 'massline', 'dock', 'deployRepulsor', 'fire', 'mine', 'boost', 'brake', 'cycleTarget', 'autoTarget',\n295:   'map', 'codex', 'pause', 'countermeasure', 'travelBurn', 'dropBomb', 'cycleBomb', 'chargeDetonate', 'tabPrev', 'tabNext',\n296:   'scanPulse', 'cruise', 'bulletTime', 'cloak', 'chargeThrow', 'siteBeam', 'deployMassSeed', 'deployWell',\n297:   'toggleClearingCone', 'toggleSkimCollector', 'deployBeacon', 'jettisonLot', 'gyreSnare', 'steeringView',\n298: ];\n299: export const GAMEPAD_REBIND_LABELS = {\n300:   accept: 'Accept',\n301:   dock: 'Dock (when prompted)',\n302:   deployRepulsor: 'Shove (repulsor)',\n303:   cancel: 'Back / cancel',\n304:   massline: 'Massline: tap latch/cut; hold line control',\n305:   fire: 'Fire',\n306:   mine: 'Mine beam (analog trigger)',\n307:   boost: 'Boost',\n308:   brake: 'Brake / reverse thrust',\n309:   cycleTarget: 'Cycle target',\n310:   autoTarget: 'Auto-target / draw-to-fly toggle',\n311:   map: 'Star map',\n312:   steeringView: 'Chase / overhead camera',\n313:   codex: 'Codex / journal',\n314:   pause: 'Pause menu',\n315:   countermeasure: 'Countermeasure',\n316:   travelBurn: 'Travel drive (burn latch)',\n317:   chargeDetonate: 'Ordnance: detonate armed bombs and charges',\n318:   tabPrev: 'Station tab: previous',\n319:   tabNext: 'Station tab: next',\n320:   dropBomb: 'Bomb bay: drop bomb',\n321:   cycleBomb: 'Bomb bay: cycle payload',\n322:   // FB-003 chord layer — stock seats live on LB (survey/deploy) and RB (combat-state) chords.\n323:   scanPulse: 'Scanner pulse',\n324:   cruise: 'Cruise drive (charge/drop)',\n325:   bulletTime: 'Bullet time (hold)',\n326:   cloak: 'Cloak toggle',\n327:   chargeThrow: 'Impulse charge: throw',\n328:   siteBeam: 'World Site beam (selected target)',\n329:   deployMassSeed: 'Anchor Mass Seed: deploy',\n330:   deployWell: 'Field: deploy attractive Well',\n331:   toggleClearingCone: 'Field: toggle Clearing Cone',\n332:   toggleSkimCollector: 'Field: toggle skim collector',\n333:   deployBeacon: 'Nav beacon: deploy',\n334:   jettisonLot: 'Cargo: jettison lot',\n335:   gyreSnare: 'Gyre Snare: hold to lash, release to bowl',\n336: };\n337: \n338: function controlSchemeFor(settings) {\n339:   const scheme = settings && settings.gameplay && settings.gameplay.controlScheme || 'pilot';\n340:   const schemes = INPUT_DEFAULTS.SCHEMES || {};\n341:   return schemes[scheme] ? scheme : 'pilot';\n342: }\n343: \n344: function schemeBindingsFor(settings) {\n345:   const schemes = INPUT_DEFAULTS.SCHEMES || {};\n346:   return schemes[controlSchemeFor(settings)] || DEFAULT_BINDINGS;\n347: }\n348: \n349: function mergedBindingsFor(settings) {\n350:   const base = schemeBindingsFor(settings);\n351:   const live = {};\n352:   const keys = new Set([...Object.keys(DEFAULT_BINDINGS || {}), ...Object.keys(base || {})]);\n353:   for (const action of keys) live[action] = ((base && base[action]) || DEFAULT_BINDINGS[action] || []).slice();\n354:   const custom = settings && settings.controls && settings.controls.bindings;\n355:   if (custom) for (const action in custom) live[action] = (custom[action] || []).slice();\n356:   return { base, live };\n357: }\n358: \n359: // Fixed interface keys from the live BINDINGS registry (not rebindable flight codes).\n360: // Pause is Esc/P (UI-owned, not in BINDINGS). Mission Log is BINDINGS.missionLog on keyboard/touch;\n361: // gamepad has no direct Mission Log button — Start opens Pause, then choose Mission Log.\n362: /** PRO-05 — one key the localizer can translate. en-US renders the old concatenation. */\n363: \n364: // NXI-003 — the Controls surface reports the input owner's ACCEPTED flight source\n365: // (resolveMovementOwner → host.movementSource), never a hover, a connectivity guess, or a\n\n(Showing lines 236-365 of 1564. Use offset=366 to continue.)\n</content>","metadata":{"preview":"// -