{"type":"tool_use","timestamp":1792371117277,"sessionID":"ses_eae696a14ffehCxB980snPYjCy","part":{"type":"tool","tool":"read","callID":"call_00_m0ftgqu2jfutelpaizykkl74","state":{"status":"completed","input":{"filePath":"C:\\Users\\93rob\\Documents\\GitHub\\SpaceFace\\test\\j5-capture-generation.test.mjs"},"output":"<path>C:\\Users\\93rob\\Documents\\GitHub\\SpaceFace\\test\\j5-capture-generation.test.mjs</path>\n<type>file</type>\n<content>\n1: // J5 (research B, board row 196 residual) — a capture owns its close exactly once. The conflict\n2: // label arms a 900 ms `done(false)` timer; if the player closes early (Escape, click-away) and\n3: // starts a new capture inside that window, the stale timer used to run the OLD closure anyway —\n4: // clearing the newer capture's `_activeCapture` handle and restoring the older button's text over\n5: // the live \"Press a key…\" listen. `done` now refuses any close it does not own. These pins drive\n6: // the real screen object with fake DOM/window plumbing; no renderer, no GPU.\n7: import test from 'node:test';\n8: import assert from 'node:assert/strict';\n9: \n10: import { settingsScreen, REBINDABLE } from '../src/ui/screens/settings.js';\n11: import { setGamepadCaptureHandler, getGamepadCaptureHandler } from '../src/ui/bindings.js';\n12: import { DEFAULTS as INPUT_DEFAULTS } from '../src/systems/input.js';\n13: \n14: const sleep = (ms) => new Promise((res) => setTimeout(res, ms));\n15: \n16: /** Minimal window shim: records capture-phase listeners so the test dispatches by hand. */\n17: function fakeWindow() {\n18:   const listeners = { keydown: [], mousedown: [] };\n19:   globalThis.window = {\n20:     addEventListener(type, fn) { listeners[type]?.push(fn); },\n21:     removeEventListener(type, fn) {\n22:       const list = listeners[type] || [];\n23:       const i = list.indexOf(fn);\n24:       if (i >= 0) list.splice(i, 1);\n25:     },\n26:   };\n27:   return listeners;\n28: }\n29: \n30: function fakeBtn() {\n31:   const classes = new Set();\n32:   const attrs = new Map();\n33:   return {\n34:     textContent: 'KeyX',\n35:     classList: { add: (c) => classes.add(c), remove: (c) => classes.delete(c) },\n36:     setAttribute: (k, v) => attrs.set(k, v),\n37:     removeAttribute: (k) => attrs.delete(k),\n38:     closest: () => null,\n39:   };\n40: }\n41: \n42: function fakeCtx() {\n43:   return {\n44:     state: { settings: { controls: {} } },\n45:     bus: { emit() {} },\n46:     gamepad: {},\n47:   };\n48: }\n49: \n50: function keyEvent(code) {\n51:   return { code, preventDefault() {}, stopPropagation() {} };\n52: }\n53: \n54: function mouseEvent(target) {\n55:   return { target };\n56: }\n57: \n58: test('J5: a stale conflict timer never mutates the capture that replaced it', async () => {\n59:   const listeners = fakeWindow();\n60:   const ctx = fakeCtx();\n61:   const live = {};\n62:   for (const action of REBINDABLE) live[action] = [];\n63:   live.scanPulse = ['KeyW']; // the code the player will try to steal\n64:   const base = {};\n65:   const committed = [];\n66:   const realCommit = settingsScreen._commitBind;\n67:   const realRender = settingsScreen._render;\n68:   settingsScreen._commitBind = function (c, action, code) { committed.push([action, code]); };\n69:   settingsScreen._render = function () {};\n70:   try {\n71:     const btnA = fakeBtn();\n72:     settingsScreen._capture(ctx, btnA, 'forward', live, base);\n73:     assert.equal(btnA.textContent, 'Press a key…');\n74: \n75:     // A conflicting key: denial label shows, and the 900 ms close timer arms.\n76:     listeners.keydown[0](keyEvent('KeyW'));\n77:     assert.match(btnA.textContent, /in use/i);\n78: \n79:     // The player bails out (click-away) and immediately rebinds a different verb.\n80:     listeners.mousedown[0](mouseEvent(null));\n81:     assert.equal(settingsScreen._capturing, false);\n82:     const btnB = fakeBtn();\n83:     settingsScreen._capture(ctx, btnB, 'reverse', live, base);\n84:     const captureB = settingsScreen._activeCapture;\n85:     assert.notEqual(captureB, null);\n86:     assert.equal(btnB.textContent, 'Press a key…');\n87: \n88:     // The stale 900 ms close fires into capture B's window: it must be a no-op.\n89:     await sleep(950);\n90:     assert.equal(settingsScreen._activeCapture, captureB, 'capture B still owns the slot');\n91:     assert.equal(settingsScreen._capturing, true, 'capture B is still listening');\n92:     assert.equal(btnB.textContent, 'Press a key…', 'stale close never restores an older label');\n93:     assert.equal(btnA.textContent, 'KeyX', 'A stayed closed');\n94: \n95:     // Capture B's own listeners still resolve a key to a commit.\n96:     assert.equal(listeners.keydown.length, 1, 'exactly one live keydown listener');\n97:     listeners.keydown[0](keyEvent('KeyF'));\n98:     assert.deepEqual(committed, [['reverse', 'KeyF']]);\n99:     assert.equal(settingsScreen._capturing, false);\n100:     assert.equal(settingsScreen._activeCapture, null);\n101:   } finally {\n102:     settingsScreen._commitBind = realCommit;\n103:     settingsScreen._render = realRender;\n104:     delete globalThis.window;\n105:   }\n106: });\n107: \n108: test('J5: the screen-hide path cancels the live capture exactly once', () => {\n109:   fakeWindow();\n110:   const ctx = fakeCtx();\n111:   const live = {};\n112:   for (const action of REBINDABLE) live[action] = [];\n113:   const base = {};\n114:   const realRender = settingsScreen._render;\n115:   settingsScreen._render = function () {};\n116:   try {\n117:     const btn = fakeBtn();\n118:     settingsScreen._capture(ctx, btn, 'boost', live, base);\n119:     assert.notEqual(settingsScreen._activeCapture, null);\n120:     settingsScreen.onHide();\n121:     assert.equal(settingsScreen._capturing, false);\n122:     assert.equal(settingsScreen._activeCapture, null);\n123:     assert.equal(btn.textContent, 'KeyX', 'cancelled listen restores the row label');\n124:     // A second hide (or any stale close) must not resurrect or double-run the closure.\n125:     settingsScreen.onHide();\n126:     assert.equal(settingsScreen._activeCapture, null);\n127:   } finally {\n128:     settingsScreen._render = realRender;\n129:     delete globalThis.window;\n130:   }\n131: });\n132: \n133: test('J5: the pad capture carries the same ownership guard', async () => {\n134:   const listeners = fakeWindow();\n135:   const ctx = fakeCtx();\n136:   const liveMap = { fire: ['Standard0'] };\n137:   const realCommit = settingsScreen._commitPadBind;\n138:   const realRender = settingsScreen._render;\n139:   const committed = [];\n140:   settingsScreen._commitPadBind = function (c, action, stdName) { committed.push([action, stdName]); };\n141:   settingsScreen._render = function () {};\n142:   try {\n143:     const btnA = fakeBtn();\n144:     settingsScreen._capturePad(ctx, btnA, 'scanPulse', liveMap);\n145:     assert.equal(ctx.gamepad.captureMode, true);\n146:     const handlerA = getGamepadCaptureHandler();\n147:     assert.equal(typeof handlerA, 'function');\n148: \n149:     // Conflicting pad button: denial label, 900 ms close timer arms.\n150:     handlerA('Standard0');\n151:     assert.match(btnA.textContent, /in use|Fire/i);\n152: \n153:     // Bail out, start a newer pad capture inside the stale window.\n154:     listeners.mousedown[0](mouseEvent(null));\n155:     const btnB = fakeBtn();\n156:     settingsScreen._capturePad(ctx, btnB, 'boost', liveMap);\n157:     const handlerB = getGamepadCaptureHandler();\n158:     assert.notEqual(handlerB, handlerA);\n159: \n160:     // Stale timer fires: capture B's listen stays live, its button keeps the prompt.\n161:     await sleep(950);\n162:     assert.equal(settingsScreen._capturing, true);\n163:     assert.equal(btnB.textContent, 'Press a pad button…');\n164: \n165:     // B still resolves: a free pad button commits and closes the listen.\n166:     handlerB('Standard3');\n167:     assert.deepEqual(committed, [['boost', 'Standard3']]);\n168:     assert.equal(settingsScreen._capturing, false);\n169:     assert.equal(settingsScreen._activeCapture, null);\n170:     assert.equal(getGamepadCaptureHandler(), null, 'the pad capture handler is released');\n171:   } finally {\n172:     settingsScreen._commitPadBind = realCommit;\n173:     settingsScreen._render = realRender;\n174:     setGamepadCaptureHandler(null);\n175:     delete globalThis.window;\n176:   }\n177: });\n178: \n179: test('J4: a per-action reset refuses while its default code is deliberately owned elsewhere', async () => {\n180:   const listeners = fakeWindow();\n181:   const ctx = fakeCtx();\n182:   const base = INPUT_DEFAULTS.BINDINGS;\n183:   const live = {};\n184:   for (const action of REBINDABLE) live[action] = (base[action] || []).slice();\n185:   const forwardDefault = base.forward[0]; // e.g. KeyW — the code the player gave to another verb\n186:   live.scanPulse = [forwardDefault];\n187:   const committed = [];\n188:   const realCommit = settingsScreen._commitBind;\n189:   const realRender = settingsScreen._render;\n190:   settingsScreen._commitBind = function (c, action, code) { committed.push([action, code]); };\n191:   settingsScreen._render = function () {};\n192:   try {\n193:     const btn = fakeBtn();\n194:     settingsScreen._capture(ctx, btn, 'forward', live, base);\n195:     listeners.keydown[0](keyEvent('Backspace'));\n196:     // Refusal names the owning action; nothing is committed; the capture stays open.\n197:     assert.match(btn.textContent, /in use/i);\n198:     assert.deepEqual(committed, [], 'a refused reset commits nothing');\n199:     assert.equal(settingsScreen._capturing, true);\n200:     // The 900 ms denial label restores the prompt, then Escape closes the listen.\n201:     await sleep(950);\n202:     assert.equal(settingsScreen._capturing, false);\n203:     assert.deepEqual(live.scanPulse, [forwardDefault], 'the deliberate owner keeps the code');\n204: \n205:     // Release the deliberate override; the same reset now succeeds.\n206:     live.scanPulse = [];\n207:     settingsScreen._capture(ctx, fakeBtn(), 'forward', live, base);\n208:     listeners.keydown[0](keyEvent('Backspace'));\n209:     assert.deepEqual(committed, [['forward', null]], 'the reset restores the default once unowned');\n210:     assert.equal(settingsScreen._capturing, false);\n211:   } finally {\n212:     settingsScreen._commitBind = realCommit;\n213:     settingsScreen._render = realRender;\n214:     delete globalThis.window;\n215:   }\n216: });\n217: \n218: test('J4: the stock scheme is conflict-free, so a full reset can never collide', () => {\n219:   // The reset-to-defaults word sets `bindings = null` in one click. That is only safe while the\n220:   // invariant holds: no default code appears on two actions. If an alias ever ships on purpose,\n221:   // this pin is the thing to reconsider — not the reset word.\n222:   const seen = new Map();\n223:   for (const action of REBINDABLE) {\n224:     for (const code of INPUT_DEFAULTS.BINDINGS[action] || []) {\n225:       assert.ok(!seen.has(code), `${code} is stock-bound to both ${seen.get(code)} and ${action}`);\n226:       seen.set(code, action);\n227:     }\n228:   }\n229:   assert.ok(seen.size > 10, 'the stock scheme actually binds keys');\n230: });\n\n(End of file - total 230 lines)\n</content>\n\n<system-reminder>\nInstructions from: C:\\Users\\93rob\\Documents\\GitHub\\SpaceFace\\test\\AGENTS.md\n# test/ agent notes\n\nTests cover deterministic simulation, focused contracts, save compatibility, launch/UI behavior, and\nregression fixtures.\n\n- Choose the proof layer through `docs/VALIDATION_WORKFLOW.md`; lab implementation tests also follow\n  `src/testing/lab/AGENTS.md`.\n- Run the narrow test file first with `node --test <file>`; broaden only after it passes.\n- Never edit `*.expected.json` merely to make a changed simulation pass. A deliberate re-record needs\n  an explicit gameplay reason and review of the semantic delta.\n- Use seeded state/RNG and simulation time. Avoid wall-clock sleeps and nondeterministic ordering.\n- Test public behavior and ownership seams rather than incidental formatting or file-size/count facts.\n- Keep adversarial coverage for duplicate events, stale saves, missing assets, unordered payloads,\n  pause/resume, and repeated initialization when relevant.\n- Preserve foreign fixture changes in the shared working tree. Add new files with `git add -N`.\n- UI/render claims still need a representative runtime probe or screenshot when feasible; DOM/source\n  assertions alone are not visual acceptance.\n- Gameplay changes also attach the player-truth verdict and contact sheet\n  (`npm run player-truth -- --mode=<mode> --gate`); a FAIL blocks landing. UNKNOWN on a core\n  check is a FAIL. Its checks are covered by `test/player-truth-*.test.mjs` fixtures.\n\n</system-reminder>","metadata":{"preview":"// J5 (research B, board row 196 residual) — a capture owns its close exactly once. The conflict\n// label arms a 900 ms `done(false)` timer; if the player closes early (Escape, click-away) and\n// starts a new capture inside that window, the stale timer used to run the OLD closure anyway —\n// clearing the newer capture's `_activeCapture` handle and restoring the older button's text over\n// the live \"Press a key…\" listen. `done` now refuses any close it does not own. These pins drive\n// the real screen object with fake DOM/window plumbing; no renderer, no GPU.\nimport test from 'node:test';\nimport assert from 'node:assert/strict';\n\nimport { settingsScreen, REBINDABLE } from '../src/ui/screens/settings.js';\nimport { setGamepadCaptureHandler, getGamepadCaptureHandler } from '../src/ui/bindings.js';\nimport { DEFAULTS as INPUT_DEFAULTS } from '../src/systems/input.js';\n\nconst sleep = (ms) => new Promise((res) => setTimeout(res, ms));\n\n/** Minimal window shim: records capture-phase listeners so the test dispatches by hand. */\nfunction fakeWindow() {\n  const listeners = { keydown: [], mousedown: [] };\n  globalThis.window = {\n    addEventListener(type, fn) { listeners[type]?.push(fn); },","truncated":false,"loaded":["C:\\Users\\93rob\\Documents\\GitHub\\SpaceFace\\test\\AGENTS.md"],"display":{"type":"file","path":"C:\\Users\\93rob\\Documents\\GitHub\\SpaceFace\\test\\j5-capture-generation.test.mjs","text":"// J5 (research B, board row 196 residual) — a capture owns its close exactly once. The conflict\n// label arms a 900 ms `done(false)` timer; if the player closes early (Escape, click-away) and\n// starts a new capture inside that window, the stale timer used to run the OLD closure anyway —\n// clearing the newer capture's `_activeCapture` handle and restoring the older button's text over\n// the live \"Press a key…\" listen. `done` now refuses any close it does not own. These pins drive\n// the real screen object with fake DOM/window plumbing; no renderer, no GPU.\nimport test from 'node:test';\nimport assert from 'node:assert/strict';\n\nimport { settingsScreen, REBINDABLE } from '../src/ui/screens/settings.js';\nimport { setGamepadCaptureHandler, getGamepadCaptureHandler } from '../src/ui/bindings.js';\nimport { DEFAULTS as INPUT_DEFAULTS } from '../src/systems/input.js';\n\nconst sleep = (ms) => new Promise((res) => setTimeout(res, ms));\n\n/** Minimal window shim: records capture-phase listeners so the test dispatches by hand. */\nfunction fakeWindow() {\n  const listeners = { keydown: [], mousedown: [] };\n  globalThis.window = {\n    addEventListener(type, fn) { listeners[type]?.push(fn); },\n    removeEventListener(type, fn) {\n      const list = listeners[type] || [];\n      const i = list.indexOf(fn);\n      if (i >= 0) list.splice(i, 1);\n    },\n  };\n  return listeners;\n}\n\nfunction fakeBtn() {\n  const classes = new Set();\n  const attrs = new Map();\n  return {\n    textContent: 'KeyX',\n    classList: { add: (c) => classes.add(c), remove: (c) => classes.delete(c) },\n    setAttribute: (k, v) => attrs.set(k, v),\n    removeAttribute: (k) => attrs.delete(k),\n    closest: () => null,\n  };\n}\n\nfunction fakeCtx() {\n  return {\n    state: { settings: { controls: {} } },\n    bus: { emit() {} },\n    gamepad: {},\n  };\n}\n\nfunction keyEvent(code) {\n  return { code, preventDefault() {}, stopPropagation() {} };\n}\n\nfunction mouseEvent(target) {\n  return { target };\n}\n\ntest('J5: a stale conflict timer never mutates the capture that replaced it', async () => {\n  const listeners = fakeWindow();\n  const ctx = fakeCtx();\n  const live = {};\n  for (const action of REBINDABLE) live[action] = [];\n  live.scanPulse = ['KeyW']; // the code the player will try to steal\n  const base = {};\n  const committed = [];\n  const realCommit = settingsScreen._commitBind;\n  const realRender = settingsScreen._render;\n  settingsScreen._commitBind = function (c, action, code) { committed.push([action, code]); };\n  settingsScreen._render = function () {};\n  try {\n    const btnA = fakeBtn();\n    settingsScreen._capture(ctx, btnA, 'forward', live, base);\n    assert.equal(btnA.textContent, 'Press a key…');\n\n    // A conflicting key: denial label shows, and the 900 ms close timer arms.\n    listeners.keydown[0](keyEvent('KeyW'));\n    assert.match(btnA.textContent, /in use/i);\n\n    // The player bails out (click-away) and immediately rebinds a different verb.\n    listeners.mousedown[0](mouseEvent(null));\n    assert.equal(settingsScreen._capturing, false);\n    const btnB = fakeBtn();\n    settingsScreen._capture(ctx, btnB, 'reverse', live, base);\n    const captureB = settingsScreen._activeCapture;\n    assert.notEqual(captureB, null);\n    assert.equal(btnB.textContent, 'Press a key…');\n\n    // The stale 900 ms close fires into capture B's window: it must be a no-op.\n    await sleep(950);\n    assert.equal(settingsScreen._activeCapture, captureB, 'capture B still owns the slot');\n    assert.equal(settingsScreen._capturing, true, 'capture B is still listening');\n    assert.equal(btnB.textContent, 'Press a key…', 'stale close never restores an older label');\n    assert.equal(btnA.textContent, 'KeyX', 'A stayed closed');\n\n    // Capture B's own listeners still resolve a key to a commit.\n    assert.equal(listeners.keydown.length, 1, 'exactly one live keydown listener');\n    listeners.keydown[0](keyEvent('KeyF'));\n    assert.deepEqual(committed, [['reverse', 'KeyF']]);\n    assert.equal(settingsScreen._capturing, false);\n    assert.equal(settingsScreen._activeCapture, null);\n  } finally {\n    settingsScreen._commitBind = realCommit;\n    settingsScreen._render = realRender;\n    delete globalThis.window;\n  }\n});\n\ntest('J5: the screen-hide path cancels the live capture exactly once', () => {\n  fakeWindow();\n  const ctx = fakeCtx();\n  const live = {};\n  for (const action of REBINDABLE) live[action] = [];\n  const base = {};\n  const realRender = settingsScreen._render;\n  settingsScreen._render = function () {};\n  try {\n    const btn = fakeBtn();\n    settingsScreen._capture(ctx, btn, 'boost', live, base);\n    assert.notEqual(settingsScreen._activeCapture, null);\n    settingsScreen.onHide();\n    assert.equal(settingsScreen._capturing, false);\n    assert.equal(settingsScreen._activeCapture, null);\n    assert.equal(btn.textContent, 'KeyX', 'cancelled listen restores the row label');\n    // A second hide (or any stale close) must not resurrect or double-run the closure.\n    settingsScreen.onHide();\n    assert.equal(settingsScreen._activeCapture, null);\n  } finally {\n    settingsScreen._render = realRender;\n    delete globalThis.window;\n  }\n});\n\ntest('J5: the pad capture carries the same ownership guard', async () => {\n  const listeners = fakeWindow();\n  const ctx = fakeCtx();\n  const liveMap = { fire: ['Standard0'] };\n  const realCommit = settingsScreen._commitPadBind;\n  const realRender = settingsScreen._render;\n  const committed = [];\n  settingsScreen._commitPadBind = function (c, action, stdName) { committed.push([action, stdName]); };\n  settingsScreen._render = function () {};\n  try {\n    const btnA = fakeBtn();\n    settingsScreen._capturePad(ctx, btnA, 'scanPulse', liveMap);\n    assert.equal(ctx.gamepad.captureMode, true);\n    const handlerA = getGamepadCaptureHandler();\n    assert.equal(typeof handlerA, 'function');\n\n    // Conflicting pad button: denial label, 900 ms close timer arms.\n    handlerA('Standard0');\n    assert.match(btnA.textContent, /in use|Fire/i);\n\n    // Bail out, start a newer pad capture inside the stale window.\n    listeners.mousedown[0](mouseEvent(null));\n    const btnB = fakeBtn();\n    settingsScreen._capturePad(ctx, btnB, 'boost', liveMap);\n    const handlerB = getGamepadCaptureHandler();\n    assert.notEqual(handlerB, handlerA);\n\n    // Stale timer fires: capture B's listen stays live, its button keeps the prompt.\n    await sleep(950);\n    assert.equal(settingsScreen._capturing, true);\n    assert.equal(btnB.textContent, 'Press a pad button…');\n\n    // B still resolves: a free pad button commits and closes the listen.\n    handlerB('Standard3');\n    assert.deepEqual(committed, [['boost', 'Standard3']]);\n    assert.equal(settingsScreen._capturing, false);\n    assert.equal(settingsScreen._activeCapture, null);\n    assert.equal(getGamepadCaptureHandler(), null, 'the pad capture handler is released');\n  } finally {\n    settingsScreen._commitPadBind = realCommit;\n    settingsScreen._render = realRender;\n    setGamepadCaptureHandler(null);\n    delete globalThis.window;\n  }\n});\n\ntest('J4: a per-action reset refuses while its default code is deliberately owned elsewhere', async () => {\n  const listeners = fakeWindow();\n  const ctx = fakeCtx();\n  const base = INPUT_DEFAULTS.BINDINGS;\n  const live = {};\n  for (const action of REBINDABLE) live[action] = (base[action] || []).slice();\n  const forwardDefault = base.forward[0]; // e.g. KeyW — the code the player gave to another verb\n  live.scanPulse = [forwardDefault];\n  const committed = [];\n  const realCommit = settingsScreen._commitBind;\n  const realRender = settingsScreen._render;\n  settingsScreen._commitBind = function (c, action, code) { committed.push([action, code]); };\n  settingsScreen._render = function () {};\n  try {\n    const btn = fakeBtn();\n    settingsScreen._capture(ctx, btn, 'forward', live, base);\n    listeners.keydown[0](keyEvent('Backspace'));\n    // Refusal names the owning action; nothing is committed; the capture stays open.\n    assert.match(btn.textContent, /in use/i);\n    assert.deepEqual(committed, [], 'a refused reset commits nothing');\n    assert.equal(settingsScreen._capturing, true);\n    // The 900 ms denial label restores the prompt, then Escape closes the listen.\n    await sleep(950);\n    assert.equal(settingsScreen._capturing, false);\n    assert.deepEqual(live.scanPulse, [forwardDefault], 'the deliberate owner keeps the code');\n\n    // Release the deliberate override; the same reset now succeeds.\n    live.scanPulse = [];\n    settingsScreen._capture(ctx, fakeBtn(), 'forward', live, base);\n    listeners.keydown[0](keyEvent('Backspace'));\n    assert.deepEqual(committed, [['forward', null]], 'the reset restores the default once unowned');\n    assert.equal(settingsScreen._capturing, false);\n  } finally {\n    settingsScreen._commitBind = realCommit;\n    settingsScreen._render = realRender;\n    delete globalThis.window;\n  }\n});\n\ntest('J4: the stock scheme is conflict-free, so a full reset can never collide', () => {\n  // The reset-to-defaults word sets `bindings = null` in one click. That is only safe while the\n  // invariant holds: no default code appears on two actions. If an alias ever ships on purpose,\n  // this pin is the thing to reconsider — not the reset word.\n  const seen = new Map();\n  for (const action of REBINDABLE) {\n    for (const code of INPUT_DEFAULTS.BINDINGS[action] || []) {\n      assert.ok(!seen.has(code), `${code} is stock-bound to both ${seen.get(code)} and ${action}`);\n      seen.set(code, action);\n    }\n  }\n  assert.ok(seen.size > 10, 'the stock scheme actually binds keys');\n});","lineStart":1,"lineEnd":230,"totalLines":230,"truncated":false}},"title":"test\\j5-capture-generation.test.mjs","time":{"start":1792371117216,"end":1792371117245}},"id":"prt_151a4cbf2001JlBzOkwPIbaGdY","sessionID":"ses_eae696a14ffehCxB980snPYjCy","messageID":"msg_151a462c5001wB7gOT1ywQmDcE"}}
