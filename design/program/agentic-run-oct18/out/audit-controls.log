{"type":"tool_use","timestamp":1792370244272,"sessionID":"ses_eae696a14ffehCxB980snPYjCy","part":{"type":"tool","tool":"read","callID":"call_00_defbkedjcnnut77htiqbct81","state":{"status":"completed","input":{"filePath":"C:\\Users\\93rob\\Documents\\GitHub\\SpaceFace\\src\\ui\\input.js"},"output":"<path>C:\\Users\\93rob\\Documents\\GitHub\\SpaceFace\\src\\ui\\input.js</path>\n<type>file</type>\n<content>\n1: // UI key router (ARCHITECTURE §5.6) — a single document keydown listener for UI-OWNED keys.\n2: //\n3: // UI owns: ESC (back/pause), map bindings, T (tech), mission log, K (codex), F1/H (help),\n4: //          Tab (cycle target), Backspace (free aim), P (pause), E (dock in range / undock station hub; Enter secondary dock),\n5: //          F5/F9 (quick save/load), cargo/comms overlays, mouse-wheel (camera zoom passthrough → camera:zoom).\n6: // Flight/input system owns movement+fire keys (W/A/S/D, mouse-aim, Space/LMB, RMB, Q/E, F) — NOT here.\n7: //\n8: // Routing rule: if a modal screen is open and it has a key handler, route there first\n9: // (ESC always = back). Otherwise translate UI-owned keys into intent events / screen pushes.\n10: // The UI never mutates sim state; docking sets ui.docked + emits dock:docked + pushes 'station'.\n11: \n12: import { isConfirmOpen, confirmGamepadAccept, confirmGamepadCancel } from './confirm.js';\n13: import { getPromptDeck } from './promptDeck.js';\n14: import {\n15:   BINDINGS,\n16:   setPromptDevice,\n17:   setGamepadPromptBindings,\n18:   setGamepadGlyphSet,\n19:   getGamepadCaptureHandler,\n20: } from './bindings.js';\n21: import { resolveActionLabel, selectedWorldSiteTarget } from '../systems/input.js';\n22: import { resolveGamepadBindings } from '../systems/gamepad.js';\n23: import { MAP_FOCUS, openGalaxyMap, isMapScreenId } from './mapAuthority.js';\n24: import { interactionDisplayName, interactionProfileForEntity } from '../data/entityInteractionProfiles.js';\n25: import { resolveDockDeny } from './dockDenyBanner.js';\n26: import { dedupError } from '../core/warnDedup.js';\n27: import { createDockIntent } from '../core/dockIntent.js';\n28: \n29: const DRILL_MASSLINE_DEF_IDS = new Set(['tether_standard', 'attachment_massline']);\n30: \n31: export function isUiInteractionFenced(state) {\n32:   return !!(state && state.ui && state.ui.fulfillmentBlackoutActive === true);\n33: }\n34: \n35: // Controller focus follows the composed screen, not incidental DOM order. A directional move ranks\n36: // only candidates that are physically in that direction, then prefers the shortest travel with a\n37: // penalty for cross-axis drift.\n38: export function spatialFocusTarget(items, active, dir) {\n39:   if (!active || !items.includes(active) || typeof active.getBoundingClientRect !== 'function') return null;\n40:   const origin = active.getBoundingClientRect();\n41:   const ox = origin.left + origin.width / 2;\n42:   const oy = origin.top + origin.height / 2;\n43:   const horizontal = dir === 'left' || dir === 'right';\n44:   const sign = dir === 'left' || dir === 'up' ? -1 : 1;\n45:   let best = null;\n46:   let bestScore = Infinity;\n47:   for (const candidate of items) {\n48:     if (candidate === active || typeof candidate.getBoundingClientRect !== 'function') continue;\n49:     const rect = candidate.getBoundingClientRect();\n50:     if (!(rect.width > 0 && rect.height > 0)) continue;\n51:     const dx = rect.left + rect.width / 2 - ox;\n52:     const dy = rect.top + rect.height / 2 - oy;\n53:     const primary = (horizontal ? dx : dy) * sign;\n54:     if (primary <= 1) continue;\n55:     const cross = Math.abs(horizontal ? dy : dx);\n56:     const overlap = horizontal\n57:       ? Math.max(0, Math.min(origin.bottom, rect.bottom) - Math.max(origin.top, rect.top))\n58:       : Math.max(0, Math.min(origin.right, rect.right) - Math.max(origin.left, rect.left));\n59:     const overlapBonus = overlap > 0 ? Math.min(42, overlap * 0.7) : 0;\n60:     const score = primary + cross * 2.35 - overlapBonus;\n61:     if (score < bestScore) { best = candidate; bestScore = score; }\n62:   }\n63:   return best;\n64: }\n65: \n66: const PAD_WIDGET_TAG = /^(BUTTON|A|INPUT|SELECT|TEXTAREA)$/;\n67: \n68: function isPadWidget(el) {\n69:   if (!el || !el.tagName) return false;\n70:   if (PAD_WIDGET_TAG.test(el.tagName)) return true;\n71:   const role = typeof el.getAttribute === 'function' ? el.getAttribute('role') : null;\n72:   return role === 'tab' || role === 'button' || role === 'menuitem' || role === 'option' || role === 'link';\n73: }\n74: \n75: function isPadFocusable(el, root) {\n76:   if (!el) return false;\n77:   if (el.disabled || el.hidden || el.inert) return false;\n78:   if (typeof el.getAttribute === 'function') {\n79:     if (el.getAttribute('aria-hidden') === 'true') return false;\n80:     if (el.getAttribute('aria-disabled') === 'true') return false;\n81:   }\n82:   const tabindex = typeof el.getAttribute === 'function' ? el.getAttribute('tabindex') : null;\n83:   // Kit words and tablists use roving tabindex: inactive siblings are tabindex=-1 so they stay\n84:   // out of Tab order. The D-pad is the arrow-key analog, so those widgets stay pad-focusable.\n85:   if (tabindex != null && Number(tabindex) < 0 && !isPadWidget(el)) return false;\n86:   let p = el;\n87:   while (p && p !== root) {\n88:     if (p.hidden || p.inert) return false;\n89:     if (p.style && p.style.display === 'none') return false;\n90:     if (typeof p.getAttribute === 'function' && p.getAttribute('aria-hidden') === 'true') return false;\n91:     p = p.parentNode;\n92:   }\n93:   return true;\n94: }\n95: \n96: /** Visible pad-reachable controls inside a screen root, including roving-tabindex widgets. */\n97: export function listGamepadFocusables(root) {\n98:   if (!root || typeof root.querySelectorAll !== 'function') return [];\n99:   return Array.from(root.querySelectorAll(\n100:     'button, [href], input, select, textarea, [role=\"tab\"], [role=\"button\"], [role=\"menuitem\"], [tabindex]:not([tabindex=\"-1\"])'\n101:   )).filter((el) => isPadFocusable(el, root));\n102: }\n103: \n104: // ---- pad-driven native value controls --------------------------------------------------------\n105: // A native slider or dropdown owns its own Left/Right. The keyboard steps it; the D-pad has to as\n106: // well, otherwise every volume, deadzone, text size, quality and language row is reachable but\n107: // unchangeable on a controller (Left/Right just hopped the highlight to another row). The value is\n108: // written and then `input` + `change` are dispatched in the order a browser dispatches them for an\n109: // arrow key, so the screen's own handlers preview and persist exactly as for a mouse drag.\n110: \n111: /** 'range' | 'select' for a native control the pad steps with Left/Right, else null. */\n112: export function padValueControlKind(el) {\n113:   if (!el || el.disabled || !el.tagName) return null;\n114:   const tag = String(el.tagName).toUpperCase();\n115:   if (tag === 'SELECT') return 'select';\n116:   if (tag === 'INPUT' && String(el.type || '').toLowerCase() === 'range') return 'range';\n117:   return null;\n118: }\n119: \n120: function decimalPlaces(n) {\n121:   if (!Number.isFinite(n)) return 0;\n122:   const [mantissa, exp] = String(n).split('e-');\n123:   const fraction = mantissa.indexOf('.') < 0 ? 0 : mantissa.length - mantissa.indexOf('.') - 1;\n124:   return fraction + (exp ? Number(exp) : 0);\n125: }\n126: \n127: function fireControlEvent(el, type) {\n128:   if (typeof el.dispatchEvent !== 'function') return;\n129:   el.dispatchEvent(typeof Event === 'function' ? new Event(type, { bubbles: true }) : { type, bubbles: true, target: el });\n130: }\n131: \n132: function stepRangeControl(el, dir) {\n133:   const min = Number.isFinite(parseFloat(el.min)) ? parseFloat(el.min) : 0;\n134:   const max = Number.isFinite(parseFloat(el.max)) ? parseFloat(el.max) : 100;\n135:   let step = parseFloat(el.step);\n136:   if (!(step > 0)) step = String(el.step).toLowerCase() === 'any' ? (max - min) / 100 : 1;\n137:   if (!(step > 0)) return false;\n138:   const parsed = parseFloat(el.value);\n139:   const from = Number.isFinite(parsed) ? parsed : min;\n140:   // Snap to the step grid anchored at min, then trim float drift (0.7 + 5 x 0.01 must read 0.75).\n141:   const slot = Math.round((from - min) / step) + (dir === 'right' ? 1 : -1);\n142:   const places = Math.max(decimalPlaces(step), decimalPlaces(min));\n143:   const next = Math.min(max, Math.max(min, Number((min + slot * step).toFixed(places))));\n144:   if (next === from) return false;\n145:   el.value = String(next);\n146:   // The browser may snap the write back to its own grid; only a value that really moved is a change.\n147:   const landed = parseFloat(el.value);\n148:   if (!Number.isFinite(landed) || landed === from) return false;\n149:   fireControlEvent(el, 'input');\n150:   fireControlEvent(el, 'change');\n151:   return true;\n152: }\n153: \n154: function stepSelectControl(el, dir) {\n155:   const options = Array.from(el.options || []);\n156:   if (options.length < 2) return false;\n157:   const delta = dir === 'right' ? 1 : -1;\n158:   let at = el.selectedIndex;\n159:   if (!Number.isInteger(at) || at < 0) at = delta > 0 ? -1 : options.length;\n160:   let to = at + delta;\n161:   while (to >= 0 && to < options.length && (options[to].disabled || options[to].hidden)) to += delta;\n162:   // Clamp, never wrap: holding the stick on a short list must not spin it past its ends.\n163:   if (to < 0 || to >= options.length) return false;\n164:   el.selectedIndex = to;\n165:   fireControlEvent(el, 'input');\n166:   fireControlEvent(el, 'change');\n167:   return true;\n168: }\n169: \n170: /**\n171:  * Step a focused native slider (by its `step`, clamped to min/max) or dropdown (previous/next\n172:  * enabled option, clamped) one notch left or right. True when the value moved; false for any other\n173:  * control, a vertical direction, or a control already at its limit.\n174:  */\n175: export function stepPadValueControl(el, dir) {\n176:   if (dir !== 'left' && dir !== 'right') return false;\n177:   const kind = padValueControlKind(el);\n178:   if (kind === 'range') return stepRangeControl(el, dir);\n179:   if (kind === 'select') return stepSelectControl(el, dir);\n180:   return false;\n181: }\n182: \n183: function sharesRow(a, b) {\n184:   if (typeof a.getBoundingClientRect !== 'function' || typeof b.getBoundingClientRect !== 'function') return false;\n185:   const ra = a.getBoundingClientRect();\n186:   const rb = b.getBoundingClientRect();\n187:   return Math.min(ra.bottom, rb.bottom) - Math.max(ra.top, rb.top) > 0;\n188: }\n189: \n190: export function createUiInput(ctx, screenManager) {\n191:   const { state, bus } = ctx;\n192:   const gp = ctx.gamepad;\n193:   let dockInRange = false;\n194:   let dockStationId = null;\n195:   const unsubscribers = [];\n196: \n197:   // Gamepad UI navigation state.\n198:   const _nav = {\n199:     up: false, down: false, left: false, right: false,\n200:     holdT: 0,\n201:     repeatT: 0,\n202:     initialDelay: 0.36,\n203:     repeatDelay: 0.12,\n204:   };\n205:   // Modal pad-verb tracker (D30): raw X/Y edges + held-for duration for screens that declare\n206:   // `onPadButton` — screen UI like the raw d-pad read, independent of the flight action map.\n207:   const _padVerb = {\n208:     x: { held: false, heldFor: 0 },\n209:     y: { held: false, heldFor: 0 },\n210:   };\n211: \n212:   // PQ-164.01: last-used device drives prompt glyphs (bindings.js owns the presentation state).\n213:   // Device order is a local observation counter fed by pad/touch activity *edges* (the shared\n214:   // input sequence stamps) and by DOM key/pointer events — a held stick does not re-stamp, so a\n215:   // keyboard act during pad flight still flips the chips, and a pad edge flips them back.\n216:   const _deviceOrder = { kbm: 0, gamepad: -1, touch: -1 };\n217:   let _deviceCounter = 0;\n218:   let _seenPadSeq = -1;\n219:   let _seenTouchSeq = -1;\n220:   let _lastPromptDevice = 'kbm';\n221:   let _seenPadBindings;\n222:   let _seenPadGlyphSet;\n223:   function noteDevice(d) {\n224:     _deviceOrder[d] = ++_deviceCounter;\n225:   }\n226:   function syncPromptDevice() {\n227:     let dev = 'kbm';\n228:     if (_deviceOrder.gamepad > _deviceOrder.kbm && _deviceOrder.gamepad >= _deviceOrder.touch) dev = 'gamepad';\n229:     else if (_deviceOrder.touch > _deviceOrder.kbm) dev = 'touch';\n230:     setPromptDevice(dev);\n231:     // The pad glyph chips read the resolved map, so a remap re-labels live prompts too.\n232:     const custom = state && state.settings && state.settings.controls\n233:       && state.settings.controls.gamepad ? state.settings.controls.gamepad.bindings : undefined;\n234:     if (custom !== _seenPadBindings) {\n235:       _seenPadBindings = custom;\n236:       setGamepadPromptBindings(resolveGamepadBindings(state && state.settings));\n237:     }\n238:     // The face-button register follows the settings address, so a glyph-set switch re-labels\n239:     // live prompt chips and pad speech the same tick.\n240:     const glyphSet = state && state.settings && state.settings.controls\n241:       && state.settings.controls.gamepad ? state.settings.controls.gamepad.glyphSet : undefined;\n242:     if (glyphSet !== _seenPadGlyphSet) {\n243:       _seenPadGlyphSet = glyphSet;\n244:       setGamepadGlyphSet(glyphSet);\n245:     }\n246:     if (dev !== _lastPromptDevice) {\n247:       _lastPromptDevice = dev;\n248:       // Repaint a live dock prompt under the new device's glyph by re-emitting the UI-owned\n249:       // dock:range fact the alert layer already listens to.\n250:       if (dockInRange && bus && bus.emit) {\n251:         bus.emit('dock:range', { stationId: dockStationId, inRange: true });\n252:       }\n253:     }\n254:   }\n255: \n256:   // physics emits dock:range while the player is near a station\n257:   unsubscribers.push(bus.on('dock:range', ({ stationId, inRange }) => {\n258:     dockInRange = !!inRange;\n259:     dockStationId = inRange ? stationId : null;\n260:     // The dock prompt is a fact the HUD reads. The rope and the dock are different pad buttons,\n261:     // so a live prompt does not take the Massline press.\n262:     if (!state.ui) state.ui = {};\n263:     state.ui.dockInRange = dockInRange;\n264:   }));\n265:   unsubscribers.push(bus.on('dock:undocked', () => { /* HUD restoration handled in uiRoot */ }));\n266: \n267:   // Emit the dock intent; uiRoot's dock:docked handler owns setting ui.docked + pushing the\n268:   // station hub (single owner of the flight→dock transition, avoids a double-push).\n269:   function doDock() {\n270:     // A live jump owns the sector transition — docking mid-charge/mid-tunnel would leave the\n271:     // ui.docked latch on while the jump machine moves the hull into the next sector.\n272:     if (isUiInteractionFenced(state) || !dockInRange || (state.ui && state.ui.docked)) return;\n273:     const jumpState = state.jump && state.jump.state;\n274:     if (jumpState === 'CHARGING' || jumpState === 'JUMPING') return;\n275:     const attempt = createDockIntent(state, { stationId: dockStationId });\n276:     // Publish the attempt before deciding so the existing faction-voiced denial surface can explain\n277:     // a refusal. The same pure selector is the command gate; a banner can never be the authority.\n278:     bus.emit('dock:attempt', attempt);\n279:     if (resolveDockDeny(state, dockStationId)) return;\n280:     if (!state.ui) state.ui = {};\n281:     state.ui.activeStationTab = state.ui.activeStationTab || 'market';\n282:     bus.emit('dock:docked', attempt);\n283:     bus.emit('audio:cue', { id: 'ui_dock' });\n284:   }\n285: \n286:   function matchesBinding(ev, binding) {\n287:     const k = ev && ev.key;\n288:     const code = ev && ev.code;\n289:     const shiftMatches = !binding || binding.shift == null || !!(ev && ev.shiftKey) ===