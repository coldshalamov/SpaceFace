pe":"file","path":"C:\\Users\\93rob\\Documents\\GitHub\\SpaceFace\\src\\ui\\input.js","text":"    syncPromptDevice();\n    handleTouchUi();\n    handleGamepadUi(dt);\n  }\n\n  return {\n    doDock, undock, tick,\n    dispose() {\n      document.removeEventListener('keydown', onBlackoutKeyDown, true);\n      for (const type of blackoutPointerEvents) {\n        document.removeEventListener(type, onBlackoutPointerEvent, true);\n      }\n      document.removeEventListener('keydown', onKeyDown);\n      window.removeEventListener('wheel', onWheel);\n      document.removeEventListener('pointerdown', clearGamepadFocus, true);\n      for (const unsubscribe of unsubscribers.splice(0)) {\n        try { unsubscribe(); } catch (_) {}\n      }\n    },\n  };\n}","lineStart":1295,"lineEnd":1315,"totalLines":1315,"truncated":false}},"title":"src\\ui\\input.js","time":{"start":1792370257541,"end":1792370257644}},"id":"prt_15197ae38001JKEdtZuXiSt6O1","sessionID":"ses_eae696a14ffehCxB980snPYjCy","messageID":"msg_151979fc2001wSi5MGd5gPk1cJ"}}
{"type":"tool_use","timestamp":1792370257688,"sessionID":"ses_eae696a14ffehCxB980snPYjCy","part":{"type":"tool","tool":"read","callID":"call_01_xvqpues44dpg21zogjo5dnh0","state":{"status":"completed","input":{"filePath":"C:\\Users\\93rob\\Documents\\GitHub\\SpaceFace\\src\\ui\\screens\\pause.js"},"output":"<path>C:\\Users\\93rob\\Documents\\GitHub\\SpaceFace\\src\\ui\\screens\\pause.js</path>\n<type>file</type>\n<content>\n1: import { createPauseFrame } from '../views/menuFrames.js';\n2: // Pause menu (ARCHITECTURE §5.4, design/specs/09). Opened by ESC in flight.\n3: // The sheet's line (design/frontend/direction/DIRECTION_SHEET.md, pause, amended by Task B §1.4):\n4: // the world held, not hidden — the frozen game at 0 % scrim; \"Paused\" at screen-title size top-left;\n5: // the flight brief as one sentence beneath it; the actions as a column of words down the left edge;\n6: // the HUD dims to 38 % rather than disappearing. Photo mode (§1.7) is a sub-state of this screen:\n7: // the pause root goes invisible under body.k-photo while the stack (and the sim pause) is unchanged.\n8: // Built on Deckplate (src/ui/deckplate/); this file owns no CSS. styles/pause.css is gone with the\n9: // 2026-09-22 migration: it existed to claw back the seam spacing that kept the EXIT keys 22px under\n10: // the pane's lower edge, and dp-frame's scrolling column is why that cannot happen any more.\n11: // ScreenManager owns aggregate pause/resume events and the time-effects request. This screen owns\n12: // only pause-mode presentation and navigation intents.\n13: \n14: import { injectDeckplate } from '../deckplate/index.js';\n15: import { confirm } from '../confirm.js';\n16: import { BINDINGS } from '../bindings.js';\n17: import { SECTORS } from '../../data/sectors.js';\n18: import { MAP_FOCUS, mapHandoffAction, openGalaxyMap } from '../mapAuthority.js';\n19: import { localizeText } from '../../localization/gameLocalization.js';\n20: import { coreText } from '../localizedCoreCopy.js';\n21: import { entitySpanHtml } from '../entityResolver.js';\n22: import { escapeHtml } from '../comms.js';\n23: import { canQuit, requestQuit } from '../quitGame.js';\n24: import { laneSetMode } from '../../core/simLaneCommands.js';\n25: import { IS_DEV } from '../../core/devMode.js';\n26: import { CREDITS } from '../../data/credits.js';\n27: import { leftoverVersionLabel, leftoverVersionDisplay, paintLeftoverVersion } from './mainMenu.js';\n28: import { el, words, settle, cue } from '../kit/index.js';\n29: import { createArcRail } from '../orrery/arcRail.js';\n30: import { isPhoneLayout } from '../../systems/mobile/model.js';\n31: import { injectOrreryScreens } from '../orrery/screenLayouts.js';\n32: import { injectPauseLayouts } from '../orrery/pauseLayouts.js';\n33: import { openReplay, forceCloseReplay, REPLAY_LABEL } from './replay.js';\n34: import { openClips, forceCloseClips, CLIPS_LABEL } from './clips.js';\n35: import { requestCodexTab } from './codex.js';\n36: import { writtenEndingArchive } from '../../story/endings/index.js';\n37: import { latestPlayerImpactFromTrace, pauseImpactCause } from '../../combat/presentationImpact.js';\n38: import {\n39:   PHOTO_EXPOSURE_DEFAULT,\n40:   PHOTO_EXPOSURE_MAX,\n41:   PHOTO_EXPOSURE_MIN,\n42:   PHOTO_FILTERS_DEFAULT,\n43:   applyPhotoPresentation,\n44:   createPhotoModeState,\n45:   cyclePhotoFilterLook,\n46:   restorePhotoPresentation,\n47:   isPhotoModeActive,\n48: } from '../../render/camera.js';\n49: \n50: const SECTOR_BY_ID = new Map(SECTORS.map((s) => [s.id, s]));\n51: /** The photo-mode hint fades after this long (Task B §1.7: two seconds). */\n52: const PHOTO_HINT_MS = 2000;\n53: export const PHOTO_LABEL = 'Photo';\n54: export const ACHIEVEMENTS_LABEL = 'Achievements';\n55: export const ENDING_ARCHIVE_LABEL = 'Ending Archive';\n56: export const PHOTO_CAPTURE_LABEL = 'Capture';\n57: export const PHOTO_STORE_KIND = 'store';\n58: /** Live store-page stills land here so PQ-159.03 captures are used for the store page. */\n59: export const STORE_PAGE_REL = 'assets/store/page';\n60: /** Canonical screenshot the store page consumes (PQ-033.03 uploads this slot). */\n61: export const STORE_PAGE_SCREENSHOT = 'spaceface-store-headed.png';\n62: \n63: export function storePagePath(filename) {\n64:   return `${STORE_PAGE_REL}/${filename || STORE_PAGE_SCREENSHOT}`;\n65: }\n66: \n67: export function storePageScreenshotPath() {\n68:   return storePagePath(STORE_PAGE_SCREENSHOT);\n69: }\n70: \n71: /** Remember a capture on the live game state so Capture always owns the store-page slot. */\n72: export function bindStorePageStill(state, rel, dataUrl) {\n73:   if (!state || !rel || !dataUrl) return false;\n74:   if (!state.render) state.render = {};\n75:   const slot = state.render.storePage || (state.render.storePage = {});\n76:   slot[rel] = dataUrl;\n77:   if (rel === storePageScreenshotPath() || String(rel).endsWith(STORE_PAGE_SCREENSHOT)) {\n78:     slot.screenshot = dataUrl;\n79:     slot.path = storePageScreenshotPath();\n80:     slot.usedFor = 'store-page';\n81:   }\n82:   return true;\n83: }\n84: \n85: function resolveStorePageWriter(host) {\n86:   const explicit = host && typeof host.writeStorePage === 'function' ? host.writeStorePage : null;\n87:   const state = host && host.state;\n88:   if (!explicit && !state) return null;\n89:   return (rel, dataUrl) => {\n90:     if (explicit) explicit(rel, dataUrl);\n91:     bindStorePageStill(state, rel, dataUrl);\n92:   };\n93: }\n94: \n95: /** Bind a photo-mode PNG onto the store page screenshot slot (and keep a dated archive). */\n96: export function publishStoreStill(capture, writer) {\n97:   if (!capture || capture.ok === false || !capture.dataUrl || typeof writer !== 'function') {\n98:     return { ok: false, reason: 'no-store-writer' };\n99:   }\n100:   const archiveName = capture.filename || photoCaptureFilename();\n101:   const archiveRel = storePagePath(archiveName);\n102:   const canonicalRel = storePageScreenshotPath();\n103:   writer(archiveRel, capture.dataUrl);\n104:   if (archiveRel !== canonicalRel) writer(canonicalRel, capture.dataUrl);\n105:   return {\n106:     ok: true,\n107:     path: canonicalRel,\n108:     archive: archiveRel,\n109:     filename: STORE_PAGE_SCREENSHOT,\n110:     usedFor: 'store-page',\n111:     slot: 'screenshot',\n112:   };\n113: }\n114: export { isPhotoModeActive, PHOTO_FILTERS_DEFAULT, PHOTO_EXPOSURE_DEFAULT };\n115: \n116: /** Find the screen manager regardless of where uiRoot exposed it. Screens navigate\n117:  *  by asking the manager to push/pop/replace; if it is not reachable we degrade to\n118:  *  emitting ui:* navigation events that uiRoot can also honour. */\n119: function getManager(ctx) {\n120:   if (ctx && ctx.screenManager) return ctx.screenManager;\n121:   if (ctx && ctx.screens && ctx.screens.pushScreen) return ctx.screens;\n122:   const ui = ctx && ctx.registry && ctx.registry.get && ctx.registry.get('ui');\n123:   if (ui && ui.screenManager) return ui.screenManager;\n124:   if (ui && ui.manager) return ui.manager;\n125:   return null;\n126: }\n127: \n128: function nav(ctx, method, arg) {\n129:   const mgr = getManager(ctx);\n130:   if (mgr && typeof mgr[method] === 'function') { mgr[method](arg); return; }\n131:   // Fallback: let uiRoot handle navigation via events.\n132:   ctx.bus.emit('ui:' + method, { id: arg });\n133: }\n134: \n135: function prettyId(id) {\n136:   return String(id || '')\n137:     .replace(/^(mission|station|sector|cmdty|ship)_/, '')\n138:     .replace(/_/g, ' ')\n139:     .replace(/\\b\\w/g, (c) => c.toUpperCase());\n140: }\n141: \n142: function missionId(m) {\n143:   return m && (m.id != null ? m.id : m.missionId);\n144: }\n145: \n146: function missionTitle(m) {\n147:   return (m && (m.title || m.name)) || prettyId(m && m.type) || 'Contract';\n148: }\n149: \n150: function fmtTime(seconds) {\n151:   const s = Math.max(0, Math.floor(Number(seconds) || 0));\n152:   const h = Math.floor(s / 3600);\n153:   const m = Math.floor((s % 3600) / 60);\n154:   if (h > 0) return h + 'h ' + m + 'm';\n155:   if (m > 0) return m + 'm';\n156:   return s + 's';\n157: }\n158: \n159: function missionProgress(m) {\n160:   const prog = Math.max(0, Number(m && m.objectiveProgress) || 0);\n161:   const tgt = Math.max(1, Number(m && m.objectiveTarget) || 1);\n162:   return Math.min(100, Math.round((prog / tgt) * 100)) + '% complete';\n163: }\n164: \n165: function deadlineText(state, mission) {\n166:   const deadline = Number(mission && mission.deadline_s);\n167:   const now = Number(state && state.simTime) || 0;\n168:   if (!Number.isFinite(deadline) || deadline <= now) return '';\n169:   return ' · ' + fmtTime(deadline - now) + ' left';\n170: }\n171: \n172: function missionDestination(m) {\n173:   return (m && (m.destName || m.destStationName || m.stationName)) ||\n174:     prettyId(m && (m.destStationId || m.destSectorId || m.dest)) || 'the objective';\n175: }\n176: \n177: function missionCommodity(m) {\n178:   const id = m && m.params && m.params.cmdtyId;\n179:   return id ? prettyId(id) : 'cargo';\n180: }\n181: \n182: function missionNextStep(m) {\n183:   const dest = missionDestination(m);\n184:   switch (m && m.type) {\n185:     case 'cargo_delivery':\n186:     case 'passenger_transport':\n187:     case 'escort':\n188:     case 'smuggling_run':\n189:     case 'salvage_retrieval':\n190:       return 'Next: follow tracked nav to ' + dest + ', then dock.';\n191:     case 'bulk_trade':\n192:       return 'Next: buy or carry ' + missionCommodity(m) + ', then sell at the destination market.';\n193:     case 'mining_quota':\n194:       return 'Next: mine ' + missionCommodity(m) + ' and keep cargo room free.';\n195:     case 'bounty_hunt':\n196:     case 'patrol_clear':\n197:       return 'Next: follow tracked nav. Expect a fight before the timer runs out.';\n198:     case 'recon_scan':\n199:       return 'Next: follow tracked nav and scan each marked site.';\n200:     default:\n201:       return 'Next: follow the tracked objective. Mission Log (' + BINDINGS.missionLog.label + ') has the details.';\n202:   }\n203: }\n204: \n205: function waypointText(wp) {\n206:   if (!wp) return '';\n207:   return wp.label || wp.reason || wp.stationName || prettyId(wp.stationId || wp.sectorId || wp.kind) || 'Nav marker set';\n208: }\n209: \n210: function sectorDisplayName(sectorId, fallback) {\n211:   if (fallback) return String(fallback);\n212:   const sector = sectorId ? SECTOR_BY_ID.get(sectorId) : null;\n213:   return (sector && sector.name) || prettyId(sectorId);\n214: }\n215: \n216: function routeCommitment(state, wp) {\n217:   const currentSectorId = state && state.world && state.world.currentSectorId || null;\n218:   const targetSectorId = wp && wp.sectorId || null;\n219:   const hasLocalFix = !!(wp && wp.pos);\n220:   const targetSectorName = targetSectorId ? sectorDisplayName(targetSectorId, wp && wp.sectorName) : '';\n221:   if (targetSectorId && !hasLocalFix && (!currentSectorId || targetSectorId !== currentSectorId)) {\n222:     return { kind: 'inter-system', objectiveLabel: 'INTER-SYSTEM ROUTE', targetSectorName };\n223:   }\n224:   if (hasLocalFix || (targetSectorId && currentSectorId && targetSectorId === currentSectorId)) {\n225:     return { kind: 'local', objectiveLabel: 'LOCAL ROUTE', targetSectorName };\n226:   }\n227:   return { kind: 'nav', objectiveLabel: 'NAV SET', targetSectorName: '' };\n228: }\n229: \n230: /** PRO-05 — Local Map copy with placeholders. en-US matches the old concatenation. */\n231: export function localMapPauseCopy(key, { place = '', inThisSystem = false } = {}) {\n232:   const label = localizeText('Local Map ({key})', { key });\n233:   const hint = inThisSystem\n234:     ? localizeText('Open Local Map ({key}) for the live marker in this system.', { key })\n235:     : localizeText('Open Local Map ({key}) for the live marker{place}; no jump route is required.', { key, place });\n236:   return { label, hint, title: 'Open Local Map' };\n237: }\n238: \n239: export function pauseMapAction(state) {\n240:   const wp = state && state.nav && state.nav.waypoint;\n241:   if (!wp) return null;\n242:   const commitment = routeCommitment(state, wp);\n243:   const currentSectorId = state && state.world && state.world.currentSectorId || null;\n244:   if (commitment.kind !== 'inter-system') {\n245:     const place = commitment.targetSectorName ? ' in ' + commitment.targetSectorName : ' in this system';\n246:     const copy = commitment.kind === 'local'\n247:       ? localMapPauseCopy(BINDINGS.localmap.label, { place })\n248:       : localMapPauseCopy(BINDINGS.localmap.label, { inThisSystem: true });\n249:     const hint = copy.hint;\n250:     // One public map surface: galaxyMap + LOCAL focus (not dual-primary localmap/starmap).\n251:     const handoff = mapHandoffAction({\n252:       focus: MAP_FOCUS.LOCAL,\n253:       label: copy.label,\n254:       title: copy.title,\n255:       body: hint,\n256:       sectorId: wp.sectorId || currentSectorId || null,\n257:       stationId: wp.stationId || null,\n258:       pos: wp.pos || null,\n259:       missionId: wp.missionId || null,\n260:       source: 'pause',\n261:     });\n262:     return {\n263:       ...handoff,\n264:       hint,\n265:       commitment: commitment.kind,\n266:       objectiveLabel: commitment.objectiveLabel,\n267:     };\n268:   }\n269:   const target = commitment.targetSectorName ? ' to ' + commitment.targetSectorName : '';\n270:   const hint = 'Open Star Map (' + BINDINGS.starmap.label + ') to review the inter-system route' + target + ' before committing a jump.';\n271:   // Inter-system review still uses the same galaxyMap surface with GALAXY focus.\n272:   const handoff = mapHandoffAction({\n273:     focus: MAP_FOCUS.GALAXY,\n274:     label: 'Star Map (' + BINDINGS.starmap.label + ')',\n275:     title: 'Open Star Map',\n276:     body: hint,\n277:     sectorId: wp.sectorId || null,\n278:     stationId: wp.stationId || null,\n279:     pos: null,\n280:     missionId: wp.missionId || null,\n281:     source: 'pause',\n282:   });\n283:   return {\n284:     ...handoff,\n285:     hint,\n286:     commitment: commitment.kind,\n287:     objectiveLabel: commitment.objectiveLabel,\n288:   };\n289: }\n290: \n291: /** Open the pause map review CTA through mapAuthority (never pushScreen localmap|starmap). */\n292: function openPauseMapReview(ctx, mapAction) {\n293:   if (!mapAction) return false;\n294:   return openGalaxyMap(ctx, {\n295:     focus: mapAction.focus,\n296:     sectorId: mapAction.sectorId,\n297:     stationId: mapAction.stationId,\n298:     pos: mapAction.pos,\n299:     missionId: mapAction.missionId,\n300:     label: mapAction.label,\n301:     source: (mapAction.source) || 'pause',\n302:   });\n303: }\n304: \n305: function routeNextText(mapAction) {\n306:   if (!mapAction) return 'resume and follow the current marker; open the map if the route gets muddy.';\n307:   if (mapAction.commitment === 'inter-system') {\n308:     return mapAction.hint + ' Resume after the destination sector looks right.';\n309:   }\n310:   if (mapAction.commitment === 'local') {\n311:     return mapAction.hint + ' Resume and fly the marker in-system.';\n312:   }\n313:   return 'resume and follow the current marker; ' + mapAction.hint;\n314: }\n315: \n316: function slotLabel(id) {\n317:   if (!id) return '';\n318:   if (id === 'quick') return 'the quick slot';\n319:   if (id === 'autosave' || id === 'auto') return 'autosave';\n320:   return 'slot ' + id;\n321: }\n322: \n323: function fmtSavedAt(value) {\n324:   if (!value) return '';\n325:   const d = new Date(value);\n326:   if (!Number.isFinite(d.getTime())) return '';\n327:   // a reading, not a machine timestamp: \"just now\", \"12 min ago\", \"3 h ago\", else \"Sep 15\"\n328:   const mins = Math.round((Date.now() - d.getTime()) / 60000);\n329:   if (mins >= 0 && mins < 1) return 'just now';\n330:   if (mins >= 1 && mins < 60) return mins + ' min ago';\n331:   if (mins >= 60 && mins < 24 * 60) return Math.round(mins / 60) + ' h ago';\n332:   return d.toLocaleDateString([], { month: 'short', day: 'numeric' });\n333: }\n334: \n335: // What the autosave setting really does, in the pause brief's voice. The old line was a fixed list\n336: // of triggers that ignored the Autosave row: a player on 120 s was told something else, and a\n337: // player on Off was never warned that quitting loses the run. Off stops only the timer\n338: // (saveSystem.update): requestAutosave never reads the setting, so docking, jumping and finishing\n339: // a contract still save, and the Off line says exactly that rather than claiming nothing saves. Missing or corrupt settings read as\n340: // the shipped default (the save loader normalizes them to it).\n341: const SHIPPED_AUTOSAVE_INTERVAL_S = 120;\n342: \n343: function autosaveIntervalOf(state) {\n344:   const gameplay = state && state.settings && state.settings.gameplay;\n345:   const value = gameplay ? Number(gameplay.autosaveIntervalS) : NaN;\n346:   return Number.isFinite(value) && value >= 0 ? value : SHIPPED_AUTOSAVE_INTERVAL_S;\n347: }\n348: \n349: export function saveLine(state) {\n350:   // A Crucible run is ephemeral by contract and saving is refused for it (PQ-133 ruling 2).\n351:   // Telling the player to press F5 here would be instructing them to attempt the one thing the\n352:   // save system now blocks.\n353:   const run = state && state.run;\n354:   if (run && run.phase !== 'inactive' && (run.kind === 'survival' || run.kind === 'lab')) {\n355:     return 'This run is not saved. Leaving the arena ends it. Your campaign save is untouched.';\n356:   }\n357:   const slot = state && state.save && state.save.currentSlot;\n358:   const savedAt = state && state.meta && state.meta.lastSavedAt;\n359:   const savedWhen = fmtSavedAt(savedAt);\n360:   if (savedWhen) {\n361:     return 'Saved ' + savedWhen + (slot ? ' to ' + slotLabel(slot) : '') + '.';\n362:   }\n363:   const everyS = autosaveIntervalOf(state);\n364:   const autosaveSentence = everyS > 0\n365:     ? 'Use Save or F5 before quitting. Autosave runs about every ' + Math.round(everyS) + ' s and when you dock, jump or finish a contract.'\n366:     : 'Timed autosave is Off. It still saves when you dock, jump or finish a contract — use Save or F5 before quitting.';\n367:   if (slot) {\n368:     return 'Loaded ' + slotLabel(slot) + '. Nothing saved this session. ' + autosaveSentence;\n369:   }\n370:   return 'Unsaved run. ' + autosaveSentence;\n371: }\n372: \n373: // The combat trace (damage.routed / physics.impulse / collision.consequence) and the hull's\n374: // scar list are the receipts that already record what hit the player. A gun's impulse row is\n375: // written after its damage row and must stay a gun — only a later receipt may replace it.\n376: const PAUSE_HIT_LINES = Object.freeze({\n377:   gun: 'A gun hit you.',\n378:   shove: 'A shove hit you.',\n379:   slam: 'A slam hit you.',\n380:   rock: 'A rock hit you.',\n381: });\n382: \n383: function causeFromScar(scar) {\n384:   if (!scar || typeof scar !== 'object') return '';\n385:   if (scar.cause === 'weapon') return 'gun';\n386:   if (scar.cause === 'slam') return scar.surface === 'terrain' ? 'rock' : 'slam';\n387:   return pauseImpactCause(scar.cause);\n388: }\n389: \n390: function newestTraceHit(state) {\n391:   const trace = state && state.combat && state.combat.trace;\n392:   const playerId = state && state.playerId;\n393:   if (!trace || playerId == null) return null;\n394:   const projected = trace.latestPlayerImpact;\n395:   if (trace.playerId === playerId && projected && typeof projected === 'object') {\n396:     const cause = pauseImpactCause(projected.cause);\n397:     if (cause && Number.isFinite(projected.tick)) {\n398:       return { tick: projected.tick, cause };\n399:     }\n400:   }\n401:   // Compatibility path for in-process state, diagnostics, and malformed or\n402:   // stale projected receipts. The authoritative full trace remains readable.\n403:   return latestPlayerImpactFromTrace(trace, playerId);\n404: }\n405: \n406: function hullScarLists(state) {\n407:   const lists = [];\n408:   const playerId = state && state.playerId;\n409:   const ent = playerId != null && state.entities && typeof state.entities.get === 'function'\n410:     ? state.entities.get(playerId)\n411:     : null;\n412:   const entScars = ent && ent.data && ent.data.livingHull && ent.data.livingHull.scars;\n413:   if (Array.isArray(entScars)) lists.push(entScars);\n414:   const player = state && state.player;\n415:   const index = player && Number.isInteger(player.activeShipIndex) ? player.activeShipIndex : 0;\n416:   const owned = player && Array.isArray(player.ownedShips) ? player.ownedShips[index] : null;\n417:   const ownedScars = owned && owned.livingHull && owned.livingHull.scars;\n418:   if (Array.isArray(ownedScars) && ownedScars !== entScars) lists.push(ownedScars);\n419:   return lists;\n420: }\n421: \n422: function newestScarHit(state) {\n423:   let best = null;\n424:   for (const list of hullScarLists(state)) {\n425:     for (let i = list.length - 1; i >= 0; i--) {\n426:       const cause = causeFromScar(list[i]);\n427:       if (!cause) continue;\n428:       const tick = Number.isFinite(list[i].tick) ? list[i].tick : 0;\n429:       if (!best || tick > best.tick) best = { tick, cause };\n430:       break;\n431:     }\n432:   }\n433:   return best;\n434: }\n435: \n436: /** One plain line for the newest thing that hit the player, or '' when nothing has. */\n437: export function pauseLastImpactLine(state) {\n438:   const traced = newestTraceHit(state);\n439:   const scarred = newestScarHit(state);\n440:   const hit = scarred && (!traced || scarred.tick > traced.tick) ? scarred : traced;\n441:   return hit ? (PAUSE_HIT_LINES[hit.cause] || '') : '';\n442: }\n443: \n444: export function pauseStatusLines(state) {\n445:   const active = (state && state.missions && Array.isArray(state.missions.active) ? state.missions.active : [])\n446:     .filter((m) => m && (!m.status || m.status === 'active'));\n447:   const trackedId = state && state.ui && state.ui.trackedMissionId;\n448:   const tracked = trackedId ? active.find((m) => missionId(m) === trackedId) : null;\n449:   if (tracked) {\n450:     return {\n451:       hit: pauseLastImpactLine(state),\n452:       objective: 'TRACKED · ' + missionTitle(tracked) + ' · ' + missionProgress(tracked) + deadlineText(state, tracked),\n453:       objectiveMention: missionId(tracked)\n454:         ? { ref: 'contract:' + missionId(tracked), label: missionTitle(tracked), pre: 'TRACKED · ', post: ' · ' + missionProgress(tracked) + deadlineText(state, tracked) }\n455:         : null,\n456:       next: missionNextStep(tracked),\n457:       save: saveLine(state),\n458:     };\n459:   }\n460:   if (active.length) {\n461:     const candidate = active[0];\n462:     return {\n463:       hit: pauseLastImpactLine(state),\n464:       objective: 'UNTRACKED CONTRACT · ' + missionTitle(candidate) + ' · ' + missionProgress(candidate) + deadlineText(state, candidate),\n465:       objectiveMention: missionId(candidate)\n466:         ? { ref: 'contract:' + missionId(candidate), label: missionTitle(candidate), pre: 'UNTRACKED CONTRACT · ', post: ' · ' + missionProgress(candidate) + deadlineText(state, candidate) }\n467:         : null,\n468:       next: 'Next: open Mission Log (' + BINDINGS.missionLog.label + ') and Track Nav on a contract.',\n469:       save: saveLine(state),\n470:     };\n471:   }\n472:   const wp = state && state.nav && state.nav.waypoint;\n473:   if (wp) {\n474:     const mapAction = pauseMapAction(state);\n475:     return {\n476:       hit: pauseLastImpactLine(state),\n477:       objective: ((mapAction && mapAction.objectiveLabel) || 'NAV SET') + ' · ' + waypointText(wp),\n478:       next: 'Next: ' + routeNextText(mapAction),\n479:       save: saveLine(state),\n480:     };\n481:   }\n482:   return {\n483:     hit: pauseLastImpactLine(state),\n484:     objective: 'NO ACTIVE CONTRACT',\n485:     next: 'Next: dock at a station, accept and track a job, then undock.',\n486:     save: saveLine(state),\n487:   };\n488: }\n489: \n490: // The exit gate carries facts, not coaching: one consequence sentence, the save fact, and the\n491: // loss line separate (`confirm`'s note). Objective and next-step guidance stay on the flight\n492: // brief behind the dialog — reading them here taught the player nothing they couldn't already see.\n493: export function pauseExitSaveFact(state) {\n494:   const run = state && state.run;\n495:   if (run && run.phase !== 'inactive' && (run.kind === 'survival' || run.kind === 'lab')) {\n496:     return 'Arena runs are never saved.';\n497:   }\n498:   const slot = state && state.save && state.save.currentSlot;\n499:   const savedWhen = fmtSavedAt(state && state.meta && state.meta.lastSavedAt);\n500:   if (savedWhen) {\n501:     return 'Saved ' + savedWhen + (slot ? ' to ' + slotLabel(slot) : '') + '.';\n502:   }\n503:   if (slot) return 'Loaded ' + slotLabel(slot) + '. Nothing saved this session.';\n504:   return 'Nothing saved this session.';\n505: }\n506: \n507: export function pauseExitConfirmNote(state) {\n508:   const run = state && state.run;\n509:   if (run && run.phase !== 'inactive' && (run.kind === 'survival' || run.kind === 'lab')) {\n510:     return 'Leaving ends the run; your campaign save is untouched.';\n511:   }\n512:   const savedWhen = fmtSavedAt(state && state.meta && state.meta.lastSavedAt);\n513:   return savedWhen ? 'Progress since then will be lost.' : 'All progress this session will be lost.';\n514: }\n515: \n516: export function pauseExitConfirmBody(state, target = 'menu') {\n517:   const opening = target === 'load'\n518:     ? 'Opening Load lets you review saves; choosing a slot replaces this session.'\n519:     : 'Returning to the main menu ends this session.';\n520:   return opening + '\\n' + pauseExitSaveFact(state);\n521: }\n522: \n523: // PRO-19 — the pause footer names the running session's seed beside the build mark so a bug\n524: // report can quote it. The session seed only: state.meta.seed, never rng internals\n525: // (state.rng continuation state / draws stay out of the DOM).\n526: export function pauseRunSeedOf(state) {\n527:   const raw = state && state.meta ? Number(state.meta.seed) : NaN;\n528:   if (!Number.isFinite(raw) || raw <= 0) return 0;\n529:   return (raw >>> 0) || 0;\n530: }\n531: \n532: export function pauseRunSeedLine(state) {\n533:   const seed = pauseRunSeedOf(state);\n534:   return seed ? 'Seed ' + seed : '';\n535: }\n536: \n537: /** Write the seed line onto its footer span. Sync: the seed is known at mount. */\n538: export function paintPauseRunSeed(target, state) {\n539:   if (!target) return '';\n540:   const line = pauseRunSeedLine(state);\n541:   const text = line ? ' · ' + line : '';\n542:   if (target.textContent !== text) target.textContent = text;\n543:   return text;\n544: }\n545: \n546: function syncPauseRunSeed(ctx) {\n547:   if (!els || !els.seedText) return;\n548:   paintPauseRunSeed(els.seedText, ctx && ctx.state);\n549: }\n550: \n551: let els = null;\n552: /** ORRERY: pause is the title's dial held mid-flight (design/frontend/ORRERY.md §6 Pause). */\n553: let pauseRail = null;\n554: \n555: // Dirty-checked brief writes: periodic refresh passes recompute the lines but only touch the DOM\n556: // when a value actually changed.\n557: const briefLast = { objective: undefined, next: undefined, save: undefined, hit: undefined };\n558: \n559: function ensurePauseHitLine() {\n560:   if (!els || els.briefHit || !els.briefObjective) return els && els.briefHit;\n561:   const parent = els.briefObjective.parentElement;\n562:   if (!parent) return null;\n563:   const node = el('p', 'dp-copy sf-muted');\n564:   node.dataset.role = 'last-hit';\n565:   node.hidden = true;\n566:   // a headless shim (the pause tests) may offer appendChild only: the line then simply joins the end\n567:   if (els.briefNext && els.briefNext.parentElement === parent && typeof parent.insertBefore === 'function') parent.insertBefore(node, els.briefNext);\n568:   else parent.appendChild(node);\n569:   els.briefHit = node;\n570:   return node;\n571: }\n572: \n573: function renderFlightBrief(ctx) {\n574:   if (!els || !els.briefObjective) return;\n575:   const lines = pauseStatusLines(ctx && ctx.state);\n576:   const hitLine = ensurePauseHitLine();\n577:   if (hitLine && lines.hit !== briefLast.hit) {\n578:     briefLast.hit = lines.hit;\n579:     hitLine.textContent = lines.hit || '';\n580:     hitLine.hidden = !lines.hit;\n581:   }\n582:   if (lines.objective !== briefLast.objective) {\n583:     briefLast.objective = lines.objective;\n584:     const mention = lines.objectiveMention;\n585:     if (mention && mention.ref) {\n586:       // ORRERY reading: the kind in engraved caps, the contract's name on its own line, and the\n587:       // progress on a small ring of ice with the time beside it. Same words, instrument form.\n588:       const kind = String(mention.pre || '').replace(/[\\s·-]+$/, '');\n589:       const pct = /(\\d+)% complete/.exec(String(mention.post || ''));\n590:       const rest = String(mention.post || '').replace(/^[\\s·-]+/, '').replace(/\\d+% complete\\s*·?\\s*/, '').trim();\n591:       const frac = pct ? Math.max(0, Math.min(1, Number(pct[1]) / 100)) : null;\n592:       const ring = frac == null ? '' : `<svg class=\"orr-brief__ring\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"9\" class=\"orr-brief__track\"/><circle cx=\"12\" cy=\"12\" r=\"9\" class=\"orr-brief__fill\" pathLength=\"1\" stroke-dasharray=\"${frac.toFixed(3)} 1\" transform=\"rotate(-90 12 12)\"/></svg>`;\n593:       els.briefObjective.innerHTML = `<span class=\"orr-brief__kind\">${escapeHtml(kind)}</span>`\n594:         + `<span class=\"orr-brief__name\">${entitySpanHtml(mention.ref, escapeHtml(mention.label))}</span>`\n595:         + `<span class=\"orr-brief__read\">${ring}${pct ? `<b>${pct[1]}%</b>` : ''}${rest ? `<span>${escapeHtml(rest)}</span>` : ''}</span>`;\n596:     } else {\n597:       els.briefObjective.textContent = lines.objective;\n598:     }\n599:   }\n600:   if (lines.next !== briefLast.next) {\n601:     briefLast.next = lines.next;\n602:     els.briefNext.textContent = lines.next;\n603:   }\n604:   if (lines.save !== briefLast.save) {\n605:     briefLast.save = lines.save;\n606:     // the quick keys are printed in the foot already; the brief keeps the save fact only\n607:     els.briefSave.textContent = String(lines.save).replace(/\\s*F5 quick-saves; F9 loads quick\\.?$/, '');\n608:   }\n609: }\n610: \n611: /* ---------- photo mode (Task B §1.7, sheet moment 12, PQ-159.03) ---------- */\n612: \n613: let photo = null;\n614: // FB-085: the pause route owns P (BINDINGS.photo) — the handler lives while this screen is top.\n615: let pausePhotoKeyHandler = null;\n616: let pauseRootEl = null;\n617: \n618: function photoHintText() {\n619:   // Esc is the modal-close key uiInput owns; inside photo it returns to this screen.\n620:   return 'Esc to return · WASD pan · wheel zoom · Capture for the store page';\n621: }\n622: \n623: /** True when the keydown is the photo binding's key (the one binding the pause route owns). */\n624: function isPhotoBindingKey(ev) {\n625:   const binding = BINDINGS.photo;\n626:   if (!binding) return false;\n627:   return ev.key === binding.key || ev.key === binding.label || ev.code === binding.code;\n628: }\n629: \n630: export function photoCaptureFilename(kind = PHOTO_STORE_KIND, now = new Date()) {\n631:   const stamp = now && typeof now.toISOString === 'function'\n632:     ? now.toISOString().replace(/[:.]/g, '-').slice(0, 19)\n633:     : 'shot';\n634:   return 'spaceface-' + (kind || PHOTO_STORE_KIND) + '-' + stamp + '.png';\n635: }\n636: \n637: export function photoModeFlags(overrides = {}) {\n638:   return {\n639:     active: true,\n640:     hideHud: true,\n641:     freeCamera: overrides.freeCamera !== false,\n642:     filters: overrides.filters === true ? true : PHOTO_FILTERS_DEFAULT,\n643:     exposure: Number.isFinite(overrides.exposure) ? overrides.exposure : PHOTO_EXPOSURE_DEFAULT,\n644:     kind: overrides.kind || PHOTO_STORE_KIND,\n645:   };\n646: }\n647: \n648: export function enterPhotoMode(state, overrides = {}) {\n649:   const flags = photoModeFlags(overrides);\n650:   const photoState = createPhotoModeState(state, flags);\n651:   applyPhotoPresentation(state, photoState);\n652:   if (state && state.bus && typeof state.bus.emit === 'function') {\n653:     state.bus.emit('settings:changed', { section: 'video', key: 'exposure', source: 'photo' });\n654:   }\n655:   return photoState;\n656: }\n657: \n658: export function exitPhotoMode(state) {\n659:   restorePhotoPresentation(state);\n660:   if (state && state.bus && typeof state.bus.emit === 'function') {\n661:     state.bus.emit('settings:changed', { section: 'video', key: 'exposure', source: 'photo-exit' });\n662:   }\n663:   return state && state.render && state.render.photoMode;\n664: }\n665: \n666: export function capturePhotoPng(source, opts = {}) {\n667:   if (!source || typeof source.toDataURL !== 'function') {\n668:     return { ok: false, reason: 'no-canvas', mime: 'image/png', filename: photoCaptureFilename(opts.kind) };\n669:   }\n670:   let dataUrl;\n671:   try {\n672:     dataUrl = source.toDataURL('image/png');\n673:   } catch {\n674:     return { ok: false, reason: 'capture-failed', mime: 'image/png', filename: photoCaptureFilename(opts.kind) };\n675:   }\n676:   if (typeof dataUrl !== 'string' || dataUrl.indexOf('data:image/png') !== 0) {\n677:     return { ok: false, reason: 'not-png', mime: 'image/png', filename: photoCaptureFilename(opts.kind) };\n678:   }\n679:   return {\n680:     ok: true,\n681:     mime: 'image/png',\n682:     dataUrl,\n683:     filename: photoCaptureFilename(opts.kind || PHOTO_STORE_KIND),\n684:     kind: opts.kind || PHOTO_STORE_KIND,\n685:   };\n686: }\n687: \n688: // Async twin of capturePhotoPng for click paths: canvas.toBlob moves the PNG readback\n689: // + encode off the calling task (toDataURL pays both synchronously), then a FileReader\n690: // makes the same data URL stampSlotCard expects. Falls back to the sync capture where\n691: // toBlob/FileReader are unavailable (non-DOM test hosts).\n692: export function capturePhotoPngAsync(source, opts = {}) {\n693:   const kind = opts.kind || PHOTO_STORE_KIND;\n694:   if (!source || typeof source.toBlob !== 'function' || typeof FileReader !== 'function') {\n695:     return Promise.resolve(capturePhotoPng(source, opts));\n696:   }\n697:   const filename = photoCaptureFilename(kind);\n698:   return new Promise((resolve) => {\n699:     let settled = false;\n700:     const done = (result) => { if (!settled) { settled = true; resolve(result); } };\n701:     try {\n702:       source.toBlob((blob) => {\n703:         if (!blob) {\n704:           done({ ok: false, reason: 'capture-failed', mime: 'image/png', filename });\n705:           return;\n706:         }\n707:         const reader = new FileReader();\n708:         reader.onload = () => {\n709:           const dataUrl = typeof reader.result === 'string' ? reader.result : null;\n710:           if (!dataUrl || dataUrl.indexOf('data:image/png') !== 0) {\n711:             done({ ok: false, reason: 'not-png', mime: 'image/png', filename });\n712:             return;\n713:           }\n714:           done({ ok: true, mime: 'image/png', dataUrl, filename, kind });\n715:         };\n716:         reader.onerror = () => done({ ok: false, reason: 'capture-failed', mime: 'image/png', filename });\n717:         try { reader.readAsDataURL(blob); }\n718:         catch { done({ ok: false, reason: 'capture-failed', mime: 'image/png', filename }); }\n719:       }, 'image/png');\n720:     } catch {\n721:       done({ ok: false, reason: 'capture-failed', mime: 'image/png', filename });\n722:     }\n723:   });\n724: }\n725: \n726: export function writePhotoCapture(capture, host = globalThis) {\n727:   if (!capture || capture.ok === false || !capture.dataUrl) {\n728:     return { ok: false, reason: (capture && capture.reason) || 'no-image' };\n729:   }\n730:   const electron = host && (host.sfDesktop || host.electronAPI || host.spaceface);\n731:   const writer = resolveStorePageWriter(host);\n732:   const store = typeof host.publishStoreStill === 'function'\n733:     ? host.publishStoreStill(capture)\n734:     : (writer ? publishStoreStill(capture, writer) : null);\n735:   if (electron && typeof electron.savePhoto === 'function') {\n736:     const result = electron.savePhoto({ filename: capture.filename, dataUrl: capture.dataUrl });\n737:     return { ok: true, via: 'electron', filename: capture.filename, result, storePage: store };\n738:   }\n739:   const doc = host && host.document;\n740:   if (doc && typeof doc.createElement === 'function') {\n741:     const a = doc.createElement('a');\n742:     a.href = capture.dataUrl;\n743:     a.download = capture.filename;\n744:     a.rel = 'noopener';\n745:     if (typeof a.click === 'function') a.click();\n746:     else if (doc.body && typeof doc.body.appendChild === 'function') {\n747:       doc.body.appendChild(a);\n748:       if (typeof a.click === 'function') a.click();\n749:       if (a.remove) a.remove();\n750:     }\n751:     return { ok: true, via: 'download', filename: capture.filename, storePage: store };\n752:   }\n753:   if (store && store.ok) return { ok: true, via: 'store-page', filename: capture.filename, storePage: store };\n754:   return { ok: false, reason: 'no-host', filename: capture.filename };\n755: }\n756: \n757: function resolvePhotoCanvas(ctx) {\n758:   const state = ctx && ctx.state;\n759:   const renderer = state && state.render && state.render.renderer;\n760:   if (renderer && renderer.domElement) return renderer.domElement;\n761:   const doc = globalThis.document;\n762:   if (doc && typeof doc.querySelector === 'function') {\n763:     return doc.querySelector('canvas');\n764:   }\n765:   return null;\n766: }\n767: \n768: function syncPhotoExposure(ctx, value) {\n769:   const state = ctx && ctx.state;\n770:   const photoState = state && state.render && state.render.photoMode;\n771:   if (!photoState || !photoState.active) return;\n772:   const next = Math.max(PHOTO_EXPOSURE_MIN, Math.min(PHOTO_EXPOSURE_MAX, Number(value)));\n773:   if (!Number.isFinite(next)) return;\n774:   photoState.exposure = next;\n775:   applyPhotoPresentation(state, photoState);\n776:   if (ctx.bus && typeof ctx.bus.emit === 'function') {\n777:     ctx.bus.emit('settings:changed', { section: 'video', key: 'exposure', source: 'photo' });\n778:   }\n779: }\n780: \n781: // FB-085 — the photo overlay owns the authored looks' SELECTION (the grades themselves live in\n782: // spaceRenderGraph.js PHOTO_FILTER_LOOKS): picking a look flips the filter flag on, and the\n783: // camera's per-frame sync hands the pair to the render graph. Exported for the focused pin.\n784: export function setPhotoLook(ctx, lookId) {\n785:   const state = ctx && ctx.state;\n786:   const photoState = state && state.render && state.render.photoMode;\n787:   if (!photoState || !photoState.active || typeof lookId !== 'string') return null;\n788:   photoState.filters = true;\n789:   photoState.filterLook = lookId;\n790:   return photoState.filterLook;\n791: }\n792: \n793: /** Advance the photo look to the next authored one (the overlay's Look control). */\n794: export function cyclePhotoLook(ctx) {\n795:   const state = ctx && ctx.state;\n796:   const photoState = state && state.render && state.render.photoMode;\n797:   if (!photoState || !photoState.active) return null;\n798:   return setPhotoLook(ctx, cyclePhotoFilterLook(photoState.filterLook));\n799: }\n800: \n801: /** FB-085 — photo FOV reads/writes the one video.fov setting the chase camera already reads. */\n802: export function syncPhotoFov(ctx, value) {\n803:   const state = ctx && ctx.state;\n804:   if (!state || !state.settings) return null;\n805:   const next = Math.max(35, Math.min(90, Math.round(Number(value))));\n806:   if (!Number.isFinite(next)) return null;\n807:   if (!state.settings.video) state.settings.video = {};\n808:   state.settings.video.fov = next;\n809:   if (ctx.bus && typeof ctx.bus.emit === 'function') {\n810:     ctx.bus.emit('settings:changed', { section: 'video', key: 'fov', source: 'photo' });\n811:   }\n812:   return next;\n813: }\n814: \n815: function runPhotoCapture(ctx) {\n816:   const capture = capturePhotoPng(resolvePhotoCanvas(ctx), { kind: PHOTO_STORE_KIND });\n817:   return writePhotoCapture(capture, {\n818:     document: globalThis.document,\n819:     sfDesktop: globalThis.sfDesktop,\n820:     electronAPI: globalThis.electronAPI,\n821:     spaceface: globalThis.spaceface,\n822:     writeStorePage: ctx && ctx.writeStorePage,\n823:     publishStoreStill: ctx && ctx.publishStoreStill,\n824:     state: ctx && ctx.state,\n825:   });\n826: }\n827: \n828: function bindPhotoKeys(photoState) {\n829:   return (ev) => {\n830:     if (!photo || !photoState) return;\n831:     const key = ev.key;\n832:     if (key === 'Escape') return; // owned by onKey\n833:     const down = ev.type === 'keydown';\n834:     const pressed = down ? 1 : 0;\n835:     if (key === 'w' || key === 'W' || key === 'ArrowUp') photoState.inputZ = down ? -pressed : (photoState.inputZ < 0 ? 0 : photoState.inputZ);\n836:     else if (key === 's' || key === 'S' || key === 'ArrowDown') photoState.inputZ = down ? pressed : (photoState.inputZ > 0 ? 0 : photoState.inputZ);\n837:     else if (key === 'a' || key === 'A' || key === 'ArrowLeft') photoState.inputX = down ? -pressed : (photoState.inputX < 0 ? 0 : photoState.inputX);\n838:     else if (key === 'd' || key === 'D' || key === 'ArrowRight') photoState.inputX = down ? pressed : (photoState.inputX > 0 ? 0 : photoState.inputX);\n839:     else if (down && (key === '+' || key === '=')) photoState.zoomInput = -1;\n840:     else if (down && (key === '-' || key === '_')) photoState.zoomInput = 1;\n841:     else if (down && (key === 'c' || key === 'C' || key === 'Enter')) {\n842:       ev.preventDefault();\n843:       runPhotoCapture(photo.ctx);\n844:     }\n845:   };\n846: }\n847: \n848: /** Enter photo mode: the pause root goes invisible, body.k-photo hides the HUD (kit.css), free\n849:  *  camera + exposure + capture for store assets. The screen stack — and so the sim pause — is\n850:  *  untouched. Filters stay off by default. */\n851: function enterPhoto(rootEl, ctx) {\n852:   if (photo) return;\n853:   const state = ctx && ctx.state;\n854:   const photoState = enterPhotoMode(state);\n855:   if (state && !state.bus && ctx.bus) state.bus = ctx.bus;\n856:   const host = rootEl.parentElement || document.body;\n857:   const hint = el('p', 'k-fine sf-photo-hint', photoHintText());\n858:   hint.setAttribute('role', 'status');\n859:   const bar = el('div', 'sf-photo-bar');\n860:   bar.setAttribute('role', 'region');\n861:   bar.setAttribute('aria-label', 'Photo mode');\n862:   const exposure = document.createElement('input');\n863:   exposure.type = 'range';\n864:   exposure.min = String(PHOTO_EXPOSURE_MIN);\n865:   exposure.max = String(PHOTO_EXPOSURE_MAX);\n866:   exposure.step = '0.05';\n867:   exposure.value = String(PHOTO_EXPOSURE_DEFAULT);\n868:   exposure.setAttribute('aria-label', 'Exposure');\n869:   exposure.addEventListener('input', () => syncPhotoExposure(ctx, exposure.value));\n870:   // FB-085: the filter flag finally does something — the Look control cycles the three authored\n871:   // grades (the grade stage itself lives on the render graph; selection lives here).\n872:   const lookBtn = el('button', 'k-word k-word--fine fh-key fh-key--small', 'Look');\n873:   lookBtn.type = 'button';\n874:   lookBtn.setAttribute('aria-label', 'Cycle photo filter look');\n875:   lookBtn.addEventListener('click', () => {\n876:     const next = cyclePhotoLook(ctx);\n877:     if (next) lookBtn.textContent = `Look · ${next}`;\n878:   });\n879:   // Photo FOV rides the one video.fov setting the chase camera already reads (settings slider\n880:   // bounds 35–90); nothing new to persist — the settings route owns it.\n881:   const fov = document.createElement('input');\n882:   fov.type = 'range';\n883:   fov.min = '35';\n884:   fov.max = '90';\n885:   fov.step = '1';\n886:   const currentFov = state && state.settings && state.settings.video && Number(state.settings.video.fov);\n887:   fov.value = String(Number.isFinite(currentFov) ? Math.round(currentFov) : 50);\n888:   fov.setAttribute('aria-label', 'Photo field of view');\n889:   fov.addEventListener('input', () => syncPhotoFov(ctx, fov.value));\n890:   const captureBtn = el('button', 'k-word k-word--fine fh-key fh-key--small', PHOTO_CAPTURE_LABEL);\n891:   captureBtn.type = 'button';\n892:   captureBtn.addEventListener('click', () => runPhotoCapture(ctx));\n893:   const exposureControl = el('label', 'sf-photo-control');\n894:   exposureControl.appendChild(el('span', 'k-t-fine', 'Exposure'));\n895:   exposureControl.appendChild(exposure);\n896:   bar.appendChild(exposureControl);\n897:   bar.appendChild(lookBtn);\n898:   const fovControl = el('label', 'sf-photo-control');\n899:   fovControl.appendChild(el('span', 'k-t-fine', 'FOV'));\n900:   fovControl.appendChild(fov);\n901:   bar.appendChild(fovControl);\n902:   bar.appendChild(captureBtn);\n903:   host.appendChild(hint);\n904:   host.appendChild(bar);\n905:   settle(hint, { from: 'bottom', state: 'photo-hint' });\n906:   const onKey = (ev) => {\n907:     if (ev.key !== 'Escape') return;\n908:     ev.preventDefault();\n909:     ev.stopImmediatePropagation();\n910:     exitPhoto(rootEl, ctx);\n911:   };\n912:   const onMove = bindPhotoKeys(photoState);\n913:   const onWheel = (ev) => {\n914:     if (!photoState) return;\n915:     photoState.zoomInput = ev.deltaY > 0 ? 1 : -1;\n916:   };\n917:   // Capture phase on window: runs ahead of uiInput's document-level handler, which would otherwise\n918:   // pop the pause screen (and unpause the sim) on the same Esc.\n919:   window.addEventListener('keydown', onKey, true);\n920:   window.addEventListener('keydown', onMove, true);\n921:   window.addEventListener('keyup', onMove, true);\n922:   window.addEventListener('wheel', onWheel, { passive: true });\n923:   const fade = setTimeout(() => { if (photo && photo.hint === hint) hint.classList.add('k-out'); }, PHOTO_HINT_MS);\n924:   document.body.classList.add('k-photo');\n925:   rootEl.style.visibility = 'hidden';\n926:   rootEl.setAttribute('aria-hidden', 'true');\n927:   photo = { hint, bar, onKey, onMove, onWheel, fade, rootEl, ctx, exposure };\n928:   cue('open');\n929: }\n930: \n931: function exitPhoto(rootEl, ctx) {\n932:   if (!photo) return;\n933:   clearTimeout(photo.fade);\n934:   window.removeEventListener('keydown', photo.onKey, true);\n935:   if (photo.onMove) {\n936:     window.removeEventListener('keydown', photo.onMove, true);\n937:     window.removeEventListener('keyup', photo.onMove, true);\n938:   }\n939:   if (photo.onWheel) window.removeEventListener('wheel', photo.onWheel);\n940:   if (photo.hint && photo.hint.parentNode) photo.hint.parentNode.removeChild(photo.hint);\n941:   if (photo.bar && photo.bar.parentNode) photo.bar.parentNode.removeChild(photo.bar);\n942:   document.body.classList.remove('k-photo');\n943:   const root = photo.rootEl || rootEl;\n944:   root.style.removeProperty('visibility');\n945:   root.removeAttribute('aria-hidden');\n946:   exitPhotoMode(ctx && ctx.state);\n947:   photo = null;\n948:   cue('close');\n949:   if (els && els.bResume) try { els.bResume.focus(); } catch (e) {}\n950:   renderFlightBrief(ctx);\n951: }\n952: \n953: export const pauseScreen = {\n954:   id: 'pause',\n955: \n956:   mount(rootEl, ctx) {\n957:     injectDeckplate();\n958:     rootEl.innerHTML = '';\n959:     rootEl.classList.remove('panel', 'sf-menu', 'sf-menu-narrow');\n960:     rootEl.classList.add('screen');\n961:     rootEl.dataset.screen = 'pause';\n962:     delete rootEl.dataset.stamp;\n963:     pauseRootEl = rootEl;\n964: \n965:     const { title, briefKicker, briefObjective, briefNext, briefSave, column } = createPauseFrame(rootEl, {\n966:       titleText: coreText('paused'),\n967:     });\n968:     // The brief's kicker is this screen's copy and comes from the same localized core copy as the\n969:     // title and every verb (check:pause-brief asserts this call).\n970:     briefKicker.textContent = coreText('flightBrief');\n971: \n972: \n973:     // .k-stage — the verbs as ONE column of words down the left edge over the held world, which is\n974:     // what the sheet's pause line specifies (\"the actions as a column of words down the left edge\")\n975:     // and what Task B §1.4 lists. The approved title frame is the grammar this screen borrows: no\n976:     // boxes, words over the world, ONE lit row plate following focus (styles/kit.css §PAUSE). Every\n977:     // verb lives in this single list: an earlier build split four \"core\" choices from a disclosure\n978:     // labelled Operations, which hid Main Menu and Quit behind a second identically-labelled\n979:     // Operations row. The list keeps the kit's native roving keyboard model either way.\n980:     const stage = el('nav', 'dp-frame__col--tight');\n981:     stage.setAttribute('aria-label', coreText('paused'));\n982:     const items = [];\n983:     const handlers = new Map();\n984:     // Deckplate (FRONTEND_PROGRAM Wave 2): verbs are grouped under etched legends and carry a kit\n985:     // glyph; the order and every label are unchanged, so one roving list still reaches them all.\n986:     const mk = (label, fn, { primary = false, danger = false, dev = false, current = false, group = null, icon = null, keycap = false, hint = null, keys = null, bank = false } = {}) => {\n987:       const action = 'pause-' + items.length;\n988:       items.push({ label, action, primary, danger, current, group, icon, keycap, hint, keys, bank });\n989:       handlers.set(action, fn);\n990:       return action;\n991:     };\n992:     // `hint` draws a keycap at the row's right edge; only keys that are live over this modal get\n993:     // one — Esc resumes (this screen's own onKey), F5/F9 quick save/load through the modal input\n994:     // branch, and the flight bindings the label already names (J, M) come through `keycap`.\n995:     const resumeAction = mk(coreText('resume'), () => this._resume(ctx), { primary: true, current: true, icon: 'chevron-right', hint: 'Esc', keys: 'Escape' });\n996:     mk(coreText('settings'), () => nav(ctx, 'pushScreen', 'settings'), { group: 'Game', bank: true, icon: 'settings' });\n997:     mk(coreText('save'), () => nav(ctx, 'pushScreen', 'saveLoad'), { group: 'Game', bank: true, icon: 'install', hint: 'F5', keys: 'F5' });\n998:     // Load discards unsaved current progress after a slot is chosen — confirm with the live run context first.\n999:     mk(coreText('load'), async () => {\n1000:       const ok = await confirm({\n1001:         title: 'Open load screen?',\n1002:         body: pauseExitConfirmBody(ctx && ctx.state, 'load'),\n1003:         note: pauseExitConfirmNote(ctx && ctx.state),\n1004:         confirmLabel: 'Open Load', danger: true,\n1005:       });\n1006:       if (ok) nav(ctx, 'pushScreen', 'saveLoad');\n1007:     }, { group: 'Game', bank: true, icon: 'remove', hint: 'F9', keys: 'F9' });\n1008:     mk(coreText('missionLog', { key: BINDINGS.missionLog.label }), () => nav(ctx, 'pushScreen', 'missionLog'), { group: 'Ship', bank: true, icon: 'missions', keycap: true });\n1009:     // THE SHIP (F2 in flight; SCREENS_B §1.2 route wiring). From pause the same instrument opens\n1010:     // with its pause-menu entry; the key case lives in the flight-only key router.\n1011:     mk('My Ship', () => nav(ctx, 'pushScreen', 'ship'), { group: 'Ship', bank: true, icon: 'shipworks' });\n1012:     // Operations = the Automation ops board (drones / traders / outposts / fleet). Reachable from\n1013:     // pause anywhere in flight — fleet orders are a flight-time action (\"recall to cash out\"), so\n1014:     // the pause route fits better than a docked-only station tab (GDD 2.0 §12 keeps automation at\n1015:     // UI-polish scope this cycle; a first-class station tab would be promotion).\n1016:     mk('Operations (Automation)', () => nav(ctx, 'pushScreen', 'automation'), { group: 'Ship', bank: true, icon: 'industry' });\n1017:     const mapAction = pauseMapAction(ctx && ctx.state);\n1018:     if (mapAction) mk(mapAction.label, () => openPauseMapReview(ctx, mapAction), { group: 'Ship', bank: true, icon: 'route', keycap: true });\n1019:     // On a phone the keyboard reference means nothing: Help opens the touch guide the deck carries instead.\n1020:     mk(coreText('helpControls'), () => { if (isPhoneLayout() && ctx.bus && ctx.bus.emit) ctx.bus.emit('touch:guide', {}); else nav(ctx, 'pushScreen', 'help'); }, { group: 'Reference', bank: true, icon: 'help' });\n1021:     mk(coreText('codex'), () => nav(ctx, 'pushScreen', 'codex'), { group: 'Reference', bank: true, icon: 'info' });\n1022:     // Achievements (PQ-033.03): the local ledger — the same screen the title's fine line opens.\n1023:     mk(ACHIEVEMENTS_LABEL, () => nav(ctx, 'pushScreen', 'achievements'), { group: 'Reference', bank: true, icon: 'ready' });\n1024:     mk('Statistics', () => nav(ctx, 'pushScreen', 'statistics'), { group: 'Reference', bank: true, icon: 'info' });\n1025:     // Photo mode (Task B §1.7 / PQ-159.03): HUD gone, free camera, exposure, capture for store\n1026:     // assets; filters off by default. Esc returns here. Do not restyle this sheet.\n1027:     mk(PHOTO_LABEL, () => enterPhoto(rootEl, ctx), { group: 'Media', bank: true, icon: 'scan' });\n1028:     // Replay (PQ-160.00): the deterministic last thirty seconds, played back with the photo-mode\n1029:     // presentation. Opens over this sheet; Esc or Exit returns to pause.\n1030:     mk(REPLAY_LABEL, () => { forceCloseClips(); openReplay(rootEl, ctx); }, { group: 'Media', bank: true, icon: 'clock' });\n1031:     // Clips (PQ-160.01): the auto-clip clip list from the moment detector. Opens over this sheet;\n1032:     // Esc or Exit returns. This screen owns presentation only, not export encoding.\n1033:     mk(CLIPS_LABEL, () => { forceCloseReplay(); openClips(rootEl, ctx); }, { group: 'Media', bank: true, icon: 'record' });\n1034:     // Ending Archive (B7): once the story owner has filed the written ending\n1035:     // (state.story.writtenFinale — the same record its ui:endingArchiveOpen handler serves), the\n1036:     // manuscript re-opens on demand. The codex deep-links to its Archive tab and the story owner\n1037:     // re-emits `endgame:archive`, so the just-opened codex refreshes to the filed ending.\n1038:     const endingArchive = writtenEndingArchive(ctx && ctx.state && ctx.state.story ? ctx.state.story.writtenFinale : null);\n1039:     // The sheet stays mounted across pause opens, so the row's gate must be re-checkable later:\n1040:     // onShow remounts once if a finale gets filed after this mount.\n1041:     this._endingArchiveAtMount = !!endingArchive;\n1042:     if (endingArchive) mk(ENDING_ARCHIVE_LABEL, () => {\n1043:       requestCodexTab('Archive');\n1044:       nav(ctx, 'pushScreen', 'codex');\n1045:       if (ctx.bus && typeof ctx.bus.emit === 'function') ctx.bus.emit('ui:endingArchiveOpen');\n1046:     }, { group: 'Media', bank: true, icon: 'ledger' });\n1047:     // DEV ONLY — Sandbox testing harness (grant weapon now, spawn enemy now, etc.). IS_DEV-gated so\n1048:     // it never appears in packaged builds. Same screen as the main-menu Sandbox button.\n1049:     mk('Physics challenges', () => nav(ctx, 'pushScreen', 'physicsVenues'), { group: 'Play', bank: true, icon: 'utility' });\n1050:     if (ctx.state?.mercyServicePublic?.bodies?.length) mk('Rescue tools', () => { nav(ctx, 'popScreen'); ctx.registry?.get('ui')?.physicalJobsPrompt?.mercy(); }, { group: 'Field work', bank: true, icon: 'utility' });\n1051:     if (ctx.state?.wreckCourtPublic?.bodies?.length) mk('Wreck Court notebook', () => { nav(ctx, 'popScreen'); ctx.registry?.get('ui')?.physicalJobsPrompt?.court(); }, { group: 'Field work', bank: true, icon: 'utility' });\n1052:     if (IS_DEV) mk('Sandbox', () => nav(ctx, 'pushScreen', 'sandbox'), { dev: true, group: 'Dev', bank: true, icon: 'utility' });\n1053:     // Main Menu discards the current session entirely — confirm with the live run context first.\n1054:     mk(coreText('mainMenu'), async () => {\n1055:       const ok = await confirm({\n1056:         title: 'Return to main menu?',\n1057:         body: pauseExitConfirmBody(ctx && ctx.state, 'menu'),\n1058:         note: pauseExitConfirmNote(ctx && ctx.state),\n1059:         confirmLabel: 'Main Menu', danger: true,\n1060:       });\n1061:       if (ok) this._toMenu(ctx);\n1062:     }, { danger: true, group: 'Exit', bank: true, icon: 'undock' });\n1063: \n1064:     // Web build: Main Menu above is the way out; Quit Game is offered only where the shell can quit.\n1065:     if (canQuit()) mk(coreText('quitGame'), async () => {\n1066:       const ok = await confirm({\n1067:         title: 'Quit game?',\n1068:         body: 'Quitting closes the game.\\n' + pauseExitSaveFact(ctx && ctx.state),\n1069:         note: pauseExitConfirmNote(ctx && ctx.state),\n1070:         confirmLabel: coreText('quitGame'), danger: true,\n1071:       });\n1072:       if (ok) requestQuit(ctx);\n1073:     }, { danger: true, group: 'Exit', bank: true, icon: 'abandon' });\n1074: \n1075:     // One list, in the sheet's order. `current` lights Resume's row while focus is outside the\n1076:     // list; the kit's roving focus then moves the same light down the column.\n1077:     const list = words(items, {\n1078:       ariaLabel: 'Pause',\n1079:       // LIGHT, like the title and motion-ask. Pause was seventeen bevelled chips in six groups --\n\n(Output capped at 50 KB. Showing lines 1-1079. Use offset=1080 to continue.)\n</content>","metadata":{"preview":"import { createPauseFrame } from '../views/menuFrames.js';\n// Pause menu (ARCHITECTURE §5.4, design/specs/09). Opened by ESC in flight.\n// The sheet's line (design/frontend/direction/DIRECTION_SHEET.md, pause, amended by Task B §1.4):\n// the world held, not hidden — the frozen game at 0 % scrim; \"Paused\" at screen-title size top-left;\n// the flight brief as one sentence beneath it; the actions as a column of words down the left edge;\n// the HUD dims to 38 % rather than disappearing. Photo mode (§1.7) is a sub-state of this screen:\n// the pause root goes invisible under body.k-photo while the stack (and the sim pause) is unchanged.\n// Built on Deckplate (src/ui/deckplate/); this file owns no CSS. styles/pause.css is gone with the\n// 2026-09-22 migration: it existed to claw back the seam spacing that kept the EXIT keys 22px under\n// the pane's lower edge, and dp-frame's scrolling column is why that cannot happen any more.\n// ScreenManager owns aggregate pause/resume events and the time-effects request. This screen owns\n// only pause-mode presentation and navigation intents.\n\nimport { injectDeckplate } from '../deckplate/index.js';\nimport { confirm } from '../confirm.js';\nimport { BINDINGS } from '../bindings.js';\nimport { SECTORS } from '../../data/sectors.js';\nimport { MAP_FOCUS, mapHandoffAction, openGalaxyMap } from '../mapAuthority.js';\nimport { localizeText } from '../../localization/gameLocalization.js';\nimport { coreText } from '../localizedCoreCopy.js';","truncated":true,"loaded":[],"display":{"type":"file","path":"C:\\Users\\93rob\\Documents\\GitHub\\SpaceFace\\src\\ui\\screens\\pause.js","text":"import { createPauseFrame } from '../views/menuFrames.js';\n// Pause menu (ARCHITECTURE §5.4, design/specs/09). Opened by ESC in flight.\n// The sheet's line (design/frontend/direction/DIRECTION_SHEET.md, pause, amended by Task B §1.4):\n// the world held, not hidden — the frozen game at 0 % scrim; \"Paused\" at screen-title size top-left;\n// the flight brief as one sentence beneath it; the actions as a column of words down the left edge;\n// the HUD dims to 38 % rather than disappearing. Photo mode (§1.7) is a sub-state of this screen:\n// the pause root goes invisible under body.k-photo while the stack (and the sim pause) is unchanged.\n// Built on Deckplate (src/ui/deckplate/); this file owns no CSS. styles/pause.css is gone with the\n// 2026-09-22 migration: it existed to claw back the seam spacing that kept the EXIT keys 22px under\n// the pane's lower edge, and dp-frame's scrolling column is why that cannot happen any more.\n// ScreenManager owns aggregate pause/resume events and the time-effects request. This screen owns\n// only pause-mode presentation and navigation intents.\n\nimport { injectDeckplate } from '../deckplate/index.js';\nimport { confirm } from '../confirm.js';\nimport { BINDINGS } from '../bindings.js';\nimport { SECTORS } from '../../data/sectors.js';\nimport { MAP_FOCUS, mapHandoffAction, openGalaxyMap } from '../mapAuthority.js';\nimport { localizeText } from '../../localization/gameLocalization.js';\nimport { coreText } from '../localizedCoreCopy.js';\nimport { entitySpanHtml } from '../entityResolver.js';\nimport { escapeHtml } from '../comms.js';\nimport { canQuit, requestQuit } from '../quitGame.js';\nimport { laneSetMode } from '../../core/simLaneCommands.js';\nimport { IS_DEV } from '../../core/devMode.js';\nimport { CREDITS } from '../../data/credits.js';\nimport { leftoverVersionLabel, leftoverVersionDisplay, paintLeftoverVersion } from './mainMenu.js';\nimport { el, words, settle, cue } from '../kit/index.js';\nimport { createArcRail } from '../orrery/arcRail.js';\nimport { isPhoneLayout } from '../../systems/mobile/model.js';\nimport { injectOrreryScreens } from '../orrery/screenLayouts.js';\nimport { injectPauseLayouts } from '../orrery/pauseLayouts.js';\nimport { openReplay, forceCloseReplay, REPLAY_LABEL } from './replay.js';\nimport { openClips, forceCloseClips, CLIPS_LABEL } from './clips.js';\nimport { requestCodexTab } from './codex.js';\nimport { writtenEndingArchive } from '../../story/endings/index.js';\nimport { latestPlayerImpactFromTrace, pauseImpactCause } from '../../combat/presentationImpact.js';\nimport {\n  PHOTO_EXPOSURE_DEFAULT,\n  PHOTO_EXPOSURE_MAX,\n  PHOTO_EXPOSURE_MIN,\n  PHOTO_FILTERS_DEFAULT,\n  applyPhotoPresentation,\n  createPhotoModeState,\n  cyclePhotoFilterLook,\n  restorePhotoPresentation,\n  isPhotoModeActive,\n} from '../../render/camera.js';\n\nconst SECTOR_BY_ID = new Map(SECTORS.map((s) => [s.id, s]));\n/** The photo-mode hint fades after this long (Task B §1.7: two seconds). */\nconst PHOTO_HINT_MS = 2000;\nexport const PHOTO_LABEL = 'Photo';\nexport const ACHIEVEMENTS_LABEL = 'Achievements';\nexport const ENDING_ARCHIVE_LABEL = 'Ending Archive';\nexport const PHOTO_CAPTURE_LABEL = 'Capture';\nexport const PHOTO_STORE_KIND = 'store';\n/** Live store-page stills land here so PQ-159.03 captures are used for the store page. */\nexport const STORE_PAGE_REL = 'assets/store/page';\n/** Canonical screenshot the store page consumes (PQ-033.03 uploads this slot). */\nexport const STORE_PAGE_SCREENSHOT = 'spaceface-store-headed.png';\n\nexport function storePagePath(filename) {\n  return `${STORE_PAGE_REL}/${filename || STORE_PAGE_SCREENSHOT}`;\n}\n\nexport function storePageScreenshotPath() {\n  return storePagePath(STORE_PAGE_SCREENSHOT);\n}\n\n/** Remember a capture on the live game state so Capture always owns the store-page slot. */\nexport function bindStorePageStill(state, rel, dataUrl) {\n  if (!state || !rel || !dataUrl) return false;\n  if (!state.render) state.render = {};\n  const slot = state.render.storePage || (state.render.storePage = {});\n  slot[rel] = dataUrl;\n  if (rel === storePageScreenshotPath() || String(rel).endsWith(STORE_PAGE_SCREENSHOT)) {\n    slot.screenshot = dataUrl;\n    slot.path = storePageScreenshotPath();\n    slot.usedFor = 'store-page';\n  }\n  return true;\n}\n\nfunction resolveStorePageWriter(host) {\n  const explicit = host && typeof host.writeStorePage === 'function' ? host.writeStorePage : null;\n  const state = host && host.state;\n  if (!explicit && !state) return null;\n  return (rel, dataUrl) => {\n    if (explicit) explicit(rel, dataUrl);\n    bindStorePageStill(state, rel, dataUrl);\n  };\n}\n\n/** Bind a photo-mode PNG onto the store page screenshot slot (and keep a dated archive). */\nexport function publishStoreStill(capture, writer) {\n  if (!capture || capture.ok === false || !capture.dataUrl || typeof writer !== 'function') {\n    return { ok: false, reason: 'no-store-writer' };\n  }\n  const archiveName = capture.filename || photoCaptureFilename();\n  const archiveRel = storePagePath(archiveName);\n  const canonicalRel = storePageScreenshotPath();\n  writer(archiveRel, capture.dataUrl);\n  if (archiveRel !== canonicalRel) writer(canonicalRel, capture.dataUrl);\n  return {\n    ok: true,\n    path: canonicalRel,\n    archive: archiveRel,\n    filename: STORE_PAGE_SCREENSHOT,\n    usedFor: 'store-page',\n    slot: 'screenshot',\n  };\n}\nexport { isPhotoModeActive, PHOTO_FILTERS_DEFAULT, PHOTO_EXPOSURE_DEFAULT };\n\n/** Find the screen manager regardless of where uiRoot exposed it. Screens navigate\n *  by asking the manager to push/pop/replace; if it is not reachable we degrade to\n *  emitting ui:* navigation events that uiRoot can also honour. */\nfunction getManager(ctx) {\n  if (ctx && ctx.screenManager) return ctx.screenManager;\n  if (ctx && ctx.screens && ctx.screens.pushScreen) return ctx.screens;\n  const ui = ctx && ctx.registry && ctx.registry.get && ctx.registry.get('ui');\n  if (ui && ui.screenManager) return ui.screenManager;\n  if (ui && ui.manager) return ui.manager;\n  return null;\n}\n\nfunction nav(ctx, method, arg) {\n  const mgr = getManager(ctx);\n  if (mgr && typeof mgr[method] === 'function') { mgr[method](arg); return; }\n  // Fallback: let uiRoot handle navigation via events.\n  ctx.bus.emit('ui:' + method, { id: arg });\n}\n\nfunction prettyId(id) {\n  return String(id || '')\n    .replace(/^(mission|station|sector|cmdty|ship)_/, '')\n    .replace(/_/g, ' ')\n    .replace(/\\b\\w/g, (c) => c.toUpperCase());\n}\n\nfunction missionId(m) {\n  return m && (m.id != null ? m.id : m.missionId);\n}\n\nfunction missionTitle(m) {\n  return (m && (m.title || m.name)) || prettyId(m && m.type) || 'Contract';\n}\n\nfunction fmtTime(seconds) {\n  const s = Math.max(0, Math.floor(Number(seconds) || 0));\n  const h = Math.floor(s / 3600);\n  const m = Math.floor((s % 3600) / 60);\n  if (h > 0) return h + 'h ' + m + 'm';\n  if (m > 0) return m + 'm';\n  return s + 's';\n}\n\nfunction missionProgress(m) {\n  const prog = Math.max(0, Number(m && m.objectiveProgress) || 0);\n  const tgt = Math.max(1, Number(m && m.objectiveTarget) || 1);\n  return Math.min(100, Math.round((prog / tgt) * 100)) + '% complete';\n}\n\nfunction deadlineText(state, mission) {\n  const deadline = Number(mission && mission.deadline_s);\n  const now = Number(state && state.simTime) || 0;\n  if (!Number.isFinite(deadline) || deadline <= now) return '';\n  return ' · ' + fmtTime(deadline - now) + ' left';\n}\n\nfunction missionDestination(m) {\n  return (m && (m.destName || m.destStationName || m.stationName)) ||\n    prettyId(m && (m.destStationId || m.destSectorId || m.dest)) || 'the objective';\n}\n\nfunction missionCommodity(m) {\n  const id = m && m.params && m.params.cmdtyId;\n  return id ? prettyId(id) : 'cargo';\n}\n\nfunction missionNextStep(m) {\n  const dest = missionDestination(m);\n  switch (m && m.type) {\n    case 'cargo_delivery':\n    case 'passenger_transport':\n    case 'escort':\n    case 'smuggling_run':\n    case 'salvage_retrieval':\n      return 'Next: follow tracked nav to ' + dest + ', then dock.';\n    case 'bulk_trade':\n      return 'Next: buy or carry ' + missionCommodity(m) + ', then sell at the destination market.';\n    case 'mining_quota':\n      return 'Next: mine ' + missionCommodity(m) + ' and keep cargo room free.';\n    case 'bounty_hunt':\n    case 'patrol_clear':\n      return 'Next: follow tracked nav. Expect a fight before the timer runs out.';\n    case 'recon_scan':\n      return 'Next: follow tracked nav and scan each marked site.';\n    default:\n      return 'Next: follow the tracked objective. Mission Log (' + BINDINGS.missionLog.label + ') has the details.';\n  }\n}\n\nfunction waypointText(wp) {\n  if (!wp) return '';\n  return wp.label || wp.reason || wp.stationName || prettyId(wp.stationId || wp.sectorId || wp.kind) || 'Nav marker set';\n}\n\nfunction sectorDisplayName(sectorId, fallback) {\n  if (fallback) return String(fallback);\n  const sector = sectorId ? SECTOR_BY_ID.get(sectorId) : null;\n  return (sector && sector.name) || prettyId(sectorId);\n}\n\nfunction routeCommitment(state, wp) {\n  const currentSectorId = state && state.world && state.world.currentSectorId || null;\n  const targetSectorId = wp && wp.sectorId || null;\n  const hasLocalFix = !!(wp && wp.pos);\n  const targetSectorName = targetSectorId ? sectorDisplayName(targetSectorId, wp && wp.sectorName) : '';\n  if (targetSectorId && !hasLocalFix && (!currentSectorId || targetSectorId !== currentSectorId)) {\n    return { kind: 'inter-system', objectiveLabel: 'INTER-SYSTEM ROUTE', targetSectorName };\n  }\n  if (hasLocalFix || (targetSectorId && currentSectorId && targetSectorId === currentSectorId)) {\n    return { kind: 'local', objectiveLabel: 'LOCAL ROUTE', targetSectorName };\n  }\n  return { kind: 'nav', objectiveLabel: 'NAV SET', targetSectorName: '' };\n}\n\n/** PRO-05 — Local Map copy with placeholders. en-US matches the old concatenation. */\nexport function localMapPauseCopy(key, { place = '', inThisSystem = false } = {}) {\n  const label = localizeText('Local Map ({key})', { key });\n  const hint = inThisSystem\n    ? localizeText('Open Local Map ({key}) for the live marker in this system.', { key })\n    : localizeText('Open Local Map ({key}) for the live marker{place}; no jump route is required.', { key, place });\n  return { label, hint, title: 'Open Local Map' };\n}\n\nexport function pauseMapAction(state) {\n  const wp = state && state.nav && state.nav.waypoint;\n  if (!wp) return null;\n  const commitment = routeCommitment(state, wp);\n  const currentSectorId = state && state.world && state.world.currentSectorId || null;\n  if (commitment.kind !== 'inter-system') {\n    const place = commitment.targetSectorName ? ' in ' + commitment.targetSectorName : ' in this system';\n    const copy = commitment.kind === 'local'\n      ? localMapPauseCopy(BINDINGS.localmap.label, { place })\n      : localMapPauseCopy(BINDINGS.localmap.label, { inThisSystem: true });\n    const hint = copy.hint;\n    // One public map surface: galaxyMap + LOCAL focus (not dual-primary localmap/starmap).\n    const handoff = mapHandoffAction({\n      focus: MAP_FOCUS.LOCAL,\n      label: copy.label,\n      title: copy.title,\n      body: hint,\n      sectorId: wp.sectorId || currentSectorId || null,\n      stationId: wp.stationId || null,\n      pos: wp.pos || null,\n      missionId: wp.missionId || null,\n      source: 'pause',\n    });\n    return {\n      ...handoff,\n      hint,\n      commitment: commitment.kind,\n      objectiveLabel: commitment.objectiveLabel,\n    };\n  }\n  const target = commitment.targetSectorName ? ' to ' + commitment.targetSectorName : '';\n  const hint = 'Open Star Map (' + BINDINGS.starmap.label + ') to review the inter-system route' + target + ' before committing a jump.';\n  // Inter-system review still uses the same galaxyMap surface with GALAXY focus.\n  const handoff = mapHandoffAction({\n    focus: MAP_FOCUS.GALAXY,\n    label: 'Star Map (' + BINDINGS.starmap.label + ')',\n    title: 'Open Star Map',\n    body: hint,\n    sectorId: wp.sectorId || null,\n    stationId: wp.stationId || null,\n    pos: null,\n    missionId: wp.missionId || null,\n    source: 'pause',\n  });\n  return {\n    ...handoff,\n    hint,\n    commitment: commitment.kind,\n    objectiveLabel: commitment.objectiveLabel,\n  };\n}\n\n/** Open the pause map review CTA through mapAuthority (never pushScreen localmap|starmap). */\nfunction openPauseMapReview(ctx, mapAction) {\n  if (!mapAction) return false;\n  return openGalaxyMap(ctx, {\n    focus: mapAction.focus,\n    sectorId: mapAction.sectorId,\n    stationId: mapAction.stationId,\n    pos: mapAction.pos,\n    missionId: mapAction.missionId,\n    label: mapAction.label,\n    source: (mapAction.source) || 'pause',\n  });\n}\n\nfunction routeNextText(mapAction) {\n  if (!mapAction) return 'resume and follow the current marker; open the map if the route gets muddy.';\n  if (mapAction.commitment === 'inter-system') {\n    return mapAction.hint + ' Resume after the destination sector looks right.';\n  }\n  if (mapAction.commitment === 'local') {\n    return mapAction.hint + ' Resume and fly the marker in-system.';\n  }\n  return 'resume and follow the current marker; ' + mapAction.hint;\n}\n\nfunction slotLabel(id) {\n  if (!id) return '';\n  if (id === 'quick') return 'the quick slot';\n  if (id === 'autosave' || id === 'auto') return 'autosave';\n  return 'slot ' + id;\n}\n\nfunction fmtSavedAt(value) {\n  if (!value) return '';\n  const d = new Date(value);\n  if (!Number.isFinite(d.getTime())) return '';\n  // a reading, not a machine timestamp: \"just now\", \"12 min ago\", \"3 h ago\", else \"Sep 15\"\n  const mins = Math.round((Date.now() - d.getTime()) / 60000);\n  if (mins >= 0 && mins < 1) return 'just now';\n  if (mins >= 1 && mins < 60) return mins + ' min ago';\n  if (mins >= 60 && mins < 24 * 60) return Math.round(mins / 60) + ' h ago';\n  return d.toLocaleDateString([], { month: 'short', day: 'numeric' });\n}\n\n// What the autosave setting really does, in the pause brief's voice. The old line was a fixed list\n// of triggers that ignored the Autosave row: a player on 120 s was told something else, and a\n// player on Off was never warned that quitting loses the run. Off stops only the timer\n// (saveSystem.update): requestAutosave never reads the setting, so docking, jumping and finishing\n// a contract still save, and the Off line says exactly that rather than claiming nothing saves. Missing or corrupt settings read as\n// the shipped default (the save loader normalizes them to it).\nconst SHIPPED_AUTOSAVE_INTERVAL_S = 120;\n\nfunction autosaveIntervalOf(state) {\n  const gameplay = state && state.settings && state.settings.gameplay;\n  const value = gameplay ? Number(gameplay.autosaveIntervalS) : NaN;\n  return Number.isFinite(value) && value >= 0 ? value : SHIPPED_AUTOSAVE_INTERVAL_S;\n}\n\nexport function saveLine(state) {\n  // A Crucible run is ephemeral by contract and saving is refused for it (PQ-133 ruling 2).\n  // Telling the player to press F5 here would be instructing them to attempt the one thing the\n  // save system now blocks.\n  const run = state && state.run;\n  if (run && run.phase !== 'inactive' && (run.kind === 'survival' || run.kind === 'lab')) {\n    return 'This run is not saved. Leaving the arena ends it. Your campaign save is untouched.';\n  }\n  const slot = state && state.save && state.save.currentSlot;\n  const savedAt = state && state.meta && state.meta.lastSavedAt;\n  const savedWhen = fmtSavedAt(savedAt);\n  if (savedWhen) {\n    return 'Saved ' + savedWhen + (slot ? ' to ' + slotLabel(slot) : '') + '.';\n  }\n  const everyS = autosaveIntervalOf(state);\n  const autosaveSentence = everyS > 0\n    ? 'Use Save or F5 before quitting. Autosave runs about every ' + Math.round(everyS) + ' s and when you dock, jump or finish a contract.'\n    : 'Timed autosave is Off. It still saves when you dock, jump or finish a contract — use Save or F5 before quitting.';\n  if (slot) {\n    return 'Loaded ' + slotLabel(slot) + '. Nothing saved this session. ' + autosaveSentence;\n  }\n  return 'Unsaved run. ' + autosaveSentence;\n}\n\n// The combat trace (damage.routed / physics.impulse / collision.consequence) and the hull's\n// scar list are the receipts that already record what hit the player. A gun's impulse row is\n// written after its damage row and must stay a gun — only a later receipt may replace it.\nconst PAUSE_HIT_LINES = Object.freeze({\n  gun: 'A gun hit you.',\n  shove: 'A shove hit you.',\n  slam: 'A slam hit you.',\n  rock: 'A rock hit you.',\n});\n\nfunction causeFromScar(scar) {\n  if (!scar || typeof scar !== 'object') return '';\n  if (scar.cause === 'weapon') return 'gun';\n  if (scar.cause === 'slam') return scar.surface === 'terrain' ? 'rock' : 'slam';\n  return pauseImpactCause(scar.cause);\n}\n\nfunction newestTraceHit(state) {\n  const trace = state && state.combat && state.combat.trace;\n  const playerId = state && state.playerId;\n  if (!trace || playerId == null) return null;\n  const projected = trace.latestPlayerImpact;\n  if (trace.playerId === playerId && projected && typeof projected === 'object') {\n    const cause = pauseImpactCause(projected.cause);\n    if (cause && Number.isFinite(projected.tick)) {\n      return { tick: projected.tick, cause };\n    }\n  }\n  // Compatibility path for in-process state, diagnostics, and malformed or\n  // stale projected receipts. The authoritative full trace remains readable.\n  return latestPlayerImpactFromTrace(trace, playerId);\n}\n\nfunction hullScarLists(state) {\n  const lists = [];\n  const playerId = state && state.playerId;\n  const ent = playerId != null && state.entities && typeof state.entities.get === 'function'\n    ? state.entities.get(playerId)\n    : null;\n  const entScars = ent && ent.data && ent.data.livingHull && ent.data.livingHull.scars;\n  if (Array.isArray(entScars)) lists.push(entScars);\n  const player = state && state.player;\n  const index = player && Number.isInteger(player.activeShipIndex) ? player.activeShipIndex : 0;\n  const owned = player && Array.isArray(player.ownedShips) ? player.ownedShips[index] : null;\n  const ownedScars = owned && owned.livingHull && owned.livingHull.scars;\n  if (Array.isArray(ownedScars) && ownedScars !== entScars) lists.push(ownedScars);\n  return lists;\n}\n\nfunction newestScarHit(state) {\n  let best = null;\n  for (const list of hullScarLists(state)) {\n    for (let i = list.length - 1; i >= 0; i--) {\n      const cause = causeFromScar(list[i]);\n      if (!cause) continue;\n      const tick = Number.isFinite(list[i].tick) ? list[i].tick : 0;\n      if (!best || tick > best.tick) best = { tick, cause };\n      break;\n    }\n  }\n  return best;\n}\n\n/** One plain line for the newest thing that hit the player, or '' when nothing has. */\nexport function pauseLastImpactLine(state) {\n  const traced = newestTraceHit(state);\n  const scarred = newestScarHit(state);\n  const hit = scarred && (!traced || scarred.tick > traced.tick) ? scarred : traced;\n  return hit ? (PAUSE_HIT_LINES[hit.cause] || '') : '';\n}\n\nexport function pauseStatusLines(state) {\n  const active = (state && state.missions && Array.isArray(state.missions.active) ? state.missions.active : [])\n    .filter((m) => m && (!m.status || m.status === 'active'));\n  const trackedId = state && state.ui && state.ui.trackedMissionId;\n  const tracked = trackedId ? active.find((m) => missionId(m) === trackedId) : null;\n  if (tracked) {\n    return {\n      hit: pauseLastImpactLine(state),\n      objective: 'TRACKED · ' + missionTitle(tracked) + ' · ' + missionProgress(tracked) + deadlineText(state, tracked),\n      objectiveMention: missionId(tracked)\n        ? { ref: 'contract:' + missionId(tracked), label: missionTitle(tracked), pre: 'TRACKED · ', post: ' · ' + missionProgress(tracked) + deadlineText(state, tracked) }\n        : null,\n      next: missionNextStep(tracked),\n      save: saveLine(state),\n    };\n  }\n  if (active.length) {\n    const candidate = active[0];\n    return {\n      hit: pauseLastImpactLine(state),\n      objective: 'UNTRACKED CONTRACT · ' + missionTitle(candidate) + ' · ' + missionProgress(candidate) + deadlineText(state, candidate),\n      objectiveMention: missionId(candidate)\n        ? { ref: 'contract:' + missionId(candidate), label: missionTitle(candidate), pre: 'UNTRACKED CONTRACT · ', post: ' · ' + missionProgress(candidate) + deadlineText(state, candidate) }\n        : null,\n      next: 'Next: open Mission Log (' + BINDINGS.missionLog.label + ') and Track Nav on a contract.',\n      save: saveLine(state),\n    };\n  }\n  const wp = state && state.nav && state.nav.waypoint;\n  if (wp) {\n    const mapAction = pauseMapAction(state);\n    return {\n      hit: pauseLastImpactLine(state),\n      objective: ((mapAction && mapAction.objectiveLabel) || 'NAV SET') + ' · ' + waypointText(wp),\n      next: 'Next: ' + routeNextText(mapAction),\n      save: saveLine(state),\n    };\n  }\n  return {\n    hit: pauseLastImpactLine(state),\n    objective: 'NO ACTIVE CONTRACT',\n    next: 'Next: dock at a station, accept and track a job, then undock.',\n    save: saveLine(state),\n  };\n}\n\n// The exit gate carries facts, not coaching: one consequence sentence, the save fact, and the\n// loss line separate (`confirm`'s note). Objective and next-step guidance stay on the flight\n// brief behind the dialog — reading them here taught the player nothing they couldn't already see.\nexport function pauseExitSaveFact(state) {\n  const run = state && state.run;\n  if (run && run.phase !== 'inactive' && (run.kind === 'survival' || run.kind === 'lab')) {\n    return 'Arena runs are never saved.';\n  }\n  const slot = state && state.save && state.save.currentSlot;\n  const savedWhen = fmtSavedAt(state && state.meta && state.meta.lastSavedAt);\n  if (savedWhen) {\n    return 'Saved ' + savedWhen + (slot ? ' to ' + slotLabel(slot) : '') + '.';\n  }\n  if (slot) return 'Loaded ' + slotLabel(slot) + '. Nothing saved this session.';\n  return 'Nothing saved this session.';\n}\n\nexport function pauseExitConfirmNote(state) {\n  const run = state && state.run;\n  if (run && run.phase !== 'inactive' && (run.kind === 'survival' || run.kind === 'lab')) {\n    return 'Leaving ends the run; your campaign save is untouched.';\n  }\n  const savedWhen = fmtSavedAt(state && state.meta && state.meta.lastSavedAt);\n  return savedWhen ? 'Progress since then will be lost.' : 'All progress this session will be lost.';\n}\n\nexport function pauseExitConfirmBody(state, target = 'menu') {\n  const opening = target === 'load'\n    ? 'Opening Load lets you review saves; choosing a slot replaces this session.'\n    : 'Returning to the main menu ends this session.';\n  return opening + '\\n' + pauseExitSaveFact(state);\n}\n\n// PRO-19 — the pause footer names the running session's seed beside the build mark so a bug\n// report can quote it. The session seed only: state.meta.seed, never rng internals\n// (state.rng continuation state / draws stay out of the DOM).\nexport function pauseRunSeedOf(state) {\n  const raw = state && state.meta ? Number(state.meta.seed) : NaN;\n  if (!Number.isFinite(raw) || raw <= 0) return 0;\n  return (raw >>> 0) || 0;\n}\n\nexport function pauseRunSeedLine(state) {\n  const seed = pauseRunSeedOf(state);\n  return seed ? 'Seed ' + seed : '';\n}\n\n/** Write the seed line onto its footer span. Sync: the seed is known at mount. */\nexport function paintPauseRunSeed(target, state) {\n  if (!target) return '';\n  const line = pauseRunSeedLine(state);\n  const text = line ? ' · ' + line : '';\n  if (target.textContent !== text) target.textContent = text;\n  return text;\n}\n\nfunction syncPauseRunSeed(ctx) {\n  if (!els || !els.seedText) return;\n  paintPauseRunSeed(els.seedText, ctx && ctx.state);\n}\n\nlet els = null;\n/** ORRERY: pause is the title's dial held mid-flight (design/frontend/ORRERY.md §6 Pause). */\nlet pauseRail = null;\n\n// Dirty-checked brief writes: periodic refresh passes recompute the lines but only touch the DOM\n// when a value actually changed.\nconst briefLast = { objective: undefined, next: undefined, save: undefined, hit: undefined };\n\nfunction ensurePauseHitLine() {\n  if (!els || els.briefHit || !els.briefObjective) return els && els.briefHit;\n  const parent = els.briefObjective.parentElement;\n  if (!parent) return null;\n  const node = el('p', 'dp-copy sf-muted');\n  node.dataset.role = 'last-hit';\n  node.hidden = true;\n  // a headless shim (the pause tests) may offer appendChild only: the line then simply joins the end\n  if (els.briefNext && els.briefNext.parentElement === parent && typeof parent.insertBefore === 'function') parent.insertBefore(node, els.briefNext);\n  else parent.appendChild(node);\n  els.briefHit = node;\n  return node;\n}\n\nfunction renderFlightBrief(ctx) {\n  if (!els || !els.briefObjective) return;\n  const lines = pauseStatusLines(ctx && ctx.state);\n  const hitLine = ensurePauseHitLine();\n  if (hitLine && lines.hit !== briefLast.hit) {\n    briefLast.hit = lines.hit;\n    hitLine.textContent = lines.hit || '';\n    hitLine.hidden = !lines.hit;\n  }\n  if (lines.objective !== briefLast.objective) {\n    briefLast.objective = lines.objective;\n    const mention = lines.objectiveMention;\n    if (mention && mention.ref) {\n      // ORRERY reading: the kind in engraved caps, the contract's name on its own line, and the\n      // progress on a small ring of ice with the time beside it. Same words, instrument form.\n      const kind = String(mention.pre || '').replace(/[\\s·-]+$/, '');\n      const pct = /(\\d+)% complete/.exec(String(mention.post || ''));\n      const rest = String(mention.post || '').replace(/^[\\s·-]+/, '').replace(/\\d+% complete\\s*·?\\s*/, '').trim();\n      const frac = pct ? Math.max(0, Math.min(1, Number(pct[1]) / 100)) : null;\n      const ring = frac == null ? '' : `<svg class=\"orr-brief__ring\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"9\" class=\"orr-brief__track\"/><circle cx=\"12\" cy=\"12\" r=\"9\" class=\"orr-brief__fill\" pathLength=\"1\" stroke-dasharray=\"${frac.toFixed(3)} 1\" transform=\"rotate(-90 12 12)\"/></svg>`;\n      els.briefObjective.innerHTML = `<span class=\"orr-brief__kind\">${escapeHtml(kind)}</span>`\n        + `<span class=\"orr-brief__name\">${entitySpanHtml(mention.ref, escapeHtml(mention.label))}</span>`\n        + `<span class=\"orr-brief__read\">${ring}${pct ? `<b>${pct[1]}%</b>` : ''}${rest ? `<span>${escapeHtml(rest)}</span>` : ''}</span>`;\n    } else {\n      els.briefObjective.textContent = lines.objective;\n    }\n  }\n  if (lines.next !== briefLast.next) {\n    briefLast.next = lines.next;\n    els.briefNext.textContent = lines.next;\n  }\n  if (lines.save !== briefLast.save) {\n    briefLast.save = lines.save;\n    // the quick keys are printed in the foot already; the brief keeps the save fact only\n    els.briefSave.textContent = String(lines.save).replace(/\\s*F5 quick-saves; F9 loads quick\\.?$/, '');\n  }\n}\n\n/* ---------- photo mode (Task B §1.7, sheet moment 12, PQ-159.03) ---------- */\n\nlet photo = null;\n// FB-085: the pause route owns P (BINDINGS.photo) — the handler lives while this screen is top.\nlet pausePhotoKeyHandler = null;\nlet pauseRootEl = null;\n\nfunction photoHintText() {\n  // Esc is the modal-close key uiInput owns; inside photo it returns to this screen.\n  return 'Esc to return · WASD pan · wheel zoom · Capture for the store page';\n}\n\n/** True when the keydown is the photo binding's key (the one binding the pause route owns). */\nfunction isPhotoBindingKey(ev) {\n  const binding = BINDINGS.photo;\n  if (!binding) return false;\n  return ev.key === binding.key || ev.key === binding.label || ev.code === binding.code;\n}\n\nexport function photoCaptureFilename(kind = PHOTO_STORE_KIND, now = new Date()) {\n  const stamp = now && typeof now.toISOString === 'function'\n    ? now.toISOString().replace(/[:.]/g, '-').slice(0, 19)\n    : 'shot';\n  return 'spaceface-' + (kind || PHOTO_STORE_KIND) + '-' + stamp + '.png';\n}\n\nexport function photoModeFlags(overrides = {}) {\n  return {\n    active: true,\n    hideHud: true,\n    freeCamera: overrides.freeCamera !== false,\n    filters: overrides.filters === true ? true : PHOTO_FILTERS_DEFAULT,\n    exposure: Number.isFinite(overrides.exposure) ? overrides.exposure : PHOTO_EXPOSURE_DEFAULT,\n    kind: overrides.kind || PHOTO_STORE_KIND,\n  };\n}\n\nexport function enterPhotoMode(state, overrides = {}) {\n  const flags = photoModeFlags(overrides);\n  const photoState = createPhotoModeState(state, flags);\n  applyPhotoPresentation(state, photoState);\n  if (state && state.bus && typeof state.bus.emit === 'function') {\n    state.bus.emit('settings:changed', { section: 'video', key: 'exposure', source: 'photo' });\n  }\n  return photoState;\n}\n\nexport function exitPhotoMode(state) {\n  restorePhotoPresentation(state);\n  if (state && state.bus && typeof state.bus.emit === 'function') {\n    state.bus.emit('settings:changed', { section: 'video', key: 'exposure', source: 'photo-exit' });\n  }\n  return state && state.render && state.render.photoMode;\n}\n\nexport function capturePhotoPng(source, opts = {}) {\n  if (!source || typeof source.toDataURL !== 'function') {\n    return { ok: false, reason: 'no-canvas', mime: 'image/png', filename: photoCaptureFilename(opts.kind) };\n  }\n  let dataUrl;\n  try {\n    dataUrl = source.toDataURL('image/png');\n  } catch {\n    return { ok: false, reason: 'capture-failed', mime: 'image/png', filename: photoCaptureFilename(opts.kind) };\n  }\n  if (typeof dataUrl !== 'string' || dataUrl.indexOf('data:image/png') !== 0) {\n    return { ok: false, reason: 'not-png', mime: 'image/png', filename: photoCaptureFilename(opts.kind) };\n  }\n  return {\n    ok: true,\n    mime: 'image/png',\n    dataUrl,\n    filename: photoCaptureFilename(opts.kind || PHOTO_STORE_KIND),\n    kind: opts.kind || PHOTO_STORE_KIND,\n  };\n}\n\n// Async twin of capturePhotoPng for click paths: canvas.toBlob moves the PNG readback\n// + encode off the calling task (toDataURL pays both synchronously), then a FileReader\n// makes the same data URL stampSlotCard expects. Falls back to the sync capture where\n// toBlob/FileReader are unavailable (non-DOM test hosts).\nexport function capturePhotoPngAsync(source, opts = {}) {\n  const kind = opts.kind || PHOTO_STORE_KIND;\n  if (!source || typeof source.toBlob !== 'function' || typeof FileReader !== 'function') {\n    return Promise.resolve(capturePhotoPng(source, opts));\n  }\n  const filename = photoCaptureFilename(kind);\n  return new Promise((resolve) => {\n    let settled = false;\n    const done = (result) => { if (!settled) { settled = true; resolve(result); } };\n    try {\n      source.toBlob((blob) => {\n        if (!blob) {\n          done({ ok: false, reason: 'capture-failed', mime: 'image/png', filename });\n          return;\n        }\n        const reader = new FileReader();\n        reader.onload = () => {\n          const dataUrl = typeof reader.result === 'string' ? reader.result : null;\n          if (!dataUrl || dataUrl.indexOf('data:image/png') !== 0) {\n            done({ ok: false, reason: 'not-png', mime: 'image/png', filename });\n            return;\n          }\n          done({ ok: true, mime: 'image/png', dataUrl, filename, kind });\n        };\n        reader.onerror = () => done({ ok: false, reason: 'capture-failed', mime: 'image/png', filename });\n        try { reader.readAsDataURL(blob); }\n        catch { done({ ok: false, reason: 'capture-failed', mime: 'image/png', filename }); }\n      }, 'image/png');\n    } catch {\n      done({ ok: false, reason: 'capture-failed', mime: 'image/png', filename });\n    }\n  });\n}\n\nexport function writePhotoCapture(capture, host = globalThis) {\n  if (!capture || capture.ok === false || !capture.dataUrl) {\n    return { ok: false, reason: (capture && capture.reason) || 'no-image' };\n  }\n  const electron = host && (host.sfDesktop || host.electronAPI || host.spaceface);\n  const writer = resolveStorePageWriter(host);\n  const store = typeof host.publishStoreStill === 'function'\n    ? host.publishStoreStill(capture)\n    : (writer ? publishStoreStill(capture, writer) : null);\n  if (electron && typeof electron.savePhoto === 'function') {\n    const result = electron.savePhoto({ filename: capture.filename, dataUrl: capture.dataUrl });\n    return { ok: true, via: 'electron', filename: capture.filename, result, storePage: store };\n  }\n  const doc = host && host.document;\n  if (doc && typeof doc.createElement === 'function') {\n    const a = doc.createElement('a');\n    a.href = capture.dataUrl;\n    a.download = capture.filename;\n    a.rel = 'noopener';\n    if (typeof a.click === 'function') a.click();\n    else if (doc.body && typeof doc.body.appendChild === 'function') {\n      doc.body.appendChild(a);\n      if (typeof a.click === 'function') a.click();\n      if (a.remove) a.remove();\n    }\n    return { ok: true, via: 'download', filename: capture.filename, storePage: store };\n  }\n  if (store && store.ok) return { ok: true, via: 'store-page', filename: capture.filename, storePage: store };\n  return { ok: false, reason: 'no-host', filename: capture.filename };\n}\n\nfunction resolvePhotoCanvas(ctx) {\n  const state = ctx && ctx.state;\n  const renderer = state && state.render && state.render.renderer;\n  if (renderer && renderer.domElement) return renderer.domElement;\n  const doc = globalThis.document;\n  if (doc && typeof doc.querySelector === 'function') {\n    return doc.querySelector('canvas');\n  }\n  return null;\n}\n\nfunction syncPhotoExposure(ctx, value) {\n  const state = ctx && ctx.state;\n  const photoState = state && state.render && state.render.photoMode;\n  if (!photoState || !photoState.active) return;\n  const next = Math.max(PHOTO_EXPOSURE_MIN, Math.min(PHOTO_EXPOSURE_MAX, Number(value)));\n  if (!Number.isFinite(next)) return;\n  photoState.exposure = next;\n  applyPhotoPresentation(state, photoState);\n  if (ctx.bus && typeof ctx.bus.emit === 'function') {\n    ctx.bus.emit('settings:changed', { section: 'video', key: 'exposure', source: 'photo' });\n  }\n}\n\n// FB-085 — the photo overlay owns the authored looks' SELECTION (the grades themselves live in\n// spaceRenderGraph.js PHOTO_FILTER_LOOKS): picking a look flips the filter flag on, and the\n// camera's per-frame sync hands the pair to the render graph. Exported for the focused pin.\nexport function setPhotoLook(ctx, lookId) {\n  const state = ctx && ctx.state;\n  const photoState = state && state.render && state.render.photoMode;\n  if (!photoState || !photoState.active || typeof lookId !== 'string') return null;\n  photoState.filters = true;\n  photoState.filterLook = lookId;\n  return photoState.filterLook;\n}\n\n/** Advance the photo look to the next authored one (the overlay's Look control). */\nexport function cyclePhotoLook(ctx) {\n  const state = ctx && ctx.state;\n  const photoState = state && state.render && state.render.photoMode;\n  if (!photoState || !photoState.active) return null;\n  return setPhotoLook(ctx, cyclePhotoFilterLook(photoState.filterLook));\n}\n\n/** FB-085 — photo FOV reads/writes the one video.fov setting the chase camera already reads. */\nexport function syncPhotoFov(ctx, value) {\n  const state = ctx && ctx.state;\n  if (!state || !state.settings) return null;\n  const next = Math.max(35, Math.min(90, Math.round(Number(value))));\n  if (!Number.isFinite(next)) return null;\n  if (!state.settings.video) state.settings.video = {};\n  state.settings.video.fov = next;\n  if (ctx.bus && typeof ctx.bus.emit === 'function') {\n    ctx.bus.emit('settings:changed', { section: 'video', key: 'fov', source: 'photo' });\n  }\n  return next;\n}\n\nfunction runPhotoCapture(ctx) {\n  const capture = capturePhotoPng(resolvePhotoCanvas(ctx), { kind: PHOTO_STORE_KIND });\n  return writePhotoCapture(capture, {\n    document: globalThis.document,\n    sfDesktop: globalThis.sfDesktop,\n    electronAPI: globalThis.electronAPI,\n    spaceface: globalThis.spaceface,\n    writeStorePage: ctx && ctx.writeStorePage,\n    publishStoreStill: ctx && ctx.publishStoreStill,\n    state: ctx && ctx.state,\n  });\n}\n\nfunction bindPhotoKeys(photoState) {\n  return (ev) => {\n    if (!photo || !photoState) return;\n    const key = ev.key;\n    if (key === 'Escape') return; // owned by onKey\n    const down = ev.type === 'keydown';\n    const pressed = down ? 1 : 0;\n    if (key === 'w' || key === 'W' || key === 'ArrowUp') photoState.inputZ = down ? -pressed : (photoState.inputZ < 0 ? 0 : photoState.inputZ);\n    else if (key === 's' || key === 'S' || key === 'ArrowDown') photoState.inputZ = down ? pressed : (photoState.inputZ > 0 ? 0 : photoState.inputZ);\n    else if (key === 'a' || key === 'A' || key === 'ArrowLeft') photoState.inputX = down ? -pressed : (photoState.inputX < 0 ? 0 : photoState.inputX);\n    else if (key === 'd' || key === 'D' || key === 'ArrowRight') photoState.inputX = down ? pressed : (photoState.inputX > 0 ? 0 : photoState.inputX);\n    else if (down && (key === '+' || key === '=')) photoState.zoomInput = -1;\n    else if (down && (key === '-' || key === '_')) photoState.zoomInput = 1;\n    else if (down && (key === 'c' || key === 'C' || key === 'Enter')) {\n      ev.preventDefault();\n      runPhotoCapture(photo.ctx);\n    }\n  };\n}\n\n/** Enter photo mode: the pause root goes invisible, body.k-photo hides the HUD (kit.css), free\n *  camera + exposure + capture for store assets. The screen stack — and so the sim pause — is\n *  untouched. Filters stay off by default. */\nfunction enterPhoto(rootEl, ctx) {\n  if (photo) return;\n  const state = ctx && ctx.state;\n  const photoState = enterPhotoMode(state);\n  if (state && !state.bus && ctx.bus) state.bus = ctx.bus;\n  const host = rootEl.parentElement || document.body;\n  const hint = el('p', 'k-fine sf-photo-hint', photoHintText());\n  hint.setAttribute('role', 'status');\n  const bar = el('div', 'sf-photo-bar');\n  bar.setAttribute('role', 'region');\n  bar.setAttribute('aria-label', 'Photo mode');\n  const exposure = document.createElement('input');\n  exposure.type = 'range';\n  exposure.min = String(PHOTO_EXPOSURE_MIN);\n  exposure.max = String(PHOTO_EXPOSURE_MAX);\n  exposure.step = '0.05';\n  exposure.value = String(PHOTO_EXPOSURE_DEFAULT);\n  exposure.setAttribute('aria-label', 'Exposure');\n  exposure.addEventListener('input', () => syncPhotoExposure(ctx, exposure.value));\n  // FB-085: the filter flag finally does something — the Look control cycles the three authored\n  // grades (the grade stage itself lives on the render graph; selection lives here).\n  const lookBtn = el('button', 'k-word k-word--fine fh-key fh-key--small', 'Look');\n  lookBtn.type = 'button';\n  lookBtn.setAttribute('aria-label', 'Cycle photo filter look');\n  lookBtn.addEventListener('click', () => {\n    const next = cyclePhotoLook(ctx);\n    if (next) lookBtn.textContent = `Look · ${next}`;\n  });\n  // Photo FOV rides the one video.fov setting the chase camera already reads (settings slider\n  // bounds 35–90); nothing new to persist — the settings route owns it.\n  const fov = document.createElement('input');\n  fov.type = 'range';\n  fov.min = '35';\n  fov.max = '90';\n  fov.step = '1';\n  const currentFov = state && state.settings && state.settings.video && Number(state.settings.video.fov);\n  fov.value = String(Number.isFinite(currentFov) ? Math.round(currentFov) : 50);\n  fov.setAttribute('aria-label', 'Photo field of view');\n  fov.addEventListener('input', () => syncPhotoFov(ctx, fov.value));\n  const captureBtn = el('button', 'k-word k-word--fine fh-key fh-key--small', PHOTO_CAPTURE_LABEL);\n  captureBtn.type = 'button';\n  captureBtn.addEventListener('click', () => runPhotoCapture(ctx));\n  const exposureControl = el('label', 'sf-photo-control');\n  exposureControl.appendChild(el('span', 'k-t-fine', 'Exposure'));\n  exposureControl.appendChild(exposure);\n  bar.appendChild(exposureControl);\n  bar.appendChild(lookBtn);\n  const fovControl = el('label', 'sf-photo-control');\n  fovControl.appendChild(el('span', 'k-t-fine', 'FOV'));\n  fovControl.appendChild(fov);\n  bar.appendChild(fovControl);\n  bar.appendChild(captureBtn);\n  host.appendChild(hint);\n  host.appendChild(bar);\n  settle(hint, { from: 'bottom', state: 'photo-hint' });\n  const onKey = (ev) => {\n    if (ev.key !== 'Escape') return;\n    ev.preventDefault();\n    ev.stopImmediatePropagation();\n    exitPhoto(rootEl, ctx);\n  };\n  const onMove = bindPhotoKeys(photoState);\n  const onWheel = (ev) => {\n    if (!photoState) return;\n    photoState.zoomInput = ev.deltaY > 0 ? 1 : -1;\n  };\n  // Capture phase on window: runs ahead of uiInput's document-level handler, which would otherwise\n  // pop the pause screen (and unpause the sim) on the same Esc.\n  window.addEventListener('keydown', onKey, true);\n  window.addEventListener('keydown', onMove, true);\n  window.addEventListener('keyup', onMove, true);\n  window.addEventListener('wheel', onWheel, { passive: true });\n  const fade = setTimeout(() => { if (photo && photo.hint === hint) hint.classList.add('k-out'); }, PHOTO_HINT_MS);\n  document.body.classList.add('k-photo');\n  rootEl.style.visibility = 'hidden';\n  rootEl.setAttribute('aria-hidden', 'true');\n  photo = { hint, bar, onKey, onMove, onWheel, fade, rootEl, ctx, exposure };\n  cue('open');\n}\n\nfunction exitPhoto(rootEl, ctx) {\n  if (!photo) return;\n  clearTimeout(photo.fade);\n  window.removeEventListener('keydown', photo.onKey, true);\n  if (photo.onMove) {\n    window.removeEventListener('keydown', photo.onMove, true);\n    window.removeEventListener('keyup', photo.onMove, true);\n  }\n  if (photo.onWheel) window.removeEventListener('wheel', photo.onWheel);\n  if (photo.hint && photo.hint.parentNode) photo.hint.parentNode.removeChild(photo.hint);\n  if (photo.bar && photo.bar.parentNode) photo.bar.parentNode.removeChild(photo.bar);\n  document.body.classList.remove('k-photo');\n  const root = photo.rootEl || rootEl;\n  root.style.removeProperty('visibility');\n  root.removeAttribute('aria-hidden');\n  exitPhotoMode(ctx && ctx.state);\n  photo = null;\n  cue('close');\n  if (els && els.bResume) try { els.bResume.focus(); } catch (e) {}\n  renderFlightBrief(ctx);\n}\n\nexport const pauseScreen = {\n  id: 'pause',\n\n  mount(rootEl, ctx) {\n    injectDeckplate();\n    rootEl.innerHTML = '';\n    rootEl.classList.remove('panel', 'sf-menu', 'sf-menu-narrow');\n    rootEl.classList.add('screen');\n    rootEl.dataset.screen = 'pause';\n    delete rootEl.dataset.stamp;\n    pauseRootEl = rootEl;\n\n    const { title, briefKicker, briefObjective, briefNext, briefSave, column } = createPauseFrame(rootEl, {\n      titleText: coreText('paused'),\n    });\n    // The brief's kicker is this screen's copy and comes from the same localized core copy as the\n    // title and every verb (check:pause-brief asserts this call).\n    briefKicker.textContent = coreText('flightBrief');\n\n\n    // .k-stage — the verbs as ONE column of words down the left edge over the held world, which is\n    // what the sheet's pause line specifies (\"the actions as a column of words down the left edge\")\n    // and what Task B §1.4 lists. The approved title frame is the grammar this screen borrows: no\n    // boxes, words over the world, ONE lit row plate following focus (styles/kit.css §PAUSE). Every\n    // verb lives in this single list: an earlier build split four \"core\" choices from a disclosure\n    // labelled Operations, which hid Main Menu and Quit behind a second identically-labelled\n    // Operations row. The list keeps the kit's native roving keyboard model either way.\n    const stage = el('nav', 'dp-frame__col--tight');\n    stage.setAttribute('aria-label', coreText('paused'));\n    const items = [];\n    const handlers = new Map();\n    // Deckplate (FRONTEND_PROGRAM Wave 2): verbs are grouped under etched legends and carry a kit\n    // glyph; the order and every label are unchanged, so one roving list still reaches them all.\n    const mk = (label, fn, { primary = false, danger = false, dev = false, current = false, group = null, icon = null, keycap = false, hint = null, keys = null, bank = false } = {}) => {\n      const action = 'pause-' + items.length;\n      items.push({ label, action, primary, danger, current, group, icon, keycap, hint, keys, bank });\n      handlers.set(action, fn);\n      return action;\n    };\n    // `hint` draws a keycap at the row's right edge; only keys that are live over this modal get\n    // one — Esc resumes (this screen's own onKey), F5/F9 quick save/load through the modal input\n    // branch, and the flight bindings the label already names (J, M) come through `keycap`.\n    const resumeAction = mk(coreText('resume'), () => this._resume(ctx), { primary: true, current: true, icon: 'chevron-right', hint: 'Esc', keys: 'Escape' });\n    mk(coreText('settings'), () => nav(ctx, 'pushScreen', 'settings'), { group: 'Game', bank: true, icon: 'settings' });\n    mk(coreText('save'), () => nav(ctx, 'pushScreen', 'saveLoad'), { group: 'Game', bank: true, icon: 'install', hint: 'F5', keys: 'F5' });\n    // Load discards unsaved current progress after a slot is chosen — confirm with the live run context first.\n    mk(coreText('load'), async () => {\n      const ok = await confirm({\n        title: 'Open load screen?',\n        body: pauseExitConfirmBody(ctx && ctx.state, 'load'),\n        note: pauseExitConfirmNote(ctx && ctx.state),\n        confirmLabel: 'Open Load', danger: true,\n      });\n      if (ok) nav(ctx, 'pushScreen', 'saveLoad');\n    }, { group: 'Game', bank: true, icon: 'remove', hint: 'F9', keys: 'F9' });\n    mk(coreText('missionLog', { key: BINDINGS.missionLog.label }), () => nav(ctx, 'pushScreen', 'missionLog'), { group: 'Ship', bank: true, icon: 'missions', keycap: true });\n    // THE SHIP (F2 in flight; SCREENS_B §1.2 route wiring). From pause the same instrument opens\n    // with its pause-menu entry; the key case lives in the flight-only key router.\n    mk('My Ship', () => nav(ctx, 'pushScreen', 'ship'), { group: 'Ship', bank: true, icon: 'shipworks' });\n    // Operations = the Automation ops board (drones / traders / outposts / fleet). Reachable from\n    // pause anywhere in flight — fleet orders are a flight-time action (\"recall to cash out\"), so\n    // the pause route fits better than a docked-only station tab (GDD 2.0 §12 keeps automation at\n    // UI-polish scope this cycle; a first-class station tab would be promotion).\n    mk('Operations (Automation)', () => nav(ctx, 'pushScreen', 'automation'), { group: 'Ship', bank: true, icon: 'industry' });\n    const mapAction = pauseMapAction(ctx && ctx.state);\n    if (mapAction) mk(mapAction.label, () => openPauseMapReview(ctx, mapAction), { group: 'Ship', bank: true, icon: 'route', keycap: true });\n    // On a phone the keyboard reference means nothing: Help opens the touch guide the deck carries instead.\n    mk(coreText('helpControls'), () => { if (isPhoneLayout() && ctx.bus && ctx.bus.emit) ctx.bus.emit('touch:guide', {}); else nav(ctx, 'pushScreen', 'help'); }, { group: 'Reference', bank: true, icon: 'help' });\n    mk(coreText('codex'), () => nav(ctx, 'pushScreen', 'codex'), { group: 'Reference', bank: true, icon: 'info' });\n    // Achievements (PQ-033.03): the local ledger — the same screen the title's fine line opens.\n    mk(ACHIEVEMENTS_LABEL, () => nav(ctx, 'pushScreen', 'achievements'), { group: 'Reference', bank: true, icon: 'ready' });\n    mk('Statistics', () => nav(ctx, 'pushScreen', 'statistics'), { group: 'Reference', bank: true, icon: 'info' });\n    // Photo mode (Task B §1.7 / PQ-159.03): HUD gone, free camera, exposure, capture for store\n    // assets; filters off by default. Esc returns here. Do not restyle this sheet.\n    mk(PHOTO_LABEL, () => enterPhoto(rootEl, ctx), { group: 'Media', bank: true, icon: 'scan' });\n    // Replay (PQ-160.00): the deterministic last thirty seconds, played back with the photo-mode\n    // presentation. Opens over this sheet; Esc or Exit returns to pause.\n    mk(REPLAY_LABEL, () => { forceCloseClips(); openReplay(rootEl, ctx); }, { group: 'Media', bank: true, icon: 'clock' });\n    // Clips (PQ-160.01): the auto-clip clip list from the moment detector. Opens over this sheet;\n    // Esc or Exit returns. This screen owns presentation only, not export encoding.\n    mk(CLIPS_LABEL, () => { forceCloseReplay(); openClips(rootEl, ctx); }, { group: 'Media', bank: true, icon: 'record' });\n    // Ending Archive (B7): once the story owner has filed the written ending\n    // (state.story.writtenFinale — the same record its ui:endingArchiveOpen handler serves), the\n    // manuscript re-opens on demand. The codex deep-links to its Archive tab and the story owner\n    // re-emits `endgame:archive`, so the just-opened codex refreshes to the filed ending.\n    const endingArchive = writtenEndingArchive(ctx && ctx.state && ctx.state.story ? ctx.state.story.writtenFinale : null);\n    // The sheet stays mounted across pause opens, so the row's gate must be re-checkable later:\n    // onShow remounts once if a finale gets filed after this mount.\n    this._endingArchiveAtMount = !!endingArchive;\n    if (endingArchive) mk(ENDING_ARCHIVE_LABEL, () => {\n      requestCodexTab('Archive');\n      nav(ctx, 'pushScreen', 'codex');\n      if (ctx.bus && typeof ctx.bus.emit === 'function') ctx.bus.emit('ui:endingArchiveOpen');\n    }, { group: 'Media', bank: true, icon: 'ledger' });\n    // DEV ONLY — Sandbox testing harness (grant weapon now, spawn enemy now, etc.). IS_DEV-gated so\n    // it never appears in packaged builds. Same screen as the main-menu Sandbox button.\n    mk('Physics challenges', () => nav(ctx, 'pushScreen', 'physicsVenues'), { group: 'Play', bank: true, icon: 'utility' });\n    if (ctx.state?.mercyServicePublic?.bodies?.length) mk('Rescue tools', () => { nav(ctx, 'popScreen'); ctx.registry?.get('ui')?.physicalJobsPrompt?.mercy(); }, { group: 'Field work', bank: true, icon: 'utility' });\n    if (ctx.state?.wreckCourtPublic?.bodies?.length) mk('Wreck Court notebook', () => { nav(ctx, 'popScreen'); ctx.registry?.get('ui')?.physicalJobsPrompt?.court(); }, { group: 'Field work', bank: true, icon: 'utility' });\n    if (IS_DEV) mk('Sandbox', () => nav(ctx, 'pushScreen', 'sandbox'), { dev: true, group: 'Dev', bank: true, icon: 'utility' });\n    // Main Menu discards the current session entirely — confirm with the live run context first.\n    mk(coreText('mainMenu'), async () => {\n      const ok = await confirm({\n        title: 'Return to main menu?',\n        body: pauseExitConfirmBody(ctx && ctx.state, 'menu'),\n        note: pauseExitConfirmNote(ctx && ctx.state),\n        confirmLabel: 'Main Menu', danger: true,\n      });\n      if (ok) this._toMenu(ctx);\n    }, { danger: true, group: 'Exit', bank: true, icon: 'undock' });\n\n    // Web build: Main Menu above is the way out; Quit Game is offered only where the shell can quit.\n    if (canQuit()) mk(coreText('quitGame'), async () => {\n      const ok = await confirm({\n        title: 'Quit game?',\n        body: 'Quitting closes the game.\\n' + pauseExitSaveFact(ctx && ctx.state),\n        note: pauseExitConfirmNote(ctx && ctx.state),\n        confirmLabel: coreText('quitGame'), danger: true,\n      });\n      if (ok) requestQuit(ctx);\n    }, { danger: true, group: 'Exit', bank: true, icon: 'abandon' });\n\n    // One list, in the sheet's order. `current` lights Resume's row while focus is outside the\n    // list; the kit's roving focus then moves the same light down the column.\n    const list = words(items, {\n      ariaLabel: 'Pause',\n      // LIGHT, like the title and motion-ask. Pause was seventeen bevelled chips in six groups --","lineStart":1,"lineEnd":1079,"totalLines":1080,"truncated":true}},"title":"src\\ui\\screens\\pause.js","time":{"start":1792370257595,"end":1792370257672}},"id":"prt_15197ae89001JI125t8zh7qAjK","sessionID":"ses_eae696a14ffehCxB980snPYjCy","messageID":"msg_151979fc2001wSi5MGd5gPk1cJ"}}
