{"type":"tool_use","timestamp":1792370502433,"sessionID":"ses_eae696a14ffehCxB980snPYjCy","part":{"type":"tool","tool":"read","callID":"call_00_7vdsw356nkebo9ssdhnpoh2a","state":{"status":"completed","input":{"filePath":"C:\\Users\\93rob\\Documents\\GitHub\\SpaceFace\\src\\ui\\screens\\settings.js","limit":50,"offset":455},"output":"<path>C:\\Users\\93rob\\Documents\\GitHub\\SpaceFace\\src\\ui\\screens\\settings.js</path>\n<type>file</type>\n<content>\n455: }\n456: \n457: export const CONTROL_SHORTCUTS = Object.freeze([\n458:   { label: 'Dock / interact', key: BINDINGS.dock.label, note: 'when prompted' },\n459:   { label: 'Mission Log', key: BINDINGS.missionLog.label, note: 'active + completed contracts; gamepad: Start → Pause → Mission Log' },\n460:   { label: 'Local Map', key: BINDINGS.localmap.label, note: 'same-sector contacts/objectives' },\n461:   { label: 'Star Map', key: BINDINGS.starmap.label, note: 'jump routes and sector objectives' },\n462:   { label: 'Codex', key: BINDINGS.codex.label, note: 'reference and unlocked journal' },\n463:   { label: 'Tech Tree', key: BINDINGS.techTree.label, note: 'unlock path and blockers' },\n464:   { label: 'Cargo Hold', key: BINDINGS.cargo.label, note: 'cargo value and capacity' },\n465:   { label: 'Comms Log', key: BINDINGS.comms.label, note: 'messages and contacts' },\n466:   { label: 'Drill / asteroid base', key: BINDINGS.drill.label, note: 'target asteroid first' },\n467:   { label: 'Claim / open base', key: BINDINGS.claimBase.label, note: 'near claimable body/base' },\n468:   { label: 'Pause', key: 'Esc / P', note: 'pause menu: resume, settings, save/load, map review' },\n469: ]);\n470: \n471: // --- Reset this page ---------------------------------------------------------------------------\n472: // One word at the foot of Audio, Video, Gameplay and Access returns that page to how the game\n473: // shipped. The shipped values are createGameState(0).settings (the single owner of defaults); each\n474: // changed key goes through `_set`, so the renderer/audio live-apply, the profile persists and the\n475: // worker lane mirrors it exactly as if the player had moved the row by hand.\n476: //\n477: // What a reset never touches, because it is not that page's preference to give back:\n478: //  - Audio: the default-mute migration stamp.\n479: //  - Video: motionReduce (the mirror of the motion choice made under Access) and the shadows\n480: //    migration stamp. The Video picture goes back through applyQualityPreset, not key by key, so the\n481: //    pinned keys stay consistent and the Quality mode lamp lights.\n482: //  - Gameplay: the build-contract backends, the control scheme (a Controls row) and, while Ironman\n483: //    is chosen, difficulty (leaving Ironman has its own confirm). Key bindings are never touched.\n484: //  - Access: the recorded motion choice (an explicit Reduce is kept; motion is asked, never assumed)\n485: //    and the language.\n486: const RESET_SKIP = Object.freeze({\n487:   audio: Object.freeze(['defaultMuteVersion']),\n488:   video: Object.freeze(['motionReduce', 'shadowsDefaultVersion']),\n489:   gameplay: Object.freeze(['physicsBackend', 'aiBackend', 'flightBackend', 'runtimeProfile', 'controlScheme', 'controlSchemeV2']),\n490:   accessibility: Object.freeze(['motionPreference', 'motionAsked', 'motionPrompted', 'motionDefaultVersion']),\n491: });\n492: // Keys a page's rows read through a fallback while the shipped defaults leave them out. Writing the\n493: // fallback explicitly is what returns a stored profile to it (a profile merge cannot delete a key).\n494: const RESET_FALLBACKS = Object.freeze({\n495:   gameplay: Object.freeze({\n496:     steeringView: 'overhead', racingDistance: 58, racingHeight: 22, racingLookAhead: 36,\n497:     velocityVectoring: true, damageNumbers: true,\n498:   }),\n499:   accessibility: Object.freeze({ textScale: 1 }),\n500: });\n501: const RESET_PAGES = Object.freeze({\n502:   Audio: Object.freeze({ sections: ['audio'] }),\n503:   Video: Object.freeze({ sections: ['video'], preset: true }),\n504:   Gameplay: Object.freeze({ sections: ['gameplay'], extras: [['controls', 'flightMode']] }),\n\n(Showing lines 455-504 of 1564. Use offset=505 to continue.)\n</content>","metadata":{"preview":"}\n\nexport const CONTROL_SHORTCUTS = Object.freeze([\n  { label: 'Dock / interact', key: BINDINGS.dock.label, note: 'when prompted' },\n  { label: 'Mission Log', key: BINDINGS.missionLog.label, note: 'active + completed contracts; gamepad: Start → Pause → Mission Log' },\n  { label: 'Local Map', key: BINDINGS.localmap.label, note: 'same-sector contacts/objectives' },\n  { label: 'Star Map', key: BINDINGS.starmap.label, note: 'jump routes and sector objectives' },\n  { label: 'Codex', key: BINDINGS.codex.label, note: 'reference and unlocked journal' },\n  { label: 'Tech Tree', key: BINDINGS.techTree.label, note: 'unlock path and blockers' },\n  { label: 'Cargo Hold', key: BINDINGS.cargo.label, note: 'cargo value and capacity' },\n  { label: 'Comms Log', key: BINDINGS.comms.label, note: 'messages and contacts' },\n  { label: 'Drill / asteroid base', key: BINDINGS.drill.label, note: 'target asteroid first' },\n  { label: 'Claim / open base', key: BINDINGS.claimBase.label, note: 'near claimable body/base' },\n  { label: 'Pause', key: 'Esc / P', note: 'pause menu: resume, settings, save/load, map review' },\n]);\n\n// --- Reset this page ---------------------------------------------------------------------------\n// One word at the foot of Audio, Video, Gameplay and Access returns that page to how the game\n// shipped. The shipped values are createGameState(0).settings (the single owner of defaults); each\n// changed key goes through `_set`, so the renderer/audio live-apply, the profile persists and the","truncated":true,"loaded":[],"display":{"type":"file","path":"C:\\Users\\93rob\\Documents\\GitHub\\SpaceFace\\src\\ui\\screens\\settings.js","text":"}\n\nexport const CONTROL_SHORTCUTS = Object.freeze([\n  { label: 'Dock / interact', key: BINDINGS.dock.label, note: 'when prompted' },\n  { label: 'Mission Log', key: BINDINGS.missionLog.label, note: 'active + completed contracts; gamepad: Start → Pause → Mission Log' },\n  { label: 'Local Map', key: BINDINGS.localmap.label, note: 'same-sector contacts/objectives' },\n  { label: 'Star Map', key: BINDINGS.starmap.label, note: 'jump routes and sector objectives' },\n  { label: 'Codex', key: BINDINGS.codex.label, note: 'reference and unlocked journal' },\n  { label: 'Tech Tree', key: BINDINGS.techTree.label, note: 'unlock path and blockers' },\n  { label: 'Cargo Hold', key: BINDINGS.cargo.label, note: 'cargo value and capacity' },\n  { label: 'Comms Log', key: BINDINGS.comms.label, note: 'messages and contacts' },\n  { label: 'Drill / asteroid base', key: BINDINGS.drill.label, note: 'target asteroid first' },\n  { label: 'Claim / open base', key: BINDINGS.claimBase.label, note: 'near claimable body/base' },\n  { label: 'Pause', key: 'Esc / P', note: 'pause menu: resume, settings, save/load, map review' },\n]);\n\n// --- Reset this page ---------------------------------------------------------------------------\n// One word at the foot of Audio, Video, Gameplay and Access returns that page to how the game\n// shipped. The shipped values are createGameState(0).settings (the single owner of defaults); each\n// changed key goes through `_set`, so the renderer/audio live-apply, the profile persists and the\n// worker lane mirrors it exactly as if the player had moved the row by hand.\n//\n// What a reset never touches, because it is not that page's preference to give back:\n//  - Audio: the default-mute migration stamp.\n//  - Video: motionReduce (the mirror of the motion choice made under Access) and the shadows\n//    migration stamp. The Video picture goes back through applyQualityPreset, not key by key, so the\n//    pinned keys stay consistent and the Quality mode lamp lights.\n//  - Gameplay: the build-contract backends, the control scheme (a Controls row) and, while Ironman\n//    is chosen, difficulty (leaving Ironman has its own confirm). Key bindings are never touched.\n//  - Access: the recorded motion choice (an explicit Reduce is kept; motion is asked, never assumed)\n//    and the language.\nconst RESET_SKIP = Object.freeze({\n  audio: Object.freeze(['defaultMuteVersion']),\n  video: Object.freeze(['motionReduce', 'shadowsDefaultVersion']),\n  gameplay: Object.freeze(['physicsBackend', 'aiBackend', 'flightBackend', 'runtimeProfile', 'controlScheme', 'controlSchemeV2']),\n  accessibility: Object.freeze(['motionPreference', 'motionAsked', 'motionPrompted', 'motionDefaultVersion']),\n});\n// Keys a page's rows read through a fallback while the shipped defaults leave them out. Writing the\n// fallback explicitly is what returns a stored profile to it (a profile merge cannot delete a key).\nconst RESET_FALLBACKS = Object.freeze({\n  gameplay: Object.freeze({\n    steeringView: 'overhead', racingDistance: 58, racingHeight: 22, racingLookAhead: 36,\n    velocityVectoring: true, damageNumbers: true,\n  }),\n  accessibility: Object.freeze({ textScale: 1 }),\n});\nconst RESET_PAGES = Object.freeze({\n  Audio: Object.freeze({ sections: ['audio'] }),\n  Video: Object.freeze({ sections: ['video'], preset: true }),\n  Gameplay: Object.freeze({ sections: ['gameplay'], extras: [['controls', 'flightMode']] }),","lineStart":455,"lineEnd":504,"totalLines":1564,"truncated":true}},"title":"src\\ui\\screens\\settings.js","time":{"start":1792370502370,"end":1792370502424}},"id":"prt_1519b6a24001d0J7p6oVECevvf","sessionID":"ses_eae696a14ffehCxB980snPYjCy","messageID":"msg_1519b571f001lv3gcZbDkw2dFF"}}
