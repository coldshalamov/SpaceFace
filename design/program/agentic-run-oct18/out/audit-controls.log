{"type":"tool_use","timestamp":1792370866920,"sessionID":"ses_eae696a14ffehCxB980snPYjCy","part":{"type":"tool","tool":"read","callID":"call_00_qxyhwwlu63s9l8dd3mzjsnta","state":{"status":"completed","input":{"filePath":"C:\\Users\\93rob\\Documents\\GitHub\\SpaceFace\\src\\ui\\screenManager.js","limit":60,"offset":370},"output":"<path>C:\\Users\\93rob\\Documents\\GitHub\\SpaceFace\\src\\ui\\screenManager.js</path>\n<type>file</type>\n<content>\n370:     // flight canvas (z-index 10) and blank the screen after New Game even though the sim is live.\n371:     // A bare global-find palette (`.sf-find--host`) lives in #screens without a stack entry —\n372:     // it owns the same lifted-lid contract, so an open palette also keeps the layer shown.\n373:     if (screensRoot) {\n374:       const findOpen = !open && typeof screensRoot.querySelector === 'function'\n375:         && !!screensRoot.querySelector('.sf-find--host');\n376:       screensRoot.style.display = (open || findOpen) ? 'flex' : 'none';\n377:       screensRoot.inert = !(open || findOpen);\n378:       if (open || findOpen) screensRoot.removeAttribute('aria-hidden');\n379:       else screensRoot.setAttribute('aria-hidden', 'true');\n380:     }\n381: \n382:     // Every stack screen is a modal interruption surface. The chart, mission log, automation,\n383:     // settings, and future registered screens all receive the same input fence and simulation\n384:     // freeze. There is deliberately no `.ui-live-screen` downgrade: a beautiful map that lets an\n385:     // off-screen enemy keep killing the player is not a map, it is an ambush.\n386:     const modalOpen = open || state.ui.docked === true || state.ui.fulfillmentBlackoutActive === true;\n387:     const externalModal = state.ui.docked === true || state.ui.fulfillmentBlackoutActive === true;\n388:     document.body.classList.toggle('ui-modal-open', modalOpen);\n389:     document.body.classList.remove('ui-live-screen');\n390:     syncHudAccessibility(open || externalModal || effectiveMode() !== 'flight');\n391:     if (backdrop) {\n392:       backdrop.hidden = !open;\n393:       // The dimmer is visual chrome; the active screen owns the dialog semantics.\n394:       backdrop.setAttribute('aria-hidden', 'true');\n395:       backdrop.style.pointerEvents = open ? 'auto' : 'none';\n396:     }\n397:     syncStageRequest(topRec, topEl);\n398:     syncPause();\n399:   }\n400: \n401:   // ------------------------------------------------------------------------------- the UI stage\n402:   //\n403:   // A screen declares the lit world it stands on with `stage` on its def — `{ scene: 'title-field' }`\n404:   // or a function of ctx for a screen whose world depends on the run. The manager is the only writer\n405:   // of `state.ui.stageRequest`, because the manager is the only thing that knows which screen is on\n406:   // top: screens under the top are display:none, so their world is not the one to draw.\n407:   //\n408:   // The seam is one-way by design. Nothing in `src/ui/` imports the renderer; the request is plain\n409:   // data on state and `src/render/uiStage.js` reads it inside the frozen presentation frame.\n410:   //\n411:   // The manager also owns `data-k-ready` for a staged screen. `data-k-ready=\"1\"` means \"the picture\n412:   // this screen was designed around is on the canvas\" — the stage is live, or it could not run and\n413:   // the authored plate is the final image. It must never mean \"a background image finished\n414:   // decoding\", which is the exact fake this packet was written against.\n415:   let stageOwnerId = null;\n416: \n417:   function resolveStageSpec(def) {\n418:     if (!def || !def.stage) return null;\n419:     try {\n420:       const spec = typeof def.stage === 'function' ? def.stage(ctx) : def.stage;\n421:       return spec && typeof spec.scene === 'string' ? spec : null;\n422:     } catch (error) {\n423:       console.error('[screenManager] stage spec failed:', error);\n424:       return null;\n425:     }\n426:   }\n427: \n428:   /**\n429:    * Every staged screen gets the authored backdrop still, whether or not its own module built one.\n\n(Showing lines 370-429 of 827. Use offset=430 to continue.)\n</content>","metadata":{"preview":"    // flight canvas (z-index 10) and blank the screen after New Game even though the sim is live.\n    // A bare global-find palette (`.sf-find--host`) lives in #screens without a stack entry —\n    // it owns the same lifted-lid contract, so an open palette also keeps the layer shown.\n    if (screensRoot) {\n      const findOpen = !open && typeof screensRoot.querySelector === 'function'\n        && !!screensRoot.querySelector('.sf-find--host');\n      screensRoot.style.display = (open || findOpen) ? 'flex' : 'none';\n      screensRoot.inert = !(open || findOpen);\n      if (open || findOpen) screensRoot.removeAttribute('aria-hidden');\n      else screensRoot.setAttribute('aria-hidden', 'true');\n    }\n\n    // Every stack screen is a modal interruption surface. The chart, mission log, automation,\n    // settings, and future registered screens all receive the same input fence and simulation\n    // freeze. There is deliberately no `.ui-live-screen` downgrade: a beautiful map that lets an\n    // off-screen enemy keep killing the player is not a map, it is an ambush.\n    const modalOpen = open || state.ui.docked === true || state.ui.fulfillmentBlackoutActive === true;\n    const externalModal = state.ui.docked === true || state.ui.fulfillmentBlackoutActive === true;\n    document.body.classList.toggle('ui-modal-open', modalOpen);\n    document.body.classList.remove('ui-live-screen');","truncated":true,"loaded":[],"display":{"type":"file","path":"C:\\Users\\93rob\\Documents\\GitHub\\SpaceFace\\src\\ui\\screenManager.js","text":"    // flight canvas (z-index 10) and blank the screen after New Game even though the sim is live.\n    // A bare global-find palette (`.sf-find--host`) lives in #screens without a stack entry —\n    // it owns the same lifted-lid contract, so an open palette also keeps the layer shown.\n    if (screensRoot) {\n      const findOpen = !open && typeof screensRoot.querySelector === 'function'\n        && !!screensRoot.querySelector('.sf-find--host');\n      screensRoot.style.display = (open || findOpen) ? 'flex' : 'none';\n      screensRoot.inert = !(open || findOpen);\n      if (open || findOpen) screensRoot.removeAttribute('aria-hidden');\n      else screensRoot.setAttribute('aria-hidden', 'true');\n    }\n\n    // Every stack screen is a modal interruption surface. The chart, mission log, automation,\n    // settings, and future registered screens all receive the same input fence and simulation\n    // freeze. There is deliberately no `.ui-live-screen` downgrade: a beautiful map that lets an\n    // off-screen enemy keep killing the player is not a map, it is an ambush.\n    const modalOpen = open || state.ui.docked === true || state.ui.fulfillmentBlackoutActive === true;\n    const externalModal = state.ui.docked === true || state.ui.fulfillmentBlackoutActive === true;\n    document.body.classList.toggle('ui-modal-open', modalOpen);\n    document.body.classList.remove('ui-live-screen');\n    syncHudAccessibility(open || externalModal || effectiveMode() !== 'flight');\n    if (backdrop) {\n      backdrop.hidden = !open;\n      // The dimmer is visual chrome; the active screen owns the dialog semantics.\n      backdrop.setAttribute('aria-hidden', 'true');\n      backdrop.style.pointerEvents = open ? 'auto' : 'none';\n    }\n    syncStageRequest(topRec, topEl);\n    syncPause();\n  }\n\n  // ------------------------------------------------------------------------------- the UI stage\n  //\n  // A screen declares the lit world it stands on with `stage` on its def — `{ scene: 'title-field' }`\n  // or a function of ctx for a screen whose world depends on the run. The manager is the only writer\n  // of `state.ui.stageRequest`, because the manager is the only thing that knows which screen is on\n  // top: screens under the top are display:none, so their world is not the one to draw.\n  //\n  // The seam is one-way by design. Nothing in `src/ui/` imports the renderer; the request is plain\n  // data on state and `src/render/uiStage.js` reads it inside the frozen presentation frame.\n  //\n  // The manager also owns `data-k-ready` for a staged screen. `data-k-ready=\"1\"` means \"the picture\n  // this screen was designed around is on the canvas\" — the stage is live, or it could not run and\n  // the authored plate is the final image. It must never mean \"a background image finished\n  // decoding\", which is the exact fake this packet was written against.\n  let stageOwnerId = null;\n\n  function resolveStageSpec(def) {\n    if (!def || !def.stage) return null;\n    try {\n      const spec = typeof def.stage === 'function' ? def.stage(ctx) : def.stage;\n      return spec && typeof spec.scene === 'string' ? spec : null;\n    } catch (error) {\n      console.error('[screenManager] stage spec failed:', error);\n      return null;\n    }\n  }\n\n  /**\n   * Every staged screen gets the authored backdrop still, whether or not its own module built one.","lineStart":370,"lineEnd":429,"totalLines":827,"truncated":true}},"title":"src\\ui\\screenManager.js","time":{"start":1792370866844,"end":1792370866877}},"id":"prt_151a0fa3a001VEF55ZrUINpE7Z","sessionID":"ses_eae696a14ffehCxB980snPYjCy","messageID":"msg_151a0c8fa001GDpscXeX5lM7og"}}
