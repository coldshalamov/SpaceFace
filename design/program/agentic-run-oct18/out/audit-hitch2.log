const fs=require("fs"),path=require("path");
const roots=["src/systems","src/core","src/render"];
const names=["update","preStep","lifetimeSweep","renderUpdate"];
function findBody(src,openIdx){
  let depth=0,started=false,i=openIdx,inStr=null,inLine=false,inBlock=false;
  for(;i<src.length;i++){
    const c=src[i],n=src[i+1];
    if(inLine){if(c==="\n")inLine=false;continue;}
    if(inBlock){if(c==="*"&&n==="/"){inBlock=false;i++;}continue;}
    if(inStr){if(c==="\\"){i++;continue;}if(c===inStr)inStr=null;continue;}
    if(c==="/"&&n==="/"){inLine=true;i++;continue;}
    if(c==="/"&&n==="*"){inBlock=true;i++;continue;}
    if(c==="\""||c==="'"||c==="`"){inStr=c;continue;}
    if(c==="{"){depth++;started=true;continue;}
    if(c==="}"){depth--;if(started&&depth===0)return [openIdx,i];}
  }
  return [openIdx,src.length];
}
const strong=/\bnew\s+(Array|Set|Map|WeakMap|WeakSet|Int32Array|Float32Array|Uint8Array|Float64Array)\b|\.(filter|map|slice|sort|concat|flat|flatMap|reduce)\(|\[\s*\.\.\.|Object\.(keys|values|entries|assign)\(/;
const out=[];
for(const root of roots){
  if(!fs.existsSync(root))continue;
  for(const f of fs.readdirSync(root)){
    if(!f.endsWith(".js"))continue;
    const p=path.join(root,f);
    const src=fs.readFileSync(p,"utf8");
    const re=new RegExp("(^|[\\s{,;])("+names.join("|")+")\\s*\\(([^)]*)\\)\\s*\\{","gm");
    let m;
    while((m=re.exec(src))){
      const braceIdx=re.lastIndex-1;
      const [s,e]=findBody(src,braceIdx);
      const body=src.slice(s,e);
      const off=s;
      const lines=body.split("\n");
      let cursor=s;
      for(const ln of lines){
        const lnStart=cursor; cursor+=ln.length+1;
        if(strong.test(ln)){
          const lineNo=src.slice(0,lnStart).split("\n").length;
          out.push(`${p}:${lineNo} ${ln.trim().slice(0,150)}`);
        }
      }
    }
  }
}
console.log(out.join("\n"));
console.log("TOTAL_LINES="+out.length);
