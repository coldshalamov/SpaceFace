const fs=require("fs"),path=require("path");
function scan(dir){
 const files=fs.readdirSync(dir,{withFileTypes:true});
 for(const ent of files){
  const p=path.join(dir,ent.name);
  if(ent.isDirectory()){ scan(p); continue; }
  if(!ent.name.endsWith(".js")) continue;
  const src=fs.readFileSync(p,"utf8");
  const lines=src.split(/\r?\n/);
  for(let i=0;i<lines.length;i++){
    if(!/^\s{2}(update|renderUpdate|prepareFrame|drawPreparedFrame)\s*\(/.test(lines[i])) continue;
    let depth=0,started=false,end=i;
    for(let j=i;j<lines.length;j++){ for(const ch of lines[j]){ if(ch==="{"){depth++;started=true;} else if(ch==="}"){depth--;} } if(started&&depth<=0){end=j;break;} }
    const body=lines.slice(i,end+1); let hits=[];
    body.forEach((ln,k)=>{
      if(/new (Map|Set|Array|WeakMap)\(|=\s*\[\]|=\s*\{\}|\[\s*\.\.\.|\.map\(|\.filter\(|\.slice\(|\.concat\(|Object\.(keys|values|entries)\(|document\.(querySelector|getElementById|createElement)|\.clone\(\)/.test(ln)) hits.push((i+k+1)+":"+ln.trim().slice(0,110));
    });
    if(hits.length) console.log(`\n=== ${p} @${i+1}\n`+hits.join("\n"));
  }
 }
}
