const fs=require("fs"),path=require("path");
const roots=["src/systems","src/core","src/core/flight","src/core/fields","src/render"];
const names=["update","preStep","lifetimeSweep","renderUpdate","step"];
const tokens=[["new ",/new\s+/g],["map",/\.map\(/g],["filter",/\.filter\(/g],["slice",/\.slice\(/g],["concat",/\.concat\(/g],["ObjKeys",/Object\.(keys|values|entries)\(/g],["spread",/\[\s*\.\.\./g],["forEach",/\.forEach\(/g],["sort",/\.sort\(/g],["JSON",/JSON\.(parse|stringify)\(/g],["newSet",/new Set\(/g],["newMap",/new Map\(/g],["reduce",/\.reduce\(/g]];
function findBody(src,openIdx){
  let depth=0,started=false,i=openIdx,inStr=null,inLine=false,inBlock=false,prev="";
  for(;i<src.length;i++){
    const c=src[i],n=src[i+1];
    if(inLine){if(c==="\n")inLine=false;continue;}
    if(inBlock){if(c==="*"&&n==="/"){inBlock=false;i++;}continue;}
    if(inStr){if(c==="\\"){i++;continue;}if(c===inStr)inStr=null;continue;}
    if(c==="/"&&n==="/"){inLine=true;i++;continue;}
    if(c==="/"&&n==="*"){inBlock=true;i++;continue;}
    if(c==="\""||c==="'"||c==="`"){inStr=c;continue;}
    if(c==="{"){depth++;started=true;continue;}
    if(c==="}"){depth--;if(started&&depth===0)return [openIdx,i];}
  }
  return [openIdx,src.length];
}
const rows=[];
for(const root of roots){
  if(!fs.existsSync(root))continue;
  for(const f of fs.readdirSync(root)){
    if(!f.endsWith(".js"))continue;
    const p=path.join(root,f);
    const src=fs.readFileSync(p,"utf8");
    const re=new RegExp("(^|[\\s{,;])("+names.join("|")+")\\s*\\(([^)]*)\\)\\s*\\{","gm");
    let m;
    while((m=re.exec(src))){
      const braceIdx=re.lastIndex-1;
      const [s,e]=findBody(src,braceIdx);
      const body=src.slice(s,e);
      let total=0,detail={};
      for(const [label,rx] of tokens){const c=(body.match(rx)||[]).length;if(c){detail[label]=c;total+=c;}}
      const lineNo=src.slice(0,m.index).split("\n").length;
      // entity scans
      const entScans=(body.match(/state\.(entityList|entities)/g)||[]).length;
      if(total>=3||entScans>0)
        rows.push({p,line:lineNo,name:m[2],total,entScans,detail});
    }
  }
}
rows.sort((a,b)=>(b.total+b.entScans*3)-(a.total+a.entScans*3));
for(const r of rows.slice(0,45)){
  console.log(`${r.p}:${r.line} ${r.name}() total=${r.total} entityRefs=${r.entScans} ${JSON.stringify(r.detail)}`);
}
