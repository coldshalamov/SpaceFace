const fs=require("fs"),path=require("path");
function walk(dir,acc){for(const e of fs.readdirSync(dir,{withFileTypes:true})){const p=path.join(dir,e.name);if(e.isDirectory())walk(p,acc);else if(e.name.endsWith(".js"))acc.push(p);}return acc;}
const files=walk("src",[]);
const rows=[];
for(const f of files){
  const src=fs.readFileSync(f,"utf8");
  const add=(src.match(/addEventListener\(/g)||[]).length;
  const rem=(src.match(/removeEventListener\(/g)||[]).length;
  const si=(src.match(/setInterval\(/g)||[]).length;
  const ci=(src.match(/clearInterval\(/g)||[]).length;
  const st=(src.match(/setTimeout\(/g)||[]).length;
  const ct=(src.match(/clearTimeout\(/g)||[]).length;
  if(add>0 && add>rem*1.5+2) rows.push(`${f} add=${add} remove=${rem}`);
  if(si>0 && ci<si) rows.push(`${f} setInterval=${si} clearInterval=${ci}`);
  if(st>0 && ct===0 && st>3) rows.push(`${f} setTimeout=${st} clearTimeout=${ct}`);
}
console.log(rows.join("\n"));
