  "probeSource": "import { createSimulation } from '../src/core/sim.js';\nimport { world } from '../src/systems/world.js';\nimport { spawnBudget } from '../src/systems/spawnBudget.js';\nimport { physics } from '../src/core/physics.js';\nimport { makeShipEntitySpec } from '../src/systems/ships.js';\nimport { ALIEN_SITES } from '../src/data/alienEcology.js';\nimport { materializeAlienEcology, tickAlienEcology, setRevelation } from '../src/systems/alienEcology.js';\nimport { veilNurseryMemory } from '../src/world/veilRayNursery.js';\nconst site=ALIEN_SITES.veil_ray_nursery;\nconst sim=createSimulation({seed:1,systems:[spawnBudget,world,physics]});\nconst state=sim.state,owner=sim.registry.get('world');state.mode='flight';\nstate.world.currentSectorId=site.sectorId;state.world.activeSector={dressing:[],pois:[]};setRevelation(state,2);\nconst center=owner._toGlobal(site.center,site.sectorId);\nconst player=sim.spawn(makeShipEntitySpec('ship_hornet',{isPlayer:true,player:state.player,pos:{x:center.x+220,z:center.z},fittings:[]}));state.playerId=player.id;\nmaterializeAlienEcology(owner,{id:site.sectorId},state.world.activeSector,[site]);\nfor(let i=0;i<726;i++){state.tick++;state.simTime=state.tick/60;tickAlienEcology(owner,1/60);}\nconst n=veilNurseryMemory(state);\nconst rows=state.entityList.filter(e=>e.alive!==false&&(e.data?.ecology?.siteId===site.siteId||Number.isInteger(e.data?.veilNurseryRib))).map(e=>({\nkind:Number.isInteger(e.data?.veilNurseryRib)?'rib':e.data.ecology.aggregate?'aggregate':'adult',\nkey:e.data.nurseryDressingKey||e.data.ecology.faunaKey,\nx:e.pos.x-center.x,y:e.pos.y||0,z:e.pos.z-center.z,rot:e.rot,radius:e.radius,\nstrainId:e.data.strainId||null,speciesId:e.data.ecology?.speciesId||null,\nribIndex:e.data.veilNurseryRib??null,phase:e.data.ecology?.phase??null,\nnurseryMode:e.data.ecology?.nurseryMode??null,visibleMembers:e.data.ecology?.visibleMembers??null\n}));\nconsole.log(JSON.stringify({seed:1,epoch:0,tick:state.tick,simTime:state.simTime,coordinates:'relative to nursery site center; renderer root yaw=-rot',surveyed:n.surveyed,watchSeconds:n.watchSeconds,mode:n.mode,entities:rows}));\nsim.dispose();"
}
