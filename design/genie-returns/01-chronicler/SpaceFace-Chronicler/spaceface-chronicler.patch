+  function walk(node, path) {
+    const next = [...path, node];
+    paths.push(next);
+    if (next.length >= 12) return;
+    for (const key of children.get(node.id) || []) {
+      if (!next.some(n => n.id === key) && byId.has(key)) walk(byId.get(key), next);
+    }
