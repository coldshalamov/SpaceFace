+import { broodModelForRoot, bindResidentBroodModel, validBroodMaterialLineage } from './broodVisualContract.js';
+import * as THREE from 'three';
+import { createLodState } from './lod.js';
+const CELL_IDS = new Set(['brood_splitter_axial','brood_splitter_port','brood_splitter_starboard']);
+const MATERIAL_IDS = new Set(['brood_splitter',...CELL_IDS]);
+const sameLife = (e,life) => e && e.occupantGeneration === life && e.alive !== false;
+const isMaterial = e => e && MATERIAL_IDS.has(e.data?.broodBodyId) && Number.isSafeInteger(e.occupantGeneration) && e.occupantGeneration>0 && Number.isFinite(e.pos?.x) && Number.isFinite(e.pos?.z);
+const TEXTURES = ['map','normalMap','bumpMap','roughnessMap','metalnessMap','aoMap','emissiveMap','alphaMap','lightMap','envMap'];
+function resourcesFor(nodes) {
+  const resources=new Set();
+  for(const node of nodes){resources.add(node.geometry);
+    for(const material of Array.isArray(node.material)?node.material:[node.material]){
+      if(!material)continue;resources.add(material);
+      for(const key of TEXTURES)if(material[key]?.isTexture)resources.add(material[key]);
+    }
+  }
