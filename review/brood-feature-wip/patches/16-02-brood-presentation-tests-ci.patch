+function fixture() {
+  const source = { id: 'spitter', type: 'ship', alive: true, occupantGeneration: 3,
+    pos: { x: 0, z: 0 }, vel: { x: 0, z: 0 }, radius: 9, rot: 0, data: { broodBodyId: 'brood_spitter' } };
+  const target = { id: 'target', alive: true, occupantGeneration: 4, pos: { x: 260, z: 0 } };
+  const state = { tick: 100, entities: new Map([[source.id, source], [target.id, target]]) };
+  function sample(tick, interrupted = false) {
+    state.tick = tick;
+    source.data.broodAttack = advanceBroodAttack(source.data.broodAttack,
+      { role: 'brood_spitter', entityId: source.id, tick, self: source, target, interrupted });
+    source.data.broodAttack.sampledTick = tick;
+  }
+  sample(100);
+  return { source, target, state, sample };
+}
+function graph() {
+  const root = new THREE.Group();
+  for (let lod = 0; lod < 3; lod++) for (const rig of BROOD_BODY_CONTRACTS.brood_spitter.motion.rigs) {
+    const pivot = new THREE.Group(); pivot.name = rig.node; pivot.position.fromArray(rig.pivot); root.add(pivot);
+  }
+  return root;
+}
+function transforms(root) { return root.children.map(n => [...n.position.toArray(), ...n.quaternion.toArray()]); }
+function accepted(f) {
+  const attack = f.source.data.broodAttack;
+  f.source.data.broodShot = { attackId: attack.attackId, life: attack.life, targetLife: attack.targetLife, tick: f.state.tick };
+}
+
+test('spitter expresses inflation on actual anatomy without a false world corridor', () => {
+  const f = fixture(), root = graph(); f.source.mesh = root;
+  const driver = createBroodMotionDriver(root, f.source);
+  driver.update(f.source, {}); const rest = transforms(root);
+  assert.equal(broodPoseFraction(f.source), .35);
+  f.sample(124); driver.update(f.source, {});
+  const inflated = transforms(root); assert.notDeepEqual(inflated, rest);
+  assert.equal(broodPoseFraction(f.source), .675);
+  for (let lod = 1; lod < 3; lod++) assert.deepEqual(inflated.slice(lod*3, lod*3+3), inflated.slice(0,3));
+  for (const kind of ['brood:phase', 'ai:telegraph']) assert.equal(resolveBroodAttackCue(kind,
+    { entityId: f.source.id, ...f.source.data.broodAttack, kind: 'brood_spit' }, f.state), null);
+  f.source.pos.z = 70; f.source.rot = 1.4; driver.update(f.source, {});
+  assert.deepEqual(transforms(root), inflated, 'Pose stays attached to physical body, not the original aim line');
+  driver.update(f.source, {}); assert.deepEqual(transforms(root), inflated, 'Paused sim cannot advance anatomy');
+  driver.update(f.source, { reducedMotion: true }); assert.equal(broodPoseFraction(f.source, true), 1);
+  f.sample(148); assert.equal(broodPoseFraction(f.source), 1, 'Commit without accepted shot stays inflated');
+  f.sample(149); assert.equal(broodPoseFraction(f.source), 1, 'Blocked/no-shot recovery never fakes a discharge');
+  f.sample(194); assert.ok(broodPoseFraction(f.source) > .35);
+  driver.dispose();
+});
+
+test('only current once-per-attack accepted shot collapses then refills over recovery', () => {
+  const f = fixture(); f.sample(148); accepted(f);
+  assert.equal(broodPoseFraction(f.source), 1);
+  f.sample(149); f.sample(152); assert.equal(broodPoseFraction(f.source), 0);
+  f.sample(180); const half = broodPoseFraction(f.source); assert.ok(half > 0 && half < .35);
+  assert.equal(broodPoseFraction(f.source), half, 'Reading repeated shot receipt never restarts collapse');
+  const receipt = f.source.data.broodShot;
+  for (const delta of [{ life: 2 }, { targetLife: 99 }, { attackId: 'old' }, { tick: 999 }, { tick: 100 }]) {
+    f.source.data.broodShot = { ...receipt, ...delta };
+    assert.ok(broodPoseFraction(f.source) >= .35, 'Stale/forged receipt cannot discharge anatomy');
+  }
+  f.source.data.broodShot = receipt; f.sample(238); assert.equal(broodPoseFraction(f.source), .35);
+});
+
+test('interruption, lost target, recycled owner and pooled sibling keep independent neutral transforms', () => {
+  const f = fixture(), sibling = fixture(), a = graph(), b = graph();
+  f.source.mesh = a; sibling.source.mesh = b;
+  const da = createBroodMotionDriver(a, f.source), db = createBroodMotionDriver(b, sibling.source);
+  db.update(sibling.source, {}); const parked = transforms(b);
+  f.sample(124); da.update(f.source, {}); const expanded = transforms(a);
+  f.sample(125, true); da.update(f.source, {});
+  assert.ok(broodPoseFraction(f.source) >= .35, 'Interrupted inflation unloads without shot-like collapse');
+  f.target.alive = false; f.sample(130); da.update(f.source, {});
+  assert.deepEqual(transforms(b), parked);
+  f.source.occupantGeneration++; da.update(f.source, {});
+  assert.notDeepEqual(transforms(a), expanded);
+  const neutral = transforms(a); da.dispose(); assert.deepEqual(transforms(a), neutral);
+  db.update(sibling.source, {}); assert.deepEqual(transforms(b), parked); db.dispose();
+});
