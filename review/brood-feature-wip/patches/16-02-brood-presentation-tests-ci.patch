+// Source-only port of CPU/runtime assertions; authored GLB installation belongs to replacement-art gates.
+// CPU source/ownership/geometry proofs. These do not certify GPU cost or the normal-camera picture.
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import * as THREE from 'three';
+import { BROOD_BODY_CONTRACTS } from '../src/data/broodBodies.js';
+import { advanceBroodAttack, BROOD_ATTACK_PROFILES } from '../src/combat/broodContact.js';
+import { broodPoseFraction, createBroodMotionDriver, BROOD_CUE_CAPACITY } from '../src/render/broodVisuals.js';
+import { ActionVfx, ACTION_VFX_EVENTS } from '../src/render/actionVfx.js';
+import { attachAuthoredMotionDriver } from '../src/render/authoredMotion.js';
+import { vfx } from '../src/render/vfx.js';
+
+function fixture(role = 'brood_charger', id = 1) {
+  const body = BROOD_BODY_CONTRACTS[role];
+  const source = { id, alive: true, type: 'ship', occupantGeneration: 7, pos: { x: 12, z: 20 },
+    vel: { x: 0, z: 0 }, rot: 0, radius: body.radius, mass: body.mass,
+    data: { broodBodyId: role } };
+  const target = { id: 'player', alive: true, occupantGeneration: 9, pos: { x: 12 + Math.min(60, BROOD_ATTACK_PROFILES[role].range * .7), z: 20 }, vel: { x: 0, z: 0 }, radius: 6 };
+  const state = { tick: 120, simTime: 2, playerId: target.id,
+    entities: new Map([[id, source], [target.id, target]]), settings: { video: {} } };
+  source.data.broodAttack = advanceBroodAttack(null, { role, entityId: id, tick: state.tick, self: source, target });
+  source.data.broodAttack.sampledTick = state.tick;
+  return { body, role, source, target, state };
+}
+function advance(f, ticks, interrupted = false) {
+  f.state.tick += ticks; f.state.simTime += ticks / 60;
+  f.source.data.broodAttack = advanceBroodAttack(f.source.data.broodAttack,
+    { role: f.role, entityId: f.source.id, tick: f.state.tick, self: f.source, target: f.target, interrupted });
+  f.source.data.broodAttack.sampledTick = f.state.tick;
+}
+function receipt(f) { return { entityId: f.source.id, ...f.source.data.broodAttack, tick: f.state.tick }; }
+function capture(out) { return out.batch.attributes.map(a => Array.from(a.array)); }
+function syntheticGraph(body, sharedMaterial = new THREE.MeshStandardMaterial()) {
+  const root = new THREE.Group();
+  for (let lod = 0; lod < 3; lod++) {
+    const group = new THREE.Group(); group.name = `LOD${lod}`; root.add(group);
+    for (const rig of body.motion.rigs) {
+      const pivot = new THREE.Group(); pivot.name = rig.node; pivot.position.fromArray(rig.pivot);
+      const mesh = new THREE.Mesh(new THREE.BoxGeometry(.1, .1, .1), sharedMaterial); pivot.add(mesh); group.add(pivot);
+    }
+    for (const [name, socket] of Object.entries(body.sockets)) {
+      const node = new THREE.Object3D(); node.name = name; node.position.fromArray(socket.position); group.add(node);
+    }
+  }
+  return root;
+}
+function poses(root) {
+  const result = []; root.traverse(node => { if (node.name.startsWith('MOTION_')) result.push([...node.position.toArray(), ...node.quaternion.toArray()]); });
+  return result;
+}
+function releaseGraph(root) {
+  const materials = new Set(); root.traverse(n => { n.geometry?.dispose(); if (n.material) materials.add(n.material); });
+  for (const mat of materials) mat.dispose();
+}
+
+for (const role of Object.keys(BROOD_BODY_CONTRACTS).filter(role => BROOD_ATTACK_PROFILES[role]?.delivery !== 'projectile')) test(`${role}: locked lane survives player sidestep and a shoved/rotated source`, () => {
+  const f = fixture(role), out = new ActionVfx(new THREE.Scene());
+  try {
+    assert.ok(out.emit('brood:phase', receipt(f), f.state)); out.update(f.state);
+    const lane = out.inspect().instances[0], boundaries = out.batch.attributes[0];
+    assert.equal(out.mesh.count, 6); assert.equal(out.particles.live, 0);
+    assert.equal(lane.primitive, 'broodCorridor'); assert.equal(lane.range, f.source.data.broodAttack.attackLine.range);
+    for (const i of [0, 3]) {
+      assert.equal(out.batch.attributes[1].getY(i), 0);
+      assert.equal(out.batch.attributes[1].getZ(i), Math.fround(lane.range));
+      assert.equal(boundaries.getW(i), 0);
+      assert.ok(Math.abs(out.batch.attributes[7].getZ(i)) + out.batch.attributes[2].getX(i) <= lane.halfWidth + 1e-6);
+    }
+    f.target.pos.z += 100; f.source.pos.z += 45; f.source.vel.z = 70; f.source.rot = 1.4;
+    advance(f, 10); out.update(f.state);
+    const after = out.inspect().instances[0];
+    assert.deepEqual([after.x, after.z, after.angle, after.range, after.halfWidth],
+      [lane.x, lane.z, lane.angle, lane.range, lane.halfWidth]);
+    assert.notEqual(after.z, f.source.pos.z, 'Visible promise is not moved onto a deflected body');
+    assert.equal(f.source.vel.z, 70, 'Presentation never overwrites the external impulse');
+    advance(f, BROOD_ATTACK_PROFILES[role].windupTicks - 10);
+    assert.ok(out.emit('brood:phase', receipt(f), f.state)); out.update(f.state);
+    assert.equal(out.live, 1); assert.equal(out.inspect().instances[0].phase, 'commit');
+    assert.deepEqual([out.slots.find(slot => slot.alive).x, out.slots.find(slot => slot.alive).z, out.slots.find(slot => slot.alive).angle], [lane.x, lane.z, lane.angle]);
+    advance(f, BROOD_ATTACK_PROFILES[role].commitTicks);
+    assert.equal(out.emit('brood:phase', receipt(f), f.state), false); out.update(f.state);
+    assert.equal(out.mesh.count, 0, 'Recovery immediately removes the active danger boundary');
+  } finally { out.dispose(); }
+});
+
+test('duplicate, stale, future, expired and forged-life events cannot restart a danger promise', () => {
+  const f = fixture(), out = new ActionVfx(new THREE.Scene()), first = receipt(f);
+  try {
+    assert.ok(out.emit('brood:phase', first, f.state));
+    const born = out.slots.find(slot => slot.alive).born;
+    for (let i = 0; i < 20; i++) { advance(f, 1); assert.equal(out.emit('brood:phase', first, f.state), false); }
+    assert.equal(out.slots.find(slot => slot.alive).born, born); assert.equal(out.live, 1);
+    assert.equal(out.emit('brood:phase', { ...receipt(f), attackId: 'forged' }, f.state), false);
+    assert.equal(out.emit('brood:phase', { ...receipt(f), tick: f.state.tick + 1 }, f.state), false);
+    assert.equal(out.emit('brood:phase', { ...receipt(f), life: 6 }, f.state), false);
+    out.update(f.state); assert.equal(out.mesh.count, 6);
+    f.source.data.broodAttackInterruptedTick = f.state.tick;
+    out.update(f.state); assert.equal(out.mesh.count, 0);
+    assert.equal(out.emit('brood:phase', first, f.state), false);
+    delete f.source.data.broodAttackInterruptedTick;
+    f.state.tick = first.phaseStartedTick + BROOD_ATTACK_PROFILES[f.role].windupTicks;
+    assert.equal(out.emit('brood:phase', first, f.state), false, 'A stale windup expires even without another event');
+  } finally { out.dispose(); }
+});
