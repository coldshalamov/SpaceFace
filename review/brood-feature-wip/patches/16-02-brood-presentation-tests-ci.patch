+test('current life, exact live owner, target loss, rewind and save reset clear cue ownership', () => {
+  for (const mutate of [
+    f => f.source.occupantGeneration++,
+    f => f.state.entities.set(f.source.id, { ...f.source }),
+    f => { f.source.alive = false; },
+    f => { f.target.alive = false; },
+    f => f.target.occupantGeneration++,
+    f => f.state.entities.set(f.target.id, { ...f.target }),
+    f => { delete f.source.data.broodAttack; },
+    f => { f.state.simTime = 0; f.state.tick = 0; },
+  ]) {
+    const f = fixture(), out = new ActionVfx(new THREE.Scene());
+    try { out.emit('brood:phase', receipt(f), f.state); out.update(f.state); mutate(f); out.update(f.state); assert.equal(out.mesh.count, 0); }
+    finally { out.dispose(); }
+  }
+});
