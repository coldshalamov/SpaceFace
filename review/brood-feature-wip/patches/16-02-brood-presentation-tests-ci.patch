+    root.traverse(node => { if (node.isMesh) assert.equal(node.material, material, 'No per-mite material clones'); });
+    root.userData.updateAuthoredMotion(f.source, 0, { reducedMotion: true });
+    assert.equal(broodPoseFraction(f.source, true), 1);
+    advance(f, BROOD_ATTACK_PROFILES[role].windupTicks);
+    root.userData.updateAuthoredMotion(f.source, 0, { reducedMotion: true });
+    assert.equal(broodPoseFraction(f.source, true), f.body.motion.poses.attack);
+    advance(f, 1, true); root.userData.updateAuthoredMotion(f.source, 0, { reducedMotion: true });
+    assert.equal(broodPoseFraction(f.source, true), f.body.motion.poses.recovery);
+    f.source.occupantGeneration++; root.userData.updateAuthoredMotion(f.source, 0, {}); assert.deepEqual(poses(root), rest);
