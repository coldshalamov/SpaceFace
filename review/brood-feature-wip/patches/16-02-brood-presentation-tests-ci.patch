+test('cold attach and deferred snapshot activation bind only the published current-life root', () => {
+  const f = fixture(), retained = syntheticGraph(f.body), candidate = syntheticGraph(f.body);
+  f.source.mesh = retained; advance(f, 15);
+  const detachOld = attachAuthoredMotionDriver(retained, f.source, []);
+  const snapshot = { ...f.source, data: { ...f.source.data }, deferAuthoredMotionRegistration: true };
+  const detachNew = attachAuthoredMotionDriver(candidate, snapshot, []), rest = poses(candidate);
+  try {
+    candidate.userData.updateAuthoredMotion(snapshot, 2.25, {}); assert.deepEqual(poses(candidate), rest);
+    assert.equal(candidate.userData.activateAuthoredMotionRegistration(f.source), false, 'Hidden candidate cannot steal ownership');
+    retained.userData.updateAuthoredMotion(f.source, 2.25, {}); assert.notDeepEqual(poses(retained), rest);
+    f.source.mesh = candidate;
+    assert.equal(candidate.userData.activateAuthoredMotionRegistration(f.source), true);
+    candidate.userData.updateAuthoredMotion(f.source, 2.25, {}); assert.notDeepEqual(poses(candidate), rest);
+    detachOld(); candidate.userData.updateAuthoredMotion(f.source, 2.25, {}); assert.notDeepEqual(poses(candidate), rest);
+    candidate.userData.updateAuthoredMotion(snapshot, 2.25, {}); assert.deepEqual(poses(candidate), rest, 'Snapshot is never the published owner');
+    f.source.occupantGeneration++; candidate.userData.updateAuthoredMotion(f.source, 2.25, {}); assert.deepEqual(poses(candidate), rest);
+  } finally { detachOld(); detachNew(); releaseGraph(retained); releaseGraph(candidate); }
+  const cold = fixture('brood_mite'), root = syntheticGraph(cold.body), restCold = poses(root);
+  const driver = createBroodMotionDriver(root, cold.source);
+  advance(cold, 15); driver.update(cold.source, {}); assert.deepEqual(poses(root), restCold);
+  cold.source.mesh = root; driver.update(cold.source, {}); assert.notDeepEqual(poses(root), restCold);
+  driver.dispose(); releaseGraph(root);
+});
