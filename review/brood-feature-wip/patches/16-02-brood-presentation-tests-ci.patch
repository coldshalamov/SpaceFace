+test('late valid admission keeps remaining sim lifetime; pause/rebase/accessibility preserve the exact lane', () => {
+  const f = fixture(); let origin = 0;
+  const out = new ActionVfx(new THREE.Scene(), (x, z, p) => Object.assign(p, { x: x - origin, z }));
+  try {
+    const initial = receipt(f); advance(f, 15);
+    assert.ok(out.emit('brood:phase', initial, f.state)); out.update(f.state);
+    assert.equal(out.slots.find(slot => slot.alive).born, 2); const parked = capture(out);
+    out.update(f.state); assert.deepEqual(capture(out), parked);
+    origin = 1000; out.update(f.state);
+    assert.equal(out.batch.attributes[0].getX(0), parked[0][0] - 1000);
+    assert.equal(out.slots.find(slot => slot.alive).x, initial.attackLine.origin.x);
+    f.state.settings.accessibility = { reducedMotion: true, reducedFlash: true };
+    out.update(f.state); const reduced = capture(out);
+    advance(f, 2); out.update(f.state);
+    for (const index of [0, 1, 2, 7]) assert.deepEqual(capture(out)[index], reduced[index], 'Reduced motion does not erase or sweep the locked geometry');
+    assert.equal(out.mesh.count, 6); assert.equal(out.particles.live, 0);
+    assert.ok(out.batch.attributes.every(a => a.array.every(Number.isFinite)));
+  } finally { out.dispose(); }
+});
