+for (const role of Object.keys(BROOD_BODY_CONTRACTS).filter(role => BROOD_ATTACK_PROFILES[role]?.delivery !== 'projectile')) test(`${role}: anatomy uses sampled phase, all LOD pivots and immutable shared material`, () => {
+  const f = fixture(role), material = new THREE.MeshStandardMaterial(), root = syntheticGraph(f.body, material);
+  f.source.mesh = root;
+  const detach = attachAuthoredMotionDriver(root, f.source, []), rest = poses(root);
+  try {
+    root.userData.updateAuthoredMotion(f.source, 99999, {}); assert.deepEqual(poses(root), rest);
+    advance(f, Math.floor(BROOD_ATTACK_PROFILES[role].windupTicks / 2));
+    root.userData.updateAuthoredMotion(f.source, 99999, {}); const half = poses(root);
+    assert.notDeepEqual(half, rest);
+    root.userData.updateAuthoredMotion(f.source, 100009, {}); assert.deepEqual(poses(root), half, 'Wall time cannot advance a paused attack');
+    const count = f.body.motion.rigs.length;
