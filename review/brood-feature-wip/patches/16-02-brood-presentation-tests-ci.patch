+test('delayed first cue rejects a recycled target and accepted metadata cannot move its lane', () => {
+  const f = fixture(), out = new ActionVfx(new THREE.Scene()), delayed = receipt(f);
+  try {
+    f.target.occupantGeneration++;
+    assert.equal(out.emit('brood:phase', delayed, f.state), false);
+    f.target.occupantGeneration--;
+    assert.ok(out.emit('brood:phase', { ...delayed, attackLine: { origin: { x: 999, z: 999 } } }, f.state));
+    out.update(f.state);
+    assert.deepEqual([out.inspect().instances[0].x, out.inspect().instances[0].z],
+      [delayed.attackLine.origin.x, delayed.attackLine.origin.z], 'Event coordinates never replace simulation truth');
+    f.source.data.broodAttack.attackLine = { ...delayed.attackLine, origin: { x: 20, z: 20 } };
+    out.update(f.state); assert.equal(out.mesh.count, 0, 'In-place producer corruption cannot retarget an already accepted lane');
+  } finally { out.dispose(); }
+});
