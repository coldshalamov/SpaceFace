+test('real Rapier bus keeps the visible promise fixed through sidestep and external shove, then clears recovery', { timeout: 120000 }, async () => {
+  const { bootRealPath, writeRealPathInput } = await import('../scripts/lib/bench/realPath.mjs');
+  const { combat, makeEnemySpawnSpec } = await import('../src/systems/combat.js');
+  const { tumbleStates } = await import('../src/systems/tumbleStates.js');
+  const { queuePhysicsImpulse } = await import('../src/core/physicsAuthority.js');
+  const host = await bootRealPath({ seed: 714, systems: ['tacticalAI', 'actions', 'flightV3', 'aiPorts', tumbleStates,
+    'collisionConsequences', 'physics', combat], hulls: [{ hullId: 'ship_kestrel', pos: { x: 0, z: 0 }, rot: 0, isPlayer: true }] });
+  const spec = makeEnemySpawnSpec('brood_charger', 1, { x: -155, z: 0 });
+  Object.assign(spec.data.ai, { forcePlayerTarget: true, huntPlayer: true, moraleImmune: true, surrenderImmune: true });
+  spec.data.runCohort = 'survival'; spec.data.combat.targetId = host.player.id;
+  spec.data.ai.activity = { ...spec.data.ai.activity, targetId: host.player.id };
+  const actor = host.runtime.spawn(spec), out = new ActionVfx(new THREE.Scene());
+  const off = host.bus.on('brood:phase', payload => out.emit('brood:phase', payload, host.state));
+  let promise = null, samples = 0, pushed = false, recovery = false, maxSideways = 0;
+  try {
+    host.step(300, {
+      before() {
+        const attack = actor.data.broodAttack;
+        writeRealPathInput(host.state, { moveX: attack && host.state.tick - attack.cueStartedTick >= 25 ? 1 : 0 });
+        if (!pushed && attack?.phase === 'commit') {
+          queuePhysicsImpulse(actor, { x: 0, y: 0, z: actor.mass * 85 }); pushed = true;
+        }
+      },
+      after() {
+        out.update(host.state);
