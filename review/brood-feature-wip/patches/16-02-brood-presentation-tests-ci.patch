+test('actual glob is closed lobed matter within sweep radius and shares bounded immutable GPU resources', () => {
+  const factory = createVisualFactory(), roots = [];
+  let geometry, material;
+  for (let id = 0; id < 400; id++) {
+    const entity = { id, type: 'projectile', radius: .8, team: 1, data: { weaponId: 'wpn_brood_glob' } };
+    assert.equal(projectileSkipsVisualFactoryMesh(entity), false);
+    const root = factory.build(entity), mesh = root.getObjectByName('BroodGlobWetMembrane'); roots.push(root);
+    assert.ok(mesh?.isMesh); assert.equal(root.children.length, 1);
+    if (!geometry) { geometry = mesh.geometry; material = mesh.material; }
+    assert.equal(mesh.geometry, geometry); assert.equal(mesh.material, material);
+    assert.equal(mesh.scale.x, entity.radius); assert.equal(material.transparent, false);
+    assert.equal(material.metalness, 0); assert.equal(material.emissiveIntensity, 2);
+    assert.equal(material.emissive.getHex(), 0xc8ed88);
+    for (let n = 0; n < geometry.attributes.position.count; n++) {
+      const p = geometry.attributes.position;
+      assert.ok(Math.hypot(p.getX(n), p.getY(n), p.getZ(n)) <= 1.00001);
+    }
+  }
+  assert.ok(geometry.index.count / 3 < 1000);
+  let disposed = 0; geometry.addEventListener('dispose', () => disposed++); material.addEventListener('dispose', () => disposed++);
+  roots[0].children[0].geometry.dispose(); roots[0].children[0].material.dispose();
+  assert.equal(disposed, 0, 'Pooled resource disposal cannot break siblings');
+  assert.equal(roots[1].children[0].geometry, geometry);
+  const recipe = resolveWeaponRecipe('wpn_brood_glob'); assert.equal(recipe.flight.mode, FLIGHT_MODE.MESH);
+  assert.equal(recipe.flight.ribbon, false); assert.equal(recipe.muzzle.surface, false);
