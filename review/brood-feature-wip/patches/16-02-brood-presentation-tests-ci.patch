+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import * as ciReport from '../scripts/check-ci-report.mjs';
+import { resolveAggregateCommand } from '../scripts/lib/ciGateGraph.mjs';
+test('Brood source presentation gates run once and never claim installed replacement art', () => {
+  const workflow = readFileSync(new URL('../.github/workflows/check.yml', import.meta.url), 'utf8');
+  const start = workflow.indexOf('      - name: Validate Brood presentation source');
+  assert.ok(start >= 0 && start < workflow.indexOf('      - name: Validate program control plane'));
+  const end = workflow.indexOf('\n      - name:', start + 1);
+  const step = workflow.slice(start, end);
+  assert.ok(step.includes('if: ${{ !cancelled() && matrix.shard == 1 }}'));
+  assert.ok(!step.includes('assets/ships/'));
+  const scripts = JSON.parse(readFileSync(new URL('../package.json', import.meta.url), 'utf8')).scripts;
+  const matrix = ciReport.buildCommandMatrix(resolveAggregateCommand(scripts, 'check:ci'), scripts);
+  const indirect = matrix.flatMap(def => ciReport.resolveLeafCommands(def.command, scripts)).flatMap(command => command.split(/\s+/));
+  const direct = workflow.split(/\r?\n/).filter(line => /node --test\s/.test(line)).flatMap(line => line.trim().split(/\s+/));
+  for (const file of ['brood-source-presentation', 'brood-spitter-presentation', 'brood-presentation-ci']) {
+    const path = `test/${file}.test.mjs`;
+    assert.ok(step.split(/\s+/).includes(path));
+    assert.equal(direct.filter(token => token === path).length, 1, path);
+    assert.equal(indirect.filter(token => token === path).length, 0, path);
+  }
+});
