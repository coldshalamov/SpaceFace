+test('ordinary actions and all production-cap Brood attacks have independent reserved admissions', () => {
+  for (const order of ['ordinary-first', 'brood-first']) {
+    const f = fixture(), state = f.state, out = new ActionVfx(new THREE.Scene());
+    const ordinary = () => {
+      for (let i = 0; i < 80; i++) out.emit('well:grind', { targetId: `ordinary:${i}`, pos: { x: 2, z: 3 } }, state);
+    };
+    const brood = () => {
+      for (let i = 0; i < BROOD_CUE_CAPACITY; i++) {
+        const next = fixture(i % 2 ? 'brood_mite' : 'brood_charger', i + 10);
+        state.entities.set(next.source.id, next.source); next.state = state;
+        assert.ok(out.emit('brood:phase', receipt(next), state));
+        for (let duplicate = 0; duplicate < 4; duplicate++) assert.equal(out.emit('brood:phase', receipt(next), state), false);
+      }
+    };
+    try {
+      if (order === 'ordinary-first') { ordinary(); brood(); } else { brood(); ordinary(); }
+      state.simTime += .05; state.tick += 3; out.update(state);
+      assert.equal(out.inspect().instances.filter(slot => slot.event === 'brood:phase').length, BROOD_CUE_CAPACITY);
+      assert.equal(out.inspect().instances.filter(slot => slot.event === 'well:grind').length, 32);
+      assert.equal(out.live, BROOD_CUE_CAPACITY + 32);
+      assert.ok(out.batch.count <= out.inspect().surfaceCapacity);
+      const geometry = out.batch.geometry;
+      const allocatedBytes = Object.values(geometry.attributes).reduce((n, a) => n + a.array.byteLength, 0)
+        + geometry.index.array.byteLength + out.mesh.instanceMatrix.array.byteLength;
+      assert.ok(allocatedBytes < 160000, `Shared geometry/instance storage is ${allocatedBytes} bytes`);
+      out.clear(); assert.equal(out.live, 0); assert.equal(out.mesh.count, 0);
