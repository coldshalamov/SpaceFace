+    assert.ok(maxSideways > 25, 'Actual native body leaves its original visible lane under the external impulse');
+    assert.ok(Math.abs(host.player.pos.z) > 25, 'Actual flight input sidesteps the line');
+    assert.equal(host.proof().sg02Ready, true);
+  } finally { off?.(); out.dispose(); host.dispose(); }
+});
