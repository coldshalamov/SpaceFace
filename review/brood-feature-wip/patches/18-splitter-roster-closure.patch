+
+test('Splitter roster admission leaves authored acts and champion recipes valid through their full cycle', () => {
+  const splitter = SWARM_ROSTER.filter(entry => entry.enemyId === 'brood_splitter');
+  assert.equal(splitter.length, 1, 'exactly one ordinary roster admission');
+  assert.equal(splitter[0].fromWave, 17);
+  for (const owner of [...Object.values(SWARM_ACT), ...SWARM_BOSS_ROTATION]) {
+    for (const pkg of owner.packages || []) {
+      assert.ok(Number.isInteger(pkg.count) && pkg.count > 0,
+        `authored ${owner.id} package ${pkg.enemyId} has a finite positive body count`);
+      assert.notEqual(pkg.enemyId, 'brood_splitter', 'the roster admission does not rewrite authored recipes');
+    }
+  }
+  // All existing authored waves, every champion in the rotation, and the unbounded tail.
+  // Wave 25 formerly received an accidental roster-shaped row with no package count.
+  for (const seed of [9, 47, 4242]) for (let wave = 1; wave <= 100; wave++) {
+    const plan = swarmPlan(wave, seed);
+    assert.ok(!plan.error, `seed ${seed}, wave ${wave}: ${JSON.stringify(plan.issues)}`);
+    assert.ok(plan.packages.every(pkg => Number.isInteger(pkg.count) && pkg.count > 0));
+    const debuts = plan.packages.filter(pkg => pkg.debut === true);
+    if (wave === 17) assert.deepEqual(debuts.map(pkg => pkg.enemyId), ['brood_splitter']);
+    if (!swarmNewcomerFor(wave) || swarmNewcomerFor(wave).fromWave !== wave) assert.equal(debuts.length, 0);
+  }
+});
