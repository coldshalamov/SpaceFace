diff --git a/src/render/broodVisuals.js b/src/render/broodVisuals.js
new file mode 100644
index 0000000..5906fae
--- /dev/null
+++ b/src/render/broodVisuals.js
@@ -0,0 +1,169 @@
+// Exact Brood anatomy and attack receipts. Presentation never owns damage, motion or targeting.
+import { BROOD_BODY_CONTRACTS } from '../data/broodBodies.js';
+import { BROOD_ATTACK_PROFILES } from '../data/broodAttackProfiles.js';
+
+// Presentation reserve follows the existing production cap; stress probes do not raise it.
+export const BROOD_CUE_CAPACITY = Math.max(...Object.values(BROOD_BODY_CONTRACTS).map(body => body.productionCap));
+export const BROOD_CUE_SURFACES = 6;
+const point = p => p && Number.isFinite(p.x) && Number.isFinite(p.z);
+const clamp = n => Math.max(0, Math.min(1, n));
+const smooth = n => { const t = clamp(n); return t * t * (3 - 2 * t); };
+export function broodVisualBody(entity) {
+  const id = entity?.data?.broodBodyId;
+  return Object.hasOwn(BROOD_BODY_CONTRACTS, id) ? BROOD_BODY_CONTRACTS[id] : null;
+}
+export function isBroodBody(entity) { return !!broodVisualBody(entity); }
+export function broodPhaseDuration(role, phase) {
+  return BROOD_ATTACK_PROFILES[role]?.[`${phase}Ticks`] || 0;
+}
+
+// A body/life pair is the authority, never the event alone. Returning the current record is
+// allocation-free; callers that retain a visual copy must retain its life and locked line too.
+export function readBroodAttack(entity, tick = entity?.data?.broodAttack?.sampledTick) {
+  const body = broodVisualBody(entity), attack = entity?.data?.broodAttack;
+  if (!body || entity.alive === false || !attack || attack.role !== body.id
+    || !Number.isSafeInteger(entity.occupantGeneration) || attack.life !== entity.occupantGeneration
+    || !Number.isSafeInteger(tick) || !Number.isSafeInteger(attack.phaseStartedTick)
+    || tick < attack.phaseStartedTick) return null;
+  if (attack.phase === 'approach') return attack;
+  const duration = broodPhaseDuration(body.id, attack.phase);
+  if (!duration || tick >= attack.phaseStartedTick + duration) return null;
+  if (attack.phase === 'recovery') return attack;
+  const line = attack.attackLine;
+  if (typeof attack.attackId !== 'string' || !attack.attackId || line?.life !== attack.life
+    || !Number.isSafeInteger(attack.cueStartedTick) || line.cueStartedTick !== attack.cueStartedTick
+    || !Number.isSafeInteger(attack.targetLife) || attack.targetLife <= 0 || line.targetLife !== attack.targetLife
+    || attack.cueStartedTick > attack.phaseStartedTick || !point(line.origin) || !point(line.dir)
+    || !Number.isFinite(line.heading) || !(line.range > 0) || !Number.isFinite(line.range)
+    || !(line.halfWidth > 0) || !Number.isFinite(line.halfWidth)
+    || Math.abs(Math.hypot(line.dir.x, line.dir.z) - 1) > 1e-5
+    || Math.abs(Math.cos(line.heading) - line.dir.x) > 1e-5
+    || Math.abs(Math.sin(line.heading) - line.dir.z) > 1e-5
+    || entity.data.broodAttackInterruptedTick >= attack.phaseStartedTick) return null;
+  return attack;
+}
+
+export function resolveBroodAttackCue(name, payload, state) {
+  const entity = state.entities?.get?.(payload?.entityId);
+  const attack = readBroodAttack(entity, state.tick);
+  if (!attack || BROOD_ATTACK_PROFILES[attack.role]?.delivery === 'projectile'
+    || (attack.phase !== 'windup' && attack.phase !== 'commit')) return null;
+  // Projectile anatomy telegraphs pressure, never a fixed corridor that promises its flight path.
+  if (name === 'brood:phase') {
+    if (payload.life !== attack.life || payload.attackId !== attack.attackId
+      || payload.phase !== attack.phase || payload.phaseStartedTick !== attack.phaseStartedTick) return null;
+  } else if (name === 'ai:telegraph') {
+    if (attack.phase !== 'windup' || !['brood_charge', 'brood_lunge'].includes(payload.kind)
+      || payload.attackLine?.life !== attack.life
+      || payload.attackLine?.cueStartedTick !== attack.cueStartedTick) return null;
+  } else return null;
+  if (Number.isSafeInteger(payload.tick) && (payload.tick > state.tick || payload.tick < attack.phaseStartedTick)) return null;
+  const target = state.entities?.get?.(attack.targetId);
+  if (!target || target.alive === false || target.occupantGeneration !== attack.targetLife) return null;
+  const line = attack.attackLine;
+  // Ignore event coordinates. Only the accepted, current-life world lane is allowed to draw.
+  return { entityId: entity.id, sourceId: entity.id, targetId: entity.id,
+    kind: attack.phase, broodCue: true, broodAttack: attack, broodTarget: target,
+    pos: { x: line.origin.x, z: line.origin.z }, direction: line.dir, attachToTarget: false };
+}
+
+export function broodCueStillCurrent(slot, state) {
+  const entity = state.entities?.get?.(slot.id);
+  if (entity !== slot.target || entity?.occupantGeneration !== slot.broodLife) return false;
+  const attack = readBroodAttack(entity, state.tick), line = attack?.attackLine;
+  const target = state.entities?.get?.(attack?.targetId);
+  return !!(target && target === slot.broodTarget && target.occupantGeneration === slot.broodTargetLife
+    && target.occupantGeneration === attack?.targetLife && target.alive !== false && attack?.attackId === slot.broodAttackId
+    && attack.phase === slot.kind && attack.phaseStartedTick === slot.broodPhaseStartedTick
+    && line.origin.x === slot.x && line.origin.z === slot.z && line.heading === slot.angle
+    && line.range === slot.broodRange && line.halfWidth === slot.broodHalfWidth);
+}
+
+function inside(root, mesh) {
+  for (let node = root; node; node = node.parent) if (node === mesh) return true;
+  return false;
+}
+export function broodPoseFraction(entity, reducedMotion = false) {
+  const body = broodVisualBody(entity), attack = readBroodAttack(entity);
+  if (!body) return 0;
+  const poses = body.motion.poses;
+  if (BROOD_ATTACK_PROFILES[body.id]?.delivery === 'projectile') {
+    const rest = poses.approach;
+    if (!attack || attack.phase === 'approach' || !Number.isSafeInteger(attack.cueStartedTick)
+      || typeof attack.attackId !== 'string' || !attack.attackId) return rest;
+    const age = attack.sampledTick - attack.phaseStartedTick;
+    const shot = entity.data.broodShot;
+    const fired = shot?.attackId === attack.attackId && shot.life === attack.life
+      && shot.targetLife === attack.targetLife && Number.isSafeInteger(shot.tick)
+      && shot.tick >= attack.cueStartedTick + broodPhaseDuration(body.id, 'windup')
+      && shot.tick <= attack.sampledTick
+      && shot.tick < attack.cueStartedTick + broodPhaseDuration(body.id, 'windup') + broodPhaseDuration(body.id, 'commit');
+    if (fired) {
+      const sinceShot = attack.sampledTick - shot.tick;
+      if (reducedMotion) return poses.attack + (rest - poses.attack) * smooth(sinceShot / broodPhaseDuration(body.id, 'recovery'));
+      if (sinceShot < 4) return poses.windup + (poses.attack - poses.windup) * smooth(sinceShot / 4);
+      return poses.attack + (rest - poses.attack) * smooth((sinceShot - 4) / (broodPhaseDuration(body.id, 'recovery') - 4));
+    }
+    if (attack.phase === 'windup') return reducedMotion ? poses.windup
+      : rest + (poses.windup - rest) * smooth(age / broodPhaseDuration(body.id, 'windup'));
+    if (attack.phase === 'commit') return poses.windup; // A phase is not proof of an emitted glob.
+    const inflated = rest + (poses.windup - rest) * smooth((attack.phaseStartedTick - attack.cueStartedTick) / broodPhaseDuration(body.id, 'windup'));
+    return reducedMotion ? rest : inflated + (rest - inflated) * smooth(age / broodPhaseDuration(body.id, 'recovery'));
+  }
+  if (!attack || attack.phase === 'approach') return 0;
+  if (reducedMotion) return attack.phase === 'commit' ? poses.attack : poses[attack.phase];
+  const age = attack.sampledTick - attack.phaseStartedTick;
+  if (attack.phase === 'windup') return poses.windup * smooth(age / broodPhaseDuration(body.id, 'windup'));
+  if (attack.phase === 'commit') return poses.windup + (poses.attack - poses.windup) * smooth(age / 8);
+  // Recovery unloads the paddles, then rests; no oscillation can look like another strike.
+  if (age < 8) return poses.attack + (poses.recovery - poses.attack) * smooth(age / 8);
+  return poses.recovery * (1 - smooth((age - 8) / (broodPhaseDuration(body.id, 'recovery') - 8)));
+}
+
+export function createBroodMotionDriver(root, entity) {
+  const body = broodVisualBody(entity);
+  if (!root || !body) return null;
+  const byName = new Map(body.motion.rigs.map(rig => [rig.node, rig]));
+  const found = new Set(), joints = [];
+  root.traverse(node => {
+    const rig = byName.get(node.name);
+    if (!rig) return;
+    found.add(rig.node);
+    joints.push({ node, rig, position: node.position.clone(), quaternion: node.quaternion.clone() });
+  });
+  if (found.size !== byName.size) throw new Error(`Brood ${body.id} is missing a sealed anatomical motion pivot`);
+  const id = entity.id, life = entity.occupantGeneration;
+  let owner = entity, activated = entity.deferAuthoredMotionRegistration !== true, disposed = false;
+  const pose = fraction => {
+    for (const { node, rig, position, quaternion } of joints) {
+      node.position.copy(position); node.quaternion.copy(quaternion);
+      if (rig.translation) {
+        node.position.x += rig.translation[0] * fraction;
+        node.position.y += rig.translation[1] * fraction;
+        node.position.z += rig.translation[2] * fraction;
+      } else {
+        // All sealed folds are local X rigid hinges over fixed collision-bearing scutes.
+        const half = (rig.foldRadians || 0) * fraction / 2, s = Math.sin(half), c = Math.cos(half);
+        node.quaternion.set(quaternion.x*c + quaternion.w*s, quaternion.y*c + quaternion.z*s,
+          quaternion.z*c - quaternion.y*s, quaternion.w*c - quaternion.x*s);
+      }
+      node.updateMatrix();
+    }
+  };
+  const update = (liveEntity, a11y) => {
+    const valid = !disposed && activated && liveEntity === owner && owner.alive !== false
+      && owner.occupantGeneration === life && broodVisualBody(owner) === body && inside(root, owner.mesh);
+    pose(valid ? broodPoseFraction(owner, !!(a11y?.reducedMotion || a11y?.motionReduce)) : 0);
+  };
+  const activate = liveEntity => {
+    if (disposed) return false;
+    if (activated) return liveEntity === owner && owner.occupantGeneration === life;
+    if (!liveEntity || liveEntity.deferAuthoredMotionRegistration === true || liveEntity.alive === false
+      || liveEntity.id !== id || !Number.isSafeInteger(life) || liveEntity.occupantGeneration !== life
+      || broodVisualBody(liveEntity) !== body || !inside(root, liveEntity.mesh)) return false;
