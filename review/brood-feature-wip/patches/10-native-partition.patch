+// Authoritative rigid decomposition. Cells describe material that already exists in the parent.
+// Centers are child source origins in parent-local coordinates. Anatomical cells are COM-rebased;
+// the one-body destruction fallback retains the original nonzero local COM.
+export function validateBodyPartition(parentSpec, parts) {
+  if (!parentSpec?.dynamic || !Array.isArray(parts) || !parts.length || parts.length > 3) return false;
+  const p = parentSpec.centerOfMass || {
+    x: 0,
+    y: 0,
+    z: 0
+  };
+  let mass = 0,
+    x = 0,
+    z = 0,
+    inertia = 0;
+  for (const part of parts) {
+    const s = part?.spec,
+      c = part?.center;
+    if (!s?.dynamic || !c || ![c.x, c.z, part.yaw ?? 0, s.mass, s.inertiaY].every(Number.isFinite) || !(s.mass > 0) || !(s.inertiaY > 0)) return false;
+    const a = part.yaw ?? 0,
+      cc = s.centerOfMass || {
+        x: 0,
+        z: 0
+      };
+    const qx = c.x + Math.cos(a) * cc.x - Math.sin(a) * cc.z,
+      qz = c.z + Math.sin(a) * cc.x + Math.cos(a) * cc.z;
+    mass += s.mass;
+    x += s.mass * qx;
+    z += s.mass * qz;
+    inertia += s.inertiaY + s.mass * ((qx - p.x) ** 2 + (qz - p.z) ** 2);
+  }
+  const near = (a, b) => Math.abs(a - b) <= Math.max(1, Math.abs(b)) * 1e-6;
+  return near(mass, parentSpec.mass) && near(x / mass, p.x) && near(z / mass, p.z) && near(inertia, parentSpec.inertiaY);
+}
+export function partitionKinematics(parent, center, yaw = 0, childCom = {
+  x: 0,
+  z: 0
+}) {
+  const rot = parent.rot,
+    c = Math.cos(rot),
+    s = Math.sin(rot);
+  const px = c * center.x - s * center.z,
+    pz = s * center.x + c * center.z;
+  const com = parent.centerOfMass || {
+    x: 0,
+    z: 0
+  };
+  const qx = center.x + Math.cos(yaw) * childCom.x - Math.sin(yaw) * childCom.z - com.x;
+  const qz = center.z + Math.sin(yaw) * childCom.x + Math.cos(yaw) * childCom.z - com.z;
+  const rx = c * qx - s * qz,
+    rz = s * qx + c * qz;
+  return {
+    pos: {
+      x: parent.pos.x + px,
+      z: parent.pos.z + pz
+    },
+    vel: {
+      x: parent.vel.x - parent.angVel * rz,
+      z: parent.vel.z + parent.angVel * rx
+    },
+    rot: rot + yaw,
+    angVel: parent.angVel
+  };
+}
