+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { stampOccupantGeneration } from '../src/core/entity.js';
+import { capturePhysicsCommands, consumePhysicsCommand, consumeProjectileContinuation,
+  queuePhysicsImpulse, queueProjectileContinuation, clearPhysicsAuthority,
+} from '../src/core/physicsAuthority.js';
+const body = () => ({ id: 1, alive: true, pos: { x: 0, z: 0 }, vel: { x: 0, z: 0 }, rot: 0 });
+const stateFor = e => { const state={tick:12,nextOccupantGeneration:100,entities:new Map([[e.id,e]])}; stampOccupantGeneration(state,e); return state; };
+test('recoil observation is detached, non-consuming and becomes empty after the native consumer', () => {
+ const e=body(),state=stateFor(e);queuePhysicsImpulse(e,{x:210});
+ const first=capturePhysicsCommands(state);
+ assert.deepEqual(capturePhysicsCommands(state),first);
+ first.entries[0].command.impulses[0].x=999;
+ assert.equal(consumePhysicsCommand(e).impulses[0].x,210);
+ assert.equal(consumePhysicsCommand(e),null);assert.deepEqual(capturePhysicsCommands(state).entries,[]);
+ queuePhysicsImpulse(e,{x:25});assert.equal(capturePhysicsCommands(state).entries[0].command.impulses[0].x,25);
+});
+test('same-object occupant replacement cannot relabel an old impulse or bounce', () => {
+ const e=body(),state=stateFor(e);queuePhysicsImpulse(e,{x:210});
+ queueProjectileContinuation(e,{velocity:{x:20,z:5},yaw:.2,tick:12});
+ stampOccupantGeneration(state,e);assert.deepEqual(capturePhysicsCommands(state).entries,[]);
+ assert.equal(consumePhysicsCommand(e),null);assert.equal(consumeProjectileContinuation(e),null);
+ queuePhysicsImpulse(e,{x:30});assert.equal(consumePhysicsCommand(e).impulses[0].x,30);
+});
+test('removed occupants and explicit clear cannot leave observed recoil behind', () => {
+ const e=body(),state=stateFor(e);queuePhysicsImpulse(e,{x:210});e.alive=false;
+ assert.deepEqual(capturePhysicsCommands(state).entries,[]);e.alive=true;clearPhysicsAuthority(e);
+ assert.deepEqual(capturePhysicsCommands(state).entries,[]);assert.equal(consumePhysicsCommand(e),null);
+});
