@@ -0,0 +1,42 @@
+// The source-only behavior gate deliberately has no rejected-art installation requirement.
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import * as ciReport from '../scripts/check-ci-report.mjs';
+import { resolveAggregateCommand } from '../scripts/lib/ciGateGraph.mjs';
+
+const workflow = readFileSync(new URL('../.github/workflows/check.yml', import.meta.url), 'utf8');
+const scripts = JSON.parse(readFileSync(new URL('../package.json', import.meta.url), 'utf8')).scripts;
+function step(name) {
+  const start = workflow.indexOf(`      - name: ${name}`);
+  assert.ok(start >= 0, name);
+  const next = workflow.indexOf('\n      - name:', start + 1);
+  return { start, source: workflow.slice(start, next < 0 ? undefined : next) };
+}
+function exactlyOnce(paths, source) {
+  const direct = workflow.split(/\r?\n/).filter(line => /node --test\s/.test(line))
+    .flatMap(line => line.trim().split(/\s+/));
+  const matrix = ciReport.buildCommandMatrix(resolveAggregateCommand(scripts, 'check:ci'), scripts);
+  const indirect = matrix.flatMap(def => ciReport.resolveLeafCommands(def.command, scripts))
+    .flatMap(command => command.split(/\s+/));
+  for (const path of paths) {
+    assert.ok(source.split(/\s+/).includes(path), path);
+    assert.equal(direct.filter(token => token === path).length, 1, path);
+    assert.equal(indirect.filter(token => token === path).length, 0, path);
+  }
+}
+test('source-only Brood regressions are independently reachable before program control', () => {
+  const gate = step('Validate source-only Brood behavior');
+  assert.ok(gate.start < step('Validate program control plane').start);
+  assert.ok(gate.source.includes('if: ${{ !cancelled() && matrix.shard == 1 }}'));
+  exactlyOnce(['brood-combat', 'brood-force-interactions', 'brood-spitter',
+    'brood-projectile-query', 'brood-physics-command-lifetime', 'swarm-specialist-debut',
+    'brood-source-ci'].map(name => `test/${name}.test.mjs`), gate.source);
+  assert.ok(!gate.source.includes('assets/ships/'), 'behavior gate does not certify historical art');
+});
+test('finite waves and retained Retry run once before the broader simulation aggregate', () => {
+  const gate = step('Validate finite Brood waves and retained Retry');
+  assert.ok(gate.start < step('Run sim check group').start);
+  assert.ok(gate.source.includes('if: ${{ !cancelled() }}'));
+  exactlyOnce(['test/brood-wave-lifecycle.test.mjs', 'test/brood-retained-wave-lifecycle.test.mjs'], gate.source);
+});
