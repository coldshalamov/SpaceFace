+++ b/test/brood-combat.test.mjs
@@ -0,0 +1,255 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { advanceBroodAttack, BROOD_ATTACK_PROFILES, BroodContactRuntime } from '../src/combat/broodContact.js';
+import { CombatDoctrineRuntime, applyCombatDoctrineToSelection } from '../src/ai/combatDoctrine.js';
+import { validateAIComponentContinuation, validateAIContinuationPayload, copyManeuver } from '../src/ai/continuation.js';
+import { PerceptionMemory } from '../src/ai/perception.js';
+import { COMBAT_LAB_STARTER_PACKAGES } from '../src/data/combatLabSetups.js';
+import { buildSlotList } from '../src/systems/ships.js';
+import { SHIPS } from '../src/data/ships.js';
+import { ManeuverPlanner } from '../src/ai/maneuver.js';
+import { createBus } from '../src/core/eventBus.js';
+import { combat, makeEnemySpawnSpec } from '../src/systems/combat.js';
+import { queuePhysicsImpulse } from '../src/core/physicsAuthority.js';
+import { tumbleStates } from '../src/systems/tumbleStates.js';
+import { bootRealPath, writeRealPathInput } from '../scripts/lib/bench/realPath.mjs';
+
+const frame = (z = 0) => ({ self: { id: 2, occupantGeneration: 20, team: 1, pos: { x: 0, z: 0 },
+  vel: { x: 0, z: 0 }, rot: 0, radius: 13, activity: { kind: 'attack_run' }, roe: 'weapons_free',
+  energyFraction: 1, heatFraction: 0, operationalMassBand: 'heavy' },
+  contacts: [{ id: 1, occupantGeneration: 10, kind: 'ship', team: 0, alive: true, hostile: true, valid: true, visible: true,
+    confidence: 1, pos: { x: 160, z }, vel: { x: 0, z: 0 }, radius: 12, tags: [], threat: 1 }] });
+const directive = { objective: { kind: 'focus', targetId: 1 }, formation: { slot: { x: 0, z: 0 },
+  velocity: { x: 0, z: 0 }, bound: 100, breakFormation: true } };
+
+test('charger freezes lane at cue start and recovers after a miss or real interruption', () => {
+  const runtime = new CombatDoctrineRuntime({ seed: 714 });
+  const update = (tick, perception = frame()) => runtime.update({ tick, entityId: 2,
+    doctrineId: 'brood_charge', perception, directive });
+  const cue = update(0);
+  assert.equal(cue.phase, 'windup');
+  assert.equal(cue.telegraph.durationTicks, 45);
+  const locked = cue.attackLine;
+  const committed = update(45, frame(110));
+  assert.equal(committed.phase, 'commit');
+  assert.deepEqual(committed.attackLine, locked);
+  assert.equal(committed.faceAngle, 0);
+  assert.equal(committed.allowedActionId, null);
+  const recovery = update(189, frame(110));
+  assert.equal(recovery.phase, 'recovery');
+  assert.equal(recovery.attackLine, null);
+  assert.equal(update(273).phase, 'approach');
+  assert.equal(update(274).phase, 'windup');
+  const interrupted = frame(); interrupted.self.broodAttackInterruptedTick = 275;
+  assert.equal(update(275, interrupted).phase, 'recovery');
+});
+
+test('sensor and frozen perception carry only validated target life; same-ID replacement cancels cue', () => {
+  const memory = new PerceptionMemory();
+  const valid = memory.observe(2, frame(), 0);
+  assert.equal(valid.contacts[0].occupantGeneration, 10);
+  const invalid = frame(); invalid.contacts[0].occupantGeneration = '10';
+  assert.equal(memory.observe(2, invalid, 1).contacts[0].occupantGeneration, null);
+  const runtime = new CombatDoctrineRuntime();
+  runtime.update({ tick: 0, entityId: 2, doctrineId: 'brood_charge', perception: frame(), directive });
+  const replacement = frame(); replacement.contacts[0].occupantGeneration = 11;
+  assert.equal(runtime.update({ tick: 45, entityId: 2, doctrineId: 'brood_charge', perception: replacement, directive }).phase, 'recovery');
+});
+
+test('committed motor uses finite forward force with no target, rock dodge, brake or lateral cancellation', () => {
+  const runtime = new CombatDoctrineRuntime({ seed: 714 });
+  runtime.update({ tick: 0, entityId: 2, doctrineId: 'brood_charge', perception: frame(), directive });
+  const perception = frame(110);
+  perception.self.vel.z = 65;
+  perception.contacts.push({ id: 3, kind: 'hazard', pos: { x: 35, z: 0 }, vel: { x: 0, z: 0 }, radius: 30, tags: ['solid'] });
+  const doctrine = runtime.update({ tick: 45, entityId: 2, doctrineId: 'brood_charge', perception, directive });
+  const planner = new ManeuverPlanner({ seed: 714, config: { squadFrames: false } });
+  const behavior = applyCombatDoctrineToSelection({ maneuver: { kind: 'intercept', formationSlot: { x: 0, z: 0 }, formationBound: 100 } }, doctrine);
+  const request = planner.plan({ tick: 45, entityId: 2, perception, directive, behavior });
+  assert.equal(request.targetHeading, 0);
+  assert.equal(request.forceLocal.right, 0);
+  assert.ok(request.forceLocal.forward > 0 && request.forceLocal.forward <= 1);
+  assert.equal(request.brake, false);
+  assert.equal(request.boost, false);
+  const ordinary = new ManeuverPlanner({ seed: 714, config: { squadFrames: false } }).plan({ tick: 45,
+    entityId: 2, perception, directive, behavior: { maneuver: { kind: 'intercept', targetId: 1, breakFormation: true } } });
+  assert.notEqual(ordinary.targetHeading, 0, 'ordinary pilot retains obstacle/target steering');
+});
+
+test('Brood continuation is typed and an active promise is safely cancelled on restore', () => {
+  const runtime = new CombatDoctrineRuntime({ seed: 714 });
+  runtime.update({ tick: 0, entityId: 2, doctrineId: 'brood_charge', perception: frame(), directive });
+  const saved = runtime.serializeContinuation();
+  assert.equal(saved.rows[0][1].broodAttack.phase, 'windup');
+  assert.doesNotThrow(() => validateAIComponentContinuation('doctrine', saved));
+  const target = new CombatDoctrineRuntime({ seed: 714 });
+  const commit = target.prepareContinuation(saved, { tick: 0, bindEntity: id => id, resolveEntity: () => null });
+  commit();
+  assert.equal(target.inspect(2), null);
+  const motor = copyManeuver({ entityId: 2, forceLocal: { forward: 1, right: 1 }, torqueYaw: 1, boost: true, brake: true },
+    { bindEntity: id => id, resolveEntity: () => ({ data: { broodBodyId: 'brood_charger' } }) }, true);
+  assert.deepEqual(motor.forceLocal, { forward: 0, right: 0 });
+  assert.equal(motor.boost, false);
+});
+
+test('contact damage requires current-life native impact and spends once, leaving terrain immunity alone', () => {
+  const bus = createBus(), packets = [];
+  const actor = { ...makeEnemySpawnSpec('brood_charger', 1, { x: 0, z: 0 }), id: 2, alive: true, occupantGeneration: 20 };
+  const player = { id: 1, team: 0, alive: true, occupantGeneration: 10 };
+  const rock = { id: 3, type: 'asteroid', alive: true };
+  const state = { tick: 45, mode: 'flight', playerId: 1, entityList: [actor, player, rock], entities: new Map([[2,actor],[1,player],[3,rock]]) };
+  const host = { state, bus, ensureKernel: () => ({ routeDamage: packet => { packets.push(packet); return { ok: true }; } }) };
+  const runtime = new BroodContactRuntime(host);
+  const arm = () => { actor.data.broodAttack = advanceBroodAttack(null, { role: 'brood_charger', entityId: 2, tick: 0,
+    self: { ...actor, rot: 0 }, target: { id: 1, occupantGeneration: 10, pos: { x: 100, z: 0 } } });
+    actor.data.broodAttack = advanceBroodAttack(actor.data.broodAttack, { role: 'brood_charger', entityId: 2, tick: 45,
+      self: actor, target: { id: 1, occupantGeneration: 10, pos: { x: 100, z: 0 } } }); };
+  arm();
+  const impact = { aId: 2, bId: 1, tick: 45, consequenceKernelVersion: 1, impulse: 200, pos: { x: 10, z: 0 } };
+  runtime.onImpact({ ...impact, tick: 44 });
+  runtime.onImpact({ ...impact, consequenceKernelVersion: 0 });
+  runtime.onImpact({ ...impact, impulse: 0 });
+  assert.equal(packets.length, 0);
+  runtime.onImpact(impact); runtime.onImpact(impact);
+  assert.equal(packets.length, 1);
+  assert.equal(packets[0].packet.impulse, null);
+  bus.emit('game:newGame', {});
+  assert.equal(actor.data.broodAttack, undefined);
+  arm(); actor.occupantGeneration++;
+  runtime.onImpact(impact);
+  assert.equal(packets.length, 1, 'copied attack cannot attach to recycled entity life');
+  actor.occupantGeneration--; delete actor.data.broodAttackInterruptedTick;
+  player.occupantGeneration = 11;
+  runtime.onImpact(impact);
+  assert.equal(packets.length, 1, 'same-id replacement target cannot inherit the attack');
+  player.occupantGeneration = 10;
+  runtime.reset(); arm();
+  runtime.onImpact({ ...impact, bId: 3 }); runtime.onImpact(impact);
+  assert.equal(packets.length, 1, 'rock collision spends attack without player damage');
+  runtime.destroy();
+  bus.emit('physics:impact', impact);
+  assert.equal(packets.length, 1);
+});
+
+test('phase receipts cannot skip the cue or introduce a delayed promise for a replacement target', () => {
+  const actor = { ...makeEnemySpawnSpec('brood_charger', 1, { x: 0, z: 0 }), id: 2, alive: true, occupantGeneration: 20 };
+  const target = { id: 1, occupantGeneration: 10, alive: true, pos: { x: 100, z: 0 } };
+  const state = { tick: 0, entities: new Map([[2,actor],[1,target]]), entityList: [actor,target] };
+  const runtime = new BroodContactRuntime({ state, bus: createBus() });
+  const attack = advanceBroodAttack(null, { role: 'brood_charger', entityId: 2, tick: 0, self: actor, target });
+  const event = { entityId: 2, targetId: 1, doctrineId: 'brood_charge', attackLine: attack.attackLine, phase: 'windup', tick: 0 };
+  runtime.onPhase(event);
+  state.tick = 1; runtime.onPhase({ ...event, phase: 'commit', tick: 1 });
+  assert.equal(actor.data.broodAttack.phase, 'windup', 'a phase event cannot erase the response window');
+  state.tick = 45; runtime.onPhase({ ...event, phase: 'commit', tick: 45 });
+  assert.equal(actor.data.broodAttack.phase, 'commit');
+  runtime.reset(); state.tick = 0; target.occupantGeneration = 11;
+  runtime.onPhase(event);
+  assert.equal(actor.data.broodAttack, undefined, 'a delayed first event cannot bind the replacement');
+  runtime.destroy();
+});
+
+async function runCharge({ sidestep = false, rock = false, shove = false, role = 'brood_charger', distance = 155 } = {}) {
+  const host = await bootRealPath({ seed: 714, systems: ['tacticalAI', 'actions', 'flightV3', 'aiPorts', tumbleStates,
+    'collisionConsequences', 'physics', combat], hulls: [{ hullId: 'ship_kestrel', pos: { x: 0, z: 0 }, rot: 0, isPlayer: true }] });
+  const spec = makeEnemySpawnSpec(role, 1, { x: -distance, z: 0 });
+  spec.data.ai.forcePlayerTarget = true; spec.data.ai.huntPlayer = true;
+  spec.data.ai.moraleImmune = true; spec.data.ai.surrenderImmune = true;
+  spec.data.runCohort = 'survival'; spec.data.combat.targetId = host.player.id;
+  spec.data.ai.activity = { ...spec.data.ai.activity, targetId: host.player.id };
+  const actor = host.runtime.spawn(spec), phases = [], impacts = [], contacts = [];
+  host.bus.on('brood:phase', p => phases.push({ phase: p.phase, tick: p.tick, pos: { ...actor.pos }, line: p.attackLine }));
+  host.bus.on('physics:impact', p => impacts.push(p));
+  host.bus.on('brood:contact', p => contacts.push(p));
+  if (rock) host.spawnObstacle({ pos: { x: -45, z: 0 }, radius: 20, mass: 800 });
+  let pushed = false, startedDodge = false;
+  const initial = { hull: host.player.hull, shield: host.player.shield, actorHull: actor.hull };
+  let maxSpeed = 0, minDistance = Infinity, maxPlayerHeading = 0, captured = new Set();
+  try {
+    host.step(420, { before: () => {
+      const a = actor.data.broodAttack;
+      if (sidestep && a?.phase === 'windup' && host.state.tick - a.phaseStartedTick >= 25) startedDodge = true;
+      writeRealPathInput(host.state, { moveX: startedDodge ? 1 : 0 });
+      if (shove && !pushed && a?.phase === 'commit') { queuePhysicsImpulse(actor, { x: 0, y: 0, z: actor.mass * 85 }); pushed = true; }
+    }, after: () => {
+      const phase = actor.data.broodAttack?.phase;
+      if (phase && !captured.has(phase)) {
+        const stack = host.runtime.getSystem('tacticalAI').stack;
+        assert.equal(validateAIComponentContinuation('doctrine', stack.combatDoctrine.serializeContinuation()), true);
+        assert.equal(validateAIComponentContinuation('maneuver', stack.maneuver.serializeContinuation()), true);
+        captured.add(phase);
+      }
+      maxPlayerHeading = Math.max(maxPlayerHeading, Math.abs(host.player.rot));
+      maxSpeed = Math.max(maxSpeed, Math.hypot(actor.vel.x, actor.vel.z));
+      minDistance = Math.min(minDistance, Math.hypot(actor.pos.x-host.player.pos.x, actor.pos.z-host.player.pos.z));
+      if (phases.some(p => p.phase === 'recovery')) return false;
+    } });
+    let postHitSteerDistance = null;
+    if (contacts.length) {
+      const z = host.player.pos.z;
+      host.step(45, { before: () => writeRealPathInput(host.state, { moveX: 1 }) });
+      postHitSteerDistance = Math.abs(host.player.pos.z - z);
+    }
+    if (shove) host.step(60, { before: () => writeRealPathInput(host.state, {}) });
+    return { phases, impacts, contacts, pushed, initial, actorHull: actor.hull, actorAlive: actor.alive,
+      postHitSteerDistance, maxPlayerHeading, finalPos: { ...actor.pos }, playerPos: { ...host.player.pos }, maxSpeed, minDistance, proof: host.proof() };
+  } finally { host.dispose(); }
+}
+
+test('real Rapier route: committed pass hits, late sidestep misses, shove redirects, rock damages charger', { timeout: 120000 }, async () => {
+  const hit = await runCharge();
+  const dodge = await runCharge({ sidestep: true });
+  const pushed = await runCharge({ shove: true });
+  const cover = await runCharge({ rock: true });
+  console.log('Brood real-path', JSON.stringify(Object.fromEntries(Object.entries({ hit, dodge, pushed, cover }).map(([key,r]) => [key, { phases: r.phases.map(p=>[p.phase,p.tick]), contacts:r.contacts.length, maxSpeed:r.maxSpeed, minDistance:r.minDistance, finalPos:r.finalPos, playerPos:r.playerPos, actorHull:r.actorHull,postHitSteer:r.postHitSteerDistance,playerYaw:r.maxPlayerHeading }]))));
+  for (const row of [hit,dodge,pushed,cover]) assert.equal(row.proof.sg02Ready, true);
+  assert.ok(hit.phases.some(p => p.phase === 'commit'));
+  assert.ok(dodge.maxSpeed < 153, 'bounded propulsion burst stays below the measured 163WU/s starter sustain; no velocity clamp');
+  assert.equal(hit.contacts.length, 1, 'actual contact spends exactly one authored attack');
+  assert.ok(hit.postHitSteerDistance > 20, 'pilot retains meaningful sideways control after native contact');
+  assert.ok(hit.maxPlayerHeading < 0.1, 'contact does not add a second yaw/helm impulse');
+  assert.equal(dodge.contacts.length, 0, 'late sideways flight evades frozen lane');
+  assert.ok(dodge.playerPos.z > 25);
+  assert.equal(pushed.contacts.length, 0);
+  assert.ok(Math.abs(pushed.finalPos.z) > 25, 'real impulse redirects actual body');
+  assert.ok(cover.actorHull < cover.initial.actorHull || !cover.actorAlive, 'real cover impact hurts attacker');
+  assert.equal(cover.contacts.length, 0);
+});
+
+ test('real mite cohort lunges with contact-only damage and keeps impulse coast into cover', { timeout: 120000 }, async () => {
+  const hit = await runCharge({ role: 'brood_mite', distance: 90 });
+  const shove = await runCharge({ role: 'brood_mite', distance: 90, shove: true });
+  console.log('Mite real-path', JSON.stringify(Object.fromEntries(Object.entries({ hit, shove }).map(([k,r]) => [k,{ phases:r.phases.map(p=>[p.phase,p.tick]),contacts:r.contacts.length,finalPos:r.finalPos,maxSpeed:r.maxSpeed }]))));
+  assert.equal(hit.contacts.length, 1);
+  assert.ok(hit.phases.some(p => p.phase === 'windup'));
+  assert.ok(hit.phases.some(p => p.phase === 'commit'));
+  assert.equal(shove.contacts.length, 0);
+  assert.ok(Math.abs(shove.finalPos.z) > 20);
+ });
+
+ test('slow starter opens distance during real five-second pursuit without a Brood sustained-speed advantage', { timeout: 120000 }, async () => {
+  const pkg = COMBAT_LAB_STARTER_PACKAGES.find(p => p.id === 'energy_baseline');
+  const fittings = buildSlotList(SHIPS.find(s => s.id === pkg.hullId)).map(() => null);
+  for (const entry of pkg.loadout) fittings[entry.slotIndex] = entry.defId;
+  const host = await bootRealPath({ seed: 714, systems: ['tacticalAI','actions','flightV3','aiPorts',tumbleStates,'collisionConsequences','physics',combat],
+    hulls: [{ hullId: pkg.hullId, fittings, pos: { x: 0, z: 0 }, rot: 0, isPlayer: true }] });
+  try {
+    const spec = makeEnemySpawnSpec('brood_charger', 1, { x: -155, z: 0 });
+    spec.data.ai.forcePlayerTarget = true; spec.data.ai.huntPlayer = true; spec.data.ai.moraleImmune = true;
+    spec.data.runCohort = 'survival'; spec.data.combat.targetId = host.player.id;
+    const actor = host.runtime.spawn(spec), starts = {};
+    let peak = 0;
+    host.step(300, { before: ({ index }) => {
+      writeRealPathInput(host.state, { moveZ: 1 });
+      if (index === 180) { starts.player = host.player.pos.x; starts.actor = actor.pos.x; }
+    }, after: () => { peak = Math.max(peak, Math.hypot(actor.vel.x, actor.vel.z)); } });
+    const playerSustain = (host.player.pos.x - starts.player) / 2;
+    const chargerSustain = (actor.pos.x - starts.actor) / 2;
+    const separation = Math.hypot(actor.pos.x-host.player.pos.x, actor.pos.z-host.player.pos.z);
+    console.log('Brood starter escape', JSON.stringify({ playerSustain, chargerSustain, chargerPeak: peak, separation }));
+    assert.equal(host.proof().sg02Ready, true);
+    assert.ok(playerSustain > chargerSustain + 10);
+    assert.ok(separation > 225 && separation < 740, 'escape happens while both bodies stay on the active physics route');
+    assert.ok(peak < 155, 'attack burst is bounded independently from whole-cycle sustain');
+  } finally { host.dispose(); }
+ });
diff --git a/test/brood-force-interactions.test.mjs b/test/brood-force-interactions.test.mjs
