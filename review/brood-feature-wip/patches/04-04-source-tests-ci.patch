+  assert.deepEqual(next.nativeTape,first.nativeTape,'retained Retry preserves every quantized native position, velocity and yaw');
+  });
+ }finally{h.runtime.dispose();clearCrucibleSetup();}
+ assert.equal(SWARM_ROSTER.filter(e=>!e.enemyId.startsWith('brood_')).length,15,'existing roster preserved');
+});
