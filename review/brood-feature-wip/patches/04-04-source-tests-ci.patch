@@ -0,0 +1,114 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { makeEnemySpawnSpec, combat } from '../src/systems/combat.js';
+import { fields } from '../src/systems/fields.js';
+import { tumbleStates } from '../src/systems/tumbleStates.js';
+import { scalarHitToDamagePacket } from '../src/combat/damage.js';
+import { broodBodyContract, broodCollisionManifest } from '../src/data/broodBodies.js';
+import { WEAPONS } from '../src/data/weapons.js';
+import { bootRealPath, writeRealPathInput } from '../scripts/lib/bench/realPath.mjs';
+
+const SYSTEMS = ['tacticalAI', 'actions', 'flightV3', 'aiPorts', tumbleStates, 'collisionConsequences', 'weapons', fields, 'physics', combat];
+async function boot(systems = SYSTEMS, playerX = 0) {
+  return bootRealPath({ seed: 31471, systems,
+    hulls: [{ hullId: 'ship_kestrel', pos: { x: playerX, z: 0 }, rot: 0, isPlayer: true }] });
+}
+function spawn(host, role, pos, { quiet = true } = {}) {
+  const spec = makeEnemySpawnSpec(role, 1, pos);
+  spec.data.ai.forcePlayerTarget = true;
+  spec.data.ai.moraleImmune = true;
+  spec.data.ai.surrenderImmune = true;
+  spec.data.runCohort = 'survival';
+  spec.data.combat.targetId = host.player.id;
+  if (quiet) { spec.data.ai.passive = true; spec.data.ai.allowPassiveManeuver = false; delete spec.data.ai.cohortRecipe; }
+  const entity = host.runtime.spawn(spec);
+  const body = broodBodyContract(role);
+  assert.equal(entity.physicsBody.collisionProxyManifest.id, broodCollisionManifest(role).id);
+  assert.equal(entity.physicsBody.mass, body.mass);
+  assert.equal(entity.physicsBody.radius, body.radius);
+  return entity;
+}
+
+test('real fields couple to both finite Brood masses through existing well and repulsor input', { timeout: 120000 }, async () => {
+  const rows = [];
+  for (const kind of ['well','repulsor']) {
+    const host = await boot();
+    try {
+      const mite = spawn(host, 'brood_mite', { x: 85, z: -25 });
+      const charger = spawn(host, 'brood_charger', { x: 85, z: 25 });
+      const deployed = [];
+      host.bus.on('fields:deployed', p => deployed.push(p));
+      host.state.input.aimWorld = { x: 150, z: 0 };
+      host.state.input.actions[kind === 'well' ? 'deployWell' : 'deployRepulsor'] = true;
+      host.step(120, { before: () => writeRealPathInput(host.state, {}) });
+      rows.push({ kind, mite: { pos: mite.pos, vel: mite.vel }, charger: { pos: charger.pos, vel: charger.vel } });
+      assert.equal(host.proof().sg02Ready, true);
+      assert.equal(deployed.length, 1);
+      assert.ok(mite.pos.x > 90, `${kind}: light organic body moves`);
+      assert.ok(charger.pos.x > 86, `${kind}: heavy organic body is not immune`);
+      if (kind === 'repulsor') assert.ok(mite.pos.x > charger.pos.x, 'mass affects the same applied field');
+      if (kind === 'well') assert.ok(Math.abs(mite.pos.z) < 25, 'well pulls laterally toward actual source');
+    } finally { host.dispose(); }
+  }
+  console.log('Brood force probes', JSON.stringify(rows));
+});
+
+test('real mass-driver impulse makes a mite ordinary ballistic ammunition into a rock', { timeout: 120000 }, async () => {
+  const host = await boot(SYSTEMS, 260);
+  try {
+    const mite = spawn(host, 'brood_mite', { x: 0, z: 0 }, { quiet: false });
+    // A live packmate keeps the existing shared planner sampling while the struck helm tumbles.
+    spawn(host, 'brood_mite', { x: 0, z: -80 }, { quiet: false });
+    const rock = host.spawnObstacle({ pos: { x: 0, z: 70 }, radius: 24, mass: 720 });
+    const cannon = WEAPONS.find(w => w.id === 'wpn_mass_driver');
+    const impacts = [], killed = [];
+    host.bus.on('physics:impact', p => impacts.push(p));
+    host.bus.on('entity:killed', p => killed.push(p));
+    host.step(30);
+    const hullBefore = mite.hull;
+    host.withFeatures(() => host.runtime.getSystem('combat').ensureKernel().routeDamage({ attackerId: host.player.id, targetId: mite.id,
+      packet: scalarHitToDamagePacket({ damage: cannon.dmg, damageType: cannon.damageType,
+        impulse: { x: 0, z: cannon.impulsePerHit }, tumbleTorque: cannon.tumbleTorque,
+        pos: { ...mite.pos }, source: { kind: 'weapon', weaponId: cannon.id, impulseProvenance: cannon.impulseProvenance } }),
+      origin: { kind: 'weapon', id: cannon.id, weaponId: cannon.id } }));
+    const gunHull = mite.hull;
+    let coast = false, ammo = false;
+    host.step(180, { after: () => {
+      const cohorts = host.runtime.getSystem('tacticalAI').stack.fodderCohorts.inspect();
+      const member = Object.values(cohorts).map(group => group.members[String(mite.id)]).find(Boolean);
+      coast ||= member?.coast === true;
+      ammo ||= member?.ammunition === true;
+      if (mite.alive === false) return false;
+    } });
+    console.log('Brood ammo probe', JSON.stringify({ hullBefore, gunHull, finalHull: mite.hull, alive: mite.alive, coast, ammo, impacts: impacts.length, killed: killed.length }));
+    assert.ok(gunHull > 0, 'the shot itself must not manufacture the rock kill');
+    assert.ok(impacts.some(p => (p.aId === mite.id && p.bId === rock.id) || (p.bId === mite.id && p.aId === rock.id)));
+    assert.ok(mite.hull < gunHull || mite.alive === false, 'ordinary collision consequence adds the physical damage');
+    assert.ok(coast, 'existing cohort coast yields to the impulse');
+    assert.ok(ammo, 'existing shared cohort identifies the incoming body as ammunition');
+    assert.ok(killed.filter(p => p.id === mite.id).length <= 1, 'one life produces at most one kill receipt');
+  } finally { host.dispose(); }
+});
+
+test('real projectiles hit the Brood body and kernel admits an ordinary tether', { timeout: 120000 }, async () => {
+  const host = await boot();
+  try {
+    const mite = spawn(host, 'brood_mite', { x: 90, z: 0 });
+    const charger = spawn(host, 'brood_charger', { x: 130, z: 55 });
+    const hits = [];
+    host.bus.on('projectile:hit', p => hits.push(p));
+    host.step(1);
+    host.assertBodies([host.player, mite, charger]);
+    const tether = host.withFeatures(() => host.runtime.getSystem('combat').ensureKernel().attachments.create({
+      defId: 'tether_standard', ownerId: host.player.id, targetId: charger.id }));
+    assert.equal(tether.ok, true, JSON.stringify(tether));
+    const attachment = host.runtime.getSystem('combat').ensureKernel().attachments.get(tether.attachment?.id ?? tether.attachmentId ?? tether.id);
+    console.log('Brood tether receipt', JSON.stringify({ id: attachment?.id, state: attachment?.state, targetId: attachment?.targetId, targetSocketId: attachment?.targetSocketId }));
+    assert.ok(attachment?.state === 'active');
+    assert.deepEqual(attachment.targetAnchorLocal, { x: broodBodyContract('brood_charger').sockets.SOCKET_BROOD_TETHER_DORSAL.position[0], z: 0 });
+    host.state.input.aimWorld = { x: 90, z: 0 };
+    host.step(240, { before: () => writeRealPathInput(host.state, { fire: true }), after: () => mite.alive === false ? false : undefined });
+    assert.ok(hits.some(p => p.targetId === mite.id), 'real projectile collision reaches physical body');
+    assert.ok(mite.hull < 36 || mite.alive === false);
+  } finally { host.dispose(); }
+});
