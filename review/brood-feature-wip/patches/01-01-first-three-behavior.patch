+import { stableId } from './contracts.js';
+// Portable, bounded tactical continuation. Only explicitly named semantic fields are captured.
+// Runtime objects, ports, traces and scratch collections never cross this boundary.
+export const TACTICAL_CONTINUATION_VERSION = 1;
+export const TACTICAL_CONTINUATION_LIMITS = Object.freeze({
+  actors: 512,
+  squads: 256,
+  contacts: 8192,
+  nodes: 100000,
+  bytes: 4 * 1024 * 1024
+});
+export function continuationError(reason) {
+  const e = new Error(`tactical_continuation_${reason}`);
+  e.code = e.message;
+  throw e;
+}
+const own = (o, k) => Object.prototype.hasOwnProperty.call(o, k);
+const plain = o => o && typeof o === 'object' && (Object.getPrototypeOf(o) === Object.prototype || Object.getPrototypeOf(o) === null);
+let captureBudget = null;
+export function withTacticalCaptureBudget(capture) {
+  const previous = captureBudget;
+  captureBudget = {
+    nodes: 0
+  };
+  try {
+    return capture();
+  } finally {
+    captureBudget = previous;
+  }
+}
+export function copyContinuationValue(value, budget = captureBudget || {
+  nodes: 0
+}, depth = 0) {
+  if (++budget.nodes > TACTICAL_CONTINUATION_LIMITS.nodes || depth > 24) continuationError('node_limit');
+  if (value == null || typeof value === 'boolean') return value;
+  if (typeof value === 'string') {
+    if (value.length > 4096) continuationError('string_limit');
+    return value;
+  }
+  if (typeof value === 'number') {
+    if (Number.isNaN(value)) continuationError('nan');
+    return Number.isFinite(value) ? value : {
+      $number: value > 0 ? 'Infinity' : '-Infinity'
+    };
+  }
+  if (Array.isArray(value)) {
+    if (value.length > 8192) continuationError('array_limit');
+    return value.map(v => copyContinuationValue(v, budget, depth + 1));
+  }
+  if (!plain(value)) continuationError('non_plain_value');
+  const out = {};
+  for (const key of Object.keys(value)) {
+    if (['__proto__', 'constructor', 'prototype'].includes(key)) continuationError('unsafe_key');
+    out[key] = copyContinuationValue(value[key], budget, depth + 1);
+  }
+  return out;
+}
+export function readContinuationValue(value, budget = {
+  nodes: 0
+}, depth = 0) {
+  if (++budget.nodes > TACTICAL_CONTINUATION_LIMITS.nodes || depth > 24) continuationError('node_limit');
+  if (plain(value) && own(value, '$number')) {
+    if (Object.keys(value).length !== 1 || !['Infinity', '-Infinity'].includes(value.$number)) continuationError('number');
+    return value.$number === 'Infinity' ? Infinity : -Infinity;
+  }
+  if (value == null || typeof value === 'boolean') return value;
+  if (typeof value === 'number') {
+    if (!Number.isFinite(value)) continuationError('number');
+    return value;
+  }
+  if (typeof value === 'string') {
+    if (value.length > 4096) continuationError('string_limit');
+    return value;
+  }
+  if (Array.isArray(value)) {
+    if (value.length > 8192) continuationError('array_limit');
+    return value.map(v => readContinuationValue(v, budget, depth + 1));
+  }
+  if (!plain(value)) continuationError('non_plain_value');
+  const out = {};
+  for (const key of Object.keys(value)) {
+    if (['__proto__', 'constructor', 'prototype'].includes(key)) continuationError('unsafe_key');
+    out[key] = readContinuationValue(value[key], budget, depth + 1);
+  }
+  return out;
+}
+export function continuationRecord(value, fields, reading = false) {
+  if (!value || typeof value !== 'object' || Array.isArray(value)) continuationError('record');
+  if (reading && Object.keys(value).some(k => !fields.includes(k))) continuationError('unknown_field');
+  const out = {};
+  for (const key of fields) if (own(value, key) && value[key] !== undefined) out[key] = (reading ? readContinuationValue : copyContinuationValue)(value[key]);
+  return out;
+}
+export function continuationRows(value, limit = 512) {
+  if (!Array.isArray(value) || value.length > limit) continuationError('rows');
+  const seen = new Set();
+  for (const row of value) {
+    if (!Array.isArray(row) || row.length !== 2 || seen.has(row[0])) continuationError('row');
+    seen.add(row[0]);
+  }
+  return value;
+}
+export function continuationPacket(value, fields) {
+  if (!plain(value) || value.version !== 1 || Object.keys(value).some(k => !['version', ...fields].includes(k))) continuationError('version');
+  return value;
+}
+export function remapContinuationRef(value, context) {
+  return value == null ? null : context.bindEntity(value);
+}
+export function remapContinuationFields(value, fields, context) {
+  if (!value) return value;
+  for (const key of fields) if (own(value, key) && value[key] != null) value[key] = remapContinuationRef(value[key], context);
+  return value;
+}
+// A tactical target may be an entity or an explicitly observed attachment. The restore
+// binding owns that distinction; string/number shape alone never grants attachment identity.
+export function remapContinuationTargets(value, fields, context) {
+  if (!value) return value;
+  for (const key of fields) if (own(value, key) && value[key] != null) {
+    value[key] = context.bindTarget ? context.bindTarget(value[key]) : context.bindEntity(value[key]);
+  }
+  return value;
+}
+export function copyManeuver(value, context = null, reading = false) {
+  const out = continuationRecord(value, ['version', 'entityId', 'tick', 'kind', 'forceLocal', 'torqueYaw', 'boost', 'brake', 'targetHeading', 'horizonTicks', 'trajectory', 'reason'], reading);
+  if (context) {
+    // A loaded Brood life must announce a new attack before it can thrust an old pass.
+    // Keep only inert motor intent until the new doctrine/cohort tick; other pilots replay exactly.
+    if (reading && context.resolveEntity?.(value.entityId)?.data?.broodBodyId) {
+      out.forceLocal = { forward: 0, right: 0 }; out.torqueYaw = 0; out.boost = false; out.brake = false;
+    }
+    remapContinuationFields(out, ['entityId'], context);
+  }
+  return out;
+}
+export function remapPerception(value, context) {
+  if (!value) return value;
+  if (value.self) {
+    const old = value.self.id;
+    remapContinuationFields(value.self, ['id'], context);
+    if (value.self.occupantGeneration != null) value.self.occupantGeneration = context.destinationGeneration(old);
+    if (value.self.activity) remapContinuationFields(value.self.activity, ['targetId'], context);
+  }
+  if (Array.isArray(value.contacts)) value.contacts = value.contacts.map(c => remapContact(c, context)).filter(Boolean);
+  if (Array.isArray(value.events)) for (const e of value.events) remapContinuationFields(e, ['sourceId', 'targetId'], context);
+  return value;
+}
+export function remapContact(contact, context) {
+  if (!contact) return null;
+  // Tether contacts are semantic attachment IDs, not entity IDs. Their endpoints still bind.
+  if (contact.kind === 'tether') {
+    contact.id = context.bindAttachment?.(contact) ?? null;
+    if (contact.id == null) return null;
+  } else if (contact.id != null) {
+    contact.id = context.bindEntity(contact.id);
+    if (contact.id == null) return null;
+  }
+  remapContinuationFields(contact, ['ownerId'], context);
+  if (contact.targetId != null) contact.targetId = context.bindEntity(contact.targetId);
+  return contact;
+}
+export function remapDirective(value, context) {
+  if (!value) return value;
+  remapContinuationFields(value, ['entityId', 'memberId', 'leaderId'], context);
+  remapContinuationTargets(value, ['focusTargetId', 'targetId'], context);
+  if (value.objective) remapContinuationTargets(value.objective, ['targetId'], context);
+  if (value.enemyMind) remapContinuationFields(value.enemyMind, ['entityId', 'targetId', 'chargeId'], context);
+  if (value.leader) remapContinuationFields(value.leader, ['id'], context);
+  return value;
+}
+export function remapDecision(value, context) {
+  if (!value) return value;
+  remapContinuationFields(value, ['entityId'], context);
+  if (value.entityId == null) return null;
+  if ((value.combatDoctrine?.doctrineId === 'brood_charge' || value.combatDoctrine?.doctrineId === 'brood_lunge' || value.combatDoctrine?.doctrineId === 'brood_spit') || value.action?.maneuver?.broodAttack) return null;
+  remapDirective(value.directive, context);
+  if (value.perception) remapPerception(value.perception, context);
+  if (value.selected) remapContinuationTargets(value.selected, ['targetId'], context);
+  if (value.behavior) remapContinuationTargets(value.behavior, ['targetId'], context);
+  if (value.action) {
+    remapContinuationFields(value.action, ['entityId'], context);
+    remapContinuationTargets(value.action, ['targetId'], context);
+    if (value.action.maneuver) remapContinuationTargets(value.action.maneuver, ['targetId'], context);
+  }
+  if (value.enemyMind) remapContinuationFields(value.enemyMind, ['entityId', 'targetId', 'chargeId'], context);
+  if (value.maneuver) remapContinuationFields(value.maneuver, ['entityId'], context);
+  if (value.combatDoctrine) remapContinuationFields(value.combatDoctrine, ['entityId', 'targetId', 'actionTargetId', 'custodyTargetId'], context);
+  return value;
+}
+
+/** Accept only mappings created from an actual saved entity record by this restore transaction. */
+export function createTacticalRestoreBindings(payload, state, entityIdRemap, savedRecords) {
+  const rows = payload?.actors;
+  if (!Array.isArray(rows) || rows.length > 512) continuationError('actor_limit');
+  const savedActorCount = rows.length;
+  const records = new Map((savedRecords || []).filter(Boolean).map(e => [String(e.id), e]));
+  const bindings = new Map(),
+    destinations = new Set();
+  for (const row of rows) {
+    const identity = continuationRecord(row, ['id', 'generation', 'worldRecordId', 'bodyLifeId'], true);
+    if (row.id == null || bindings.has(String(row.id))) continuationError('actor_identity');
+    const saved = records.get(String(row.id));
+    const destId = entityIdRemap?.get(String(row.id));
+    const entity = destId == null ? null : state.entities.get(destId);
+    if (!saved || !entity || entity.alive === false) continue;
+    if (row.worldRecordId != null && (saved.data?.worldRecordId !== row.worldRecordId || entity.data?.worldRecordId !== row.worldRecordId)) continue;
+    if (row.bodyLifeId != null && (saved.data?.bodyLifeId !== row.bodyLifeId || entity.data?.bodyLifeId !== row.bodyLifeId)) continue;
+    if (destinations.has(entity)) continuationError('duplicate_destination');
+    destinations.add(entity);
+    bindings.set(String(row.id), {
+      row: identity,
+      entity,
+      generation: entity.occupantGeneration
+    });
+  }
+  const binding = id => {
+    const b = bindings.get(String(id));
+    return b && b.entity.alive !== false && state.entities.get(b.entity.id) === b.entity && b.entity.occupantGeneration === b.generation ? b : null;
+  };
+  const attachmentRefs = new Map();
+  const currentAttachment = ref => ref && ref.attachment.state === 'active'
+    && state.combat?.attachments?.byId?.[ref.id] === ref.attachment
+    && binding(ref.oldOwner)?.entity === ref.owner && binding(ref.oldTarget)?.entity === ref.target
+    && ref.attachment.ownerId === ref.owner.id && ref.attachment.targetId === ref.target.id;
+  const bindAttachment = contact => {
+    const id = contact?.id;
+    if (contact?.kind !== 'tether' || id == null) return null;
+    if (!attachmentRefs.has(id)) {
+      const owner = binding(contact.ownerId)?.entity;
+      const target = binding(contact.targetId)?.entity;
+      const byId = state.combat?.attachments?.byId;
+      const attachment = byId && own(byId, id) ? byId[id] : null;
+      const ref = { id, attachment, owner, target, oldOwner: contact.ownerId, oldTarget: contact.targetId };
+      attachmentRefs.set(id, !bindings.has(String(id)) && contact.attachmentId === id
+        && attachment?.id === id && owner && target && currentAttachment(ref) ? ref : null);
+    }
+    const ref = attachmentRefs.get(id);
+    // Conflicting saved observations cannot rebind an attachment to a different pair of lives.
+    if (!ref || contact.attachmentId !== id || contact.ownerId !== ref.oldOwner || contact.targetId !== ref.oldTarget) {
+      attachmentRefs.set(id, null);
+      return null;
+    }
+    return currentAttachment(ref) ? id : null;
+  };
+  return {
+    tick: state.tick,
+    simTime: state.simTime,
+    bindEntity: id => binding(id)?.entity.id ?? null,
+    bindAttachment,
+    targetKind: id => attachmentRefs.has(id) ? 'attachment' : binding(id) ? 'entity' : null,
+    bindTarget: id => attachmentRefs.has(id)
+      ? (currentAttachment(attachmentRefs.get(id)) ? id : null) : binding(id)?.entity.id ?? null,
+    resolveEntity: id => binding(id)?.entity ?? null,
+    savedGeneration: id => binding(id)?.row.generation ?? null,
+    destinationGeneration: id => binding(id)?.generation ?? null,
+    bindingReport: () => ({ savedActors: savedActorCount, boundActors: bindings.size, omittedActors: savedActorCount - bindings.size }),
+    assertCurrent() {
+      for (const b of bindings.values()) if (!binding(b.row.id)) continuationError('stale_binding');
+      for (const ref of attachmentRefs.values()) if (ref && !currentAttachment(ref)) continuationError('stale_attachment');
+    }
+  };
+}
+/** Called only after whole-envelope validation, before any target-bearing owner prepares. */
+export function prepareTacticalTargetBindings(data, context) {
+  if (!data.stack || !context.bindAttachment) return;
+  for (const [, memory] of data.stack.components.memory.rows) {
+    for (const [, contact] of memory.contacts) if (contact.kind === 'tether') context.bindAttachment(contact);
+  }
+  for (const [, perception] of data.stack.perceptionCache) {
+    for (const contact of perception.contacts) if (contact.kind === 'tether') context.bindAttachment(contact);
+  }
+}
+export function captureTacticalActors(state) {
+  const out = [];
+  for (const entity of state.entities.values()) {
+    if (!entity || entity.alive === false) continue;
+    out.push({
+      id: entity.id,
+      generation: entity.occupantGeneration ?? null,
+      worldRecordId: entity.data?.worldRecordId ?? null,
+      bodyLifeId: entity.data?.bodyLifeId ?? null
+    });
+    if (out.length > 512) continuationError('actor_limit');
+  }
+  return out;
+}
