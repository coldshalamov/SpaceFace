+++ b/src/combat/broodProjectile.js
@@ -0,0 +1,51 @@
+// Biological emission policy; the ordinary weapon service still owns spawning and packets.
+import { isRecovering, isTumbling } from './tumbleStatus.js';
+import { physicsBodyNativeReady } from '../core/physicsAuthority.js';
+import { resolveCollisionProxyManifest } from '../data/collisionProxyManifests.js';
+import { sweepCollisionProxyInto } from '../core/collisionProxySweep.js';
+import { broodBodyContract } from '../data/broodBodies.js';
+import { BROOD_ATTACK_PROFILES } from '../data/broodAttackProfiles.js';
+
+export function isBroodProjectile(entity, weapon) {
+  return entity?.data?.broodBodyId === 'brood_spitter' && weapon?.defId === 'wpn_brood_glob';
+}
+export function broodProjectileMouth(entity) {
+  const socket = broodBodyContract(entity?.data?.broodBodyId)?.sockets.SOCKET_BROOD_PROJECTILE_MOUTH;
+  if (!socket || !entity?.pos || !Number.isFinite(entity.rot)) return null;
+  const [x, y, z] = socket.position, c = Math.cos(entity.rot), s = Math.sin(entity.rot);
+  return { x: entity.pos.x + c*x - s*z, y, z: entity.pos.z + s*x + c*z };
+}
+export function broodProjectileReady(entity, weapon, state) {
+  if (!isBroodProjectile(entity, weapon) || entity.alive === false || state.entities.get(entity.id) !== entity
+    || isTumbling(state, entity) || isRecovering(state, entity)) return false;
+  const attack = entity.data.broodAttack, profile = BROOD_ATTACK_PROFILES.brood_spitter;
+  const target = attack && state.entities.get(attack.targetId);
+  return !!(attack?.phase === 'commit' && attack.attackId && attack.role === 'brood_spitter'
+    && Number.isSafeInteger(attack.life) && attack.life > 0 && attack.life === entity.occupantGeneration
+    && target?.alive !== false && target?.occupantGeneration === attack.targetLife
+    && Number.isSafeInteger(attack.targetLife) && attack.targetLife > 0
+    && state.tick >= attack.phaseStartedTick && state.tick < attack.phaseStartedTick + profile.commitTicks
+    && state.tick - attack.cueStartedTick >= profile.windupTicks
+    && !(entity.data.broodAttackInterruptedTick >= attack.phaseStartedTick)
+    && weapon._broodSpentAttack !== attack.attackId);
+}
+
+// Sweep the actual glob disc from body origin to mouth. Use the same compound narrow phase
+// as projectile physics, including initial overlap and rounded corners, never a point ray.
+export function broodMouthClear(state, source, mouth, radius) {
+  const hit = {};
+  for (const body of state.entities.values()) {
+    if (!body?.alive || !body.collides || body === source || body.type === 'projectile'
+      || !physicsBodyNativeReady(body) || !body.pos) continue;
+    const manifest = body.shield > 0 ? null : resolveCollisionProxyManifest(body);
+    if (manifest) {
+      if (sweepCollisionProxyInto(hit, body, manifest, source.pos, mouth, radius)) return false;
+    } else {
+      const dx = mouth.x-source.pos.x, dz = mouth.z-source.pos.z, length2 = dx*dx+dz*dz;
+      const t = length2 ? Math.max(0, Math.min(1, ((body.pos.x-source.pos.x)*dx+(body.pos.z-source.pos.z)*dz)/length2)) : 0;
+      const r = Math.max(0, body.physicsBody?.radius ?? body.radius ?? 0) + radius;
+      if (Math.hypot(body.pos.x-source.pos.x-t*dx, body.pos.z-source.pos.z-t*dz) <= r) return false;
+    }
+  }
+  return true;
+}
