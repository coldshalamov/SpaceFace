+// Brood attack state and the narrow contact-damage adapter. Movement stays in the AI actuator;
+// only an actual native impact can spend an attack. Ordinary player terrain immunity is untouched.
+import { scalarHitToDamagePacket } from './damage.js';
+
+import { BROOD_ATTACK_PROFILES } from '../data/broodAttackProfiles.js';
+export { BROOD_ATTACK_PROFILES } from '../data/broodAttackProfiles.js';
+export function broodRole(entity) {
+  const id = entity?.data?.broodBodyId;
+  return BROOD_ATTACK_PROFILES[id] ? id : null;
+}
+
+// Pure tick-driven state machine shared by the charged body and cheap cohort member.
+export function advanceBroodAttack(previous, { role, entityId, tick, self, target, interrupted = false, life = self?.occupantGeneration ?? 0 }) {
+  const profile = BROOD_ATTACK_PROFILES[role];
+  if (!profile || !self?.pos || !Number.isInteger(tick)) return null;
+  let attack = previous?.life === life ? previous : { role, life, endsAtTick: null, phase: 'approach', phaseStartedTick: tick, cycle: 0, attackId: null, targetId: null, attackLine: null };
+  const transition = (phase, fields = {}) => ({ ...attack, phase, phaseStartedTick: tick,
+    endsAtTick: phase === 'approach' ? null : tick + profile[`${phase}Ticks`], ...fields });
+  const age = tick - attack.phaseStartedTick;
+  const targetLife = Number.isSafeInteger(target?.occupantGeneration) && target.occupantGeneration > 0 ? target.occupantGeneration : null;
+  if ((attack.phase === 'windup' || attack.phase === 'commit') && attack.targetLife !== targetLife) {
+    return transition('recovery', { outcome: 'target_life_changed' });
+  }
+  if (!target?.pos || target.alive === false || interrupted) {
+    if (attack.phase !== 'recovery') return transition('recovery', { outcome: interrupted ? 'interrupted' : 'target_lost' });
+    return attack;
+  }
+  if (attack.phase === 'approach') {
+    // Do not announce a release that the shared engagement response window must refuse.
+    if (profile.delivery === 'projectile' && tick + profile.windupTicks < (self.broodAttackReadyTick || 0)) return attack;
+    const dx = target.pos.x - self.pos.x, dz = target.pos.z - self.pos.z;
+    const distance = Math.hypot(dx, dz);
+    if (distance > profile.range) return attack;
+    const heading = distance > 1e-6 ? Math.atan2(dz, dx) : (self.rot || 0);
+    const attackLine = Object.freeze({
+      origin: Object.freeze({ x: self.pos.x, z: self.pos.z }), heading,
+      dir: Object.freeze({ x: Math.cos(heading), z: Math.sin(heading) }),
+      // The cue is the bounded swept lane for this motor window, not an arbitrary long ray.
+      range: profile.delivery === 'projectile' ? profile.range : profile.speed * profile.commitTicks / 60
+        + Math.max(0, (self.vel?.x || 0) * Math.cos(heading) + (self.vel?.z || 0) * Math.sin(heading)) * profile.windupTicks / 60,
+      halfWidth: self.radius || 8,
+      cueStartedTick: tick, life, targetLife,
+    });
+    return transition('windup', { targetId: target.id, targetLife, attackLine, cueStartedTick: tick,
+      attackId: `${role}:${entityId}:${life}:${tick}:${attack.cycle}`, outcome: null });
+  }
+  if (attack.phase === 'windup' && age >= profile.windupTicks) return transition('commit');
+  if (attack.phase === 'commit' && age >= profile.commitTicks) return transition('recovery', { outcome: 'pass_complete' });
+  if (attack.phase === 'recovery' && age >= profile.recoveryTicks) {
+    return transition('approach', { cycle: attack.cycle + 1, attackId: null, attackLine: null, targetId: null, outcome: null });
+  }
+  return attack;
+}
+
+export class BroodContactRuntime {
+  constructor(host) {
+    this.host = host;
+    this.reset();
+    const bus = host.bus;
+    this.off = [
+      bus.on('ai:doctrinePhase', p => this.onPhase(p)),
+      bus.on('physics:impact', p => this.onImpact(p)),
+      ...['game:started', 'game:newGame', 'save:loaded', 'run:ended'].map(event => bus.on(event, () => this.reset())),
+    ];
+  }
+  reset() {
+    this.spent = new WeakMap(); this.published = new WeakMap();
+    for (const entity of this.host.state?.entityList || []) if (broodRole(entity)) {
+      delete entity.data.broodAttack;
+      delete entity.data.broodShot;
+      for (const weapon of entity.data.weapons || []) delete weapon._broodSpentAttack;
+      delete entity.data.broodAttackInterruptedTick;
+    }
+  }
+  destroy() { for (const off of this.off || []) if (typeof off === 'function') off(); this.off = []; this.reset(); }
+  onPhase(p) {
+    const state = this.host.state;
+    if (!p || p.tick !== state.tick || !['approach', 'windup', 'commit', 'recovery'].includes(p.phase)) return;
+    const role = p.doctrineId === 'brood_charge' ? 'brood_charger' : p.doctrineId === 'brood_lunge' ? 'brood_mite' : p.doctrineId === 'brood_spit' ? 'brood_spitter' : null;
+    if (!role) return;
+    const entity = state.entities.get(p.entityId);
+    if (!entity || entity.alive === false || broodRole(entity) !== role
+      || !Number.isSafeInteger(entity.occupantGeneration) || entity.occupantGeneration < 1) return;
+    const previous = entity.data.broodAttack;
+    if (p.attackLine && p.attackLine.life !== (entity.occupantGeneration ?? 0)) return;
+    if (p.attackLine && (!Number.isSafeInteger(p.attackLine.targetLife) || p.attackLine.targetLife < 1
+      || state.entities.get(p.targetId)?.occupantGeneration !== p.attackLine.targetLife)) return;
+    if (p.phase !== 'windup' && (!previous || previous.phase === 'approach') && p.phase !== 'approach') return;
+    if (previous && p.tick < previous.phaseStartedTick) return;
+    const cueStartedTick = p.attackLine?.cueStartedTick ?? previous?.cueStartedTick;
+    if (p.phase === 'windup' && cueStartedTick !== p.tick) return;
+    if (p.phase === 'commit' && (previous?.phase !== 'windup'
+      || !Number.isSafeInteger(cueStartedTick)
+      || p.tick - cueStartedTick < BROOD_ATTACK_PROFILES[role].windupTicks)) return;
+    if (p.phase === 'windup' || p.phase === 'approach') delete entity.data.broodShot;
+    entity.data.broodAttack = { role, life: entity.occupantGeneration ?? 0, phase: p.phase, phaseStartedTick: p.tick,
+      endsAtTick: p.phase === 'approach' ? null : p.tick + BROOD_ATTACK_PROFILES[role][`${p.phase}Ticks`],
+      targetId: p.targetId, targetLife: p.attackLine?.targetLife ?? previous?.targetLife ?? null, attackLine: p.attackLine || previous?.attackLine || null,
+      cueStartedTick, attackId: cueStartedTick == null ? null : `${role}:${entity.id}:${entity.occupantGeneration ?? 0}:${cueStartedTick}` };
+  }
+  publish() {
+    for (const entity of this.host.state.entityList || []) {
+      if (!entity || entity.alive === false || !broodRole(entity)) continue;
+      const attack = entity.data.broodAttack;
+      if (!attack) continue;
+      if (attack.role === 'brood_spitter') {
+        const target = this.host.state.entities.get(attack.targetId);
+        if (attack.life !== entity.occupantGeneration || (attack.targetId != null
+          && (!target || target.alive === false || target.occupantGeneration !== attack.targetLife))) {
+          delete entity.data.broodAttack; delete entity.data.broodShot; continue;
+        }
+      }
+      attack.sampledTick = this.host.state.tick;
+      if (this.published.get(entity) === attack) continue;
+      this.published.set(entity, attack);
+      this.host.bus.emit('brood:phase', { entityId: entity.id, ...attack, tick: this.host.state.tick });
+    }
+  }
+  onImpact(p) {
+    const state = this.host.state;
+    if (!p || state.mode !== 'flight' || p.tick !== state.tick || p.consequenceKernelVersion !== 1
+      || !(Number(p.impulse ?? p.dp) > 0)) return null;
+    const a = state.entities.get(p.aId), b = state.entities.get(p.bId);
+    if (!a || !b || a === b || a.alive === false || b.alive === false) return null;
+    return this.contact(a, b, p) || this.contact(b, a, p);
+  }
+  contact(actor, target, impact) {
+    const role = broodRole(actor), attack = actor.data?.broodAttack;
+    if (!role || BROOD_ATTACK_PROFILES[role].delivery === 'projectile' || !attack || !Number.isSafeInteger(attack.life) || attack.life < 1
+      || attack.life !== actor.occupantGeneration || attack.phase !== 'commit' || !attack.attackId
+      || !Number.isSafeInteger(attack.phaseStartedTick) || impact.tick < attack.phaseStartedTick
+      || impact.tick - attack.phaseStartedTick >= BROOD_ATTACK_PROFILES[role].commitTicks
+      || actor.data.broodAttackInterruptedTick >= attack.phaseStartedTick
+      || this.spent.get(actor) === attack.attackId) return null;
+    // Any real collision spends this pass, including cover and other bodies. No proximity fuse.
+    this.spent.set(actor, attack.attackId);
+    actor.data.broodAttackInterruptedTick = impact.tick;
+    if (!Number.isSafeInteger(attack.targetLife) || attack.targetLife < 1 || target.occupantGeneration !== attack.targetLife
+      || target.id !== attack.targetId || target.id !== this.host.state.playerId
+      || actor.team === target.team || this.host.playerIsDockProtected?.()) return null;
+    const packet = scalarHitToDamagePacket({ damage: BROOD_ATTACK_PROFILES[role].damage,
+      damageType: 'kinetic', pos: impact.pos, source: { kind: 'brood_contact', weaponId: role } });
+    // Native contact already exchanged momentum. This packet must never supply a second impulse.
+    const result = this.host.ensureKernel().routeDamage({ attackerId: actor.id, targetId: target.id,
+      packet, origin: { kind: 'brood_contact', id: role } });
+    if (result?.ok) this.host.bus.emit('brood:contact', { entityId: actor.id, targetId: target.id,
+      attackId: attack.attackId, role, tick: impact.tick, pos: impact.pos, damage: BROOD_ATTACK_PROFILES[role].damage });
+    return result;
+  }
+}
