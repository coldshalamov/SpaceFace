+// Gameplay allocation is independent of the approved anatomical mass distribution.
+export const SPLITTER_ID = 'brood_splitter';
+export const SPLITTER_CELLS = Object.freeze(['brood_splitter_axial', 'brood_splitter_port', 'brood_splitter_starboard']);
+export const SPLITTER_FAMILY_LIVES = 4;
+export const SPLITTER_CAPACITY = 3;
+export const SPLITTER_TISSUE = 72;
+export const SPLITTER_JOINED_HULL = 36;
+export const SPLITTER_RECOVERY_TICKS = 12;
+export const SPLITTER_WRECK_SECONDS = 18;
+export const splitterLifeCost = id => id === SPLITTER_ID ? SPLITTER_FAMILY_LIVES : 1;
+export const isSplitterCell = id => SPLITTER_CELLS.includes(id);
+export const supportsSplitterBudget = budget => !!budget && ['request', 'bindEntity', 'releaseEntity', 'release', 'releaseSome', 'ownerForEntity'].every(key => typeof budget[key] === 'function');
