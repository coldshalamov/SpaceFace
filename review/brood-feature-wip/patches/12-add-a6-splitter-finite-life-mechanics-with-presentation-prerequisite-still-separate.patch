@@ -0,0 +1,281 @@
+import { inheritMaterialImpulseProvenance } from './impulseKernel.js';
+import { broodBodyContract } from '../data/broodBodies.js';
+import { SPLITTER_ID, SPLITTER_CELLS, SPLITTER_TISSUE, SPLITTER_JOINED_HULL, SPLITTER_RECOVERY_TICKS, SPLITTER_WRECK_SECONDS, supportsSplitterBudget, isSplitterCell } from '../data/broodSplitter.js';
+export function splitterRemainingTissue(parent, lethal) {
+  // Potential post-mitigation channels are deliberately uncapped. Never reconstruct this from
+  // the public kill receipt, raw weapon damage, or result.totalApplied (which is hull-clamped).
+  const channels = lethal?.result?.hullByChannel;
+  if (!channels || !Number.isFinite(lethal?.result?.hullDamage)) return 0;
+  const overflow = Math.max(0, Object.values(channels).reduce((sum, v) => sum + (Number.isFinite(v) ? Math.max(0, v) : 0), 0) - lethal.result.hullDamage);
+  const initial = parent.data?.splitterFamily?.tissueTotal ?? SPLITTER_TISSUE;
+  const joinedMax = parent.data?.splitterFamily?.joinedHull ?? SPLITTER_JOINED_HULL;
+  const remaining = parent.data?.splitterFamily?.tissueRemaining;
+  return Math.max(0, (Number.isFinite(remaining) ? remaining : initial - joinedMax) - overflow);
+}
+function inheritTissueStatuses(host, parent, child, share, lethal) {
+  const from = host.state.combat?.entities?.[parent.id];
+  const to = host.kernel?.initializeEntity?.(child);
+  if (!from || !to) return;
+  // Existing disable/damage state belongs to these same tissues. Reproduction must not heal
+  // a broken drive or erase accumulated heat simply because entity identity changed.
+  to.heat = Math.max(0, from.heat || 0) * share;
+  for (const [id, subsystem] of Object.entries(to.subsystems || {})) {
+    const previous = from.subsystems?.[id];
+    if (!previous) continue;
+    const ratio = previous.maxHealth > 0 ? Math.max(0, Math.min(1, previous.health / previous.maxHealth)) : 0;
+    Object.assign(subsystem, {
+      health: subsystem.maxHealth * ratio,
+      destroyed: previous.destroyed,
+      effectiveDisabled: previous.effectiveDisabled,
+      pendingTransition: structuredClone(previous.pendingTransition),
+      lastDamageTick: previous.lastDamageTick
+    });
+  }
+  to.pendingSubsystemTransitionCount = Object.values(to.subsystems || {}).filter(s => s.pendingTransition).length;
+  to.statuses = structuredClone(from.statuses || {});
+  to.pendingStatuses = structuredClone(from.pendingStatuses || []);
+  for (const status of [...Object.values(to.statuses), ...to.pendingStatuses]) {
+    status.inheritedDamageShare = (status.inheritedDamageShare ?? 1) * share;
+  }
+  // Status.advance increments its periodic clock AFTER routeDamage/onKill returns. The lethal
+  // pulse already spent here must not hit the same material again under a child's fresh id.
+  if (lethal.origin?.kind === 'status') {
+    const status = to.statuses[lethal.origin.id];
+    const period = host.kernel?.catalog?.statuses?.get?.(lethal.origin.id)?.periodic?.everyTicks;
+    if (status && Number.isFinite(status.nextPeriodicTick)) status.nextPeriodicTick += Math.max(1, period || 1);
+  }
+  to.statusModifiersDirty = true;
+}
+function retainWholeCorpse(host, parent, family, reason) {
+  // Fail closed to the material that already existed, with the same source pose, proxy, COM
+  // and inertia. Never combine a generic corpse/shard burst with this authored body.
+  const spec = {
+    type: 'wreck',
+    team: 0,
+    hull: 0,
+    hullMax: 0,
+    pos: {
+      ...parent.pos
+    },
+    vel: {
+      ...parent.vel
+    },
+    rot: parent.rot,
+    angVel: parent.angVel,
+    radius: parent.radius,
+    mass: parent.physicsBody.mass,
+    ttl: SPLITTER_WRECK_SECONDS,
+    physicsBody: structuredClone(parent.physicsBody),
+    data: {
+      broodBodyId: parent.data.broodBodyId,
+      splitterResidue: true,
+      runCohort: parent.data.runCohort,
+      runWave: parent.data.runWave,
+      salvagePool: {},
+      splitterFallback: reason
+    }
+  };
+  const spawned = host.helpers.spawnEntity(spec);
+  const corpse = typeof spawned === 'object' ? spawned : host.state.entities.get(spawned);
+  if (!corpse) return null;
+  const native = host.helpers?.combatPhysics;
+  native?.partitionBody?.({
+    parent,
+    parts: [{
+      entity: corpse,
+      center: {
+        x: 0,
+        z: 0
+      },
+      yaw: 0
+    }]
+  });
+  inheritMaterialImpulseProvenance(parent, corpse, 1, host.state.tick);
+  parent.data.splitterMaterialTransferred = true;
+  if (family) {
+    family.settled = true;
+    const budget = host.helpers.spawnBudget;
+    if (supportsSplitterBudget(budget) && family.parentLife === parent.occupantGeneration && budget.ownerForEntity(parent.id) === family.ownerId) {
+      budget.releaseSome(family.ownerId, 2);
+    }
+  }
+  host.bus.emit('brood:partitionFailed', {
+    parent,
+    reason,
+    cancelled: family?.latentLives || 0,
+    corpse
+  });
+  return {
+    children: [],
+    corpse,
+    cancelled: family?.latentLives || 0,
+    fallback: reason
+  };
+}
+
+/** Synchronous death-owner transaction. No renderer, delayed spawn, radius fit, or spawn ring. */
+export function partitionBroodSplitter(host, parent, killerId, lethal, makeSpec) {
+  if (parent?.type !== 'ship') return null;
+  if (parent.data?.broodBodyId !== SPLITTER_ID && !isSplitterCell(parent.data?.broodBodyId)) return null;
+  const attachments = host.kernel?.attachments;
+  const attached = new Set([...(attachments?.listForEntity(parent.id, true) || []), ...(attachments?.listControlledBy(parent.id, true) || [])]);
+  for (const attachment of attached) attachments.breakAttachment(attachment, 'entity_destroyed', parent.id);
+  if (isSplitterCell(parent?.data?.broodBodyId)) return retainWholeCorpse(host, parent, null, 'spent_cell');
+  if (parent?.data?.broodBodyId !== SPLITTER_ID) return null;
+  const family = parent.data.splitterFamily;
+  const budget = host.helpers?.spawnBudget;
+  const body = broodBodyContract(SPLITTER_ID);
+  if (!body?.splitterCells?.length) return null;
+  if (family?.settled) return retainWholeCorpse(host, parent, null, 'settled_family');
+  const native = host.helpers?.combatPhysics;
+  const reserved = family && family.parentLife === parent.occupantGeneration && supportsSplitterBudget(budget) && budget.ownerForEntity(parent.id) === family.ownerId;
+  // Unsupported old/manual actors never mint unfunded children. Their single existing body
+  // takes the ordinary corpse route, while the wave cancels any recorded latent life debt.
+  if (!reserved || typeof native?.partitionBody !== 'function') {
+    return retainWholeCorpse(host, parent, family, !reserved ? 'unreserved_family' : 'unsupported_physics');
+  }
+  const tissue = splitterRemainingTissue(parent, lethal);
+  const children = [];
+  for (let index = 0; index < 3; index++) {
+    const cell = body.splitterCells[index],
+      spec = makeSpec(SPLITTER_CELLS[index], 1, {
+        ...parent.pos
+      });
+    if (!spec) {
+      for (const e of children) e.alive = false;
+      return retainWholeCorpse(host, parent, family, 'missing_cell_contract');
+    }
+    const share = cell.tissueShare;
+    spec.hull = spec.hullMax = tissue * share;
+    spec.data = {
+      ...spec.data,
+      runCohort: parent.data.runCohort,
+      runWave: parent.data.runWave,
+      runRole: parent.data.runRole,
+      splitterChild: {
+        schema: 1,
+        familyId: family.id,
+        ordinal: index,
+        parentLife: family.parentLife,
+        bornTick: host.state.tick
+      },
+      broodRecoveryUntilTick: host.state.tick + SPLITTER_RECOVERY_TICKS,
+      ...(parent.data.recoveringUntil > host.state.simTime ? {
+        recoveringUntil: parent.data.recoveringUntil
+      } : {}),
+      ...(parent.data.disabled ? {
+        disabled: true
+      } : {}),
+      ...(parent.data.neutralized ? {
+        neutralized: true
+      } : {}),
+      // One immutable family entitlement belongs to the parent. Descendants cannot multiply it.
+      splitterRewardSuppressed: true,
+      rewardEligible: false
+    };
+    spec.data.ai = {
+      ...spec.data.ai,
+      forcePlayerTarget: true,
+      huntPlayer: true,
+      moraleImmune: true,
+      surrenderImmune: true,
+      spawnContext: 'encounter',
+      activity: {
+        kind: 'attack_run',
+        reason: 'survival_pursuit',
+        targetId: host.state.playerId,
+        anchor: null
+      }
+    };
+    spec.data.combat = {
+      ...spec.data.combat,
+      targetId: host.state.playerId
+    };
+    if (parent.disabled === true) spec.disabled = true;
+    if (parent.flags?.disabled === true) spec.flags = {
+      ...spec.flags,
+      disabled: true
+    };
+    if (!(spec.hull > 0)) {
+      spec.type = 'wreck';
+      spec.team = 0;
+      spec.ttl = SPLITTER_WRECK_SECONDS;
+      spec.data = {
+        broodBodyId: SPLITTER_CELLS[index],
+        splitterChild: spec.data.splitterChild,
+        splitterResidue: true,
+        runCohort: parent.data.runCohort,
+        runWave: parent.data.runWave,
+        salvagePool: {}
+      };
+    }
+    const spawned = host.helpers.spawnEntity(spec);
+    const child = typeof spawned === 'object' ? spawned : host.state.entities.get(spawned);
+    if (!child) {
+      for (const e of children) e.alive = false;
+      return retainWholeCorpse(host, parent, family, 'cell_spawn_failed');
+    }
+    children.push(child);
+  }
+  // Settle hostile capacity before native publication. The budget is the existing owner;
+  // failure leaves no bound/unbound child seats and falls back to one corpse synchronously.
+  const living = children.filter(e => e.type === 'ship');
+  if (budget.releaseEntity(parent.id, parent) !== 1) {
+    for (const child of children) child.alive = false;
+    return retainWholeCorpse(host, parent, family, 'parent_binding_refused');
+  }
+  const extra = Math.max(0, living.length - 2),
+    returned = extra ? budget.request(extra, family.ownerId) : 0;
+  if (returned !== extra) {
+    budget.releaseSome(family.ownerId, 2 + returned);
+    for (const child of children) child.alive = false;
+    return retainWholeCorpse(host, parent, family, 'reservation_rebind_refused');
+  }
+  if (living.length < 2) budget.releaseSome(family.ownerId, 2 - living.length);
+  const rollbackSeats = () => {
+    let freed = 0;
+    for (const child of living) freed += budget.releaseEntity(child.id, child);
+    budget.releaseSome(family.ownerId, Math.max(0, living.length - freed));
+    for (const child of children) child.alive = false;
+  };
+  for (const child of living) if (!budget.bindEntity(child.id, family.ownerId)) {
+    rollbackSeats();
+    return retainWholeCorpse(host, parent, family, 'child_binding_refused');
+  }
+  const receipt = native.partitionBody({
+    parent,
+    parts: children.map((entity, i) => ({
+      entity,
+      center: {
+        x: body.splitterCells[i].center[0],
+        z: body.splitterCells[i].center[2]
+      },
+      yaw: body.splitterCells[i].yaw || 0
+    }))
+  });
+  if (!receipt) {
+    rollbackSeats();
+    return retainWholeCorpse(host, parent, family, 'native_partition_refused');
+  }
+  family.settled = true;
+  parent.data.splitterMaterialTransferred = true;
+  for (const child of children) inheritMaterialImpulseProvenance(parent, child, child.physicsBody.mass / parent.physicsBody.mass, host.state.tick);
+  for (let i = 0; i < children.length; i++) if (children[i].type === 'ship') {
+    inheritTissueStatuses(host, parent, children[i], body.splitterCells[i].tissueShare, lethal);
+  }
+  host.bus.emit('brood:partitioned', {
+    parent,
+    children,
+    receipt,
+    killerId,
+    tissueRemaining: tissue,
+    familyId: family.id,
+    cancelled: 3 - living.length,
+    tick: host.state.tick
+  });
+  return {
+    children,
+    receipt,
+    cancelled: 3 - living.length
+  };
+}
