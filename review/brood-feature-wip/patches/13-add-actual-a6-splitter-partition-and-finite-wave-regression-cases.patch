+// CPU routing proof only. Real-camera art and audible mix still need presentation review.
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { vfx } from '../src/render/vfx.js';
+import { audio } from '../src/audio/audioSystem.js';
+
+test('material handoff keeps kill feedback without a reactor blast or duplicate debris', () => {
+  const calls = [];
+  const receipt = { id: 2, killerId: 1, type: 'ship', materialTransferred: true, pos: {x:2,z:3} };
+  const visual = { _emitJuiceCue: (...args) => calls.push(['cue', ...args]),
+    _scheduleDetonation: () => calls.push(['blast']), state: { entities:new Map() } };
+  vfx._onKilled.call(visual, receipt);
+  assert.equal(calls.length, 1); assert.equal(calls[0][0], 'cue');
+  const sounds=[];
+  const sound = { rt: {ctx:{currentTime:0}}, state:{playerId:1,simTime:1},
+    _applyPriorityCue: p=>sounds.push(['priority',p.id]), play:id=>sounds.push(['sound',id]) };
+  audio._onKilled.call(sound, receipt);
+  assert.deepEqual(sounds.map(p=>p[1]), ['combat.player.kill','sfx_ambient_rock_calve']);
+});
+
+test('expired source material is silently retired, while ordinary wreck destruction remains', () => {
+  let blasts=0;
+  const visual={_scene:{},_explode:()=>blasts++};
+  const sound={play:()=>blasts++};
+  const receipt={id:3,type:'wreck',entity:{data:{splitterResidue:true}}};
+  vfx._onDestroyed.call(visual,receipt); audio._onDestroyed.call(sound,receipt);
+  assert.equal(blasts,0);
+  vfx._onDestroyed.call(visual,{id:4,type:'wreck'}); audio._onDestroyed.call(sound,{id:4,type:'wreck'});
+  assert.equal(blasts,2);
+});
diff --git a/test/brood-splitter-lifecycle.test.mjs b/test/brood-splitter-lifecycle.test.mjs
new file mode 100644
index 0000000..7c2965e
--- /dev/null
+++ b/test/brood-splitter-lifecycle.test.mjs
@@ -0,0 +1,577 @@
+import { recordImpulseProvenance, holdImpulseProvenance, readRecentImpulseProvenance } from '../src/combat/impulseKernel.js';
+import { bindStuntEvidence, unbindStuntEvidence, observeAppliedImpulse } from '../src/combat/stuntEvidence.js';
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { queuePhysicsImpulse } from '../src/core/physicsAuthority.js';
+import { tumbleStates } from '../src/systems/tumbleStates.js';
+import { bootRealPath, writeRealPathInput } from '../scripts/lib/bench/realPath.mjs';
+import { combat, makeEnemySpawnSpec } from '../src/systems/combat.js';
+import { spawnBudget } from '../src/systems/spawnBudget.js';
+import { survivalWave } from '../src/systems/survivalWave.js';
+import { survivalRewards } from '../src/systems/survivalRewards.js';
+import { aftermathWrecks } from '../src/systems/aftermathWrecks.js';
+import { mining } from '../src/systems/mining.js';
+import { materializeWaveBatch } from '../src/systems/waveMaterialization.js';
+import { createRunState } from '../src/core/runState.js';
+import { scalarHitToDamagePacket } from '../src/combat/damage.js';
+import { broodBodyContract } from '../src/data/broodBodies.js';
+import { save } from '../src/save/saveSystem.js';
+import { splitterRemainingTissue } from '../src/combat/broodSplitter.js';
+const DT = 1 / 60;
+const req = {
+  ownerId: 'survival-wave:17',
+  enemyId: 'brood_splitter',
+  level: 1,
+  count: 1,
+  gateGroup: 'front',
+  seed: 927,
+  wave: 17,
+  packageIndex: 0,
+  batchIndex: 0,
+  role: 'pressure',
+  swarm: true
+};
+async function boot(extra = []) {
+  assert.ok(broodBodyContract('brood_splitter')?.splitterCells, 'requires the reviewed real anatomy contract, never a runtime fixture');
+  const h = await bootRealPath({
+    seed: 927,
+    systems: [spawnBudget, 'actions', ...extra, 'physics', combat],
+    hulls: [{
+      hullId: 'ship_kestrel',
+      isPlayer: true,
+      pos: {
+        x: 0,
+        z: 0
+      }
+    }]
+  });
+  h.state.run = {
+    ...createRunState({
+      kind: 'survival',
+      ruleset: 'swarm',
+      seed: 927
+    }),
+    phase: 'active',
+    wave: 17,
+    arenaId: 'helios_core'
+  };
+  h.state.world.currentSectorId = null;
+  return h;
+}
+function materialize(h, count = 1) {
+  return materializeWaveBatch({
+    state: h.state,
+    helpers: h.runtime.getHelpers()
+  }, {
+    ...req,
+    count
+  });
+}
+function hit(h, e, damage, options = {}) {
+  return h.withFeatures(() => h.runtime.getSystem('combat').ensureKernel().routeDamage({
+    attackerId: h.player.id,
+    targetId: e.id,
+    packet: scalarHitToDamagePacket({
+      damage,
+      damageType: 'kinetic',
+      ...options
+    }),
+    origin: {
+      kind: 'weapon',
+      id: 'test_lethal'
+    }
+  }));
+}
+function children(h, parent) {
+  return h.state.entityList.filter(e => e.alive && e.data?.splitterChild?.familyId === parent.data.splitterFamily.id);
+}
+function startFamilyWave(h) {
+  const wave = h.runtime.getSystem('survivalWave');
+  h.bus.emit('run:wavePlanned', {
+    wave: 17,
+    plan: {
+      ok: true,
+      schedule: [{
+        ...req,
+        atTick: 0,
+        debut: true
+      }],
+      swarm: {
+        killTarget: 4,
+        concurrent: 3,
+        reinforceGapTicks: 24,
+        roster: [{
+          enemyId: 'wasp_swarmer',
+          role: 'mass',
+          fromWave: 1,
+          weight: 10
+        }]
+      },
+      completionRules: {
+        blockingRoles: ['pressure']
+      }
+    }
+  });
+  h.bus.emit('run:waveStarted', {
+    wave: 17
+  });
+  return wave;
+}
+test('all 41 occupancies keep all-or-none three-seat families inside the unchanged cap40', async () => {
+  const h = await boot();
+  try {
+    const budget = h.runtime.getSystem('spawnBudget').api;
+    budget.setMax(40);
+    for (let occupied = 0; occupied <= 40; occupied++) {
+      budget.reset();
+      budget.request(occupied, 'survival-wave:occupied');
+      const receipt = materialize(h, 1);
+      assert.equal(receipt.admitted, occupied <= 37 ? 1 : 0, `occupancy ${occupied}`);
+      assert.equal(budget.current(), occupied + (occupied <= 37 ? 3 : 0));
+      if (receipt.admitted) {
+        const e = h.state.entities.get(receipt.spawnedIds[0]);
+        assert.equal(e.data.splitterFamily.parentLife, e.occupantGeneration);
+        e.alive = false;
+      }
+    }
+  } finally {
+    h.dispose();
+  }
+});
+for (const damage of [36, 48, 72, 100000]) test(`effective lethal damage ${damage} consumes finite tissue and never creates a duplicate corpse`, async () => {
+  const h = await boot([aftermathWrecks, mining]);
+  try {
+    const receipt = materialize(h);
+    assert.equal(receipt.admittedLives, 4);
+    const parent = h.state.entities.get(receipt.spawnedIds[0]);
+    h.step(1);
+    let kills = 0;
+    h.bus.on('entity:killed', p => {
+      if (p.id === parent.id) kills++;
+    });
+    const result = hit(h, parent, damage);
+    assert.ok(result.ok);
+    assert.equal(parent.alive, false);
+    const parts = children(h, parent);
+    assert.equal(parts.length, 3);
+    assert.ok(parts.every(e => !e.data.splitterFamily));
+    assert.equal(kills, 1);
+    const expected = splitterRemainingTissue(parent, {
+      result
+    });
+    assert.ok(Math.abs(parts.reduce((n, e) => n + (e.type === 'ship' ? e.hull : 0), 0) - expected) < 1e-8);
+    assert.ok(Math.abs(parts.reduce((n, e) => n + e.physicsBody.mass, 0) - 42) < 1e-7);
+    assert.equal(h.state.entityList.filter(e => e.alive && e.type === 'wreck').length, expected > 0 ? 0 : 3, 'no whole parent wreck or companion shard');
+    assert.equal(h.runtime.getSystem('spawnBudget').api.current(), expected > 0 ? 3 : 0);
+    h.runtime.getSystem('combat').kill(parent, h.player.id, {
+      result
+    });
+    assert.equal(kills, 1);
+    assert.equal(children(h, parent).length, 3);
+    for (const e of parts.filter(e => e.type === 'ship')) hit(h, e, 1000);
+    assert.equal(children(h, parent).filter(e => e.type === 'ship').length, 0, 'cells never recursively split');
+    assert.ok(h.state.entityList.filter(e => e.alive && e.type === 'wreck').length <= 3, 'cell death keeps its exact material, not a shard burst');
+  } finally {
+    h.dispose();
+  }
+});
+test('last-parent synchronous kill cannot clear before descendants; cancellation never asks for filler', async () => {
+  for (const overkill of [false, true]) {
+    const h = await boot([survivalWave, survivalRewards]);
+    try {
+      const wave = startFamilyWave(h);
+      const parent = [...wave._cohort.values()][0].entity;
+      h.step(1);
+      assert.equal(wave._plannedBodies, 4);
+      assert.equal(wave._admittedTotal, 4);
+      const clears = [];
+      h.bus.on('run:waveCleared', p => clears.push(p));
+      h.bus.on('entity:killed', p => {
+        if (p.id === parent.id) wave._checkCleared(h.state.run);
+      });
+      hit(h, parent, overkill ? 1000 : 36);
+      assert.equal(wave._cohort.size, overkill ? 0 : 3);
+      assert.equal(clears.length, overkill ? 1 : 0);
+      if (!overkill) {
+        for (const e of children(h, parent)) hit(h, e, 1000);
+        wave._checkCleared(h.state.run);
+      }
+      assert.equal(clears.length, 1);
+      assert.equal(clears[0].admitted, 4);
+      assert.equal(clears[0].killed, overkill ? 1 : 4);
+      assert.equal(clears[0].cancelled, overkill ? 3 : 0);
+      assert.equal(Object.keys(h.state.stunts.rewards.deaths).length, 1, 'one parent entitlement for the whole family');
+    } finally {
+      h.dispose();
+    }
+  }
+});
+test('unreserved old/manual parent retains one full-mass authored corpse and no descendant debt', async () => {
+  const h = await boot([aftermathWrecks, mining]);
+  try {
+    const parent = h.runtime.spawn(makeEnemySpawnSpec('brood_splitter', 1, {
+      x: 90,
+      z: 0
+    }));
+    h.step(1);
+    hit(h, parent, 36);
+    const corpses = h.state.entityList.filter(e => e.alive && e.type === 'wreck');
+    assert.equal(corpses.length, 1);
+    assert.equal(corpses[0].physicsBody.mass, 42);
+    assert.deepEqual(corpses[0].physicsBody.collisionProxyManifest, parent.physicsBody.collisionProxyManifest);
+    assert.equal(h.state.entityList.some(e => e.alive && e.data?.splitterChild), false);
+    assert.equal(h.runtime.getSystem('spawnBudget').api.current(), 0);
+  } finally {
+    h.dispose();
+  }
+});
