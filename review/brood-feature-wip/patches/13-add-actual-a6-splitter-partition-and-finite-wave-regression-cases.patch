+test('untimed/persistent wrecks remain resident and pause freezes finite wreck clocks', () => {
+  const sim = createSimulation({
+    seed: 904
+  });
+  sim.state.mode = 'flight';
+  const player = sim.spawn({
+    type: 'ship',
+    isPlayer: true,
+    pos: {
+      x: 0,
+      z: 0
+    }
+  });
+  sim.state.playerId = player.id;
+  const persistent = sim.spawn({
+    type: 'wreck',
+    pos: {
+      x: 300,
+      z: 0
+    },
+    data: {
+      markerId: 'durable_wreck'
+    }
+  });
+  const finite = sim.spawn({
+    type: 'wreck',
+    pos: {
+      x: 100,
+      z: 0
+    },
+    ttl: .1,
+    data: {
+      splitterResidue: true
+    }
+  });
+  sim.state.ui.screenStack = ['pause'];
+  const time = sim.state.simTime;
+  for (let i = 0; i < 100; i++) sim.step(SIM_DT);
+  assert.equal(sim.state.simTime, time);
+  assert.equal(finite.ttl, .1);
+  assert.equal(persistent.ttl, Infinity);
+  sim.state.ui.screenStack = [];
+  for (let i = 0; i < 9; i++) sim.step(SIM_DT);
+  assert.equal(sim.state.entities.has(finite.id), false);
+  assert.equal(sim.state.entities.get(persistent.id), persistent);
+  assert.equal(persistent.ttl, Infinity);
+});
