+// EXPLICIT SYNTHETIC PHYSICS FIXTURE. These circles are not Splitter art or production proxies.
+const centers = [{
+    x: -4,
+    z: 0
+  }, {
+    x: 3,
+    z: -3
+  }, {
+    x: 3,
+    z: 3
+  }],
+  masses = [18, 12, 12],
+  inertias = [9, 6, 6];
+const com = {
+  x: 0,
+  z: 0
+};
+const I = inertias.reduce((n, v, i) => n + v + masses[i] * (centers[i].x ** 2 + centers[i].z ** 2), 0);
+function actor(id, center, mass, inertia) {
+  return {
+    id,
+    occupantGeneration: id,
+    type: 'ship',
+    alive: true,
+    collides: true,
+    mass,
+    radius: 1,
+    pos: {
+      x: 100,
+      z: 90
+    },
+    vel: {
+      x: 31,
+      z: -17
+    },
+    rot: .67,
+    angVel: 1.9,
+    flags: {},
+    data: {},
+    physicsBody: {
+      schemaVersion: 1,
+      dynamic: true,
+      shape: 'ball',
+      radius: 1,
+      mass,
+      inertiaY: inertia,
+      centerOfMass: center,
+      material: 'ship',
+      ccd: true,
+      revision: 0
+    }
+  };
+}
+const close = (a, b, e = 1e-3) => assert.ok(Math.abs(a - b) < e, `${a} != ${b}`);
+function totals(owner, entities, origin) {
+  let M = 0,
+    Px = 0,
+    Pz = 0,
+    L = 0,
+    E = 0,
+    Cx = 0,
+    Cz = 0;
+  for (const e of entities) {
+    const r = owner.records.get(e.id),
+      m = r.body.mass(),
+      p = r.body.worldCom(),
+      v = r.body.linvel(),
+      w = -r.body.angvel().y,
+      iv = r.body.principalInertia().y;
+    M += m;
+    Px += m * v.x;
+    Pz += m * v.z;
+    Cx += m * p.x;
+    Cz += m * p.z;
+    L += iv * w + m * ((p.x - origin.x) * v.z - (p.z - origin.z) * v.x);
+    E += .5 * m * (v.x * v.x + v.z * v.z) + .5 * iv * w * w;
+  }
+  return {
+    M,
+    Px,
+    Pz,
+    L,
+    E,
+    Cx: Cx / M,
+    Cz: Cz / M
+  };
+}
