+        x: 100100,
+        z: -89910
+      };
+      owner.setFrameOrigin({
+        x: 99900,
+        z: -90000
+      }, 6);
+    }
+    owner.syncFromEntities([parent]);
+    if (motion === 'rebase') owner.setFrameOrigin({
+      x: 100000,
+      z: -90000
+    }, 7);
+    if (motion === 'native_impulse') owner.applyImpulse({
+      entityId: 1,
+      impulse: {
