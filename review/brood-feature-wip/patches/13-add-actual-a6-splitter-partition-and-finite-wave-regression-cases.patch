diff --git a/test/brood-splitter-attribution.test.mjs b/test/brood-splitter-attribution.test.mjs
new file mode 100644
index 0000000..dcc7357
--- /dev/null
+++ b/test/brood-splitter-attribution.test.mjs
@@ -0,0 +1,101 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { recordImpulseProvenance, holdImpulseProvenance, readRecentImpulseProvenance, readRecentImpulseProvenanceHistory, inheritMaterialImpulseProvenance } from '../src/combat/impulseKernel.js';
+import { bindStuntEvidence, unbindStuntEvidence, observeAppliedImpulse } from '../src/combat/stuntEvidence.js';
+const actor = (id, mass = 42) => ({
+  id,
+  occupantGeneration: id,
+  alive: true,
+  type: 'ship',
+  mass,
+  radius: 5,
+  hull: 36,
+  hullMax: 36,
+  pos: {
+    x: 0,
+    z: 0
+  },
+  vel: {
+    x: 20,
+    z: 0
+  },
+  rot: 0,
+  data: {
+    runCohort: 'survival',
+    runWave: 17
+  },
+  physicsBody: {
+    mass
+  }
+});
+test('three cells and one-body fallback keep original attribution clocks without additional stunt roots', () => {
+  const player = actor(10, 24),
+    parent = actor(11),
+    parts = [actor(12, 30), actor(13, 6), actor(14, 6)],
+    corpse = actor(15);
+  const state = {
+    tick: 20,
+    simTime: 20 / 60,
+    playerId: 10,
+    run: {
+      seed: 17
+    },
+    entities: new Map([player, parent, ...parts, corpse].map(e => [e.id, e])),
+    entityList: [player, parent, ...parts, corpse]
+  };
+  const journal = bindStuntEvidence(state);
+  try {
+    const root = observeAppliedImpulse(parent, {
+      x: 0,
+      z: 0
+    }, {
+      x: 20,
+      z: 0
+    }, {
+      actorId: 10,
+      weaponId: 'wpn_mass_driver'
+    }, 20, 'weapon_hit', state);
+    assert.ok(root);
+    recordImpulseProvenance(parent, {
+      actorId: 10,
+      weaponId: 'wpn_mass_driver',
+      tag: 'weapon_hit',
+      appliedTick: 20,
+      magnitude: 840
+    });
+    holdImpulseProvenance(parent, 260, 20, 20);
+    const sequence = journal.sequence;
+    for (const part of parts) assert.equal(inheritMaterialImpulseProvenance(parent, part, part.mass / 42, 20), true);
+    const copies = parts.map(p => readRecentImpulseProvenance(p, 20));
+    assert.equal(copies.reduce((n, p) => n + p.magnitude, 0), 840);
+    for (const p of copies) {
+      assert.equal(p.actorId, 10);
+      assert.equal(p.appliedTick, 20);
+      assert.equal(p.holdUntilTick, 260);
+    }
+    assert.equal(inheritMaterialImpulseProvenance(parent, corpse, 1, 20), true);
+    assert.deepEqual(readRecentImpulseProvenance(corpse, 20), readRecentImpulseProvenance(parent, 20));
+    assert.equal(journal.roots.size, 1);
+    assert.equal(journal.sequence, sequence, 'partition is neither a new impulse nor a new scoring edge');
+    for (const part of parts) assert.equal(readRecentImpulseProvenance(part, 261), null, 'original hold expiry is unchanged');
+  } finally {
+    unbindStuntEvidence(state);
+  }
+});
+test('recycled source or child life cannot relabel previous material attribution', () => {
+  const parent = actor(20),
+    child = actor(21);
+  recordImpulseProvenance(parent, {
+    actorId: 10,
+    tag: 'weapon_hit',
+    appliedTick: 10,
+    magnitude: 90
+  });
+  assert.equal(inheritMaterialImpulseProvenance(parent, child, .5, 10), true);
+  child.occupantGeneration++;
+  assert.equal(readRecentImpulseProvenance(child, 10), null);
+  assert.deepEqual(readRecentImpulseProvenanceHistory(child, 10), []);
+  parent.occupantGeneration++;
+  assert.equal(inheritMaterialImpulseProvenance(parent, child, .5, 10), false);
+  assert.equal(inheritMaterialImpulseProvenance(parent, 1, .5, 10), false);
+});
diff --git a/test/brood-splitter-counterplay.test.mjs b/test/brood-splitter-counterplay.test.mjs
new file mode 100644
index 0000000..e0f8872
--- /dev/null
+++ b/test/brood-splitter-counterplay.test.mjs
@@ -0,0 +1,95 @@
+import { BroodContactRuntime, advanceBroodAttack } from '../src/combat/broodContact.js';
+import { createBus } from '../src/core/eventBus.js';
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { combat, makeEnemySpawnSpec } from '../src/systems/combat.js';
+import { queuePhysicsImpulse } from '../src/core/physicsAuthority.js';
+import { tumbleStates } from '../src/systems/tumbleStates.js';
+import { bootRealPath, writeRealPathInput } from '../scripts/lib/bench/realPath.mjs';
+import { validateAIComponentContinuation } from '../src/ai/continuation.js';
+async function runCharge({ sidestep = false, rock = false, shove = false, role = 'brood_charger', distance = 155 } = {}) {
+  const host = await bootRealPath({ seed: 714, systems: ['tacticalAI', 'actions', 'flightV3', 'aiPorts', tumbleStates,
+    'collisionConsequences', 'physics', combat], hulls: [{ hullId: 'ship_kestrel', pos: { x: 0, z: 0 }, rot: 0, isPlayer: true }] });
+  const spec = makeEnemySpawnSpec(role, 1, { x: -distance, z: 0 });
+  spec.data.ai.forcePlayerTarget = true; spec.data.ai.huntPlayer = true;
+  spec.data.ai.moraleImmune = true; spec.data.ai.surrenderImmune = true;
+  spec.data.runCohort = 'survival'; spec.data.combat.targetId = host.player.id;
+  spec.data.ai.activity = { ...spec.data.ai.activity, targetId: host.player.id };
+  const actor = host.runtime.spawn(spec), phases = [], impacts = [], contacts = [];
+  host.bus.on('brood:phase', p => phases.push({ phase: p.phase, tick: p.tick, pos: { ...actor.pos }, line: p.attackLine }));
+  host.bus.on('physics:impact', p => impacts.push(structuredClone(p)));
+  host.bus.on('brood:contact', p => contacts.push(p));
+  let cover = null;
+  let pushed = false, startedDodge = false;
+  const initial = { hull: host.player.hull, shield: host.player.shield, actorHull: actor.hull };
+  let maxSpeed = 0, minDistance = Infinity, maxPlayerHeading = 0, captured = new Set();
+  try {
+    host.step(420, { before: () => {
+      const a = actor.data.broodAttack;
+      if (rock && !cover && a?.phase === 'windup') cover = host.spawnObstacle({pos:{x:actor.pos.x/2,z:0},radius:8,mass:800});
+      if (sidestep && a?.phase === 'windup' && host.state.tick - a.phaseStartedTick >= 12) startedDodge = true;
+      writeRealPathInput(host.state, { moveX: startedDodge ? 1 : 0 });
+      if (shove && !pushed && a?.phase === 'commit') { queuePhysicsImpulse(actor, { x: 0, y: 0, z: actor.mass * 85 }); pushed = true; }
+    }, after: () => {
+      const phase = actor.data.broodAttack?.phase;
+      if (phase && !captured.has(phase)) {
+        const stack = host.runtime.getSystem('tacticalAI').stack;
+        assert.equal(validateAIComponentContinuation('doctrine', stack.combatDoctrine.serializeContinuation()), true);
+        assert.equal(validateAIComponentContinuation('maneuver', stack.maneuver.serializeContinuation()), true);
+        captured.add(phase);
+      }
+      maxPlayerHeading = Math.max(maxPlayerHeading, Math.abs(host.player.rot));
+      maxSpeed = Math.max(maxSpeed, Math.hypot(actor.vel.x, actor.vel.z));
+      minDistance = Math.min(minDistance, Math.hypot(actor.pos.x-host.player.pos.x, actor.pos.z-host.player.pos.z));
+      if (phases.some(p => p.phase === 'recovery') || !actor.alive) return false;
+    } });
+    let postHitSteerDistance = null;
+    if (contacts.length) {
+      const z = host.player.pos.z;
+      host.step(45, { before: () => writeRealPathInput(host.state, { moveX: 1 }) });
+      postHitSteerDistance = Math.abs(host.player.pos.z - z);
+    }
+    if (shove) host.step(60, { before: () => writeRealPathInput(host.state, {}) });
+    return { phases, impacts, contacts, pushed, initial, actorId:actor.id, coverId:cover?.id, actorHull: actor.hull, actorAlive: actor.alive,
+      postHitSteerDistance, maxPlayerHeading, finalPos: { ...actor.pos }, playerPos: { ...host.player.pos }, maxSpeed, minDistance, proof: host.proof() };
+  } finally { host.dispose(); }
+}
+
+
+for(const role of ['brood_splitter','brood_splitter_axial']) test(`${role} real A6 contact has a visible response window, sidestep and physical redirect`, async()=>{
+  const options={role,distance:role==='brood_splitter'?120:90};
+  const hit=await runCharge(options),dodge=await runCharge({...options,sidestep:true}),shove=await runCharge({...options,shove:true}),cover=await runCharge({...options,rock:true});
+  console.log('Splitter counterplay',JSON.stringify({role,...Object.fromEntries(Object.entries({hit,dodge,shove,cover}).map(([k,r])=>[k,{phases:r.phases.map(p=>[p.phase,p.tick]),contacts:r.contacts.length,actorAlive:r.actorAlive,actorHull:r.actorHull,finalPos:r.finalPos,playerPos:r.playerPos,maxSpeed:r.maxSpeed}]))}));
+  for(const r of [hit,dodge,shove]) {
+    assert.equal(r.proof.sg02Ready,true);
+    assert.ok(r.phases.some(p=>p.phase==='windup'));
+    assert.ok(r.phases.some(p=>p.phase==='commit'));
+    assert.ok(r.phases.some(p=>p.phase==='recovery') || !r.actorAlive,'contact death also terminates the finite attack');
+  }
+  assert.equal(hit.contacts.length,1);
+  assert.equal(dodge.contacts.length,0);
+  assert.equal(shove.contacts.length,0);
+  assert.ok(Math.abs(shove.finalPos.z)>20);
+  assert.equal(cover.contacts.length,0,'locked target takes no remote bite through intervening matter');
+  assert.ok(cover.impacts.some(p=>(p.aId===cover.actorId&&p.bId===cover.coverId)||(p.bId===cover.actorId&&p.aId===cover.coverId)),'intervening cover meets the actual native body');
+  assert.ok(cover.actorHull<cover.initial.actorHull||!cover.actorAlive,'cover remains physically consequential');
+});
+
+test('pre-existing tumble/disable prevents a bite, but the same native collision may cause a new tumble',()=>{
+  for(const mode of ['old_collision','new_weapon','new_collision','disabled','recovering']) {
+    const actor={...makeEnemySpawnSpec('brood_splitter',1,{x:0,z:0}),id:2,occupantGeneration:2,alive:true};
+    const player={id:1,occupantGeneration:1,alive:true,team:0,pos:{x:50,z:0}};
+    const state={tick:60,simTime:1,mode:'flight',playerId:1,entityList:[actor,player],entities:new Map([[1,player],[2,actor]]),combat:{entities:{2:{statuses:{},pendingStatuses:[]}}}};
+    let hits=0;
+    const runtime=new BroodContactRuntime({state,bus:createBus(),ensureKernel:()=>({routeDamage:()=>{hits++;return {ok:true};}})});
+    actor.data.broodAttack=advanceBroodAttack(null,{role:'brood_splitter',entityId:2,tick:0,self:actor,target:player});
+    actor.data.broodAttack=advanceBroodAttack(actor.data.broodAttack,{role:'brood_splitter',entityId:2,tick:36,self:actor,target:player});
+    if(mode==='disabled') actor.data.disabled=true;
+    else if(mode==='recovering') actor.data.recoveringUntil=2;
+    else state.combat.entities[2].pendingStatuses.push({id:'status_tumbling',applyTick:mode==='old_collision'?10:60,data:{kind:mode==='new_weapon'?'weapon_tumble':'collision_tumble',startedAt:mode==='old_collision'?1/6:1}});
+    const impact={aId:2,bId:1,tick:60,consequenceKernelVersion:1,impulse:200,pos:{x:5,z:0}};
+    runtime.onImpact(impact);runtime.onImpact(impact);
+    assert.equal(hits,mode==='new_collision'?1:0,mode);
+    runtime.destroy();
+  }
+});
diff --git a/test/brood-splitter-death-presentation.test.mjs b/test/brood-splitter-death-presentation.test.mjs
