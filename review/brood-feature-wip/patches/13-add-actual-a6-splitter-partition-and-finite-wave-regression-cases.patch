+function nativeMaterialTotals(owner, entities) {
+  const result = { mass: 0, px: 0, pz: 0, angular: 0, energy: 0, cx: 0, cz: 0, colliders: 0 };
+  for (const entity of entities) {
+    const record = owner.records.get(entity.id), body = record.body;
+    const mass = body.mass(), com = body.worldCom(), velocity = body.linvel();
+    const spin = -body.angvel().y, inertia = body.principalInertia().y;
+    result.mass += mass; result.px += mass * velocity.x; result.pz += mass * velocity.z;
+    result.cx += mass * com.x; result.cz += mass * com.z;
+    result.angular += inertia * spin + mass * (com.x * velocity.z - com.z * velocity.x);
+    result.energy += .5 * mass * (velocity.x ** 2 + velocity.z ** 2) + .5 * inertia * spin ** 2;
+    result.colliders += record.colliders.length;
+  }
+  result.cx /= result.mass; result.cz /= result.mass;
+  return result;
+}
