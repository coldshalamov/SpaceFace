@@ -0,0 +1,178 @@
+// Node-safe production factory integration proof with an experienced-player launch config.
+// It covers retained-instance reset postconditions and seeded absolute Brood spawn replay. It does
+// not claim clicked UI, staged loading, DOM, or GPU evidence. Lethal
+// hits are injected through combat.onHit to test wave ownership quickly, not to
+// claim a player completed these fights or to replace contact-attack physics tests.
+import test from 'node:test';
+import {createHash} from 'node:crypto';
+import assert from 'node:assert/strict';
+import {createGameState} from '../src/core/gameState.js';
+import {createAuthoritativeRuntime} from '../src/runtime/createAuthoritativeRuntime.js';
+import {makeShipEntitySpec} from '../src/systems/ships.js';
+import {crucibleHullSetupFor,crucibleLaunchConfig,requestCrucibleRun,buildCrucibleRetryRequest,clearCrucibleSetup} from '../src/ui/crucibleLaunch.js';
+import {SWARM_RULESET,SWARM_ROSTER} from '../src/data/swarmMode.js';
+import {swarmStakeFor} from '../src/data/swarmStakes.js';
+import {applySandboxSetup} from '../src/ui/sandbox/sandboxSetup.js';
+import {SURVIVAL_COHORT_TAG} from '../src/systems/waveMaterialization.js';
+import {clearEntityRuntime} from '../src/core/entity.js';
+import {resetFreshRunSystems} from '../src/core/runReset.js';
+import {snapshotFeatureMaps,applyFeatureConfigToMaps,restoreFeatureMaps} from '../src/data/featureFlags.js';
+import {broodBodyContract,broodCollisionManifest} from '../src/data/broodBodies.js';
+const DT=1/60,SEED=4242;
+const life=e=>`${e.id}:${e.occupantGeneration}`;
+// Match realPath.mjs: backend construction and out-of-step gameplay actions must
+// hold the selected runtime's feature maps, including across asynchronous setup.
+// The runtime itself scopes init/step only; unwrapped callbacks see legacy defaults.
+async function withRuntimeFeatures(runtime,run){
+ const previous=snapshotFeatureMaps();applyFeatureConfigToMaps(runtime.config.features);
+ try{return await run();}finally{restoreFeatureMaps(previous);}
+}
+async function boot(setup, retained=null){
+ const runtime=retained || createAuthoritativeRuntime({profileId:'production',nodeSafeOnly:true,seed:setup.seed});
+ return withRuntimeFeatures(runtime,async()=>{
+ const state=runtime.state;state.mode='loading';state.ui.screenStack=[];
+ const requests=[];runtime.bus.on('game:new',p=>requests.push(p));
+ assert.equal(requestCrucibleRun(runtime.bus,setup,SWARM_RULESET),true);
+ assert.equal(requests.length,1,'validated door requests one new game');
+ runtime.getSystem('ships').buyShip({defId:setup.hullId,setActive:true,grant:true});
+ const player=runtime.spawn(makeShipEntitySpec(setup.hullId,{isPlayer:true,player:state.player,pos:{x:0,z:0}}));
+ state.playerId=player.id;
+ const events={arrivals:[],plans:[],clears:[],kills:[],drafts:[]};
+ runtime.bus.on('run:wavePlanned',p=>events.plans.push(structuredClone(p)));
+ runtime.bus.on('run:waveMaterialized',p=>events.arrivals.push({...p}));
+ runtime.bus.on('run:waveCleared',p=>{events.clears.push({...p});console.log('Brood retained wave cleared',p.wave??p.runWave,'tick',state.tick);});
+ runtime.bus.on('run:draftOffered',p=>events.drafts.push({wave:p.wave,count:p.offers.length}));
+ runtime.bus.on('entity:killed',p=>{
