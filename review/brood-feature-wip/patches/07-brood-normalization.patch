+export function normalizeBroodCollisionPrimitives(primitives, scale) {
+  if (!Array.isArray(primitives) || !primitives.length || primitives.length > 32 || !(scale > 0) || !Number.isFinite(scale)) throw new RangeError('invalid bounded Brood collision geometry');
+  return primitives.map(p=>{
+    if (!p || !['convex','capsule','obb'].includes(p.kind)) throw new RangeError('unsupported Brood collision primitive');
     const result={id:p.id,kind:p.kind};
+    if(p.kind==='convex') { result.vertices=normalizeConvexProxyVertices(p.vertices).map(([x,z])=>[x/scale,z/scale]); return result; }
     for(const key of p.kind==='capsule'?['ax','az','bx','bz','r']:['x','z','hx','hz']) result[key]=p[key]/scale;
     if(p.kind==='obb') result.angleDeg=p.rot*180/Math.PI;
     return result;
   });
+}
