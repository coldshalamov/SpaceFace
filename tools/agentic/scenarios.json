{
  "schemaVersion": 1,
  "name": "spaceface.agenticScenarioRegistry",
  "scenarios": [
    {
      "id": "boot-liveness",
      "seconds": 20,
      "purpose": "Title/New Game or Continue reaches changing flight canvas; sim and renderer advance together.",
      "checkpoints": [
        "flight-entered",
        "canvas-changing",
        "player-control"
      ],
      "invariants": [
        "no-frame-error-streak",
        "no-required-asset-invisible",
        "no-unrecovered-context-loss"
      ]
    },
    {
      "id": "flight-accel-brake",
      "seconds": 18,
      "purpose": "Measure throttle response, acceleration, jerk, brake settling and residual drift.",
      "checkpoints": [
        "throttle-on",
        "cruise",
        "brake-on",
        "settled"
      ],
      "metrics": [
        "inputLatencyMs",
        "peakAccel",
        "peakJerk",
        "brakeSettleS",
        "residualSpeed"
      ]
    },
    {
      "id": "flight-slalom",
      "seconds": 25,
