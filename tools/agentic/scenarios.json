      "checkpoints": [
        "gate-1",
        "gate-3",
        "gate-5",
        "complete"
      ],
      "metrics": [
        "crossTrackP95",
        "meanSpeed",
        "yawJerkP95",
        "overshootCount"
      ]
    },
