+  _bayFineMult(def) {
+    const table = { legal: 0, restricted: 0.8, illegal: 1.2, contraband: 1.5 };
+    const legality = def && def.legality;
+    if (legality && table[legality] != null) return table[legality];
+    return def && Number(def.fineMult) > 0 ? Number(def.fineMult) : 1;
