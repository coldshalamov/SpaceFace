{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "master": true,
      "main": true,
      "codex/iphone14-mobile": true,
      "codex/oct15-maturity-checkpoint": true,
      "devin/1791331347-gyre-snare": true,
      "devin/1791416174-gyre-snare-polish": true
    }
  },
  "framework": null,
  "ignoreCommand": "node scripts/vercel-ignore-build.mjs",
  "installCommand": "ELECTRON_SKIP_BINARY_DOWNLOAD=1 PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 npm ci",
  "buildCommand": "npm run build:bundle",
  "outputDirectory": "build/web",
  "headers": [
    {
      "source": "/workers/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/main.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
