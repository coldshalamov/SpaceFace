{
  "$name": "Field Hardware",
  "$source": "design/frontend/direction/packets/_COMMON/02_ART_DIRECTION.md §6 §7 §9, with the plate, edge-light and legend values measured off the produced Cycles renders rather than asserted.",
  "$produced": "2026-09-10, S1 / PQ-194.00",
  "$scaleNote": "Type sizes are px at a 1920-wide frame. ×0.75 at 1280 with a hard 12 px floor; ×1.25 at 2560. The floor is an accessibility floor, not a style choice, and it applies to canvas text too.",

  "colour": {
    "ground":        { "value": "#0C0A08", "role": "the painted background where no scene exists; warm near-black" },
    "plate":         { "value": "#1A1714", "role": "gunmetal surface; measured #20180F lit on the produced plate" },
    "plate-raised":  { "value": "#26211B", "role": "one step lighter: the selected or active plate" },
    "plate-sunk":    { "value": "#100E0C", "role": "recessed wells that hold rows and readouts" },
    "edge-light":    { "value": "#F2B950", "role": "lit top edges; the produced relief band peaks at #8F7455. Used at 47% — a hair over the top of §7's 30–45% band, because 38% falls to 2.45:1 against the ground and a plate edge is component-boundary information" },
    "under-shadow":  { "value": "#090605", "role": "the 1–2 px shadow under a plate; measured off the produced plate" },
    "bone":          { "value": "#EAE6DF", "role": "text on plates: 100% live, 62% resting, 38% tertiary" },
    "legend":        { "value": "#FFB347", "role": "backlit legend light (amber); renders #FFBE4C lit, #AD782D at rest. Resting is 45%, not §4's 40%: 40% measures 2.62:1 against a sunk well, below the programme's own 3:1 UI floor (§7). The floor is not aesthetic and wins" },
    "signal":        { "value": "#F2B950", "role": "the actionable thing; the selected row's light; primary key legend" },
    "hazard":        { "value": "#FF6A2B", "role": "safety paint, destructive, danger (UI signal value)" },
    "hazard-paint":  { "value": "#D9551F", "role": "the sprayed enamel the produced chevrons use; chalkier than the signal" },
    "hazard-yellow": { "value": "#C79A3C", "role": "the alternating chevron" },
    "wanted":        { "value": "#FF4D3D", "role": "replaces signal while wanted" },
    "cold":          { "value": "#DDE6FF", "role": "the cold white-blue backlight of the wanted temperature" },
    "good":          { "value": "#9BD8A0", "role": "numerals only" },
    "bad":           { "value": "#FF7A6B", "role": "numerals only" },
    "glass":         { "value": "#05070A", "role": "smoked windows, used at 35–55% darkening" },
    "paper":         { "value": "#E8DFCE", "role": "the codex reading insert" }
  },

  "temperature": {
    "$note": "A temperature changes the whole frame, never one badge (§7).",
    "flight":  { "key": "#FFDCAE", "fill": "#8FA6C8", "signal": "signal",  "legend": "legend" },
    "docked":  { "key": "#FFDCB4", "fill": "#A8846A", "signal": "signal",  "legend": "legend",
                 "plateShift": "+6% red, legends brighter" },
    "wanted":  { "key": "#E8EEFF", "fill": "#7E93C6", "signal": "wanted",  "legend": "cold",
                 "note": "every backlight goes cold white-blue, one sustained cold tone" },
    "crucible":{ "key": "#FFFFFF", "fill": "#CFE0FF", "signal": "#FFFFFF", "legend": "#FFFFFF",
                 "note": "white-hot: edge-light white, hazard stripes live" }
  },

  "alpha": {
    "bone-live": 1.0, "bone-resting": 0.62, "bone-tertiary": 0.38,
    "legend-live": 1.0, "legend-resting": 0.45, "legend-off": 0.0,
    "edge-light": 0.47, "glass": 0.45, "glass-deep": 0.60, "wear-max": 0.08
  },

  "type": {
    "display": { "family": "Archivo", "wght": 900, "wdth": 125, "tracking": "0.02em",
                 "lineHeight": 0.9, "case": "uppercase allowed: it is a marking" },
    "legend":  { "family": "Archivo", "wght": 600, "wdth": 62, "tracking": "0.06em",
                 "lineHeight": 1.0, "case": "uppercase" },
    "body":    { "family": "Instrument Sans", "wght": 400, "lineHeight": 1.4,
                 "measure": "64ch", "case": "sentence" },
    "emphasis":{ "family": "Instrument Sans", "wght": 500, "lineHeight": 1.4 },
    "data":    { "family": "Instrument Sans", "wght": 500, "features": "tnum",
                 "align": "right", "note": "tabular; never proportional" },
    "heroNum": { "family": "Archivo", "wght": 800, "wdth": 125, "features": "tnum" },
    "scale": {
      "fine": 12, "data": 14, "body": 16, "emphasis": 20, "subhead": 28, "menu": 40,
      "heroNum": 64, "screenTitle": 96, "hero": 140, "name": 200
    },
    "scale1280": {
      "fine": 12, "data": 12, "body": 12, "emphasis": 15, "subhead": 21, "menu": 30,
      "heroNum": 48, "screenTitle": 72, "hero": 105, "name": 150
    },
    "scale2560": {
      "fine": 15, "data": 18, "body": 20, "emphasis": 25, "subhead": 35, "menu": 50,
      "heroNum": 80, "screenTitle": 120, "hero": 175, "name": 250
    },
    "floorPx": 12,
    "$rule": "Every screen carries at least one element at 64 px or larger."
  },

  "space": { "hair": 2, "xs": 4, "s": 8, "m": 12, "l": 16, "xl": 24, "2xl": 32, "3xl": 48,
             "4xl": 64, "5xl": 96 },

  "plate": {
    "$note": "Modelled values: 1 Blender unit = 1 design pixel at @1x, so these are literal.",
    "thickness": 7,
    "edgeRelief": 3.4,
    "edgeLift": 1.3,
    "litEdgePx": 3,
    "underShadowPx": 2,
    "radius": 4,
    "radiusSmall": 2,
    "cutAngle": 30,
    "cutAngleRule": "one signature 45° cut, top-right, on primary plates only",
    "grainOpacity": 0.06,
    "sliceDefault": 24,
    "sliceEdgeSmall": 16
  },

  "motion": {
    "poster": { "stagger": 40, "settle": 280, "settleMin": 240, "settleMax": 320,
                "ease": "cubic-bezier(0.2, 0.8, 0.2, 1)", "driftDegPerSec": 0.5,
                "parallaxMaxPx": 6 },
    "bench":  { "slide": 200, "slideMin": 180, "slideMax": 220, "lightUp": 100,
                "pressDown": 60, "pressUp": 120, "overshootFrames": 1,
                "ease": "cubic-bezier(0.2, 0.8, 0.2, 1)" },
    "edge":   { "valueEase": 120, "pulse": 400, "pulseCount": 1,
                "ease": "cubic-bezier(0.33, 0, 0.15, 1)" },
    "reduced": { "all": 0, "note": "every transition becomes a cut; drift and parallax off" }
  },

  "contrastPairs": [
    { "use": "body text on a plate",            "fg": "bone",   "bg": "plate",        "alpha": 1.0,  "floor": 4.5 },
    { "use": "resting text on a plate",         "fg": "bone",   "bg": "plate",        "alpha": 0.62, "floor": 4.5 },
    { "use": "tertiary text on a plate (large)","fg": "bone",   "bg": "plate",        "alpha": 0.38, "floor": 3.0 },
    { "use": "body text on a raised plate",     "fg": "bone",   "bg": "plate-raised", "alpha": 1.0,  "floor": 4.5 },
    { "use": "resting text on a raised plate",  "fg": "bone",   "bg": "plate-raised", "alpha": 0.62, "floor": 4.5 },
    { "use": "body text in a sunk well",        "fg": "bone",   "bg": "plate-sunk",   "alpha": 1.0,  "floor": 4.5 },
    { "use": "body text on the ground",         "fg": "bone",   "bg": "ground",       "alpha": 1.0,  "floor": 4.5 },
    { "use": "resting text on the ground",      "fg": "bone",   "bg": "ground",       "alpha": 0.62, "floor": 4.5 },
    { "use": "lit legend in its well",          "fg": "legend", "bg": "plate-sunk",   "alpha": 1.0,  "floor": 3.0 },
    { "use": "resting legend in its well",      "fg": "legend", "bg": "plate-sunk",   "alpha": 0.45, "floor": 3.0 },
    { "use": "signal on a plate (UI)",          "fg": "signal", "bg": "plate",        "alpha": 1.0,  "floor": 3.0 },
    { "use": "signal text on a plate",          "fg": "signal", "bg": "plate",        "alpha": 1.0,  "floor": 4.5 },
    { "use": "wanted signal on a plate",        "fg": "wanted", "bg": "plate",        "alpha": 1.0,  "floor": 3.0 },
    { "use": "cold legend on a plate (wanted)", "fg": "cold",   "bg": "plate",        "alpha": 1.0,  "floor": 4.5 },
    { "use": "good numeral on a plate",         "fg": "good",   "bg": "plate",        "alpha": 1.0,  "floor": 4.5 },
    { "use": "bad numeral on a plate",          "fg": "bad",    "bg": "plate",        "alpha": 1.0,  "floor": 4.5 },
    { "use": "hazard on a plate (UI element)",  "fg": "hazard", "bg": "plate",        "alpha": 1.0,  "floor": 3.0 },
    { "use": "edge light against the ground",   "fg": "edge-light", "bg": "ground",   "alpha": 0.47, "floor": 3.0 },
    { "use": "body text on the paper insert",   "fg": "#22201C","bg": "paper",        "alpha": 1.0,  "floor": 4.5 },
    { "use": "focus ring on the darkest plate", "fg": "bone",   "bg": "plate-sunk",   "alpha": 1.0,  "floor": 3.0 },
    { "use": "focus ring on the lightest plate","fg": "bone",   "bg": "plate-raised", "alpha": 1.0,  "floor": 3.0 }
  ]
}
